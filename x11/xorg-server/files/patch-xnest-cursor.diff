+    xnestPrivCursor *priv = xnestGetCursorPriv(pCursor, pScreen);
     XImage *ximage;
     Pixmap source, mask;
     XColor fg_color, bg_color;
     unsigned long valuemask;
     XGCValues values;
+
+    if (priv)
+        return True;
+
+    priv = malloc(sizeof(*priv));
+    if (!priv)
+        return False;

     valuemask = GCFunction |
         GCPlaneMask | GCForeground | GCBackground | GCClipMask;
@@ -98,10 +106,10 @@
     bg_color.green = pCursor->backGreen;
     bg_color.blue = pCursor->backBlue;

-    xnestSetCursorPriv(pCursor, pScreen, calloc(1, sizeof(xnestPrivCursor)));
-    xnestCursor(pCursor, pScreen) =
+    priv->cursor =
         XCreatePixmapCursor(xnestDisplay, source, mask, &fg_color, &bg_color,
                             pCursor->bits->xhot, pCursor->bits->yhot);
+    xnestSetCursorPriv(pCursor, pScreen, priv);

     XFreePixmap(xnestDisplay, source);
     XFreePixmap(xnestDisplay, mask);
@@ -112,15 +120,25 @@
 Bool
 xnestUnrealizeCursor(DeviceIntPtr pDev, ScreenPtr pScreen, CursorPtr pCursor)
 {
-    XFreeCursor(xnestDisplay, xnestCursor(pCursor, pScreen));
-    free(xnestGetCursorPriv(pCursor, pScreen));
+    xnestPrivCursor *priv = xnestGetCursorPriv(pCursor, pScreen);
+
+    /* The cursor may not have been realized on this screen. */
+    if (priv) {
+        XFreeCursor(xnestDisplay, priv->cursor);
+        free(priv);
+        xnestSetCursorPriv(pCursor, pScreen, NULL);
+    }
     return True;
 }

