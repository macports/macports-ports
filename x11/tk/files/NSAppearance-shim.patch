--- macosx/tkMacOSXPrivate.h
+++ macosx/tkMacOSXPrivate.h
@@ -488,6 +488,153 @@ VISIBILITY_HIDDEN
 - (NSMenuItem *)itemInSupermenu;
 @end
 
+/* Minimal compatibility for very old SDKs (pre-10.9).
+ * This block is placed immediately BEFORE the existing
+ * "// Need undocumented appearance: argument" area and does not modify
+ * the subsequent existing declarations.
+ */
+#if MAC_OS_X_VERSION_MAX_ALLOWED < 1090
+#pragma mark - NSAppearance
+
+@interface NSAppearance : NSObject
++ (instancetype)appearanceNamed:(NSString *)name;
+- (NSString *)bestMatchFromAppearancesWithNames:(NSArray *)names;
+- (NSString *)name;
+@end
+
+#pragma mark - NSView
+
+@interface NSView (TKAppearanceShim)
+@property(nonatomic, readonly) NSAppearance *effectiveAppearance;
+@end
+
+#pragma mark - NSMenu
+
+@interface NSMenu (TKAppearanceShim)
+- (BOOL)popUpMenuPositioningItem:(NSMenuItem *)item
+                    atLocation:(NSPoint)location
+                        inView:(NSView *)view
+                     appearance:(NSAppearance *)appearance;
+@end
+
+#pragma mark - Implementation
+
+static NSAppearance *TKAquaAppearance(void)
+{
+    static NSAppearance *appearance;
+    if (!appearance)
+        appearance = [[NSAppearance alloc] init];
+    return appearance;
+}
+
+static id TKAppearanceNamed(id self, SEL _cmd, NSString *name)
+{
+    (void)self;
+    (void)_cmd;
+    (void)name;
+    return TKAquaAppearance();
+}
+
+static id TKAppearanceName(id self, SEL _cmd)
+{
+    (void)self;
+    (void)_cmd;
+    return @"NSAppearanceNameAqua";
+}
+
+static id TKAppearanceBestMatch(id self, SEL _cmd, NSArray *names)
+{
+    (void)self;
+    (void)_cmd;
+    if ([names containsObject:@"NSAppearanceNameAqua"])
+        return @"NSAppearanceNameAqua";
+    return [names count] ? [names objectAtIndex:0]
+                         : @"NSAppearanceNameAqua";
+}
+
+static id TKViewEffectiveAppearance(id self, SEL _cmd)
+{
+    (void)self;
+    (void)_cmd;
+    return TKAquaAppearance();
+}
+
+static BOOL TKMenuPopUpWithAppearance(
+    id self,
+    SEL _cmd,
+    NSMenuItem *item,
+    NSPoint location,
+    NSView *view,
+    NSAppearance *appearance)
+{
+    (void)_cmd;
+    (void)appearance;
+    return [self popUpMenuPositioningItem:item
+                             atLocation:location
+                                 inView:view];
+}
+
+static void __attribute__((constructor))
+TKInstallAppearanceShim(void)
+{
+    Class appearanceClass = objc_getClass("NSAppearance");
+    if (!appearanceClass) {
+        appearanceClass =
+            objc_allocateClassPair([NSObject class], "NSAppearance", 0);
+        objc_registerClassPair(appearanceClass);
+    }
+    Class appearanceMetaClass = object_getClass(appearanceClass);
+    if (!class_getInstanceMethod(
+            appearanceClass,
+            @selector(bestMatchFromAppearancesWithNames:))) {
+        class_addMethod(
+            appearanceClass,
+            @selector(bestMatchFromAppearancesWithNames:),
+            (IMP)TKAppearanceBestMatch,
+            "@@:@");
+    }
+    if (!class_getInstanceMethod(
+            appearanceClass,
+            @selector(name))) {
+        class_addMethod(
+            appearanceClass,
+            @selector(name),
+            (IMP)TKAppearanceName,
+            "@@:");
+    }
+    if (!class_getInstanceMethod(
+            appearanceMetaClass,
+            @selector(appearanceNamed:))) {
+        class_addMethod(
+            appearanceMetaClass,
+            @selector(appearanceNamed:),
+            (IMP)TKAppearanceNamed,
+            "@@:@");
+    }
+    Class viewClass = [NSView class];
+    if (!class_getInstanceMethod(
+            viewClass,
+            @selector(effectiveAppearance))) {
+        class_addMethod(
+            viewClass,
+            @selector(effectiveAppearance),
+            (IMP)TKViewEffectiveAppearance,
+            "@@:");
+    }
+
+    Class menuClass = [NSMenu class];
+    SEL menuSelector =
+        @selector(popUpMenuPositioningItem:atLocation:inView:appearance:);
+    if (!class_getInstanceMethod(menuClass, menuSelector)) {
+        class_addMethod(
+            menuClass,
+            menuSelector,
+            (IMP)TKMenuPopUpWithAppearance,
+            "B@:@{_NSPoint=dd}@:@");
+    }
+}
+#endif
+
 // Need undocumented appearance: argument
 @interface NSMenu(TKMenu)
 - (BOOL)popUpMenuPositioningItem:(NSMenuItem *)item
