patch {
    reinplace -E "s|build-linux|build-${goos}|g"        ${worksrcpath}/Makefile
    reinplace -E "s|GOOS=linux|GOOS=${goos}|g"          ${worksrcpath}/Makefile
    reinplace -E "s|GOARCH=amd64|GOARCH=${goarch}|g"    ${worksrcpath}/Makefile
}

