PortSystem          1.0
PortGroup           github 1.0

github.setup        wiire-a pixiewps 1.4.2 v
github.tarball_from releases
revision            0
checksums           rmd160  c7b99738a6211901e5e6c25b73df381989cd03a0 \
                    sha256  c4dc0569e476ebdbd85992da2d1ff799db97ed0040da9dc44e13d08a97a9de1e \
                    size    97380

name                pixiewps
categories          security
maintainers         {jesuschapman.me:developer @JesusChapman} openmaintainer
license             GPL-3+

description         Offline WPS brute-force utility

long_description    Pixiewps is a tool written in C used to brute-force \
                    offline the WPS PIN, exploiting the low or non-existing \
                    entropy of some software implementations, the so-called \
                    pixie-dust attack. As opposed to the traditional online \
                    brute-force attack implemented in tools like Reaver or \
                    Bully, this method can recover the PIN in only a matter \
                    of seconds or minutes if the target is vulnerable.

use_xz              yes

use_configure       no

build.args-append   CC="${configure.cc} [get_canonical_archflags cc]"

destroot.args       PREFIX=${prefix}

variant openssl description {Enable OpenSSL support for better speeds} {
    depends_lib-append \
                    path:lib/libssl.dylib:openssl

    build.args-append \
                    OPENSSL=1
}
