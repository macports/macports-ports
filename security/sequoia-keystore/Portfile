# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           gitlab 1.0
PortGroup           cargo 1.0
PortGroup           openssl 1.0

gitlab.setup        sequoia-pgp sequoia-keystore 0.3.0-pqc.1 server/v
revision            1
checksums           ${distname}${extract.suffix} \
                    rmd160  edfc421aae9d8a3885f30cc29b456f7771266b36 \
                    sha256  f2f389d5abcd6fa5b9c3c3796f2e75349d2820ddb77a34a729e9ac327eaf1cdb \
                    size    315884

description         This project implements a private key store for Sequoia.
long_description    ${description} \
    This allows sequoia to access private keys stored in OpenPGP smartcards.
license             LGPL-2.0+

categories          security mail
maintainers         {cal @neverpanic} openmaintainer

depends_build-append \
                    port:capnproto \
                    port:pkgconfig
depends_run-append \
                    port:opensc

worksrcdir ${name}-${version}/server

post-patch {
    # Replace Cargo.lock with our own copy since upstream does not update the
    # lockfiles of all dependent crates for security releases; but keep our
    # version so we get repeatable builds regardless of when something is
    # installed.
    # This file is generated using `cargo generate-lockfile` in the source
    # tree.
    file delete -force \
        ${worksrcpath}/Cargo.lock
    xinstall \
        -m 644 \
        ${filespath}/Cargo.lock \
        ${workpath}/${name}-${version}/Cargo.lock
}

build.args \
    --no-default-features \
    --features {"sequoia-openpgp/crypto-openssl sequoia-openpgp/compression sequoia-keystore/softkeys sequoia-keystore/openpgp-card"}

destroot {
    xinstall -d -m 0755 \
        ${destroot}${prefix}/lib/sequoia
    xinstall -m 0755 \
        ${worksrcpath}/../target/[option triplet.${muniversal.build_arch}]/release/sequoia-keystore \
        ${destroot}${prefix}/lib/sequoia/
}

livecheck.regex {tags/server%2Fv([0-9][^<]+)</id>}

