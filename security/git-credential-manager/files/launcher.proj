<Project DefaultTargets="CreateLauncher">
  <PropertyGroup>
    <GcmDirectory>$(MSBuildThisFileDirectory)tools/net10.0/any</GcmDirectory>
  </PropertyGroup>
  <UsingTask TaskName="Microsoft.NET.Build.Tasks.CreateAppHost"
             AssemblyFile="$(MSBuildSDKsPath)/Microsoft.NET.Sdk/tools/net10.0/Microsoft.NET.Build.Tasks.dll" />
  <Target Name="CreateLauncher">
    <CreateAppHost
        AppHostSourcePath="$(MSBuildToolsPath)/AppHostTemplate/apphost"
        AppHostDestinationPath="$(GcmDirectory)/git-credential-manager"
        AppBinaryName="git-credential-manager.dll"
        IntermediateAssembly="$(GcmDirectory)/git-credential-manager.dll"
        DotNetSearchLocations="AppRelative"
        AppRelativeDotNet="../dotnet"
        EnableMacOSCodeSign="true" />
  </Target>
</Project>
