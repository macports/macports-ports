dannylongeuay/tree-sitter-go-template has been deleted, so the gotmpl grammar
fetch in helix-term's build script fails and git prompts for GitHub credentials.
Point at ngalaiko/tree-sitter-go-template, which upstream moved to in
https://github.com/helix-editor/helix/commit/ac91b309c1e2 and which contains the
same revision -- keeping the rev unchanged so 25.07.1's shipped highlight
queries still match the grammar.

--- languages.toml.orig
+++ languages.toml
@@ -806,7 +806,7 @@
 
 [[grammar]]
 name = "gotmpl"
-source = { git = "https://github.com/dannylongeuay/tree-sitter-go-template", rev = "395a33e08e69f4155156f0b90138a6c86764c979" }
+source = { git = "https://github.com/ngalaiko/tree-sitter-go-template", rev = "395a33e08e69f4155156f0b90138a6c86764c979" }
 
 [[language]]
 name = "gowork"
