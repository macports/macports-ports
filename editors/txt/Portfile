                    rmd160  e6a3e88313ae5442d7458df7e491756635555890 \
                    sha256  a706346ec4ce8fc8ce3040837ffe27a882b76e8907d0826cf415f21916ca1c31 \
                    size    3028812

destroot {
    set bin ${worksrcpath}/target/[cargo.rust_platform]/release/${name}
    xinstall -m 0755 ${bin} ${destroot}${prefix}/bin/

    set bash_dir ${destroot}${prefix}/share/bash-completion/completions
    set fish_dir ${destroot}${prefix}/share/fish/vendor_completions.d
    set zsh_dir ${destroot}${prefix}/share/zsh/site-functions
    xinstall -d ${bash_dir} ${fish_dir} ${zsh_dir}
    system "${bin} --completions bash > ${bash_dir}/${name}"
    system "${bin} --completions fish > ${fish_dir}/${name}.fish"
    system "${bin} --completions zsh > ${zsh_dir}/_${name}"

    set docdir ${destroot}${prefix}/share/doc/${name}
    xinstall -d ${docdir}
    xinstall -m 0644 -W ${worksrcpath} CHANGELOG.md LICENSE-APACHE LICENSE-MIT README.md ${docdir}
}

