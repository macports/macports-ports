PortSystem          1.0

name                macdown-se
version             1.0.0
categories          editors aqua
platforms           darwin
supported_archs     arm64
license             MIT
maintainers         {@jeff-oomu} openmaintainer

description         Open-source Markdown editor for Apple Silicon
long_description    MacDown SE is the native Apple Silicon continuation of the classic \
                    native Markdown editor for macOS, featuring built-in Model Context \
                    Protocol (MCP) server integration and AppKit performance.

homepage            https://github.com/eldris-io/macdown-se
master_sites        ${homepage}/releases/download/v${version}/
distname            MacDown-SE-${version}
use_dmg             yes

checksums           rmd160  3870ed9e91838fa83144539a58be02fd75a879b5 \
                    sha256  81849c62f42745ff520adaa303e0dafa383ee6a3ea7c285cd24080bedacb0631 \
                    size    8591919

destroot {
    copy "${workpath}/MacDown SE.app" ${destroot}${applications_dir}
    xinstall -d ${destroot}${prefix}/bin
    ln -s "${applications_dir}/MacDown SE.app/Contents/SharedSupport/bin/macdown-se" ${destroot}${prefix}/bin/macdown-se
    ln -s "${prefix}/bin/macdown-se" ${destroot}${prefix}/bin/macdown
}

livecheck.type      github
livecheck.url       ${homepage}/releases
livecheck.regex     {/releases/tag/v([0-9.]+)}
