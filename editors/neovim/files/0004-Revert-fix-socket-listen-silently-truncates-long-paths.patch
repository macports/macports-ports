From b188524af70daa15d85ae4aa79a42e88e275b159 Mon Sep 17 00:00:00 2001
From: Herby Gillot <herby.gillot@gmail.com>
Date: Sat, 28 Nov 2026 06:14:48 -0500
Subject: [PATCH 4/4] Revert "fix(socket): --listen silently truncates long
 paths #40625"

uv_pipe_bind2() needs libuv 1.46, and MacPorts libuv is 1.44.2. Only the
src/nvim/event/socket.c part is reverted. Remove this patch once
MacPorts' libuv is 1.46 or later.

See: https://github.com/neovim/neovim/commit/65345c99814dfce63f248acfac53e8bcf62f3222

This reverts the src/nvim/event/socket.c part of commit
65345c99814dfce63f248acfac53e8bcf62f3222.
---
 src/nvim/event/socket.c | 6 ++----
 1 file changed, 2 insertions(+), 4 deletions(-)

diff --git a/src/nvim/event/socket.c b/src/nvim/event/socket.c
index baf977590..2205fc08e 100644
--- a/src/nvim/event/socket.c
+++ b/src/nvim/event/socket.c
@@ -169,8 +169,7 @@ int socket_watcher_start(SocketWatcher *watcher, int backlog, socket_cb cb)
     }
     uv_freeaddrinfo(watcher->uv.tcp.addrinfo);
   } else {
-    result = uv_pipe_bind2(&watcher->uv.pipe.handle, watcher->addr, strlen(watcher->addr),
-                           UV_PIPE_NO_TRUNCATE);
+    result = uv_pipe_bind(&watcher->uv.pipe.handle, watcher->addr);
 
     // If bind failed with EACCES/EADDRINUSE, check if socket is stale
     if (result == UV_EACCES || result == UV_EADDRINUSE) {
@@ -197,8 +196,7 @@ int socket_watcher_start(SocketWatcher *watcher, int backlog, socket_cb cb)
           watcher->stream->data = watcher;
 
           // Retry bind with fresh handle
-          result = uv_pipe_bind2(&watcher->uv.pipe.handle, watcher->addr, strlen(watcher->addr),
-                                 UV_PIPE_NO_TRUNCATE);
+          result = uv_pipe_bind(&watcher->uv.pipe.handle, watcher->addr);
         }
       } else {
         // Socket is alive - this is a real error
