+const SDL_PixelFormatDetails *SDL_GetPixelFormatDetails(SDL_PixelFormatStruct *format) {
+    SDL_PixelFormatDetails *details = (SDL_PixelFormatDetails *)malloc(sizeof(SDL_PixelFormatDetails));
+    if (!details) {
+        return NULL;
+    }
+    // suffer.
+    details->format          = format->format;
+    details->bits_per_pixel  = format->BitsPerPixel;
+    details->bytes_per_pixel = format->BytesPerPixel;
+    details->Rmask           = format->Rmask;
+    details->Gmask           = format->Gmask;
+    details->Bmask           = format->Bmask;
+    details->Amask           = format->Amask;
+
+    details->Rbits           = 8 - format->Rloss;
+    details->Gbits           = 8 - format->Gloss;
+    details->Bbits           = 8 - format->Bloss;
+    details->Abits           = 8 - format->Aloss;
+
+    details->Rshift          = format->Rshift;
+    details->Gshift          = format->Gshift;
+    details->Bshift          = format->Bshift;
+    details->Ashift          = format->Ashift;
+
+    return details;
+}
