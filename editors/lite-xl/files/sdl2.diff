@@ -0,0 +1,442 @@
+#include "properties.h"
+#include <stdlib.h>
+#include <string.h>
+
+typedef enum {
+	PROP_TYPE_STRING,
+	PROP_TYPE_NUMBER,
+	PROP_TYPE_FLOAT,
+	PROP_TYPE_BOOLEAN,
+	PROP_TYPE_POINTER,
+} PropertyType;
+
+typedef struct {
+	char *name;
+	PropertyType type;
+	union {
+		char *string_value;
+		int64_t number_value;
+		float float_value;
+		SDL_bool bool_value;
+		void *pointer_value;
+	} value;
+	SDL_CleanupPropertyCallback cleanup;
+	void *cleanup_userdata;
+} Property;
+
+typedef struct {
+	SDL_PropertiesID id;
+	Property *properties;
+	int count;
+	int capacity;
+	SDL_mutex *lock;
+} PropertyStore;
+
+static PropertyStore **stores = NULL;
+static int store_count = 0;
+static int store_capacity = 0;
+static SDL_mutex *stores_lock = NULL;
+static SDL_PropertiesID next_id = 1;
+
+static void ensure_stores_lock(void) {
+	if (!stores_lock) {
+		stores_lock = SDL_CreateMutex();
+	}
+}
+
+static PropertyStore *get_store(SDL_PropertiesID id) {
+	for (int i = 0; i < store_count; i++) {
+		if (stores[i]->id == id) {
+			return stores[i];
+		}
+	}
+	return NULL;
+}
+
+static Property *find_property(PropertyStore *store, const char *name) {
+	if (!store || !name) return NULL;
+	for (int i = 0; i < store->count; i++) {
+		if (strcmp(store->properties[i].name, name) == 0) {
+			return &store->properties[i];
+		}
+	}
+	return NULL;
+}
+
+static void cleanup_property_value(Property *prop) {
+	if (!prop) return;
+	switch (prop->type) {
+		case PROP_TYPE_STRING:
+			SDL_free(prop->value.string_value);
+			break;
+		case PROP_TYPE_POINTER:
+			if (prop->cleanup && prop->value.pointer_value) {
+				prop->cleanup(prop->cleanup_userdata, prop->value.pointer_value);
+			}
+			break;
+		default:
+			break;
+	}
+}
+
+SDL_PropertiesID SDL_CreateProperties(void) {
+	ensure_stores_lock();
+	SDL_LockMutex(stores_lock);
+
+	if (store_count >= store_capacity) {
+		int new_capacity = store_capacity ? store_capacity * 2 : 16;
+		PropertyStore **new_stores = SDL_realloc(stores, sizeof(PropertyStore *) * new_capacity);
+		if (!new_stores) {
+			SDL_UnlockMutex(stores_lock);
+			return SDL_PROPERTIES_INVALID;
+		}
+		stores = new_stores;
+		store_capacity = new_capacity;
+	}
+
+	PropertyStore *store = SDL_malloc(sizeof(PropertyStore));
+	if (!store) {
+		SDL_UnlockMutex(stores_lock);
+		return SDL_PROPERTIES_INVALID;
+	}
+
+	store->id = next_id++;
+	store->properties = NULL;
+	store->count = 0;
+	store->capacity = 0;
+	store->lock = SDL_CreateMutex();
+
+	if (!store->lock) {
+		SDL_free(store);
+		SDL_UnlockMutex(stores_lock);
+		return SDL_PROPERTIES_INVALID;
+	}
+
+	stores[store_count++] = store;
+	SDL_PropertiesID id = store->id;
+	SDL_UnlockMutex(stores_lock);
+	return id;
+}
+
+static SDL_bool add_or_update_property(PropertyStore *store, const char *name, PropertyType type, const void *value, SDL_CleanupPropertyCallback cleanup, void *cleanup_userdata) {
+	if (!store || !name) return SDL_FALSE;
+
+	Property *prop = find_property(store, name);
+	if (prop) {
+		cleanup_property_value(prop);
+	} else {
+		if (store->count >= store->capacity) {
+			int new_capacity = store->capacity ? store->capacity * 2 : 16;
+			Property *new_props = SDL_realloc(store->properties, sizeof(Property) * new_capacity);
+			if (!new_props) return -1;
+			SDL_memset(new_props + store->capacity, 0, (new_capacity - store->capacity) * sizeof(Property));
+			store->properties = new_props;
+			store->capacity = new_capacity;
+		}
+		prop = &store->properties[store->count++];
+		prop->name = SDL_malloc(SDL_strlen(name) + 1);
+		if (!prop->name) {
+			store->count--;
+			return SDL_FALSE;
+		}
+		strcpy(prop->name, name);
+	}
+
+	prop->type = type;
+	prop->cleanup = cleanup;
+	prop->cleanup_userdata = cleanup_userdata;
+
+	switch (type) {
+		case PROP_TYPE_STRING:
+			prop->value.string_value = SDL_malloc(SDL_strlen((const char *)value) + 1);
+			if (!prop->value.string_value) return SDL_FALSE;
+			strcpy(prop->value.string_value, (const char *)value);
+			break;
+		case PROP_TYPE_NUMBER:
+			prop->value.number_value = *(int64_t *)value;
+			break;
+		case PROP_TYPE_FLOAT:
+			prop->value.float_value = *(float *)value;
+			break;
+		case PROP_TYPE_BOOLEAN:
+			prop->value.bool_value = *(SDL_bool *)value;
+			break;
+		case PROP_TYPE_POINTER:
+			prop->value.pointer_value = (void *)value;
+			break;
+	}
+	return SDL_TRUE;
+}
+
+SDL_bool SDL_SetStringProperty(SDL_PropertiesID props, const char *name, const char *value) {
+	ensure_stores_lock();
+	SDL_LockMutex(stores_lock);
+	PropertyStore *store = get_store(props);
+	SDL_UnlockMutex(stores_lock);
+
+	if (!store || !name || !value) return SDL_FALSE;
+
+	SDL_LockMutex(store->lock);
+	SDL_bool result = add_or_update_property(store, name, PROP_TYPE_STRING, value, NULL, NULL);
+	SDL_UnlockMutex(store->lock);
+	return result;
+}
+
+SDL_bool SDL_SetNumberProperty(SDL_PropertiesID props, const char *name, int64_t value) {
+	ensure_stores_lock();
+	SDL_LockMutex(stores_lock);
+	PropertyStore *store = get_store(props);
+	SDL_UnlockMutex(stores_lock);
+
+	if (!store || !name) return SDL_FALSE;
+
+	SDL_LockMutex(store->lock);
+	SDL_bool result = add_or_update_property(store, name, PROP_TYPE_NUMBER, &value, NULL, NULL);
+	SDL_UnlockMutex(store->lock);
+	return result;
+}
+
+SDL_bool SDL_SetFloatProperty(SDL_PropertiesID props, const char *name, float value) {
+	ensure_stores_lock();
+	SDL_LockMutex(stores_lock);
+	PropertyStore *store = get_store(props);
+	SDL_UnlockMutex(stores_lock);
+
+	if (!store || !name) return SDL_FALSE;
+
+	SDL_LockMutex(store->lock);
+	SDL_bool result = add_or_update_property(store, name, PROP_TYPE_FLOAT, &value, NULL, NULL);
+	SDL_UnlockMutex(store->lock);
+	return result;
+}
+
+SDL_bool SDL_SetBooleanProperty(SDL_PropertiesID props, const char *name, SDL_bool value) {
+	ensure_stores_lock();
+	SDL_LockMutex(stores_lock);
+	PropertyStore *store = get_store(props);
+	SDL_UnlockMutex(stores_lock);
+
+	if (!store || !name) return SDL_FALSE;
+
+	SDL_LockMutex(store->lock);
+	SDL_bool result = add_or_update_property(store, name, PROP_TYPE_BOOLEAN, &value, NULL, NULL);
+	SDL_UnlockMutex(store->lock);
+	return result;
+}
+
+SDL_bool SDL_SetPointerProperty(SDL_PropertiesID props, const char *name, void *value) {
+	if (value == NULL) {
+		return SDL_ClearProperty(props, name);
+	}
+
+	ensure_stores_lock();
+	SDL_LockMutex(stores_lock);
+	PropertyStore *store = get_store(props);
+	SDL_UnlockMutex(stores_lock);
+
+	if (!store || !name) return SDL_FALSE;
+
+	SDL_LockMutex(store->lock);
+	SDL_bool result = add_or_update_property(store, name, PROP_TYPE_POINTER, value, NULL, NULL);
+	SDL_UnlockMutex(store->lock);
+	return result;
+}
+
+
+SDL_bool SDL_SetPointerPropertyWithCleanup(SDL_PropertiesID props, const char *name, void *value, SDL_CleanupPropertyCallback cleanup, void *userdata)
+{
+	ensure_stores_lock();
+	SDL_LockMutex(stores_lock);
+	PropertyStore *store = get_store(props);
+	SDL_UnlockMutex(stores_lock);
+
+	if (!store || !name) return SDL_FALSE;
+
+	SDL_LockMutex(store->lock);
+	SDL_bool result = add_or_update_property(store, name, PROP_TYPE_POINTER, value, cleanup, userdata);
+	SDL_UnlockMutex(store->lock);
+	return result;
+}
+
+const char *SDL_GetStringProperty(SDL_PropertiesID props, const char *name, const char *default_value) {
+	ensure_stores_lock();
+	SDL_LockMutex(stores_lock);
+	PropertyStore *store = get_store(props);
+	SDL_UnlockMutex(stores_lock);
+
+	if (!store || !name) return default_value;
+
+	SDL_LockMutex(store->lock);
+	Property *prop = find_property(store, name);
+	const char *result = (prop && prop->type == PROP_TYPE_STRING) ? prop->value.string_value : default_value;
+	SDL_UnlockMutex(store->lock);
+	return result;
+}
+
+SDL_PropertiesID SDL_GetSurfaceProperties(SDL_Surface *surface) {
+	if (!surface) return 0;
+
+	ensure_stores_lock();
+	SDL_LockMutex(stores_lock);
+
+	SDL_PropertiesID props = (SDL_PropertiesID)(uintptr_t)surface->userdata;
+	if (props == 0) {
+		props = SDL_CreateProperties();
+		surface->userdata = (void*)(uintptr_t)props;
+	}
+
+	SDL_UnlockMutex(stores_lock);
+	return props;
+}
+
+int64_t SDL_GetNumberProperty(SDL_PropertiesID props, const char *name, int64_t default_value) {
+	ensure_stores_lock();
+	SDL_LockMutex(stores_lock);
+	PropertyStore *store = get_store(props);
+	SDL_UnlockMutex(stores_lock);
+
+	if (!store || !name) return default_value;
+
+	SDL_LockMutex(store->lock);
+	Property *prop = find_property(store, name);
+	int64_t result = (prop && prop->type == PROP_TYPE_NUMBER) ? prop->value.number_value : default_value;
+	SDL_UnlockMutex(store->lock);
+	return result;
+}
+
+float SDL_GetFloatProperty(SDL_PropertiesID props, const char *name, float default_value) {
+	ensure_stores_lock();
+	SDL_LockMutex(stores_lock);
+	PropertyStore *store = get_store(props);
+	SDL_UnlockMutex(stores_lock);
+
+	if (!store || !name) return default_value;
+
+	SDL_LockMutex(store->lock);
+	Property *prop = find_property(store, name);
+	float result = (prop && prop->type == PROP_TYPE_FLOAT) ? prop->value.float_value : default_value;
+	SDL_UnlockMutex(store->lock);
+	return result;
+}
+
+SDL_bool SDL_GetBooleanProperty(SDL_PropertiesID props, const char *name, SDL_bool default_value) {
+	ensure_stores_lock();
+	SDL_LockMutex(stores_lock);
+	PropertyStore *store = get_store(props);
+	SDL_UnlockMutex(stores_lock);
+
+	if (!store || !name) return default_value;
+
+	SDL_LockMutex(store->lock);
+	Property *prop = find_property(store, name);
+	SDL_bool result = (prop && prop->type == PROP_TYPE_BOOLEAN) ? prop->value.bool_value : default_value;
+	SDL_UnlockMutex(store->lock);
+	return result;
+}
+
+void *SDL_GetPointerProperty(SDL_PropertiesID props, const char *name, void *default_value) {
+	ensure_stores_lock();
+	SDL_LockMutex(stores_lock);
+	PropertyStore *store = get_store(props);
+	SDL_UnlockMutex(stores_lock);
+
+	if (!store || !name) return default_value;
+
+	SDL_LockMutex(store->lock);
+	Property *prop = find_property(store, name);
+	void *result = (prop && prop->type == PROP_TYPE_POINTER) ? prop->value.pointer_value : default_value;
+	SDL_UnlockMutex(store->lock);
+	return result;
+}
+
+SDL_bool SDL_HasProperty(SDL_PropertiesID props, const char *name) {
+	ensure_stores_lock();
+	SDL_LockMutex(stores_lock);
+	PropertyStore *store = get_store(props);
+	SDL_UnlockMutex(stores_lock);
+
+	if (!store || !name) return SDL_FALSE;
+
+	SDL_LockMutex(store->lock);
+	SDL_bool result = find_property(store, name) != NULL ? SDL_TRUE : SDL_FALSE;
+	SDL_UnlockMutex(store->lock);
+	return result;
+}
+
+
+SDL_bool SDL_ClearProperty(SDL_PropertiesID props, const char *name)
+{
+	ensure_stores_lock();
+	SDL_LockMutex(stores_lock);
+	PropertyStore *store = get_store(props);
+	SDL_UnlockMutex(stores_lock);
+
+	if (!store || !name) return SDL_FALSE;
+
+	SDL_LockMutex(store->lock);
+	SDL_bool result = SDL_FALSE;
+	for (int i = 0; i < store->count; i++) {
+		if (strcmp(store->properties[i].name, name) == 0) {
+			result = SDL_TRUE;
+			cleanup_property_value(&store->properties[i]);
+			SDL_free(store->properties[i].name);
+			if (--store->count != 0)
+				SDL_memmove(&store->properties[i], &store->properties[i + 1], (store->count - i) * sizeof(Property));
+			break;
+		}
+	}
+	SDL_UnlockMutex(store->lock);
+	return result;
+}
+
+void SDL_DestroyProperties(SDL_PropertiesID props) {
+	ensure_stores_lock();
+	SDL_LockMutex(stores_lock);
+
+	for (int i = 0; i < store_count; i++) {
+		if (stores[i]->id == props) {
+			PropertyStore *store = stores[i];
+
+			SDL_LockMutex(store->lock);
+			for (int j = 0; j < store->count; j++) {
+				cleanup_property_value(&store->properties[j]);
+				SDL_free(store->properties[j].name);
+			}
+			SDL_free(store->properties);
+			SDL_UnlockMutex(store->lock);
+			SDL_DestroyMutex(store->lock);
+			SDL_free(store);
+
+			if (i < store_count - 1) {
+				SDL_memmove(&stores[i], &stores[i + 1], (store_count - i - 1) * sizeof(PropertyStore *));
+			}
+			store_count--;
+			break;
+		}
+	}
+
+	SDL_UnlockMutex(stores_lock);
+}
+
+SDL_bool SDL_LockProperties(SDL_PropertiesID props) {
+	ensure_stores_lock();
+	SDL_LockMutex(stores_lock);
+	PropertyStore *store = get_store(props);
+	SDL_UnlockMutex(stores_lock);
+
+	if (store) {
+		SDL_LockMutex(store->lock);
+	}
+	return SDL_TRUE;
+}
+
+void SDL_UnlockProperties(SDL_PropertiesID props) {
+	ensure_stores_lock();
+	SDL_LockMutex(stores_lock);
+	PropertyStore *store = get_store(props);
+	SDL_UnlockMutex(stores_lock);
+
+	if (store) {
+		SDL_UnlockMutex(store->lock);
+	}
+}
