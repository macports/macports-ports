+SDL_bool SDL_RemovePath(const char *path)
+{
+#ifdef SDL_PLATFORM_WINDOWS
+    WCHAR *wpath = WIN_UTF8ToStringW(path);
+    if (!wpath) {
+        return SDL_FALSE;
+    }
+
+    WIN32_FILE_ATTRIBUTE_DATA info;
+    if (!GetFileAttributesExW(wpath, GetFileExInfoStandard, &info)) {
+        SDL_free(wpath);
+        if (GetLastError() == ERROR_FILE_NOT_FOUND) {
+            // Note that ERROR_PATH_NOT_FOUND means a parent dir is missing, and we consider that an error.
+            return SDL_TRUE;  // thing is already gone, call it a success.
+        }
+        return WIN_SetError("Couldn't get path's attributes");
+    }
+
+    const int isdir = (info.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY);
+    const BOOL rc = isdir ? RemoveDirectoryW(wpath) : DeleteFileW(wpath);
+    SDL_free(wpath);
+    if (!rc) {
+        return WIN_SetError("Couldn't remove path");
+    }
+#else // !SDL_PLATFORM_WINDOWS
+    int rc;
+
+#ifdef SDL_PLATFORM_ANDROID
+    if (*path == '/') {
+        rc = remove(path);
+    } else {
+        char *apath = NULL;
+        SDL_asprintf(&apath, "%s/%s", SDL_AndroidGetInternalStoragePath(), path);
+        if (!apath) {
+            return SDL_FALSE;
+        }
+        rc = remove(apath);
+        SDL_free(apath);
+    }
+#elif defined(SDL_PLATFORM_IOS) // !SDL_PLATFORM_ANDROID
+    if (*path == '/') {
+        rc = remove(path);
+    } else {
+        char *base = SDL_GetPrefPath("", "");
+        if (!base) {
+            return SDL_FALSE;
+        }
+
+        char *apath = NULL;
+        SDL_asprintf(&apath, "%s%s", base, path);
+        SDL_free(base);
+        if (!apath) {
+            return SDL_FALSE;
+        }
+        rc = remove(apath);
+        SDL_free(apath);
+    }
+#else // !SDL_PLATFORM_IOS
+    rc = remove(path);
+#endif // !SDL_PLATFORM_IOS
+    if (rc < 0) {
+        if (errno == ENOENT) {
+            // It's already gone, this is a success
+            return SDL_TRUE;
+        }
+        return SDL_SetError("Can't remove path: %s", strerror(errno));
+    }
+#endif // SDL_PLATFORM_WINDOWS
+    return SDL_TRUE;
+}
