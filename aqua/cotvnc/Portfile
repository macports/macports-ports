PortSystem              1.0
PortGroup               xcode 1.0
PortGroup               github 1.0

name                    cotvnc
github.setup            ays7 chicken 2026.12.1
github.tarball_from     archive
revision                0

categories              aqua vnc
platforms               {macosx >= 20}
maintainers             {@ays7} openmaintainer
license                 GPL-2+

description             Chicken Fork is a modernized VNC and RDP client for macOS
long_description        Chicken Fork is a Cocoa-based VNC and Microsoft Remote \
                        Desktop (RDP) client for macOS. Based on the classic \
                        Chicken of the VNC codebase, it supports Apple Silicon \
                        and Intel (Universal), Metal rendering, Retina/HiDPI \
                        display scaling, dynamic desktop resizing, UTF-8 \
                        extended clipboard, and FreeRDP 3.x with NLA/TLS.

homepage                https://github.com/ays7/chicken

checksums               rmd160  0a705dbc92ad0176e8eaf1ea1bbc2820f3168c6f \
                        sha256  bc3b3abeffd7329405d374c09170650b117c39a11f2a5fcb9d9f02348b3faeb3 \
                        size    31621069

post-patch {
    set plist ${worksrcpath}/cotvnc/Resources/Info.plist
    system "/usr/libexec/PlistBuddy -c 'Delete :SUFeedURL' ${plist}"
    system "/usr/libexec/PlistBuddy -c 'Delete :SUPublicDSAKeyFile' ${plist}"
}

xcode.project           cotvnc/ChickenFork.xcodeproj
xcode.scheme            "Chicken Fork"
xcode.configuration     Deployment

xcode.build.settings-append \
                        SDKROOT=macosx \
                        DEVELOPMENT_TEAM= \
                        CODE_SIGN_IDENTITY= \
                        CODE_SIGNING_ALLOWED=NO \
                        CODE_SIGNING_REQUIRED=NO \
                        ENABLE_USER_SCRIPT_SANDBOXING=NO \
                        DEPLOYMENT_LOCATION=NO \
                        DEPLOYMENT_POSTPROCESSING=NO

destroot {
    copy "${worksrcpath}/cotvnc/build/${xcode.configuration}/Chicken Fork.app" \
        "${destroot}${applications_dir}/Chicken Fork.app"
}

subport ${name}-devel {
    PortGroup           obsolete 1.0

    version             2016-01-27
    revision            1
    replaced_by         ${name}

    livecheck.type      none
}
