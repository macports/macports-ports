PortSystem          1.0

name                RemoteCrab
version             1.4.5
categories          aqua
license             Restrictive
maintainers         {@edwin-hao-ai} openmaintainer

description         Use an iPhone or iPad as the camera, microphone, trackpad and keyboard of a Mac
long_description    RemoteCrab turns an iPhone or iPad into the camera, microphone, \
                    trackpad and keyboard of a Mac over the local network, with no \
                    account and no cloud round trip. The Mac can also serve itself to \
                    any browser tab with a link and a six digit code, so the other side \
                    installs nothing. Local network use is free; remote access from \
                    outside your network is a subscription.
homepage            https://vgoapp.com/remotecrab/

master_sites        https://vgoapp.com/downloads/
distfiles           RemoteCrab-${version}.dmg
checksums           rmd160  b0be4b3ad39ee44a2ba7ebe48553f052cfd52b87 \
                    sha256  951d0e1ffd7ae1624150eb7fa61c158449271b06947f39089e1fc95c024ee177 \
                    size    20197390

platforms           {darwin >= 25}
supported_archs     arm64

use_dmg             yes
use_configure       no

build {}

destroot {
    copy ${worksrcpath}/RemoteCrab.app ${destroot}${applications_dir}
}

livecheck.type      regex
livecheck.url       https://vgoapp.com/downloads/appcast.xml
livecheck.regex     {<sparkle:shortVersionString>([0-9.]+)</sparkle:shortVersionString>}
