# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           github 1.0

github.setup        evanscastonguay omac 1.4.7 v
github.tarball_from releases
revision            0

categories          aqua
license             MIT
maintainers         @evanscastonguay openmaintainer

description         Tiling window manager with Omarchy's keybindings
long_description    Omac arranges windows side by side without overlap and \
                    lets you drive them from the keyboard, bringing the \
                    window keys of Omarchy to the Mac. It is a single app \
                    plus the omac command line tool, configured by one TOML \
                    file. Unofficial and not affiliated with Omarchy.

# This port installs the upstream release binary unchanged, on purpose.
# The app is signed with the upstream Developer ID, and macOS ties the
# Accessibility permission a window manager needs to that signature. A
# build from source would be ad-hoc signed, so each upgrade would revoke
# the permission. The app is not notarized; MacPorts sets no quarantine
# attribute on what it installs, so Gatekeeper does not block the launch.
supported_archs     arm64
platforms           {darwin >= 23}
installs_libs       no

# The release asset has the same name in every version, so each version
# keeps its distfile in its own directory.
distname            Omac-arm64
use_zip             yes
dist_subdir         ${name}/${version}
worksrcdir          Omac-${version}-arm64

checksums           rmd160  f573e41fb396f60b3db78bd8e380dc753ec67be3 \
                    sha256  a064aeee7f13f0a23207b119a05032c1cd0100f915ceb6ce797e0386ede1d92e \
                    size    3516476

use_configure       no

build {}

destroot {
    copy ${worksrcpath}/Omac.app ${destroot}${applications_dir}
    ln -s ${applications_dir}/Omac.app/Contents/Helpers/omac \
        ${destroot}${prefix}/bin/omac
}

notes "
To start Omac, open ${applications_dir}/Omac.app, then turn Omac on in
System Settings > Privacy & Security > Accessibility. To start it at
login, run 'omac login on'.

After 'sudo port upgrade omac', run 'omac quit' and open the app again.

Keep a single copy of Omac: if the upstream install script installed one,
remove ~/Applications/Omac.app and ~/.local/bin/omac.
"
