PortSystem          1.0
PortGroup           github 1.0

github.setup        Yudaotor lyrimuse 1.8.0 v
github.tarball_from archive
revision            0

categories          aqua audio
license             GPL-3
maintainers         {@Yudaotor} openmaintainer

description         Word-synced desktop lyrics for Apple Music, Spotify and \
                    browser web players

long_description    Lyrimuse shows word-by-word synced lyrics as a floating \
                    overlay, a Dynamic-Island-style capsule, an \
                    Apple-Music-style lyrics window or right in the menu bar, \
                    for Apple Music, Spotify and YouTube Music / Spotify Web \
                    playing in a browser. Lyrics are fetched from eleven \
                    sources and every candidate is scored on one scale so the \
                    best match wins. Translation, per-line romanization \
                    (pinyin, Cantonese Jyutping, Japanese furigana) and \
                    Last.fm / ListenBrainz scrobbling are built in.

checksums           ${distname}${extract.suffix} \
                        rmd160  a5b0cc35709747284b811d0ed881174d2f68318b \
                        sha256  731fb05d704b54053c9506b3ec67d27f3883b33348c790d6e22a8d00f5bffd9c \
                        size    22798760

# The app builds with Command Line Tools alone (no full Xcode needed), but the
# source requires the macOS 26 SDK (upstream CI builds on macos-26).
if {${os.platform} eq "darwin" && ${os.major} < 25} {
    known_fail      yes
    pre-fetch {
        ui_error "${name} requires the macOS 26 SDK (macOS 26 or later with \
current Command Line Tools) to build."
        return -code error "unsupported macOS version"
    }
}

# media-control reads playback state of the MediaRemote-backed players (QQ
# Music, NetEase Cloud Music, Kugou, Spotify) — it is a runtime dependency,
# spawned as a helper process. Go builds the bundled collector daemon; the
# Swift toolchain comes from the Command Line Tools.
depends_build-append \
                    port:go
depends_lib-append  port:media-control

use_configure       no

build.dir           ${worksrcpath}/lyrimuse
build.cmd           ./build.sh
build.target
build.args          --dest ${workpath}/stage/Lyrimuse.app

# SwiftPM resolves the remaining source dependency (KeyboardShortcuts) during
# the build; redirect all of its working state into ${workpath} so nothing is
# written outside the sandbox-allowed tree (same approach as aqua/Ice).
# LYRIMUSE_NO_SPARKLE is upstream's own switch for package-manager builds: it
# leaves Sparkle out of Package.swift, compiles the updater down to a same-shaped
# no-op, drops both update entry points from the UI and skips the framework embed.
# An app installed by MacPorts must not update itself — 'port upgrade' is the
# supported path — and this replaces the source edits this port used to carry.
build.env-append    LYRIMUSE_NO_SPARKLE=1 \
                    LYRIMUSE_VERSION=${version} \
                    LYRIMUSE_GOTOOLCHAIN=local \
                    GOFLAGS=-buildvcs=false \
                    GOCACHE=${workpath}/.gocache \
                    GOPATH=${workpath}/.gopath \
                    GOMODCACHE=${workpath}/.gomodcache \
                    TMPDIR=${workpath}/tmp \
                    HOME=${workpath}/home \
                    LYRIMUSE_SPM_CACHE_PATH=${workpath}/spm-cache \
                    LYRIMUSE_SPM_SCRATCH_PATH=${workpath}/spm-scratch \
                    LYRIMUSE_MEDIA_CONTROL_PREFIX=${prefix}

pre-build {
    file mkdir ${workpath}/tmp
    file mkdir ${workpath}/home/Library/Caches

    # SwiftPM sandboxes its manifest-loading subprocesses via sandbox-exec, but
    # macOS rejects nested sandbox_apply calls when the process is already
    # sandboxed by MacPorts. Allow sandbox-exec to apply its own profile.
    append portsandbox_profile " (allow process-exec (literal \"/usr/bin/sandbox-exec\") (with no-profile))"
}

destroot {
    xinstall -d ${destroot}${applications_dir}
    copy ${workpath}/stage/Lyrimuse.app ${destroot}${applications_dir}/Lyrimuse.app
}

notes "
Lyrimuse is ad-hoc signed when built from source; macOS may ask you to approve\
 Automation access for your music player on first launch.

This build has no in-app updater — run 'sudo port selfupdate && sudo port\
 upgrade lyrimuse' to update.
"
