PortSystem          1.0
PortGroup           github 1.0
PortGroup           xcode 1.0
PortGroup           xcodeversion 1.0

github.setup        robbietilton Compositor 1.5.12 v
github.tarball_from archive
revision            0

categories          aqua graphics
maintainers         @wu21-web openmaintainer
license             MIT

description         The Photoshop alternative for Mac
long_description    Compositor is a free, open source image editor built with \
                    SwiftUI and AppKit. It provides layers, masks, adjustment \
                    layers, selections, painting and retouching tools, filters, \
                    and Photoshop PSD and PSB import.
homepage            https://robbietilton.com/compositor

checksums           rmd160  6f5edac13df44a0a67bc894b4e0531408be188b6 \
                    sha256  37460a5b97c6d0c1409b7848b352fc13448351bec262d7edc016cf31457bfca5 \
                    size    4331608

platforms           {darwin >= 25}
supported_archs     arm64
universal_variant   no

minimum_xcodeversions [list ${os.major} 26.0]

patchfiles          patch-disable-updater.diff

xcode.project       Compositor.xcodeproj
xcode.scheme        Compositor
xcode.configuration Release

build.pre_args-append \
                    -onlyUsePackageVersionsFromResolvedFile \
                    -derivedDataPath ${workpath}/derived-data \
                    -clonedSourcePackagesDirPath ${workpath}/spm-packages

pre-build {
    append portsandbox_profile { (allow process-exec (literal "/usr/bin/sandbox-exec") (with no-profile))}
}

xcode.build.settings \
                    CODE_SIGN_STYLE=Manual \
                    CODE_SIGN_IDENTITY=- \
                    DEVELOPMENT_TEAM= \
                    MACOSX_DEPLOYMENT_TARGET=26.0

destroot {
    xinstall -d ${destroot}${applications_dir}
    copy ${worksrcpath}/build/${xcode.configuration}/Compositor.app \
        ${destroot}${applications_dir}/Compositor.app

    set docdir ${destroot}${prefix}/share/doc/${name}
    xinstall -d ${docdir}
    xinstall -m 0644 ${worksrcpath}/LICENSE ${docdir}
}
