PortSystem              1.0
PortGroup               cmake 1.1
PortGroup               github 1.0
PortGroup               legacysupport 1.1

# _static_assert
legacysupport.newest_darwin_requires_legacy \
                        14

github.setup            kugelrund dzip 3.2 v
github.tarball_from     archive
github.livecheck.regex  {([0-9.]+)}

categories              archivers
license                 MPL-2
maintainers             nomaintainer

description             file compression tool
long_description        Dzip is a program for file compression.  Its advantage \
                        over more popular compression software is in the size \
                        of the program, easily fitting on a floppy disk. \
                        Dzip's original purpose was to compress demo \
                        recordings of the id software game Quake.

depends_lib             port:zlib

checksums               rmd160  84e472bc22ab9937c337c6ff7559a2e242dc5f9e \
                        sha256  7f7b80c3393232735a57cde0243e00923bbc16ea07daaa308e0ce1e3641bb93a \
                        size    117310

compiler.cxx_standard   2011

post-destroot {
    set destdocdir  ${destroot}${prefix}/share/doc/${name}

    xinstall -d ${destdocdir}
    xinstall -W ${worksrcpath} -m 644 \
        LICENSE \
        README.md \
        Readme \
        ${destdocdir}
}
