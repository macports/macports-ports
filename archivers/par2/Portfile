# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem        1.0
PortGroup         github 1.0

name              par2
github.setup      Parchive par2cmdline 1.4.0 v
revision          0
description       Parchive: Parity Archive Volume Set for data recovery

long_description  Parchive takes .par files and can regenerate missing data \
                  based upon a Reed-Soloman Code. This is useful for \
                  restoring missing pieces of a multi-part archive like the \
                  kinds used on Usenet. Version 2 does not require \
                  like-sized pieces, so it is useful for many more kinds of \
                  data recovery.

license           GPL-2
installs_libs     no
categories        archivers
maintainers       nomaintainer

checksums         rmd160  af471862a64f80b2bfc31d51880c88e200808fd9 \
                  sha256  f738242adf3bbfe0b041b3263e5be4d76e4b16a4e938952a38265efd94c7869d \
                  size    3016006

installs_libs     no

depends_lib-append \
                  port:libomp

test.run          yes
test.target       check

# C++14 is enforced as of par2cmdline 1.4.0
# See: https://github.com/Parchive/par2cmdline/commit/049d51080af6b119e7ebb9157429e32edcc606e1
compiler.cxx_standard 2014

configure.cppflags-append \
                  -Xpreprocessor -fopenmp -I${prefix}/include/libomp
configure.ldflags-append \
                  -L${prefix}/lib/libomp -lomp

# alignof is C23. Not necessary to build
configure.checks.implicit_int   no
configure.checks.implicit_function_declaration.whitelist-append alignof

post-destroot {
    set docdir ${prefix}/share/doc/${name}-${version}
    xinstall -d ${destroot}${docdir}
    xinstall -m 0644 -W ${worksrcpath} AUTHORS COPYING README.md \
        ${destroot}${docdir}
}

livecheck.distname  {${github.name}}
