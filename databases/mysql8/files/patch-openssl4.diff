Fix build with OpenSSL 4

The CMake module works fine, but needs an adjustment to try to correct
thing with OpenSSL 4.

OpenSSL also no longer makes the pointer returned from
X509_get_subject_name() writable; the correct alternative is to create
a new (writable) X509_NAME, modify it, then call
X509_set_subject_name().

Signed-off-by: Clemens Lang <cal@macports.org>
--- ./cmake/ssl.cmake.orig	2026-11-24 00:46:44
+++ ./cmake/ssl.cmake	2026-11-24 00:47:27
@@ -151,7 +151,7 @@
       ${version_part} "${${version_part}}")
   ENDFOREACH()
   SET(OPENSSL_VERSION_MAJOR ${OPENSSL_VERSION_MAJOR} CACHE INTERNAL "" FORCE)
-  IF(OPENSSL_VERSION_MAJOR VERSION_EQUAL 3)
+  IF(OPENSSL_VERSION_MAJOR VERSION_GREATER_EQUAL 3)
     # OpenSSL 3
     SET(OPENSSL_FIX_VERSION "${OPENSSL_VERSION_PATCH}")
   ELSE()
--- ./sql/auth/sql_authentication.cc.orig	2026-11-24 01:01:11
+++ ./sql/auth/sql_authentication.cc	2026-11-24 01:07:47
@@ -5365,7 +5365,7 @@
     if (!X509_set_pubkey(x509, pkey)) goto err;
 
     /** Set CN value in subject */
-    name = X509_get_subject_name(x509);
+    name = X509_NAME_new();
     if (!name) goto err;
 
     if (!X509_NAME_add_entry_by_txt(name, "CN", MBSTRING_ASC,
@@ -5373,6 +5373,9 @@
                                     0))
       goto err;
 
+    if (!X509_set_subject_name(x509, name))
+      goto err;
+
     /** Set Issuer */
     if (!X509_set_issuer_name(
             x509, self_sign ? name : X509_get_subject_name(ca_x509)))
