--- /dev/null
+++ test/macports-smoke.sql
@@ -0,0 +1,51 @@
+-- MacPorts smoke test of the duckdb shell and its statically linked
+-- extensions. Run it from an empty directory; the Portfile's test phase
+-- passes the version being built as the expected_version variable.
+.bail on
+.mode list
+.headers off
+SET autoinstall_known_extensions = false;
+
+CREATE MACRO expect(name, got, want) AS
+    CASE WHEN got IS NOT DISTINCT FROM want THEN 'ok: ' || name
+    ELSE error(name || ': expected ' || coalesce(want::VARCHAR, 'NULL') || ', got ' || coalesce(got::VARCHAR, 'NULL'))
+    END;
+
+SELECT expect('version', version(), getvariable('expected_version'));
+
+SELECT expect('extensions',
+              string_agg(extension_name, ' ' ORDER BY extension_name),
+              'autocomplete core_functions ducklake icu json parquet')
+FROM duckdb_extensions()
+WHERE install_mode = 'STATICALLY_LINKED'
+  AND extension_name IN ('autocomplete', 'core_functions', 'ducklake', 'icu', 'json', 'parquet');
+
+SELECT expect('core',
+              sum(i) || ' ' || list_sum([1, 2, 3]) || ' ' || regexp_replace('duckdb', 'duck', 'lake'),
+              '500000500000 6 lakedb')
+FROM range(1000001) t(i);
+
+ATTACH 'db.duckdb' AS d;
+CREATE TABLE d.t AS SELECT 42 AS x;
+DETACH d;
+ATTACH 'db.duckdb' AS d (READ_ONLY);
+SELECT expect('storage', x, 42) FROM d.t;
+DETACH d;
+
+COPY (SELECT i, i * 2 AS j FROM range(1000) t(i)) TO 't.parquet';
+SELECT expect('parquet', sum(j), 999000) FROM 't.parquet';
+
+COPY (SELECT 'x' AS b) TO 't.json';
+SELECT expect('json', b || json_extract('{"a": [1, 2, 3]}', '$.a[1]'), 'x2') FROM read_json('t.json');
+
+SELECT expect('icu-timezone',
+              strftime(timezone('America/New_York', TIMESTAMPTZ '2026-07-01 12:00:00+00'), '%H:%M'),
+              '08:00');
+SELECT expect('icu-collation', list(s ORDER BY s COLLATE en), ['a', 'B']) FROM (VALUES ('B'), ('a')) v(s);
+
+SELECT expect('autocomplete', trim(suggestion), 'SELECT') FROM sql_auto_complete('SELEC') LIMIT 1;
+
+ATTACH 'ducklake:t.ducklake' AS lake (DATA_PATH 'lake');
+CREATE TABLE lake.t AS SELECT i AS x FROM range(10) t(i);
+DELETE FROM lake.t WHERE x % 2 = 0;
+SELECT expect('ducklake', sum(x), 25) FROM lake.t;
