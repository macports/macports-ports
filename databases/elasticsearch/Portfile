# give branches.json a hash-dependent filename to avoid update clashes
set branches_file   ${branches_json}-${branches_json_hash}
post-fetch {
    if {[file exists ${distpath}/${branches_json}]} {
        delete -force ${distpath}/${branches_file}
        move ${distpath}/${branches_json} ${distpath}/${branches_file}
    }
}
pre-checksum {
    set idx [lsearch -exact ${all_dist_files} ${branches_json}]
    if {${idx} >= 0} {
        set all_dist_files \
            [lreplace ${all_dist_files} ${idx} ${idx} ${branches_file}]
    }
}

