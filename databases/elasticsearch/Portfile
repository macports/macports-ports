# diff -Naurd -I '^ *#' ./elasticsearch-orig/gradle/wrapper/gradle-wrapper.properties ./elasticsearch-new/gradle/wrapper/gradle-wrapper.properties | sed -E -e 's/\.\/elasticsearch-(orig|new)\//\.\//' > patch-gradle-wrapper_properties.diff
