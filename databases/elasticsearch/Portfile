proc percent_encode {str} { 
    return [subst [regsub -all {[^a-zA-Z0-9/.~_-]} $str {%[format %02x [scan {&} %c]]}]]
}

# runtime java (not bundled); check that run time java is the same as build java:
# cat ${worksrcpath}/build-tools-internal/src/main/resources/minimumRuntimeVersion
