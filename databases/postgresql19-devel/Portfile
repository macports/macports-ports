# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           compilers 1.0
PortGroup           muniversal 1.0
PortGroup           legacysupport 1.1
PortGroup           openssl 1.0

name                postgresql19-devel
version             19rc2
revision            0

set pgname          postgresql19

categories          databases
maintainers         {gmail.com:davidgilman1 @dgilman} \
                    openmaintainer
license             Permissive
description         The most advanced open-source database available anywhere.
long_description    PostgreSQL is Object-Relational Database Management System.\
                    It supports almost all SQL constructs, including transactions, \
                    subselects, and user-defined types and functions. Write-ahead \
                    logging means increased performance while retaining data \
                    integrity.
conflicts           ${pgname} \
                    postgresql96-doc postgresql10-doc postgresql11-doc postgresql12-doc \
                    postgresql13-doc postgresql14-doc postgresql15-doc

homepage            https://www.postgresql.org/
master_sites        postgresql:source/v${version}/
distname            postgresql-${version}

checksums           rmd160  3ccd3d64a1e2bd656de10b169ee00b6fde392ba7 \
                    sha256  23a7bb862e4bac395c047305ed0084117b01e71255ce858b907cdcd78ce40351 \
                    size    23981427

use_bzip2           yes

# https://trac.macports.org/ticket/66060
# https://trac.macports.org/ticket/67365
# https://postgrespro.ru/list/thread-id/2551610
# The problem is specific to PPC: https://github.com/macports/macports-ports/pull/16460
platform darwin powerpc {
    patchfiles-append  patch-icu.diff \
                       patch-fix-ppc-asm.diff
}

openssl.branch      3
depends_lib         port:readline port:zlib \
                    port:libxml2 port:libxslt \
                    path:lib/pkgconfig/icu-uc.pc:icu \
                    path:lib/libgssapi_krb5.dylib:kerberos5 \
                    path:lib/libzstd.dylib:zstd \
                    path:lib/liblz4.dylib:lz4
depends_build       port:bison port:pkgconfig \
                    port:docbook-xml-4.5 port:docbook-xsl-nons \
                    path:bin/perl:perl5
depends_run         port:postgresql_select-19 \
                    path:share/curl/curl-ca-bundle.crt:curl-ca-bundle

legacysupport.newest_darwin_requires_legacy \
                    15
worksrcdir          postgresql-${version}

if {${universal_possible} && [variant_isset universal]} {
    set zicpath     ${worksrcpath}-${build_arch}/src/timezone/zic
} else {
    set zicpath     ${worksrcpath}/src/timezone/zic
}
if {${os.platform} eq "darwin" && ${os.major} < 10} {
    depends_build-append port:flex
}
set libdir          ${prefix}/lib/${pgname}
set mandir          ${prefix}/share/doc/${pgname}/man
configure.args      PG_SYSROOT=disabled \
                    ZIC=${zicpath} \
                    --sysconfdir=${prefix}/etc/${pgname} \
                    --bindir=${libdir}/bin \
                    --libdir=${libdir} \
                    --includedir=${prefix}/include/${pgname} \
                    --datadir=${prefix}/share/${pgname} \
                    --docdir=${prefix}/share/doc/${pgname} \
                    --mandir=${mandir} \
                    --with-includes=${prefix}/include \
                    --with-libraries=${prefix}/lib \
                    --with-openssl \
                    --with-bonjour \
                    --with-readline \
                    --with-zlib \
                    --with-lz4 \
                    --with-zstd \
                    --with-libxml \
                    --with-libxslt \
                    --with-gssapi \
                    --with-uuid=e2fs \
                    --with-icu

configure.universal_args-delete --disable-dependency-tracking

# building psql with clang from Xcode prior to 4.4 causes segfault on query; see #31717
compiler.blacklist-append {clang < 421}
compilers.choose          cc cxx
compilers.setup           -gcc -fortran -clang33 -clang34 -clang37 -clang90 \
                          -clang11 -clang12 -clang13

compiler.c_standard       2011

if {${universal_possible} && [variant_isset universal]} {
    configure.cflags-append    -DAC_APPLE_UNIVERSAL_BUILD
}

build.type          gnu

set pl_python_versions  {311 312 313 314 315}
set pl_perl_versions    {5.28 5.30 5.32 5.34}
set pl_tcl_versions     {8 9}

set pl_subports [dict create]
foreach v ${pl_python_versions} {
    dict lappend pl_subports python ${name}-python${v}
}
foreach v ${pl_perl_versions} {
    dict lappend pl_subports perl ${name}-perl${v}
}
foreach v ${pl_tcl_versions} {
    dict lappend pl_subports tcl ${name}-tcl${v}
}
dict for {lang names} ${pl_subports} {
    foreach n ${names} {
        subport ${n} {}
    }
}

set pl_lang ""
set pl_ver  ""
regexp "^${name}-(python|perl|tcl)(.+)\$" ${subport} -> pl_lang pl_ver

if {${pl_lang} eq ""} {
    build.target        world

    destroot.target     install-world

    test.run            yes
    test.target         check

    # remember to change livecheck with first proper release
    livecheck.type      regex
    # beta/rc releases (e.g. 19beta3, 19rc1); switch to the release regex below at 19.0
    livecheck.regex    alt="v(19\[a-z\]+\[0-9\])"
    #livecheck.regex    alt="v(19\\.\[.0-9\]+)"
    livecheck.url       ${homepage}/ftp/source/

    post-destroot {
        ln -s ${libdir}/bin/psql ${destroot}${prefix}/bin/psql19

        reinplace -E "s#^CFLAGS =#CFLAGS +=#g" \
            ${destroot}${prefix}/lib/${pgname}/pgxs/src/Makefile.global
        reinplace -E "s#^MKDIR_P.*#MKDIR_P = /bin/mkdir -p#g" \
            ${destroot}${prefix}/lib/${pgname}/pgxs/src/Makefile.global

        set gzip [findBinary gzip ${portutil::autoconf::gzip_path}]
        foreach manpage [glob -type f ${destroot}${mandir}/man\[1-9\]/*] {
            system "$gzip -9vf ${manpage}"
        }
    }

    if {!${universal_possible} || ![variant_isset universal]} {
        post-destroot {
            reinplace -E "s#-arch\[\[:space:\]\]+\[\[:alnum:\]_\]+##g" \
                ${destroot}${prefix}/lib/${pgname}/pgxs/src/Makefile.global
        }
    } else {
        merger-post-destroot {
            foreach arch ${configure.universal_archs} {
                reinplace -E "s#-arch\[\[:space:\]\]+\[\[:alnum:\]_\]+##g" \
                    ${destroot}-${arch}${prefix}/lib/${pgname}/pgxs/src/Makefile.global

                reinplace -E "s#${worksrcpath}-${arch}#${worksrcpath}#g" \
                    ${destroot}-${arch}${prefix}/lib/${pgname}/pgxs/src/Makefile.global
            }
        }
    }

    variant llvm description {add support for JIT compilation} {
        set llvm_ver 22

        foreach clang ${compilers.clang_variants} {
            if { [variant_exists ${clang}] && [variant_isset ${clang}] } {
                set clang_port_ver [string range ${clang} 5 end]
                set llvm_ver ${clang_port_ver}
            }
        }

        depends_lib-append      port:llvm-${llvm_ver}
        depends_build-append    port:clang-${llvm_ver}
        configure.args-append   --with-llvm
        configure.env-append    LLVM_CONFIG=${prefix}/libexec/llvm-${llvm_ver}/bin/llvm-config \
                                CLANG=${prefix}/libexec/llvm-${llvm_ver}/bin/clang
    }

    notes "To use the postgresql server as a startup item install the ${name}-server port."
} else {
    universal_variant   no
    supported_archs     arm64 x86_64

    conflicts           {*}[lsearch -all -inline -not -exact \
                            [dict get ${pl_subports} ${pl_lang}] ${subport}]
    depends_run
    depends_lib-append  port:${name}

    switch ${pl_lang} {
        python {
            set pl_ver_dot  [string index ${pl_ver} 0].[string range ${pl_ver} 1 end]
            description     PL/Python procedural language for PostgreSQL 19 \
                            (Python ${pl_ver_dot})
            long_description ${description}. Includes the hstore, jsonb and \
                            ltree transforms for PL/Python.
            depends_lib-append      port:python${pl_ver}
            configure.args-append   --with-python
            configure.python        ${prefix}/bin/python${pl_ver_dot}
            set pl_dirs     {src/pl/plpython contrib/hstore_plpython \
                             contrib/jsonb_plpython contrib/ltree_plpython}
        }
        perl {
            description     PL/Perl procedural language for PostgreSQL 19 \
                            (Perl ${pl_ver})
            long_description ${description}. Includes the bool, hstore and \
                            jsonb transforms for PL/Perl.
            depends_lib-append      port:perl${pl_ver}
            configure.args-append   --with-perl
            configure.perl          ${prefix}/bin/perl${pl_ver}
            set pl_dirs     {src/pl/plperl contrib/bool_plperl \
                             contrib/hstore_plperl contrib/jsonb_plperl}
        }
        tcl {
            set tcl_shver   [expr {${pl_ver} == 8 ? "8.6" : "9.0"}]
            description     PL/Tcl procedural language for PostgreSQL 19 \
                            (Tcl ${tcl_shver})
            long_description ${description}.
            depends_lib-append      port:tcl${pl_ver}
            configure.args-append   --with-tcl \
                                    --with-tclconfig=${prefix}/lib/tcl${pl_ver}
            configure.env-append    TCLSH=${prefix}/bin/tclsh${tcl_shver}
            set pl_dirs     {src/pl/tcl}
        }
    }

    set pl_make_args [list -f ${filespath}/pl-only.mk \
                          "PL_DIRS=\"${pl_dirs}\"" \
                          "BE_DLLLIBS=\"-bundle_loader ${libdir}/bin/postgres\""]
    build.pre_args-append   {*}${pl_make_args}
    build.target            all
    destroot.pre_args-append {*}${pl_make_args}
    destroot.target         install

    test.run            no
    livecheck.type      none
}
