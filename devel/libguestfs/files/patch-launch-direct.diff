From 6663b268365a5a8126e1743325c454dc258e00fd Mon Sep 17 00:00:00 2001
From: "Richard W.M. Jones" <rjones@redhat.com>
Date: Wed, 29 Jul 2026 10:25:01 +0100
Subject: [PATCH] lib/launch-direct.c: Avoid use of non-portable execvpe

Fixes: https://github.com/libguestfs/libguestfs/issues/386
Reported-by: Mohamed Akram
---
 lib/launch-direct.c | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/lib/launch-direct.c b/lib/launch-direct.c
index b2021ee2cf..03c1e6d3d7 100644
--- lib/launch-direct.c
+++ lib/launch-direct.c
@@ -878,7 +878,9 @@ launch_direct (guestfs_h *g, void *datav, const char *arg)
     if (g->pgroup)
       setpgid (0, 0);
 
-    execvpe (data->qemu, argv, env);        /* Run qemu. */
+    /* Assign to environ since execvpe is a GNU extension. */
+    environ = env;
+    execvp (data->qemu, argv);  /* Run qemu. */
     perror (data->qemu);
     _exit (EXIT_FAILURE);
   }
