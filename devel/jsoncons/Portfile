# https://github.com/danielaparker/jsoncons/issues/488
if {${configure.cxx_stdlib} ne "libc++"} {
    configure.cppflags-append \
                        -DJSONCONS_HAS_STATEFUL_ALLOCATOR=0 -DJSONCONS_HAS_POLYMORPHIC_ALLOCATOR=0
}

