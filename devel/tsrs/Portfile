PortSystem          1.0
PortGroup           cargo   1.0
PortGroup           github  1.0

github.setup        oxc-project tsrs 0.18.0 v
github.tarball_from archive
revision            0

homepage            https://www.npmjs.com/package/tsrs

description         Rust port of the TypeScript 7 type checker

long_description    \
    tsrs is a drop-in replacement for the TypeScript 7 compiler \(tsc\) and \
    language server, written in Rust. It aims for full conformance with \
    TypeScript, with lower memory use and faster type checking. The \
    TypeScript standard library declarations are embedded in the binary.

categories          devel lang
installs_libs       no
license             Apache-2
platforms           {darwin >= 16}
maintainers         {gmail.com:herby.gillot @herbygillot} \
                    openmaintainer

checksums           ${distname}${extract.suffix} \
                    rmd160  ec5f5892ac00eab2e672bb0ed712d747732edb85 \
                    sha256  d9a08890fb9b60442e4ae1a9a90b987daef7f3429afb2153cf8ebff635f7fcd6 \
                    size    7868196

# libmimalloc-sys2 builds its bundled mimalloc with cmake
depends_build-append \
                    path:bin/cmake:cmake

depends_lib-append  port:libiconv

# Smoke test script for the test phase
patchfiles          patch-macports-smoketest.diff

post-patch {
    reinplace "s|@TSRS@|${worksrcpath}/target/[cargo.rust_platform]/release/${name}|g" \
        ${worksrcpath}/macports-smoketest.sh
    reinplace "s|@TESTDIR@|${workpath}/smoketest|g" \
        ${worksrcpath}/macports-smoketest.sh
}

build.args          -p tsrs_cli

# Report the TypeScript nightly as its version, as upstream release binaries do
pre-build {
    set fp [open ${worksrcpath}/Cargo.toml r]
    regexp {\nnightly = "([^"]+)"} [read ${fp}] -> ts_nightly
    close ${fp}
    build.env-append    TSRS_TS_VERSION=${ts_nightly}
}

destroot {
    xinstall -m 0755 \
        ${worksrcpath}/target/[cargo.rust_platform]/release/${name} \
        ${destroot}${prefix}/bin/
}

test.run            yes
test.cmd            /bin/sh
test.target         macports-smoketest.sh

