--- /dev/null
+++ macports-smoketest.sh
@@ -0,0 +1,24 @@
+#!/bin/sh
+# Smoke test for the tsrs binary built by MacPorts
+set -e
+
+tsrs="@TSRS@"
+testdir="@TESTDIR@"
+
+rm -rf "$testdir"
+mkdir -p "$testdir"
+cd "$testdir"
+
+"$tsrs" --version
+
+echo 'const n: number = [1, 2].map(x => x * 2).length; export {n};' > ok.ts
+"$tsrs" --strict --noEmit --lib es2022 ok.ts
+
+echo 'const s: string = 1;' > bad.ts
+if "$tsrs" --strict --noEmit bad.ts; then
+    echo "tsrs accepted a type error" >&2
+    exit 1
+fi
+
+"$tsrs" --strict --outDir out ok.ts
+test -s out/ok.js
