# Start the blob service on loopback and send it an anonymous request: an
# Azure Storage AuthorizationFailure shows the service answering, not just a
# port being open. --noproxy: MacPorts exports a configured proxy_http, which
# would otherwise get the loopback request.
test.run            yes
test {
    set port 10199
    set data ${workpath}/test-data
    file mkdir ${data}
    set pid [exec ${destroot}${prefix}/bin/azurite-blob --blobHost 127.0.0.1 \
        --blobPort ${port} --location ${data} --silent >& ${workpath}/test.log &]
    set reply ""
    for {set i 0} {$i < 50 && ![string match *AuthorizationFailure* ${reply}]} {incr i} {
        after 200
        catch {set reply [exec /usr/bin/curl -s --noproxy * http://127.0.0.1:${port}/devstoreaccount1?comp=list]}
    }
    catch {exec kill ${pid}}
    if {![string match *AuthorizationFailure* ${reply}]} {
        return -code error "azurite-blob did not answer as Azure Storage on port ${port}"
    }
    ui_info "azurite-blob answered on port ${port}: AuthorizationFailure, as expected"
}
