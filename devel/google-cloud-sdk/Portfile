# Variant binaries that generate their own shell completions via `<binary> completion bash|zsh|fish`.
# Only binaries whose generated scripts register completions for their own installed name are listed.
set variant_completions [dict create \
    cloud_sql_proxy cloud-sql-proxy \
    istioctl        istioctl \
    kubectl         kubectl \
    minikube        minikube \
    skaffold        skaffold]

use_configure       no
build {
    # Define the basic installation command
    set install_command "CLOUDSDK_CONFIG=${worksrcpath}/.config CLOUDSDK_PYTHON=${python.bin} ./install.sh \
        --usage-reporting false \
        --command-completion false \
        --path-update false \
        --quiet \
        --install-python false"

    # Determine flags for installation of additional components
    set additional_components {}
    foreach component_variant [dict keys ${variant_to_component}] {
        if {[variant_isset ${component_variant}]} {
            lappend additional_components [dict get ${variant_to_component} ${component_variant}]
        }
    }
    if { [llength ${additional_components}] > 0 } {
        append install_command " --additional-components"
        foreach additional_component ${additional_components} {
            append install_command " " ${additional_component}
        }
    }

    # Run installer script
    system -W ${worksrcpath} ${install_command}

    # Default to the MacPorts Python binary
    reinplace "s|CLOUDSDK_PYTHON=\$(order_python .*|CLOUDSDK_PYTHON=${python.bin}|" \
        ${worksrcpath}/bin/bq \
        ${worksrcpath}/bin/docker-credential-gcloud \
        ${worksrcpath}/bin/git-credential-gcloud.sh \
        ${worksrcpath}/bin/gcloud \
        ${worksrcpath}/bin/gsutil \
        ${worksrcpath}/bin/java_dev_appserver.sh

    reinplace "s|^#!/usr/bin/env python$|#!${python.bin}|" \
        ${worksrcpath}/bin/dev_appserver.py

    # Disable updater
    reinplace "s|\"disable_updater\": false|\"disable_updater\": true|" ${worksrcpath}/lib/googlecloudsdk/core/config.json
}

test.run    yes
test.cmd    bin/gcloud
test.target
test.args   version

destroot {
    set libexecdir ${destroot}${prefix}/libexec/${name}
    xinstall -d ${libexecdir}
    copy \
        ${worksrcpath}/.install \
        ${worksrcpath}/bin \
        ${worksrcpath}/lib \
        ${worksrcpath}/platform \
        ${libexecdir}
    foreach f { bq docker-credential-gcloud gcloud gsutil } {
        ln -s ../libexec/${name}/bin/${f} ${destroot}${prefix}/bin/${f}
    }
    ln -s ../libexec/${name}/bin/git-credential-gcloud.sh ${destroot}${prefix}/bin/git-credential-gcloud

    # Symlink binaries installed by additional components selected via variants.
    # Each component records its files in .install/<component>.manifest; binaries usually
    # come from a platform-specific sub-component (e.g. <component>-darwin-arm.manifest).
    foreach component_variant [dict keys ${variant_to_component}] {
        if {![variant_isset ${component_variant}]} {
            continue
        }
        set component [dict get ${variant_to_component} ${component_variant}]
        foreach suffix [list "" -nix -darwin -darwin-${arch_classifier}] {
            set manifest ${worksrcpath}/.install/${component}${suffix}.manifest
            if {![file exists ${manifest}]} {
                continue
            }
            set fd [open ${manifest} r]
            set entries [split [read -nonewline ${fd}] "\n"]
            close ${fd}
            foreach entry ${entries} {
                if {[regexp {^bin/([^/]+)$} ${entry} -> f]} {
                    set link ${destroot}${prefix}/bin/${f}
                    if {[catch {file lstat ${link} link_stat}]} {
                        ln -s ../libexec/${name}/bin/${f} ${link}
                    }
                }
            }
        }
    }

    # bash completion
    set bash_completions_path ${prefix}/etc/bash_completion.d
    xinstall -d ${destroot}${bash_completions_path}
    xinstall -m 644 ${worksrcpath}/completion.bash.inc ${destroot}${bash_completions_path}/google-cloud-sdk

    # zsh completion
    set gcloud_libexec ${destroot}${prefix}/libexec/google-cloud-sdk
    xinstall -m 644 ${worksrcpath}/completion.zsh.inc ${gcloud_libexec}

    # Shell completions for variant binaries that can generate them
    set zsh_completions_path ${prefix}/share/zsh/site-functions
    set fish_completions_path ${prefix}/share/fish/vendor_completions.d
    foreach component_variant [dict keys ${variant_completions}] {
        if {![variant_isset ${component_variant}]} {
            continue
        }
        set f [dict get ${variant_completions} ${component_variant}]
        xinstall -d ${destroot}${zsh_completions_path} ${destroot}${fish_completions_path}
        system -W ${worksrcpath} "./bin/${f} completion bash < /dev/null > ${destroot}${bash_completions_path}/${f}"
        system -W ${worksrcpath} "./bin/${f} completion zsh < /dev/null > ${destroot}${zsh_completions_path}/_${f}"
        system -W ${worksrcpath} "./bin/${f} completion fish < /dev/null > ${destroot}${fish_completions_path}/${f}.fish"
    }
}

notes "
    google-cloud-sdk zsh completions aren't loaded automatically.
    You must source them manually in your ~/.zshrc:
        source '${prefix}/libexec/google-cloud-sdk/completion.zsh.inc'"

foreach component_variant [dict keys ${variant_completions}] {
    if {[variant_isset ${component_variant}]} {
        notes-append "
    Completions for binaries added by variants are also installed for zsh in
    ${prefix}/share/zsh/site-functions and for fish in
    ${prefix}/share/fish/vendor_completions.d. MacPorts zsh loads them
    automatically; with macOS /bin/zsh, add this to your ~/.zshrc before compinit:
        fpath=(${prefix}/share/zsh/site-functions \$fpath)"
        break
    }
}

