github.setup        Mattbusel Every-Other-Token 5.0.2 v
github.tarball_from archive
name                every-other-token
revision            0
categories          devel
installs_libs       no
license             MIT
maintainers         {tensorust.com:mattbusel @Mattbusel} \
                    openmaintainer

description         Watch an LLM answer token by token with per-token confidence

long_description    {*}${description}. every-other-token streams a reply from \
                    OpenAI, Anthropic, Gemini, OpenRouter or a local \
                    OpenAI-compatible server (Ollama and others), shows each \
                    token's confidence and perplexity from logprobs, and can \
                    rewrite every other token live. It runs as a CLI, a \
                    terminal UI or a local web UI. The mock provider needs \
                    no API key.

checksums           ${distname}${extract.suffix} \
                    rmd160  f9680cdef1010697424c6bfe22acf6543520068f \
                    sha256  a93c578ebbba3d1ebda8d0acbeecfcb54986066018269139243cb30589adaa76 \
                    size    1223007

destroot {
    set bin ${worksrcpath}/target/[cargo.rust_platform]/release/${name}
    xinstall -m 0755 ${bin} ${destroot}${prefix}/bin/

    xinstall -d ${destroot}${prefix}/share/bash-completion/completions
    xinstall -d ${destroot}${prefix}/share/zsh/site-functions
    xinstall -d ${destroot}${prefix}/share/fish/vendor_completions.d
    system "${bin} --completions bash > ${destroot}${prefix}/share/bash-completion/completions/${name}"
    system "${bin} --completions zsh > ${destroot}${prefix}/share/zsh/site-functions/_${name}"
    system "${bin} --completions fish > ${destroot}${prefix}/share/fish/vendor_completions.d/${name}.fish"

    xinstall -d ${destroot}${prefix}/share/doc/${name}
    xinstall -m 0644 -W ${worksrcpath} README.md CHANGELOG.md LICENSE \
        ${destroot}${prefix}/share/doc/${name}
}

