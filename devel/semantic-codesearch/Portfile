PortSystem          1.0
PortGroup           github 1.0
PortGroup           cargo  1.0

github.setup        flupkede codesearch 1.7.4 v
github.tarball_from archive
name                semantic-codesearch
revision            0

categories          devel
installs_libs       no
license             Apache-2.0
maintainers         {@oakimov} openmaintainer

description         Fast local semantic code search
long_description    {*}${description}. This is a command-line tool and MCP \
                    server that indexes local repositories and searches them \
                    with vector embeddings and full-text ranking. The port \
                    builds the Rust binary only. The optional C# helper is \
                    not included.

homepage            https://github.com/flupkede/codesearch

# ort-sys 2.0.0-rc.15 publishes prebuilt ONNX Runtime for
# aarch64-apple-darwin only. x86_64-apple-darwin is not in that dist table,
# so the crate cannot link on Intel Macs.
supported_archs     arm64

# Those prebuilt objects (ONNX Runtime 1.31.0, aarch64-apple-darwin+coreml)
# are Mach-O LC_BUILD_VERSION minos 13.4, so macOS 13.4 or later is required.
# They were built with SDK 15.5 and reference ___isPlatformVersionAtLeast from
# libclang_rt.osx; force-link the compiler runtime so the final link succeeds
# with macosx_deployment_target 13.4.
platforms           {darwin >= 22}
macosx_deployment_target 13.4
rust.add_compiler_runtime yes

checksums           ${distname}${extract.suffix} \
                    rmd160  5989b053aa2d0ef32bfd49ed06a50b1e27fa983c \
                    sha256  d78de93d5552fb59bc1b59b43ab89a0ac291aa37774ec876c37149bb40b64c85 \
                    size    1789778

depends_lib-append  port:libiconv

# Upstream .cargo/config.toml sends the build to ../target, outside the
# source tree. Drop that so the binary lands in the cargo PortGroup path.
post-extract {
    reinplace {/^target-dir = /d} ${worksrcpath}/.cargo/config.toml
}

# Registry and models stay in the invoking user's ~/.codesearch
# (repos.json) and each repository's .codesearch.db. Leave CODESEARCH_HOME
# unset so a manual install's indexes are opened as-is. A LaunchAgent runs
# as that user; a root LaunchDaemon would look in root's home instead.
startupitem.create      yes
startupitem.autostart   yes
startupitem.location    LaunchAgents
startupitem.executable  ${prefix}/bin/codesearch serve start --no-tui --quiet true
startupitem.logevents   yes

destroot {
    xinstall -m 0755 \
        ${worksrcpath}/target/[cargo.rust_platform]/release/codesearch \
        ${destroot}${prefix}/bin/
}

