                    port:lz4 \
                    port:lzma \
                    port:snappy \
                    port:xz \
                    port:zlib \
                    port:zstd

patch.pre_args-replace  -p0 -p1

patchfiles-append   0001-folly-Portability-define-FOLLY_PPC-kIsArchPPC-for-32.patch \
                    0002-cmake-only-link-c-abi-on-Apple-when-the-C-stdlib-is-.patch \
                    0003-folly-DiscriminatedPtr-support-32-bit-architectures-.patch \
                    0004-folly-io-IOBuf-keep-HeapPrefix-at-8-bytes-on-ABIs-wi.patch \
                    0005-folly-relax-layout-assertions-that-cannot-hold-on-Da.patch \
                    0006-folly-ConstexprMath-avoid-long-double-literals-for-e.patch \
                    0007-folly-portability-Asm-pause-on-32-bit-PPC-too-with-A.patch \
                    0008-folly-support-building-networking-code-against-legac.patch \
                    0009-folly-support-legacy-macOS-10.5-10.6-in-system-porta.patch \
                    0010-folly-Subprocess-avoid-constructor-priority-with-GCC.patch \
                    0011-folly-json-dynamic-restore-deprecated-iterator-range.patch

if {${os.platform} eq "darwin" && ${os.major} < 19} {
    patchfiles-append \
                    0012-folly-test-adjust-tests-for-Darwin-ppc32-and-legacy-.patch
}

