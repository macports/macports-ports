                    size    16477591

maintainers         {gmail.com:herby.gillot @herbygillot} \
                    openmaintainer

build.pre_args-append \
                    -o ./_bin/${name}
build.args          ./${name}

installs_libs       no

destroot {
    xinstall -m 0755 ${worksrcpath}/_bin/${name} ${destroot}${prefix}/bin/
}
