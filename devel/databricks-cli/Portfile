# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           golang 1.0

go.setup            github.com/databricks/cli 1.28.0 v
go.toolchain_min    1.27
github.tarball_from archive
name                databricks-cli
revision            0

categories          devel
# Databricks License (LICENSE): use only with the Databricks Services.
# Redistribution is allowed under its terms, but Databricks may terminate the
# license at any time, so binary archives are not distributed.
license             Restrictive
maintainers         nomaintainer
installs_libs       no

description         Command-line interface for the Databricks platform

long_description    The Databricks CLI is a command-line tool for the \
                    Databricks platform, built on the Databricks REST APIs. \
                    It manages workspaces, jobs, clusters, Unity Catalog \
                    objects and other resources, and deploys data and AI \
                    projects with Declarative Automation Bundles (DABs).

homepage            https://docs.databricks.com/dev-tools/cli/

checksums           rmd160  8d6ddf2e31b82835a8bbddecc81ff1ea3403d5be \
                    sha256  f8b651976f34ec46f4b13df0bb1376fdde98fabd4d690192642dd87587dd7e92 \
                    size    12383978

# Let Go fetch the modules listed in go.sum at build time.
go.offline_build    no

# Build as upstream's release does (.goreleaser.yaml): no cgo, the frozen Go
# Cryptographic Module in FIPS 140-3 mode, and the version stamped in at link
# time. Without buildVersion the CLI falls back to the module version, which
# is not valid semver in a source build, and panics at startup.
set build_pkg       github.com/databricks/cli/internal/build
# The commit the v${version} tag points to; update with the version.
set git_commit      0efdff8464fc72a3b1e11d03237839cba65875f6
lassign [split ${version} .] v_major v_minor v_patch

build.env-append    CGO_ENABLED=0 \
                    GOFIPS140=v1.0.0
build.args          -trimpath \
                    -ldflags=\"-s -w \
                        -X ${build_pkg}.buildProjectName=cli \
                        -X ${build_pkg}.buildVersion=${version} \
                        -X ${build_pkg}.buildTag=v${version} \
                        -X ${build_pkg}.buildSummary=v${version} \
                        -X ${build_pkg}.buildFullCommit=${git_commit} \
                        -X ${build_pkg}.buildShortCommit=[string range ${git_commit} 0 8] \
                        -X ${build_pkg}.buildMajor=${v_major} \
                        -X ${build_pkg}.buildMinor=${v_minor} \
                        -X ${build_pkg}.buildPatch=${v_patch}\" \
                    -o databricks \
                    .

# The unit tests, as upstream's Taskfile (test-unit) runs them, without its
# gotestsum wrapper. The skipped tests expect to run inside upstream's git
# checkout (a .git two levels up, an origin URL containing /cli); the
# release archive has no .git.
test.run            yes
test.args           -timeout=10m \
                    -skip '^(TestFindDirWithLeaf|TestGitAutoLoad|TestGitAutoLoadWithEnvironment|TestGitManuallySetBranch|TestGitManuallySetBranchWithEnvironment)$'
# Keep the tests' token storage in files: the login path otherwise probes the
# macOS keychain, which the build user doesn't have, and macOS opens a
# "Keychain Not Found" dialog.
test.env-append     DATABRICKS_AUTH_STORAGE=plaintext
test.target         ./acceptance/internal ./libs/... ./internal/... ./cmd/... \
                    ./bundle/... ./experimental/ssh/... .

destroot {
    xinstall -m 0755 ${worksrcpath}/databricks ${destroot}${prefix}/bin/

    set docdir ${destroot}${prefix}/share/doc/${name}
    xinstall -d ${docdir}
    xinstall -m 0644 -W ${worksrcpath} LICENSE NOTICE README.md ${docdir}
}

notes "
The Databricks CLI has been installed as '${prefix}/bin/databricks'. To set up\
 authentication, run:

    databricks auth login --host <workspace-url>

For more information, see https://docs.databricks.com/dev-tools/cli/
"
