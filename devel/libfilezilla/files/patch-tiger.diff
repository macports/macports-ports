Tiger lacks CSIdentity and CFStringCreateWithBytesNoCopy; local OS-user
impersonation fails closed. Remote FTP/SFTP authentication is unaffected.
Link ApplicationServices explicitly for LSOpenFromURLSpec on Tiger.

--- lib/impersonation.cpp.orig
+++ lib/impersonation.cpp
@@ -39,6 +39,7 @@
 #include <unistd.h>
 
 #if FZ_MAC
+#include <AvailabilityMacros.h>
 #include <CoreServices/CoreServices.h>
 #endif
 
@@ -212,7 +213,7 @@
 			return true;
 		}
 	}
-#elif FZ_MAC
+#elif FZ_MAC && MAC_OS_X_VERSION_MAX_ALLOWED >= 1050
 	bool ret{};
 
 	CFStringRef cfu = CFStringCreateWithCString(NULL, username.c_str(), kCFStringEncodingUTF8);
--- lib/process.cpp.orig
+++ lib/process.cpp
@@ -1030,7 +1030,7 @@
 
 cfsr cfsr_view(std::string_view const& v)
 {
-	return cfsr(CFStringCreateWithBytesNoCopy(nullptr, reinterpret_cast<uint8_t const*>(v.data()), v.size(), kCFStringEncodingUTF8, false, kCFAllocatorNull), true);
+	return cfsr(CFStringCreateWithBytes(nullptr, reinterpret_cast<UInt8 const*>(v.data()), v.size(), kCFStringEncodingUTF8, false), true);
 }
 
 int try_launch_bundle(std::vector<std::string> const& cmd_with_args)
--- lib/Makefile.am.orig
+++ lib/Makefile.am
@@ -163,7 +163,7 @@
 endif
 
 if FZ_MAC
-libfilezilla_la_LDFLAGS += -framework CoreServices
+libfilezilla_la_LDFLAGS += -framework CoreServices -framework ApplicationServices
 endif
 
 if FZ_UNIX
--- lib/Makefile.in.orig
+++ lib/Makefile.in
@@ -113,7 +113,7 @@
 @FZ_WINDOWS_FALSE@am__append_5 = \
 @FZ_WINDOWS_FALSE@	libfilezilla/glue/unix.hpp
 
-@FZ_MAC_TRUE@am__append_6 = -framework CoreServices
+@FZ_MAC_TRUE@am__append_6 = -framework CoreServices -framework ApplicationServices
 @FZ_UNIX_TRUE@am__append_7 = -lcrypt
 subdir = lib
 ACLOCAL_M4 = $(top_srcdir)/aclocal.m4
