# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           github 1.0

github.setup        markksantos ai-model-watch 1.0.0 v
github.tarball_from archive
revision            0

categories          devel net
platforms           any
supported_archs     noarch
license             MIT
maintainers         {markksantos.com:hello @markksantos} openmaintainer

description         list the models each AI provider's API serves and show what is new

long_description    ${name} fetches the model list from each AI provider's \
                    API (OpenRouter with no key, and OpenAI, Anthropic, \
                    Google Gemini, Mistral, xAI and DeepSeek with your own \
                    keys), saves it, and on the next run prints only the \
                    model IDs that were not there before. Listing models \
                    spends no tokens. It has --watch, --json and --exit-code \
                    for cron and CI, and needs nothing besides Node.js.

homepage            https://artificialwatch.com

checksums           rmd160  fb2ebd1d55f1abc2b0c57b0808931d3bbe2a348f \
                    sha256  ab64e081ae8f1be28f820d04ea4a5edf45db8ff068f22f65cb7f36453ff1b5b8 \
                    size    8777

depends_run         path:bin/node:nodejs22

use_configure       no

post-patch {
    reinplace "s|^#!/usr/bin/env node|#!${prefix}/bin/node|" ${worksrcpath}/bin/${name}.js
}

build {}

destroot {
    set libdir ${destroot}${prefix}/libexec/${name}
    xinstall -d ${libdir}/bin
    xinstall -m 0644 -W ${worksrcpath} index.js package.json ${libdir}
    xinstall -m 0755 ${worksrcpath}/bin/${name}.js ${libdir}/bin
    ln -s ${prefix}/libexec/${name}/bin/${name}.js ${destroot}${prefix}/bin/${name}

    set docdir ${destroot}${prefix}/share/doc/${name}
    xinstall -d ${docdir}
    xinstall -m 0644 -W ${worksrcpath} CHANGELOG.md LICENSE README.md ${docdir}
}

# The unit tests use a fake fetch, so they need no network and no API keys.
test.run            yes
test {
    system -W ${worksrcpath} "${prefix}/bin/node --test test/watch.test.js"
}
