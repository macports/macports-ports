PortSystem          1.0
PortGroup           cargo   1.0
PortGroup           github  1.0

github.setup        faiscadev fakecloud 0.50.0 v
github.tarball_from archive
revision            0

homepage            https://fakecloud.dev

description         Free, open-source local AWS cloud emulator

long_description    \
    fakecloud is a local emulator of Amazon Web Services and an open-source \
    alternative to LocalStack. A single binary serves over a hundred AWS \
    services on one port, speaking the real AWS wire protocols so that \
    unmodified SDKs, the AWS CLI, Terraform and CDK work against it. It \
    requires no account or auth token.

categories          devel net
installs_libs       no
license             AGPL-3+
platforms           {darwin >= 16}
maintainers         {gmail.com:herby.gillot @herbygillot} \
                    openmaintainer

checksums           ${distname}${extract.suffix} \
                    rmd160  8d8161ba9564e84b028324fbb0ae14f29913f135 \
                    sha256  8bfc6c977a773f8488911458e400d1e3bb01e0719a1c320f2286e68b7a7d4759 \
                    size    18980334

depends_build-append \
                    path:bin/pkg-config:pkgconfig

depends_lib-append  port:bzip2 \
                    port:libiconv \
                    port:xz \
                    port:zlib \
                    port:zstd

build.args-append   --package ${name}

# link MacPorts zstd instead of the copy bundled in zstd-sys
build.env-append    ZSTD_SYS_USE_PKG_CONFIG=1

post-patch {
    # zstd-sys forces a static link against the pkg-config zstd; use the dylib
    reinplace "s|\.statik(true)|.statik(false)|" \
        {*}[glob ${cargo.home}/macports/zstd-sys-*/build.rs]
}

destroot {
    xinstall -m 0755 \
        ${worksrcpath}/target/[cargo.rust_platform]/release/${name} \
        ${destroot}${prefix}/bin/
}

