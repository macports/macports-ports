PortSystem          1.0
PortGroup           golang 1.0

go.setup            github.com/stripe/stripe-mock 0.206.0 v
revision            0

homepage            https://github.com/stripe/stripe-mock

description         Mock HTTP server that responds like the real Stripe API

long_description    \
    stripe-mock is a mock HTTP server that responds like the real Stripe API. \
    It is powered by the Stripe OpenAPI specification, which it bundles \
    together with fixture data, and can be used instead of the live API to \
    run test suites of Stripe client libraries and integrations.

categories          devel net
installs_libs       no
license             MIT
maintainers         {@endelwar} openmaintainer

checksums           rmd160  b13250f8544dee264c0aca86999978af467d1ec8 \
                    sha256  113395fa2cbb0775f241070d9c4d956ef9e762ce54c4ea2bc10b1e801cacb8c6 \
                    size    2297004

# Dependencies are vendored in the source tarball.
build.env-append    CGO_ENABLED=0
build.args          -ldflags \"-s -w -X main.version=${version}\" \
                    -o ${name}

destroot {
    xinstall -m 0755 ${worksrcpath}/${name} ${destroot}${prefix}/bin/
}

test.run            yes
test.cmd            ./${name}
test.target         version
