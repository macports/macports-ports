github.setup        ivankovic omnidiff 0.3.0 v
github.tarball_from archive
revision            0

categories          devel textproc
license             AGPL-3
maintainers         {gmail.com:herby.gillot @herbygillot} \
                    openmaintainer

description         Fast, robust, accurate content-aware diffing
long_description    OmniDiff parses both sides of a diff with tree-sitter and \
                    matches their syntax trees, so a change is reported as what \
                    it structurally is - an insertion, deletion, update, or \
                    move - rather than as whichever lines happened to align. It \
                    also compares pictures, fonts, PDFs and archives by their \
                    content. It runs as an interactive terminal UI, a plain-text \
                    batch formatter, or a JSON emitter, and works as a git \
                    difftool and a Jujutsu (jj) diff formatter.

homepage            https://ivankovic.github.io/omnidiff/showcase/

depends_lib-append  port:libiconv

checksums           ${distname}${extract.suffix} \
                    rmd160  3b1953c3365af47b1057fdd8b1c83fbde71494fe \
                    sha256  82046f16077ecbb8122818bd9ea6ee1a0f01c0ca4650b037afbf610e155f33e5 \
                    size    104075924

destroot {
    set bin ${worksrcpath}/target/[cargo.rust_platform]/release/${name}
    xinstall -m 0755 ${bin} ${destroot}${prefix}/bin/

    # The man page and completions come from the binary's own clap definition,
    # as the project's release workflow makes them.
    xinstall -d ${destroot}${prefix}/share/man/man1 \
        ${destroot}${prefix}/share/bash-completion/completions \
        ${destroot}${prefix}/share/zsh/site-functions \
        ${destroot}${prefix}/share/fish/vendor_completions.d
    system "${bin} util man > ${destroot}${prefix}/share/man/man1/${name}.1"
    system "${bin} util completions bash > ${destroot}${prefix}/share/bash-completion/completions/${name}"
    system "${bin} util completions zsh > ${destroot}${prefix}/share/zsh/site-functions/_${name}"
    system "${bin} util completions fish > ${destroot}${prefix}/share/fish/vendor_completions.d/${name}.fish"

    xinstall -d ${destroot}${prefix}/share/doc/${name}
    xinstall -m 0644 -W ${worksrcpath} README.md THIRD-PARTY-NOTICES.md LICENSE \
        ${destroot}${prefix}/share/doc/${name}
}

