Skip optional X11 tests and benchmarks requiring posix_spawn on Tiger.
The libxkbcommon-x11 library remains enabled. Applied only on Darwin 8.

--- meson.build.orig
+++ meson.build
@@ -939,7 +939,7 @@
     )
 endif
 
-if get_option('enable-x11')
+if false # Tiger lacks spawn.h/posix_spawn for optional X11 tests
     libxkbcommon_x11_test_internal = library(
         'xkbcommon-x11-internal',
         libxkbcommon_x11_sources,
@@ -1205,7 +1205,7 @@
         dependencies: test_dep),
     env: test_env,
 )
-if get_option('enable-x11')
+if false # Tiger lacks spawn.h/posix_spawn for optional X11 tests
     has_xvfb = find_program('Xvfb', required: false)
     has_xkbcomp = find_program('xkbcomp', required: false)
     # We only warn because the build machine may not be the same
@@ -1380,7 +1380,7 @@
     executable('bench-atom', 'bench/atom.c', dependencies: test_dep),
     env: bench_env,
 )
-if get_option('enable-x11')
+if false # Tiger lacks spawn.h/posix_spawn for optional X11 tests
   benchmark(
       'x11',
       executable('bench-x11', 'bench/x11.c', dependencies: x11_test_dep),
