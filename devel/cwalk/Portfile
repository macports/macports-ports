# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:filetype=tcl:et:sw=4:ts=4:sts=4

PortSystem              1.0
PortGroup               cmake 1.1
PortGroup               github 1.0

github.setup            likle cwalk 1.2.9 v
github.tarball_from     archive

categories              devel
license                 MIT
homepage                https://likle.github.io/cwalk
maintainers             {sethm.id.au:dev @McDaMastR} \
                        openmaintainer

description             Cross-platform path library
long_description        cwalk is a lightweight C library which focuses on file \
                        path manipulation.  It supports Unix and Windows path \
                        styles on all platforms.

checksums               rmd160  e16dbf4d3505b6ef996126d3e602f1ec6b6e8937 \
                        sha256  54f160031687ec90a414e0656cf6266445207cb91b720dacf7a7c415d6bc7108 \
                        size    84158

configure.args-append   -DBUILD_SHARED_LIBS=ON \
                        -DENABLE_TESTS=ON \
                        -DIGNORE_WARNINGS=ON

pre-test {
    # Fix "Library not loaded: @rpath/libcwalk.dylib" error
    system "install_name_tool -add_rpath ${cmake.build_dir} ${cmake.build_dir}/${name}test"
}

test.run                yes
test.cmd                ${cmake.build_dir}/${name}test
test.target

post-destroot {
    set destdocdir  ${destroot}${prefix}/share/doc/${name}

    xinstall -d ${destdocdir}
    xinstall -m 644 \
        ${worksrcpath}/CONTRIBUTING.md \
        ${worksrcpath}/LICENSE.md \
        ${worksrcpath}/README.md \
        ${worksrcpath}/banner.png \
        ${destdocdir}
}
