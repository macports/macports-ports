PortSystem          1.0
PortGroup           boost 1.0
PortGroup           cmake 1.1
PortGroup           github 1.0
PortGroup           legacysupport 1.1
PortGroup           openssl 1.0

boost.version       1.81

github.setup        facebook wangle 2026.07.27.00 v
revision            0
categories          devel
license             BSD
maintainers         {@barracuda156 macos-powerpc.org:barracuda} openmaintainer

description         ${name} is a framework providing a set of common \
                    client/server abstractions for building services \
                    in a consistent, modular and composable way.
long_description    {*}${description}

checksums           rmd160  20ccbbe41f34cc10f1082c27f8749358a26ea2a0 \
                    sha256  bcf1ea11f23a4840c5f89f9f9928ca3e781854740eba6dbfeb80b46896a606f2 \
                    size    435263
github.tarball_from releases
distname            ${name}-v${version}
extract.mkdir       yes

cmake.source_dir    ${worksrcpath}/${name}

cmake.generator     Ninja

set libfmt_v        12
cmake.prefix_path-append \
                    ${prefix}/lib/libfmt${libfmt_v}/cmake
# doesn't build with libressl as of 2016-09-05
depends_lib-append  port:double-conversion \
                    port:fizz \
                    port:folly \
                    port:google-glog \
                    port:libevent \
                    port:libfmt${libfmt_v} \
                    port:libsodium \
                    port:zlib

if {${os.platform} eq "darwin" && ${os.major} < 15} {
    patchfiles-append patch-tcp.diff
}

# Fix error: invalid output constraint '=@ccc' in asm
compiler.blacklist-append \
                    {clang < 1400}
compiler.cxx_standard   2020

configure.args-append \
                    -DBUILD_TESTS=OFF \
                    -DBUILD_SHARED_LIBS=ON

legacysupport.newest_darwin_requires_legacy 19

if {[string match *clang* ${configure.compiler}]} {
    # Don’t use libcxx with gcc.
    legacysupport.use_mp_libcxx yes
}

if {[string match *gcc* ${configure.compiler}] && ${configure.build_arch} in [list arm i386 ppc]} {
    # ___atomic_fetch_sub_8, ___atomic_compare_exchange_8, ___atomic_store_8, ___atomic_load_8, ___atomic_fetch_add_8
    configure.ldflags-append \
                    -latomic
}
