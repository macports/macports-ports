# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem              1.0
PortGroup               cmake 1.1
PortGroup               github 1.0
PortGroup               legacysupport 1.1

# filesystem
legacysupport.newest_darwin_requires_legacy 18
legacysupport.use_mp_libcxx                 yes

github.setup            benman64 subprocess 0.6.0 v
github.tarball_from     archive

categories              devel
license                 MIT
maintainers             {sethm.id.au:dev @McDaMastR} \
                        openmaintainer

description             Cross-platform subprocess library for C++
long_description        {*}${description} similar to design of python \
                        subprocess.

checksums               rmd160  d2325dbd61cac37297c54eb3591ed170af387e94 \
                        sha256  eb976fe5f632760a53398965df4d0ed4780e11cf0b154dc73ba2795585a25414 \
                        size    723949

patchfiles              add-install-rules.diff \
                        fix-project-version.diff

post-patch {
    reinplace -W ${cmake.source_dir} \
        "s|@@FILESPATH@@|${filespath}|" \
        src/cpp/CMakeLists.txt
    reinplace -W ${cmake.source_dir} \
        "s|@@VERSION@@|${version}|" \
        CMakeLists.txt
}

compiler.cxx_standard   2017
cmake.set_cxx_standard  yes

configure.args-append   -DBUILD_SHARED_LIBS=ON \
                        -DBUILD_TESTING=OFF

post-destroot {
    set destdocdir  ${destroot}${prefix}/share/doc/${name}

    xinstall -d ${destdocdir}
    xinstall -W ${cmake.source_dir} -m 644 \
        LICENSE \
        README.md \
        ${destdocdir}
}
