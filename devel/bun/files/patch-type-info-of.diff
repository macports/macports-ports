Rust 1.99 removed the free function `core::mem::type_info::of` (TypeId::of
without the 'static bound). Homebrew's bun 1.4.3 build, which does compile
std from the rust library sources, fails on the same calls. Restore that
helper with the intrinsic the old function used, so lifetime-carrying field
types still reflect.
--- src/collections/lib.rs.orig
+++ src/collections/lib.rs
@@ -2,13 +2,14 @@
 
 #![feature(
     type_info,
+    core_intrinsics,
     adt_const_params,
     unsized_const_params,
     const_cmp,
     const_trait_impl,
     allocator_api
 )]
-#![allow(incomplete_features)]
+#![allow(incomplete_features, internal_features)]
 #![warn(unused_must_use)]
 
 pub mod hive_array;
--- src/collections/multi_array_list.rs.orig
+++ src/collections/multi_array_list.rs
@@ -47,7 +47,6 @@
 
