Rust 1.99 dropped Default for std::sync::Once. Upstream still derives
Default on Start which embeds Once; implement Default manually
(Once::new / OnceLock::new) so the port builds with MacPorts rust.
Matches Homebrew-core's bun formula patch.
--- src/runtime/cli/lint_js.rs.orig
+++ src/runtime/cli/lint_js.rs
@@ -409,12 +409,21 @@
 /// Startup state that all VMs share.
-#[derive(Default)]
 struct Start {
     initialize: std::sync::Once,
     /// Set if the run won't have more than a few VMs. Stays unset if a VM starts before the files are known.
     is_for_few: AtomicBool,
     memory: std::sync::OnceLock<usize>,
 }
 
+impl Default for Start {
+    fn default() -> Self {
+        Self {
+            initialize: std::sync::Once::new(),
+            is_for_few: AtomicBool::new(false),
+            memory: std::sync::OnceLock::new(),
+        }
+    }
+}
+
 impl Start {
     /// [`memory_for_engines`]
     fn memory(&self) -> usize {
