PortSystem          1.0
PortGroup           github 1.0
PortGroup           muniversal 1.0

github.setup        dlang dub 1.42.0 v
# Change github.tarball_from to 'releases' or 'archive' next update
github.tarball_from tarball
categories          devel
license             GPL-3
maintainers         {gmail.com:ppadil @papadil} openmaintainer
description         Package and build management system for D
long_description    Package and build manager for D applications and libraries.

depends_lib         port:ldc

checksums           rmd160  57bc066656f14e09208ba7e5a9b1a80ecc62434f \
                    sha256  2dcaadcf34e77f519b4fc13793a662bb3c8357d80e0ea5b4ce6f0d98b31e69a4 \
                    size    1564843

use_configure       no

build.cmd           ${prefix}/bin/ldmd2
build.target
build.env

destroot {
    xinstall -d -m 0755 ${destroot}${prefix}/share/bash-completion/completions
    xinstall -m 0644 ${worksrcpath}/scripts/bash-completion/dub.bash ${destroot}${prefix}/share/bash-completion/completions

    xinstall -m 0755 ${worksrcpath}/bin/dub ${destroot}${prefix}/bin

    xinstall -d -m 0755 ${destroot}${prefix}/share/${name}
    copy ${worksrcpath}/examples ${destroot}${prefix}/share/dub
}

if { ${build_arch} eq "x86_64" || ${build_arch} eq "ppc64"  || ${build_arch} eq "arm64" } {
             #build.env-append "DMD=${prefix}/bin/ldmd2 -m64"
      build.args     -m64 -run ./build.d
} else {
      build.args  -m32 -run ./build.d
}


github.livecheck.regex  {([^"rba]+)}
