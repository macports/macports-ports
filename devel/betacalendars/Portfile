PortSystem          1.0
PortGroup           cmake 1.1
PortGroup           github 1.0

github.setup        mateopedersen betacalendars-calendar-layout 0.2.0 v
github.tarball_from archive
name                betacalendars
revision            0

categories          devel
license             MIT
maintainers         @mateopedersen openmaintainer

description         deterministic Gregorian calendar grids and print geometry toolkit
long_description    BetaCalendars is a dependency-light C++ toolkit for deterministic Gregorian calendar topology and printable layout geometry. It supports seven week-start conventions, natural and fixed six-week grids, undated planner grids, physical paper formats, and multiple export formats.
homepage            https://www.betacalendars.com/

checksums           rmd160  8f20f0a6db6e4979beca922aa175d2a7ece68539 \
                    sha256  4fd98ccf69a323a982432b72f2e09d96019f6efec4281c0f34ff971d9d383434 \
                    size    21363

compiler.cxx_standard 2017

configure.args-append \
                    -DBETACALENDARS_BUILD_TESTS=ON \
                    -DBETACALENDARS_BUILD_TOOLS=ON

test.run            yes

post-destroot {
    xinstall -d ${destroot}${prefix}/share/man/man1
    xinstall -m 644 ${filespath}/betacal.1 ${destroot}${prefix}/share/man/man1/
    ln -s betacal.1 ${destroot}${prefix}/share/man/man1/betacal-layout.1

    xinstall -d ${destroot}${prefix}/share/doc/${name}
    xinstall -m 644 ${worksrcpath}/README.md ${destroot}${prefix}/share/doc/${name}/
    xinstall -m 644 ${worksrcpath}/LICENSE ${destroot}${prefix}/share/doc/${name}/
}

github.livecheck.regex {([0-9.]+)}
