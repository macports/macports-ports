index cc60e540..fb90e334 100644
--- thrift/lib/cpp2/server/Cpp2ConnContext.cpp
+++ thrift/lib/cpp2/server/Cpp2ConnContext.cpp
@@ -22,6 +22,10 @@
 #include <sys/ucred.h> // @manual
 #endif
 
+#ifndef SOL_LOCAL
+#define SOL_LOCAL 0
+#endif
+
 namespace {
 
 #ifndef _WIN32
@@ -62,6 +66,7 @@ Cpp2ConnContext::PeerCred Cpp2ConnContext::PeerCred::queryFromSocket(
     return PeerCred{ErrorRetrieving, errnoToUid(errno), 0};
   } else {
 #ifdef __APPLE__
+#ifdef LOCAL_PEEREPID
     pid_t epid = 0;
     if (getsockopt(
             socket.toFd(),
@@ -73,6 +74,11 @@ Cpp2ConnContext::PeerCred Cpp2ConnContext::PeerCred::queryFromSocket(
     } else {
       return PeerCred{epid, cred.cr_uid, cred.cr_gid};
     }
+#else
+    // Old SDKs have no LOCAL_PEEREPID and old kernels do not implement
