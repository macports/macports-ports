From ae7e3a47495efc7bf7ed6c1cd74bac0cad345699 Mon Sep 17 00:00:00 2001
From: Sergey Fedorov <barracuda@macos-powerpc.org>
Date: Wed, 29 Jul 2026 12:13:51 +0000
Subject: [PATCH] Build the test harness only when BUILD_TESTS is on

Upstream now honors BUILD_TESTS for GMock discovery and the test
directories, but still builds edencommon_testharness whenever GMock
happens to be found.  The harness links Folly::folly_test_util, so this
is an opportunistic dependency on googletest and a configure failure on
installations whose folly does not export that target -- e.g. when
building edencommon purely as a dependency of watchman.

Gate the harness on BUILD_TESTS and drop the opportunistic GMock lookup.
(Rebased for v2026.10.26.00; originally added the BUILD_TESTS option.)

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_015ECmTd2wkJqqrArR8VHCDm
---
 CMakeLists.txt | 4 +---
 1 file changed, 1 insertion(+), 3 deletions(-)

diff --git CMakeLists.txt CMakeLists.txt
index 5ff58e3..1be2494 100644
--- CMakeLists.txt
+++ CMakeLists.txt
@@ -88,8 +88,6 @@ if (BUILD_TESTS)
   find_package(GMock MODULE REQUIRED)
   include(GoogleTest)
   enable_testing()
-else()
-  find_package(GMock MODULE QUIET)
 endif()
 if (LIBGMOCK_FOUND)
   include_directories(${GMOCK_INCLUDEDIR} ${LIBGMOCK_INCLUDE_DIR})
@@ -97,7 +95,7 @@ endif()
 
 add_subdirectory(eden/common/os)
 add_subdirectory(eden/common/telemetry)
-if (LIBGMOCK_FOUND)
+if (BUILD_TESTS)
   add_subdirectory(eden/common/testharness)
 endif()
 add_subdirectory(eden/common/utils)
