--- /dev/null
+++ macports-smoke.cpp
@@ -0,0 +1,20 @@
+#include <angelscript.h>
+#include <cstdio>
+#include <cstring>
+// Runs a recursive script through the library and checks its result.
+static int result = 0;
+void setResult(int v) { result = v; }
+int main() {
+  asIScriptEngine *e = asCreateScriptEngine();
+  e->RegisterGlobalFunction("void setResult(int)", asFUNCTION(setResult), asCALL_CDECL);
+  asIScriptModule *m = e->GetModule("m", asGM_ALWAYS_CREATE);
+  const char *src = "int fib(int n){return n<2?n:fib(n-1)+fib(n-2);} void main(){setResult(fib(20));}";
+  m->AddScriptSection("s", src, strlen(src));
+  if (m->Build() < 0) return 1;
+  asIScriptContext *c = e->CreateContext();
+  c->Prepare(m->GetFunctionByDecl("void main()"));
+  int r = c->Execute();
+  printf("%s %d (expect 6765) exec=%d\n", asGetLibraryVersion(), result, r);
+  c->Release(); e->ShutDownAndRelease();
+  return result == 6765 ? 0 : 2;
+}
