The googletest submodule is empty in a release archive, and upstream then stops
with a FATAL_ERROR telling the builder to run `git submodule update --init`, so
the test suite cannot be built from the archive at all. Fall back to an
installed GoogleTest instead. The submodule still wins when it is present, so a
git checkout behaves exactly as before.

--- CMakeLists.txt.orig	2026-09-21 13:23:52
+++ CMakeLists.txt	2026-09-21 13:23:52
@@ -480,9 +480,15 @@
 		option(BUILD_GMOCK "Builds the googlemock subproject" ON)
 		add_subdirectory(extlibs/googletest)
 	else()
-		message(FATAL_ERROR
-			"Missing GoogleTest and GoogleMock in extlibs/googletest. "
-			"Please run `git submodule update --init` to fetch the submodule.")
+		# A release archive carries no submodule contents; use an installed
+		# GoogleTest rather than stopping. These are INTERFACE libraries and
+		# not ALIAS targets because a target imported by a config package is
+		# not GLOBAL, which ALIAS requires.
+		find_package(GTest CONFIG REQUIRED)
+		add_library(gtest INTERFACE)
+		target_link_libraries(gtest INTERFACE GTest::gtest)
+		add_library(gmock INTERFACE)
+		target_link_libraries(gmock INTERFACE GTest::gmock)
 	endif()
 
 	if (NETWORKIT_MONOLITH)
