destroot {
    set bindir ${worksrcpath}/target/[cargo.rust_platform]/release
    set nshdir ${prefix}/libexec/${name}

    xinstall -d ${destroot}${nshdir}/bin \
        ${destroot}${nshdir}/runtime/macos \
        ${destroot}${prefix}/share/doc/${name}

    xinstall -m 0755 ${bindir}/nsh ${destroot}${nshdir}/bin
    xinstall -m 0755 ${bindir}/nsh-macos-host ${bindir}/nsh-macos-app \
        ${destroot}${nshdir}/runtime/macos
    ln -s ${nshdir}/bin/nsh ${destroot}${prefix}/bin/nsh

    xinstall -m 0644 ${worksrcpath}/LICENSE-APACHE ${worksrcpath}/README.md \
        ${destroot}${prefix}/share/doc/${name}
}

