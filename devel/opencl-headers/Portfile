    reinplace -W ${worksrcpath} \
        {s|${CMAKE_INSTALL_FULL_INCLUDEDIR}|\\$ENV{DESTDIR}${CMAKE_INSTALL_FULL_INCLUDEDIR}|g} \
        CMakeLists.txt
