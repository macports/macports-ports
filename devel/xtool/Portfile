# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           github 1.0
PortGroup           openssl 1.0
PortGroup           xcodeversion 1.0

github.setup        xtool-org xtool 1.24.0
github.tarball_from archive
revision            0

categories          devel
license             MIT
maintainers         {gmail.com:herby.gillot @herbygillot} \
                    openmaintainer

description         Cross-platform Xcode replacement for building iOS apps \
                    with SwiftPM

long_description    ${name} builds, signs and installs iOS apps from a \
                    SwiftPM package, without an Xcode project. It handles \
                    Apple Developer account sign-in, certificates and \
                    provisioning profiles, and talks to connected devices \
                    through libimobiledevice.

homepage            https://xtool.sh

checksums           rmd160  75b6058a6edff2eeec15b3b80c2ff8348af9aa35 \
                    sha256  eef031747a42143f0f0bc1cd6d20c5610c7abda98a8da4a463cf0686626af213 \
                    size    10195144

# Xcode 26, needed for swift-tools-version 6.2, requires macOS 15.
platforms           {darwin >= 24}

depends_lib-append  path:lib/libimobiledevice-1.0.dylib:libimobiledevice \
                    path:lib/libimobiledevice-glue-1.0.dylib:libimobiledevice-glue \
                    path:lib/libplist-2.0.dylib:libplist \
                    path:lib/libusbmuxd-2.0.dylib:libusbmuxd

minimum_xcodeversions \
                    {24 26.0}

# minimum_xcodeversions errors out at fetch; this lets CI skip instead
if {![info exists xcodeversion] || ${xcodeversion} eq "none" || [vercmp ${xcodeversion} < 26.0]} {
    known_fail yes
}

installs_libs       no
universal_variant   no

use_configure       no
use_xcode           yes

# Header conflicts with the SDK when SwiftPM drives the clang importer.
compiler.cpath

# Link MacPorts libraries instead of xtool-core's prebuilt xcframeworks.
build.env-append    XTL_SYSTEM_LIBRARIES=1 \
                    PKG_CONFIG_PATH=[openssl::pkgconfig_dir]:${prefix}/lib/pkgconfig \
                    XTOOL_VERSION=${version}

set swift_build_flags [list --configuration release \
                        --arch ${configure.build_arch} \
                        --disable-sandbox \
                        --cache-path ${workpath}/.swiftpm/cache \
                        --config-path ${workpath}/.swiftpm/config \
                        --security-path ${workpath}/.swiftpm/security]

build.cmd           swift
build.target        build
build.args          --product ${name} {*}${swift_build_flags}

test.run            yes
test.cmd            swift
test.target         test
test.args           {*}${swift_build_flags}
test.env-append     {*}${build.env}

destroot {
    set bin ${worksrcpath}/.build/${configure.build_arch}-apple-macosx/release/${name}
    xinstall -m 0755 ${bin} ${destroot}${prefix}/bin/

    foreach {shell dest} [list \
            bash ${prefix}/share/bash-completion/completions/${name} \
            zsh  ${prefix}/share/zsh/site-functions/_${name} \
            fish ${prefix}/share/fish/vendor_completions.d/${name}.fish] {
        xinstall -d [file dirname ${destroot}${dest}]
        system "${bin} --generate-completion-script ${shell} > ${destroot}${dest}"
    }

    xinstall -d ${destroot}${prefix}/share/doc/${name}
    xinstall -m 0644 -W ${worksrcpath} LICENSE.md README.md \
        ${destroot}${prefix}/share/doc/${name}
}
