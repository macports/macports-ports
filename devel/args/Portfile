PortSystem              1.0
PortGroup               cmake 1.1
PortGroup               github 1.0

github.setup            Taywee args 6.6.1
github.tarball_from     archive

categories              devel
license                 MIT
platforms               any
supported_archs         noarch
maintainers             {sethm.id.au:dev @McDaMastR} \
                        openmaintainer

description             A header-only C++ argument parser library
long_description        {*}${description}.  Supposed to be flexible and \
                        powerful, and attempts to be compatible with the \
                        functionality of the Python standard argparse library.

checksums               rmd160  40b830839157869a5b8e7a418ecac2c3d648191d \
                        sha256  61cdbb13f55493e6ffe07018c86b17f9ff68a5c1059eb15f4f079e04429915ff \
                        size    119662

compiler.cxx_standard   2011

configure.args-append   -DARGS_BUILD_EXAMPLE=OFF \
                        -DARGS_BUILD_UNITTESTS=ON \
                        -DARGS_MAIN_PROJECT=ON

test.run                yes
test.cmd                ctest
test.target

post-destroot {
    set destdocdir  ${destroot}${prefix}/share/doc/${name}

    xinstall -d ${destdocdir}
    xinstall -W ${worksrcpath} -m 644 \
        CHANGELOG \
        CONTRIBUTING.md \
        LICENSE \
        README.md \
        ${destdocdir}
}
