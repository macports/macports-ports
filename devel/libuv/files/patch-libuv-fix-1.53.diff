+/* posix_spawn() first appeared in Mac OS X 10.5: always fork() on Tiger. */
+# if MAC_OS_X_VERSION_MIN_REQUIRED < 1050
+#  define UV__DARWIN_NO_POSIX_SPAWN 1
+# endif
+/* POSIX_SPAWN_CLOEXEC_DEFAULT and posix_spawn_file_actions_addinherit_np()
+ * first appeared in Mac OS X 10.7: treat older systems like any other
+ * non-Apple posix_spawn() platform. */
+# if MAC_OS_X_VERSION_MIN_REQUIRED < 1070
+#  define UV__DARWIN_NO_CLOEXEC_DEFAULT 1
+# endif
+#endif
+
+#ifndef UV__DARWIN_NO_POSIX_SPAWN
 #include <spawn.h>
+#endif
 #include <paths.h>
 #include <dlfcn.h>
 
