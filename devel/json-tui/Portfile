PortSystem              1.0
PortGroup               cmake 1.1
PortGroup               github 1.0

github.setup            ArthurSonzogni json-tui 1.4.2 v
github.tarball_from     archive

categories              devel sysutils
license                 MIT
homepage                https://arthursonzogni.com/en/json-tui
maintainers             {sethm.id.au:dev @McDaMastR} \
                        openmaintainer

description             JSON terminal UI made in C++
long_description        json-tui is a terminal UI to visualize JSON.

installs_libs           no

depends_build-append    port:args
depends_lib-append      port:FTXUI \
                        port:nlohmann-json

checksums               rmd160  f7a4073797e59f7ca881df6ceef319142beb6d1c \
                        sha256  11949dbeccaac813bec62f3cb9e3dd398846c9bb9306291c0eb72a97e7567c48 \
                        size    353105

compiler.cxx_standard   2017

configure.args-append   -DJSON_TUI_BUILD_TESTS=OFF \
                        -DJSON_TUI_CLANG_TIDY=OFF

post-destroot {
    set destdocdir  ${destroot}${prefix}/share/doc/${name}

    xinstall -d ${destdocdir}
    xinstall -W ${cmake.source_dir} -m 644 \
        CHANGELOG.md \
        LICENSE \
        README.md \
        demo.webp \
        ${destdocdir}
}
