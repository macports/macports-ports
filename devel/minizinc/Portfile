# Need strndup()
PortGroup           legacysupport 1.1

legacysupport.newest_darwin_requires_legacy 10

github.setup        MiniZinc libminizinc 2.11.0
github.tarball_from archive
name                minizinc
revision            0

homepage            https://www.minizinc.org

description         MiniZinc is a free and open-source constraint modeling \
                    language.

long_description    {*}${description} You can use MiniZinc to model \
                    constraint satisfaction and optimization problems \
                    in a high-level, solver-independent way, taking advantage \
                    of a large library of pre-defined constraints. Your model \
                    is then compiled into FlatZinc, a solver input language \
                    that is understood by a wide range of solvers. MiniZinc \
                    is developed at Monash University in collaboration with \
                    Data61 Decision Sciences and the University of Melbourne.

categories          devel
installs_libs       no
license             MPL-2
maintainers         {gmail.com:herby.gillot @herbygillot} \
                    openmaintainer
platforms           darwin linux

checksums           rmd160  8f1f6afff93325805c2f289d1559a163718ddd04 \
                    sha256  9c88aa270864d78c4f39437533796f5bf60bf71bec78f02685742b2c44aeba26 \
                    size    8506173

depends_build-append \
                    port:bison

depends_lib-append  port:zlib

compiler.cxx_standard \
                    2017

# 2.11 bundles its MiniZinc libraries at install time whenever it finds a
# Python 3, which would make the result depend on the host. Keep installing
# the library sources, as 2.10 did.
configure.args-append \
                    -DMZN_BUNDLE_LIBRARIES=OFF \
                    -DUSE_CCACHE=OFF
