                        size    2516396

compiler.cxx_standard   2017

post-destroot {
    set destdocdir  ${destroot}${prefix}/share/doc/${name}

    xinstall -d ${destdocdir}
    xinstall -W ${cmake.source_dir} -m 644 \
        CHANGELOG.md \
        LICENSE \
        README.md \
        demo.gif \
        logo.png \
        ${destdocdir}
}
