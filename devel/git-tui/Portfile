github.setup            ArthurSonzogni git-tui 1.4.0 v
github.tarball_from     archive
revision                1

categories              devel sysutils
license                 MIT
maintainers             {sethm.id.au:dev @McDaMastR} \
                        openmaintainer

description             Terminal interfaces for git
long_description        A collection of human-friendly terminal interfaces for \
                        git.

installs_libs           no

depends_lib-append      port:FTXUI \
                        port:subprocess
depends_run-append      bin:git:git

checksums               rmd160  ce3ef7b7c6699d1cc4864b0ff76eb6d58ed8d3ab \
