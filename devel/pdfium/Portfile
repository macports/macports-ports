foreach source ${source_archives} {
    lassign ${source} tag repository commit directory format
    if {${format} eq "gitiles"} {
        master_sites-append ${repository}/+archive/:${tag}
    } else {
        master_sites-append ${repository}/archive/:${tag}
    }
    distfiles-append ${commit}.tar.gz:${tag}
}
