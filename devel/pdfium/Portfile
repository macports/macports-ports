# The Chromium build snapshot is validated with Clang 21 and newer.
# Its GN toolchain does not support GCC on macOS.
compiler.blacklist-append \
                    *gcc* {clang < 2100} \
                    {macports-clang-[3-9].*} {macports-clang-1[0-9]} macports-clang-20
use_xcode           yes
universal_variant   no

# Gitiles puts download-time timestamps in its tar headers. Canonicalize
# archive metadata before the checksum phase, retaining file contents and
# executable bits. Running this again on a cached archive is idempotent.
post-fetch {
    foreach source ${source_archives} {
        lassign ${source} tag repository commit directory format
        if {${format} ne "gitiles"} {
            continue
        }
        set archive ${distpath}/${commit}.tar.gz
        set temp [mkdtemp ${workpath}/normalize.XXXXXX]
        try {
            system -W ${temp} "${prefix}/bin/gnutar -xf [shellescape ${archive}]"
            system -W ${temp} "${prefix}/bin/gnutar --sort=name --format=gnu --mtime=@0 --owner=0 --group=0 --numeric-owner --mode='u+rwX,go+rX,go-w' -cf - . | ${prefix}/bin/gzip -n > [shellescape ${archive}.normalized]"
            file rename -force ${archive}.normalized ${archive}
        } finally {
            delete ${temp}
            delete ${archive}.normalized
        }
    }
}

extract {
    foreach source ${source_archives} {
        lassign ${source} tag repository commit directory format
        set target ${worksrcpath}/${directory}
        xinstall -d ${target}
        set strip {}
        if {${format} eq "github"} {
            set strip --strip-components=1
        }
        system -W ${target} "${prefix}/bin/gnutar -xf [shellescape ${distpath}/${commit}.tar.gz] ${strip}"
    }
}

patchfiles          patch-macports.diff
patch.pre_args      -p1

post-patch {
    reinplace "s|//third_party/cpython3/host/bin/python3|${configure.python}|" \
        ${worksrcpath}/.gn
    # Reuse Chromium's system-ICU target and header forwarding generator.
    xinstall -d ${worksrcpath}/third_party/icu
    copy -force ${worksrcpath}/build/linux/unbundle/icu.gn \
        ${worksrcpath}/third_party/icu/BUILD.gn
    xinstall -d ${worksrcpath}/tools/generate_shim_headers
    copy ${filespath}/generate_shim_headers.py \
        ${worksrcpath}/tools/generate_shim_headers/generate_shim_headers.py
    reinplace "1s|^#!.*|#!${configure.python}|" \
        ${worksrcpath}/tools/generate_shim_headers/generate_shim_headers.py
    set fd [open ${worksrcpath}/build/config/gclient_args.gni w]
    puts ${fd} {build_with_chromium = false
checkout_android = false
checkout_libpng = false
checkout_skia = false
checkout_google_benchmark = false
checkout_src_internal = false}
    close ${fd}
}

configure.cmd       ${prefix}/bin/gn
configure.dir       ${worksrcpath}
configure.pre_args
configure.args      gen out/Release --fail-on-unused-args

pre-configure {
    set cpu ${configure.build_arch}
    if {${cpu} eq "x86_64"} {
        set cpu x64
    }
    # Query the chosen compiler, including Xcode's real toolchain when
    # configure.cc is the /usr/bin/clang driver.
    set clang_resource_dir [file normalize [string trim [exec ${configure.cc} -print-resource-dir]]]
    set clang_base_path [file dirname [file dirname [file dirname ${clang_resource_dir}]]]
    set clang_version [file tail ${clang_resource_dir}]
    xinstall -d ${worksrcpath}/out/Release
    set fd [open ${worksrcpath}/out/Release/args.gn w]
    puts ${fd} "is_debug = false
is_component_build = false
pdf_is_standalone = false
pdf_enable_v8 = false
pdf_enable_xfa = false
pdf_use_skia = false
pdf_use_libyuv = false
pdf_use_partition_alloc = false
pdf_enable_brotli = false
pdf_bundle_freetype = false
use_system_freetype = true
use_system_harfbuzz = true
use_system_libjpeg = true
use_system_libpng = true
use_system_zlib = true
use_system_lcms2 = true
use_system_libopenjpeg2 = true
use_custom_libcxx = false
use_custom_libcxx_for_host = false
use_siso = false
use_remoteexec = false
use_sysroot = false
clang_use_chrome_plugins = false
treat_warnings_as_errors = false
clang_base_path = \"${clang_base_path}\"
clang_version = \"${clang_version}\"
is_clang = true
use_lld = false
symbol_level = 0
target_cpu = \"${cpu}\"
mac_deployment_target = \"${macosx_deployment_target}\"
mac_min_system_version = \"${macosx_deployment_target}\"
use_system_xcode = true
pkg_config = \"${prefix}/bin/pkg-config\""
    close ${fd}
}

build.cmd           ${prefix}/bin/ninja
build.dir           ${worksrcpath}
build.pre_args      -C out/Release
build.target        pdfium

destroot {
    xinstall -m 755 ${worksrcpath}/out/Release/libpdfium.dylib ${destroot}${prefix}/lib
    system "install_name_tool -id ${prefix}/lib/libpdfium.dylib [shellescape ${destroot}${prefix}/lib/libpdfium.dylib]"
    system "codesign --force --sign - [shellescape ${destroot}${prefix}/lib/libpdfium.dylib]"
    xinstall -d ${destroot}${prefix}/include/pdfium/cpp ${destroot}${prefix}/lib/pkgconfig
    xinstall -m 644 {*}[glob ${worksrcpath}/public/*.h] ${destroot}${prefix}/include/pdfium
    xinstall -m 644 {*}[glob ${worksrcpath}/public/cpp/*.h] ${destroot}${prefix}/include/pdfium/cpp
    set fd [open ${destroot}${prefix}/lib/pkgconfig/pdfium.pc w]
    puts ${fd} "prefix=${prefix}
libdir=\${prefix}/lib
includedir=\${prefix}/include

Name: PDFium
Description: PDF rendering and manipulation library
Version: ${version}
Libs: -L\${libdir} -lpdfium
Cflags: -I\${includedir}/pdfium"
    close ${fd}
    set docdir ${destroot}${prefix}/share/doc/${name}
    xinstall -d ${docdir}
    xinstall -m 644 -W ${worksrcpath} LICENSE AUTHORS README.md ${docdir}
    xinstall -m 644 ${portpath}/Portfile ${docdir}
    foreach component {agg23 abseil-cpp dragonbox/src fast_float/src highway/src} {
        set licdir ${docdir}/licenses/${component}
        xinstall -d ${licdir}
        foreach licensefile [glob -nocomplain ${worksrcpath}/third_party/${component}/LICENSE* ${worksrcpath}/third_party/${component}/copying] {
            xinstall -m 644 ${licensefile} ${licdir}
        }
    }
}

livecheck.type      git
livecheck.url       https://pdfium.googlesource.com/pdfium.git
livecheck.version   [lindex [lindex ${source_archives} 0] 2]

notes {
    This build provides PDF rendering without JavaScript, XFA, Skia or the
    experimental Brotli decoder. Use pkg-config --cflags --libs pdfium when
    building applications against the library.
}
