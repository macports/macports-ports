# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem              1.0
PortGroup               cmake 1.1
PortGroup               github 1.0

github.setup            ArthurSonzogni FTXUI 7.0.3 v

categories              devel sysutils
license                 MIT
homepage                https://arthursonzogni.github.io/FTXUI
maintainers             {sethm.id.au:dev @McDaMastR} \
                        openmaintainer

description             C++ Functional Terminal User Interface
long_description        The Functional Terminal (X) User Interface (FTXUI) is \
                        a simple cross-platform C++ library for terminal based \
                        user interfaces.

distname                source

checksums               rmd160  b7817081cac69fba790a73fe6ea70bf23afcfc58 \
                        sha256  be506d647bf6eed2e7927f99ea080bcccff0938d9a35617756161d5b76df8b8a \
                        size    362593

extract.mkdir           yes

compiler.cxx_standard   2017
compiler.thread_local_storage \
                        yes

configure.args-append   -DBUILD_SHARED_LIBS=ON \
                        -DFTXUI_BUILD_DOCS=OFF \
                        -DFTXUI_BUILD_EXAMPLES=OFF \
                        -DFTXUI_BUILD_MODULES=OFF \
                        -DFTXUI_BUILD_TESTS=OFF \
                        -DFTXUI_BUILD_TESTS_FUZZER=OFF \
                        -DFTXUI_CLANG_TIDY=OFF \
                        -DFTXUI_DEV_WARNINGS=OFF \
                        -DFTXUI_ENABLE_CCACHE=OFF \
                        -DFTXUI_ENABLE_COVERAGE=OFF \
                        -DFTXUI_ENABLE_INSTALL=ON \
                        -DFTXUI_QUIET=OFF

post-destroot {
    set destdocdir  ${destroot}${prefix}/share/doc/[string tolower ${name}]

    xinstall -d ${destdocdir}
    xinstall -W ${worksrcpath} -m 644 \
        CHANGELOG.md \
        LICENSE \
        README.md \
        ${destdocdir}
}
