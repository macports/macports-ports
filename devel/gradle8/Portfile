# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem              1.0
PortGroup               java 1.0

name                    gradle8
version                 8.14.7

categories              devel java groovy
license                 Apache-2
platforms               any
supported_archs         noarch
homepage                https://gradle.org
maintainers             {sethm.id.au:dev @McDaMastR} \
                        openmaintainer

description             An open-source build system for the JVM ecosystem
long_description        Gradle 8 is a highly scalable build automation tool \
                        designed to handle everything from large, \
                        multi-project enterprise builds to quick development \
                        tasks across various languages.  Gradle’s modular, \
                        performance-oriented architecture seamlessly \
                        integrates with development environments, making it a \
                        go-to solution for building, testing, and deploying \
                        applications on Java, Kotlin, Scala, Android, Groovy, \
                        C++, and Swift.

# Building requires Java == 8 && Java == 11 && Java == 17 (auto-downloaded)
# Running requires 24 >= Java >= 8
java.version            1.8-24
java.fallback           openjdk21

set gradle_home         ${workpath}/.home/.gradle
set gradle_destdir      ${destroot}${prefix}/share/${name}
set gradle_distfile     gradle-${version}-src.zip
# Keep in sync with gradle-wrapper.properties
set gradlew_version     8.14.6
set gradlew_distfile    gradle-${gradlew_version}-bin.zip

master_sites            https://services.gradle.org/distributions
distfiles               ${gradle_distfile} ${gradlew_distfile}
worksrcdir              gradle-${version}

checksums               ${gradle_distfile} \
                            rmd160  c95eebb560249ea11cc88fc910e428960ffc2547 \
                            sha256  43ed47e6206ffa9d40b6d9e58f66e41dab1264d41102f668fec08f5df9479f3c \
                            size    63005596 \
                        ${gradlew_distfile} \
                            rmd160  03c92e41875b14f347e8d5888555246b776dc6f0 \
                            sha256  7988ed071b2a07900e2ec715fca15c6ab72bce6db433af301fa7fa7e9407bd24 \
                            size    139420601

use_zip                 yes
extract.only            ${gradle_distfile}

patchfiles              use-fetched-gradle-bin.diff

post-patch {
    reinplace -W ${worksrcpath} \
        "s|@@DISTPATH@@|${distpath}|" \
        gradle/wrapper/gradle-wrapper.properties
    reinplace -W ${worksrcpath} \
        "s|@@GRADLEW_DISTFILE@@|${gradlew_distfile}|" \
        gradle/wrapper/gradle-wrapper.properties
}

use_configure           no

# TODO Figure out how to remove the timestamp from the Gradle version
# when running `gradle8 --version`.
build.cmd               ./gradlew
build.target            :distributions-full:binDistributionZip
build.args              --no-build-cache \
                        --no-daemon \
                        --max-workers=${build.jobs}
build.env-append        GRADLE_USER_HOME=${gradle_home}

destroot.target         :distributions-full:install
destroot.destdir        --project-prop=gradle_installPath=${gradle_destdir}
destroot.args           --no-build-cache \
                        --no-daemon \
                        --max-workers=${build.jobs}
destroot.env-append     GRADLE_USER_HOME=${gradle_home}

post-destroot {
    set destbindir  ${destroot}${prefix}/bin
    set destdocdir  ${destroot}${prefix}/share/doc/${name}

    xinstall -d ${destbindir}
    delete ${gradle_destdir}/bin/gradle.bat
    ln -s ../share/${name}/bin/gradle ${destbindir}/${name}

    xinstall -d ${destdocdir}
    move \
        ${gradle_destdir}/NOTICE \
        ${gradle_destdir}/README \
        ${destdocdir}
}

livecheck.type          regex
livecheck.url           https://services.gradle.org/distributions
livecheck.regex         "gradle-(8(\\.\[0-9]+)*)-src"
