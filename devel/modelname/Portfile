# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           golang 1.0

go.setup            github.com/BoNour/modelname 0.2.0 v
go.offline_build    no
go.toolchain_min    1.23
revision            0

homepage            https://whizi.io/models/

description         \
    Parse AI model IDs into vendor, family, version and date

long_description    \
    modelname reads AI model IDs and display names such as \
    claude-opus-4-1-20250805, meta-llama/llama-3.3-70b-instruct:free or \
    \"Gemini 3.1 Pro Preview\" and prints their vendor, family, version, \
    size, date and tags. Old and new naming schemes land in the same family \
    so they sort correctly. It makes no network calls.

categories          devel textproc
installs_libs       no
license             MIT
maintainers         nomaintainer

checksums           rmd160  7db882f9e7730c3e3d5b9e8203b7deccc887b403 \
                    sha256  c95136957102fd78a1011aaf6946dfced50127d771eae098cbfc2b3b85857bad \
                    size    11205

build.pre_args-append \
                    -ldflags \"-X main.version=${version}\"
build.args-append   -o ${name} ./cmd/modelname

destroot {
    xinstall -m 0755 ${worksrcpath}/${name} ${destroot}${prefix}/bin/
    xinstall -d ${destroot}${prefix}/share/doc/${name}
    xinstall -m 0644 -W ${worksrcpath} LICENSE README.md \
        ${destroot}${prefix}/share/doc/${name}
}
