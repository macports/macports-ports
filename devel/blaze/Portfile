PortSystem          1.0
PortGroup           github 1.0
PortGroup           rust 1.0

github.setup        indexable-inc blaze 0.20261027.0 v
github.tarball_from archive
revision            0
categories          devel lang
platforms           {darwin >= 22}
license             {MIT Apache-2}
maintainers         {@wu21-web} openmaintainer

description         Incremental rust builds up to 92x faster than cargo/rustc
long_description    Blaze provides cargo build, test and run through a daemon \
                    that keeps a Rust workspace compiled and applies live edits. \
                    This port builds the default Cranelift backend from source.
homepage            https://ix.dev/blaze

supported_archs     arm64
universal_variant   no
macosx_deployment_target 13.0
configure.ccache    no

set rust_date       2026-10-27
set rust_target     aarch64-apple-darwin
set rust_archive    rust-nightly-${rust_target}
set rust_prefix     ${workpath}/bootstrap

master_sites-append https://static.rust-lang.org/dist/${rust_date}:bootstrap
distfiles-append    ${rust_archive}.tar.xz:bootstrap
dist_subdir         ${name}/${version}
extract.only        ${distname}${extract.suffix}
extract.rename      no
worksrcdir          ${github.project}-${version}

checksums           ${distname}${extract.suffix} \
                    rmd160  bedbd8156023f23fc6f25137e5eaf8dfae93c80b \
                    sha256  06d75f41fa8516778050dc95fd376b87e5a1be87da511fafa01e31294ecb87cf \
                    size    19086969 \
                    ${rust_archive}.tar.xz \
                    sha256  538d2a8c3f3f9d44ddd5ea706c5ce1535744ca292da8b4fea734547ad42603dd \
                    size    161364384

proc blaze_dependencies {} {
    depends_build-delete port:rust port:cargo
}
port::register_callback blaze_dependencies

configure {
    system -W ${workpath} "/usr/bin/tar -xf [shellescape ${distpath}/${rust_archive}.tar.xz]"
    system -W ${workpath}/${rust_archive} \
        "/bin/sh ./install.sh --prefix=[shellescape ${rust_prefix}] --components=rustc,cargo,rust-std-${rust_target} --disable-ldconfig"
}

cargo.bin           ${rust_prefix}/bin/cargo
build.cmd           ${cargo.bin}
build.target        {}
build.pre_args      build --release --frozen --offline
build.args          --package ra-jit --bins --target ${rust_target} -j${build.jobs}
build.env-append    CARGO_HOME=${cargo.home} \
                    CARGO_TARGET_DIR=${worksrcpath}/target \
                    RUSTC=${rust_prefix}/bin/rustc

destroot {
    foreach program {blaze cargo-blaze ra-jit cargo-ra-jit ra-jit-rustc ra-jit-rustc-first} {
        xinstall -m 0755 ${worksrcpath}/target/${rust_target}/release/${program} \
            ${destroot}${prefix}/bin
    }
    xinstall -d ${destroot}${prefix}/share/doc/${name}
    xinstall -m 0644 ${worksrcpath}/README.md ${worksrcpath}/LICENSE-MIT \
        ${worksrcpath}/LICENSE-APACHE ${destroot}${prefix}/share/doc/${name}
}

notes "Run blaze in a Rust project. Rust or rustup is not required."

