--- CMakeLists.txt.orig
+++ CMakeLists.txt
@@ -34,6 +34,8 @@
   project(clspv)
 endif()
 
+include(GNUInstallDirs)
+
 set(CMAKE_CXX_STANDARD 17)
 
 if (WIN32)
@@ -89,7 +91,11 @@
 endif()
 
 option(CLSPV_BUILD_SPIRV_DIS "Enable build of spirv-dis if the target does not exist" ON)
-if (NOT TARGET spirv-dis AND CLSPV_BUILD_SPIRV_DIS)
+option(CLSPV_USE_EXTERNAL_SPIRV_TOOLS "Use an installed SPIRV-Tools package" OFF)
+if(CLSPV_USE_EXTERNAL_SPIRV_TOOLS)
+  find_package(SPIRV-Tools CONFIG REQUIRED)
+  find_package(SPIRV-Tools-tools CONFIG REQUIRED)
+elseif (NOT TARGET spirv-dis AND CLSPV_BUILD_SPIRV_DIS)
   # First tell SPIR-V Tools where to find SPIR-V Headers
   set(SPIRV-Headers_SOURCE_DIR ${SPIRV_HEADERS_SOURCE_DIR})
 
--- cmake/CMakeLists.txt.orig
+++ cmake/CMakeLists.txt
@@ -45,7 +45,15 @@
 
 set(BAKE_FILE_INPUT_FILE ${DEFINE_CLSPV_BUILTINS_OUTPUT_FILE})
 set(BAKE_FILE_OUTPUT_FILE ${CLSPV_GENERATED_INCLUDES_DIR}/opencl_builtins_header.h)
-set(BAKE_FILE_BASE_HEADER_FILE ${CLANG_SOURCE_DIR}/lib/Headers/opencl-c-base.h)
+if(EXTERNAL_LLVM)
+  execute_process(
+    COMMAND ${CLSPV_LLVM_BINARY_DIR}/bin/clang -print-resource-dir
+    OUTPUT_VARIABLE CLSPV_CLANG_RESOURCE_DIR
+    OUTPUT_STRIP_TRAILING_WHITESPACE)
+  set(BAKE_FILE_BASE_HEADER_FILE ${CLSPV_CLANG_RESOURCE_DIR}/include/opencl-c-base.h)
+else()
+  set(BAKE_FILE_BASE_HEADER_FILE ${CLANG_SOURCE_DIR}/lib/Headers/opencl-c-base.h)
+endif()
 set(BAKE_FILE_DATA_VARIABLE_NAME clspv_builtins_header_data)
 set(BAKE_FILE_SIZE_VARIABLE_NAME clspv_builtins_header_size)
 set(BAKE_FILE_DATA_BASE_VARIABLE_NAME opencl_base_builtins_header_data)
--- lib/CMakeLists.txt.orig
+++ lib/CMakeLists.txt
@@ -140,7 +140,7 @@
   LLVMipo
 )
 
-if(${EXTERNAL_LLVM} EQUAL 1)
+if(EXTERNAL_LLVM)
   include(${CLSPV_LLVM_BINARY_DIR}/lib/cmake/llvm/LLVMConfig.cmake)
 
   llvm_map_components_to_libnames(CLSPV_LLVM_LINKS ${CLSPV_LLVM_COMPONENTS})
--- tools/reflection/CMakeLists.txt.orig
+++ tools/reflection/CMakeLists.txt
@@ -25,7 +25,11 @@
   ${SPIRV_HEADERS_INCLUDE_DIRS}
   ${SPIRV_TOOLS_SOURCE_DIR}/include)
 
-target_link_libraries(clspv-reflection PRIVATE clspv_core SPIRV-Tools-static)
+if(CLSPV_USE_EXTERNAL_SPIRV_TOOLS)
+  target_link_libraries(clspv-reflection PRIVATE clspv_core SPIRV-Tools)
+else()
+  target_link_libraries(clspv-reflection PRIVATE clspv_core SPIRV-Tools-static)
+endif()
 
 set_target_properties(clspv-reflection PROPERTIES RUNTIME_OUTPUT_DIRECTORY ${CLSPV_BINARY_DIR}/bin)
