PortSystem          1.0
PortGroup           boost 1.0
PortGroup           cmake 1.1
PortGroup           github 1.0
PortGroup           openssl 1.0

boost.version       1.81

github.setup        facebookarchive fbzmq 2022.05.30.00 v
revision            1
categories          devel net
license             MIT
maintainers         {@barracuda156 macos-powerpc.org:barracuda} openmaintainer

description         ${name} provides a framework for writing services in C++ \
                    while leveraging the awesomeness of libzmq (message passing semantics)
long_description    {*}${description}

checksums           rmd160  e97bdfbaef1f04fa155fd829755ce4fc88ec17a4 \
                    sha256  c9c70b3b656fdd0c1706a348ad1f09a1736b4121438c3f21cd8b04e0d8fad8a4 \
                    size    191974
github.tarball_from archive

post-extract {
    # Old one does not pass needed include path.
    delete -f ${worksrcpath}/build/fbcode_builder/CMake/FBThriftCppLibrary.cmake
    copy ${filespath}/FBThriftCppLibrary.cmake ${worksrcpath}/build/fbcode_builder/CMake/
    # https://github.com/facebook/fbthrift/issues/708
    copy ${filespath}/FindXxhash.cmake ${worksrcpath}/build/fbcode_builder/CMake/
}

patchfiles-append   folly-includes.patch

# Unstructured annotation `cpp.type` is not allowed. Use a structured annotation instead.
# Optional field cannot have custom default value: `value` (in `Response`).
patchfiles-append   fbthrift-annotations.patch

cmake.generator     Ninja

set libfmt_v        12
cmake.prefix_path-append \
                    ${prefix}/lib/libfmt${libfmt_v}/cmake

depends_lib-append  port:double-conversion \
                    port:fbthrift \
                    port:fizz \
                    port:folly \
                    port:gflags \
                    port:google-glog \
                    port:gtest \
                    port:libfmt${libfmt_v} \
                    port:libsodium \
                    port:wangle \
                    path:lib/libzmq.dylib:zmq \
                    port:zlib \
                    port:zstd

compiler.blacklist-append \
                    {clang < 1200}

compiler.cxx_standard   2017

if {[string match *clang* ${configure.compiler}]} {
    # SocketTest.cpp:204:19: error: lambda capture 'evb' is not used [-Werror,-Wunused-lambda-capture]
    configure.cxxflags-append \
                    -Wno-error=unused-lambda-capture
}

if {[string match *gcc* ${configure.compiler}]} {
    configure.ldflags-append \
                    -latomic
}
