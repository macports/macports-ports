From 3434818d2a2a28bcea0fe12d756ec4cbf0ea5fa5 Mon Sep 17 00:00:00 2001
From: Mateusz Majchrzycki <mateusz@edgeimpulse.com>
Date: Fri, 25 Sep 2026 13:39:48 +0200
Subject: [PATCH 1/2] Add support for Xcode SDK 27

---
 configure.ac | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/configure.ac b/configure.ac
index b3e282786..55e7270ad 100644
--- configure.ac
+++ configure.ac
@@ -560,6 +560,7 @@ case "${host_os}" in
       AC_DEFINE([SDK_14_0], 140000, [SDK_VERS value for Xcode SDK macOS 14.0 / iOS 17])
       AC_DEFINE([SDK_15_0], 150000, [SDK_VERS value for Xcode SDK macOS 15.0 / iOS 18])
       AC_DEFINE([SDK_26_0], 260000, [SDK_VERS value for Xcode SDK macOS / iOS 26])
+      AC_DEFINE([SDK_27_0], 270000, [SDK_VERS value for Xcode SDK macOS / iOS 26.6])
 
       # Substitute the Xcode include path detected earlier
       AC_SUBST(SDK_INC_DIR, [$xcodedir_inc])
@@ -740,6 +741,9 @@ case "${host_os}" in
         *-26.*)
           AC_DEFINE([SDK_VERS], SDK_26_0, [SDK version])
           ;;
+        *-27.*)
+          AC_DEFINE([SDK_VERS], SDK_27_0, [SDK version])
+          ;;
         legacy)
           AC_DEFINE([SDK_VERS], SDK_10_XX, [SDK version])
           ;;

From cf288f6e10bab8302ee69dd09afd01fa62e349f4 Mon Sep 17 00:00:00 2001
From: Mateusz Majchrzycki <mateusz@edgeimpulse.com>
Date: Fri, 25 Sep 2026 13:40:08 +0200
Subject: [PATCH 2/2] Fix linker error

---
 coregrind/link_tool_exe_darwin.in | 18 +++++++++++++++---
 1 file changed, 15 insertions(+), 3 deletions(-)

diff --git a/coregrind/link_tool_exe_darwin.in b/coregrind/link_tool_exe_darwin.in
index 9f573121d..9fd9eee68 100644
--- coregrind/link_tool_exe_darwin.in
+++ coregrind/link_tool_exe_darwin.in
@@ -154,6 +154,16 @@ my $cmd = "/usr/bin/ld";
 if ($archstr eq "arm64") {
     $cmd = "$cmd -Z -L../coregrind -lmySystem -lmydyld";
     $cmd = "$cmd -segaddr __TEXT $ala";
+    # macOS 26's linker forces PIE and no longer honours -image_base, which
+    # otherwise would have kept __DATA_CONST/__DATA contiguous with __TEXT.
+    # Without explicit addresses those segments fall back to the default PIE
+    # base (below __TEXT) and the linker rejects them as "out of order".
+    if (@DARWIN_VERS@ >= 260000) {
+        my $data_const_ala = (Math::BigInt->new($ala) + Math::BigInt->new("0x10000000"))->as_hex();
+        my $data_ala        = (Math::BigInt->new($ala) + Math::BigInt->new("0x20000000"))->as_hex();
+        $cmd = "$cmd -segaddr __DATA_CONST $data_const_ala";
+        $cmd = "$cmd -segaddr __DATA $data_ala";
+    }
     # we add roughly ~30 bytes when using install_name_tool so we pad the header by 256 bytes to be safe
     $cmd = "$cmd -headerpad 256";
 } else {
@@ -161,9 +171,11 @@ if ($archstr eq "arm64") {
     $cmd = "$cmd -image_base $ala";
 }
 
-# Xcode 16 is completely borked and crashes when you use -segaddr so we rollback to
-# the old linker in the meantime
-if (@DARWIN_VERS@ >= 140000) {
+# Xcode 16 through 25 are completely borked and crash when you use -segaddr so
+# we rollback to the old linker in the meantime. Xcode 26+ removed
+# -ld_classic entirely (it's silently ignored), so there's nothing to roll
+# back to there; we instead work around the new linker above.
+if (@DARWIN_VERS@ >= 140000 && @DARWIN_VERS@ < 260000) {
     $cmd = "$cmd -ld_classic";
 
 # If we're building with clang (viz, the C compiler as specified
