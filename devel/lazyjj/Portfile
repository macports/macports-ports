github.setup        Cretezy lazyjj 0.6.1 v
github.tarball_from archive
revision            0

description         TUI for the Jujutsu (jj) version control system

long_description    lazyjj is a terminal user interface for Jujutsu (jj), \
                    built in Rust with Ratatui. It drives the jj command \
                    line tool to browse the log, inspect changes and \
                    files, and manage bookmarks.

categories          devel
installs_libs       no
license             Apache-2
maintainers         {gmail.com:herby.gillot @herbygillot} \
                    openmaintainer

depends_run         port:jujutsu

