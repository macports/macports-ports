# The tools find their XGo root, which holds the packages XGo programs
# build against, as the directory above their bin; install the tree.
set xgo_root        ${prefix}/libexec/${name}

post-extract {
    # make.go reads the version from git or a VERSION file, which the
    # release tarball no longer has
    set fd [open ${worksrcpath}/VERSION w]
    puts ${fd} v${version}
    close ${fd}
}

build.cmd           ${go.bin} run cmd/make.go --build
build.pre_args      {}
build.args          {}
build.env-append    GOPROOT_FINAL=${xgo_root}

destroot {
    xinstall -d ${destroot}${xgo_root}
    foreach f [glob -directory ${worksrcpath} *] {
        copy ${f} ${destroot}${xgo_root}/
    }
    foreach tool {xgo hdq} {
        ln -s ${xgo_root}/bin/${tool} ${destroot}${prefix}/bin/${tool}
    }
    # gop is the command's former name
    ln -s ${xgo_root}/bin/xgo ${destroot}${prefix}/bin/gop
}

github.livecheck.regex {([0-9.]+)}
