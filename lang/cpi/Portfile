                    size    22014

use_xcode           yes

# cpi.pro asks for CONFIG c++20, which Qt 5's qmake doesn't know; c++2a is
# its name for the same standard, which 2.2's code needs.
compiler.cxx_standard 2020
configure.args-append CONFIG+=c++2a

post-configure {
    reinplace "s|/usr/local|${prefix}|g" ${worksrcpath}/Makefile
}
