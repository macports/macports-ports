# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:filetype=tcl:et:sw=4:ts=4:sts=4

PortSystem              1.0
PortGroup               github 1.0
PortGroup               java 1.0

github.setup            mozilla rhino 1.9.1 Rhino _Release
github.tarball_from     archive
livecheck.version       [string map {. _} ${version}]
git.branch              [join ${github.tag_prefix}]${livecheck.version}[join ${github.tag_suffix}]

categories              lang java devel
license                 MPL-2
platforms               any
supported_archs         noarch
homepage                https://rhino.github.io
maintainers             {sethm.id.au:dev @McDaMastR} \
                        openmaintainer

description             Mozilla JavaScript engine for Java
long_description        Rhino is an open source implementation of JavaScript \
                        written entirely in Java.  It is typically embedded \
                        into Java applications to provide scripting to end \
                        users.

depends_build-append    bin:gradle:gradle \
                        bin:gzip:gzip

# Building requires 21 >= Java >= 17
# Running requires Java >= 11
java.version            17-21

set gradle_home         ${workpath}/.home/.gradle

checksums               rmd160  44dcce2093f1f51a8eba4dd51758827442a8f66b \
                        sha256  fd909b819b18e849f2788e32ad29216adb3075427bf50c0f8d647b9a49c1e092 \
                        size    10666729

patchfiles              skip-test262.diff

use_configure           no

build.cmd               gradle
build.target            build
build.args              --no-daemon \
                        --exclude-task=check \
                        --gradle-user-home="${gradle_home}" \
                        --max-workers=${build.jobs}

post-build {
    system -W ${worksrcpath}/man "gzip rhino.1"
}

test.run                yes
test.target             check
test.args               --no-daemon \
                        --gradle-user-home="${gradle_home}" \
                        --max-workers=${build.jobs}

destroot {
    set destbindir  ${destroot}${prefix}/bin
    set destdocdir  ${destroot}${prefix}/share/doc/${name}
    set destjavadir ${destroot}${prefix}/share/java
    set destmandir  ${destroot}${prefix}/share/man

    set modules {
        rhino
        rhino-all
        rhino-engine
        rhino-kotlin
        rhino-tools
        rhino-xml
    }

    xinstall -d ${destbindir}
    xinstall ${filespath}/${name} ${destbindir}
    reinplace "s|@@PREFIX@@|${prefix}|g" ${destbindir}/${name}

    xinstall -d ${destjavadir}
    foreach module ${modules} {
        xinstall -m 644 \
            ${worksrcpath}/${module}/build/libs/${module}-${version}.jar \
            ${destjavadir}/${module}.jar
    }

    xinstall -d ${destdocdir}
    xinstall -m 644 \
        ${worksrcpath}/CODE_OF_CONDUCT.md \
        ${worksrcpath}/LICENSE.txt \
        ${worksrcpath}/NOTICE-tools.txt \
        ${worksrcpath}/NOTICE.txt \
        ${worksrcpath}/PGP_KEYS.txt \
        ${worksrcpath}/README.md \
        ${worksrcpath}/RELEASE-NOTES.md \
        ${worksrcpath}/RELEASE-STEPS.md \
        ${worksrcpath}/SECURITY.md \
        ${worksrcpath}/USAGE.md \
        ${destdocdir}

    if {[variant_isset doc]} {
        xinstall -d ${destdocdir}/javadoc
        foreach module ${modules} {
            if {[file exists ${worksrcpath}/${module}/build/docs/javadoc]} {
                copy \
                    ${worksrcpath}/${module}/build/docs/javadoc \
                    ${destdocdir}/javadoc/${module}
            }
        }
    }

    xinstall -d ${destmandir}/man1
    xinstall -m 444 ${worksrcpath}/man/rhino.1.gz ${destmandir}/man1
}

variant doc \
        description {Install javadoc} {
    build.target-append javadoc
}
