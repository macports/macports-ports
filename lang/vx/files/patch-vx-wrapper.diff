--- macports/vx-wrapper.in.orig
+++ macports/vx-wrapper.in
@@ -0,0 +1,26 @@
+#!/bin/sh
+# Points the Vx toolchain at MacPorts' LLVM @LLVM_VERSION@, then runs the real @TOOL@.
+set -eu
+
+VX_LLVM_BIN="@PREFIX@/libexec/llvm-@LLVM_VERSION@/bin"
+VX_PREFIX="@PREFIX@/libexec/vx"
+
+PATH="${VX_LLVM_BIN}:@PREFIX@/bin:${PATH}"
+export PATH
+export LLVM_CONFIG_PATH="${LLVM_CONFIG_PATH:-${VX_LLVM_BIN}/llvm-config}"
+export MLIR_TRANSLATE_PATH="${MLIR_TRANSLATE_PATH:-${VX_LLVM_BIN}/mlir-translate}"
+export OPT_PATH="${OPT_PATH:-${VX_LLVM_BIN}/opt}"
+export LLC_PATH="${LLC_PATH:-${VX_LLVM_BIN}/llc}"
+export CLANG_PATH="${CLANG_PATH:-${VX_LLVM_BIN}/clang}"
+# MacPorts' clang has no default sysroot; without one, programs vxc links cannot find SDK libraries.
+if [ -z "${SDKROOT:-}" ]; then
+    SDKROOT=$(/usr/bin/xcrun --show-sdk-path 2>/dev/null || true)
+    export SDKROOT
+fi
+export VX_DISPATCH_LIB="${VX_DISPATCH_LIB:-${VX_PREFIX}/lib/libvx_npu_dispatch.dylib}"
+export VX_MLIR_SHIMS="${VX_MLIR_SHIMS:-${VX_PREFIX}/lib/libvx_mlir_shims.dylib}"
+if [ -d "${VX_PREFIX}/share/ane-primitives" ]; then
+    export VX_ANE_MODEL_DIR="${VX_ANE_MODEL_DIR:-${VX_PREFIX}/share/ane-primitives}"
+fi
+
+exec "${VX_PREFIX}/bin/@TOOL@" "$@"
