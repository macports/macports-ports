# macOS stage3: add link support for the system libc++.
# https://github.com/ziglang/zig/pull/23264
#
# The macOS 27 SDK's math.h leaves INFINITY and NAN to the compiler's float.h,
# which this release's bundled clang headers do not provide, so libc++ fails to
# compile. Backport from lang/zig-bootstrap.
# https://github.com/llvm/llvm-project/pull/164348
patchfiles-append   patch-macos-libc++-dynamic-link.diff \
                    patch-zig-infinity-nan.diff
