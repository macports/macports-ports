From 80672b2e4b50251a450ab516c9d5b20de321cabe Mon Sep 17 00:00:00 2001
From: Mark Mentovai <mark@mentovai.com>
Date: Wed, 30 Sep 2026 12:42:59 -0400
Subject: [PATCH] Get LLVM from MacPorts for JIT builds

---
 Tools/jit/_llvm.py | 4 ++++
 1 file changed, 4 insertions(+)

diff --git Tools/jit/_llvm.py Tools/jit/_llvm.py
index 96cf5fc47147..046007f59813 100644
--- Tools/jit/_llvm.py
+++ Tools/jit/_llvm.py
@@ -94,6 +94,10 @@ async def _find_tool(
         path = os.path.join(llvm_tools_install_dir, "bin", tool)
         if await _check_tool_version(path, llvm_version, echo=echo):
             return path
+    # Versioned MacPorts-installed executables:
+    path = f"{tool}-mp-{llvm_version}"
+    if await _check_tool_version(path, llvm_version, echo=echo):
+        return path
     # Unversioned executables:
     path = tool
     if await _check_tool_version(path, llvm_version, echo=echo):
-- 
