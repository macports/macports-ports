post-extract {
    foreach {sub_author sub_project sub_commit sub_dir} ${submodules} {
        delete ${worksrcpath}/external/${sub_dir}
        move ${workpath}/${sub_project}-${sub_commit} ${worksrcpath}/external/${sub_dir}
    }
}

# S-Lang (slang, slang2) owns include/slang.h; skip the ~24k-file docs tree
patchfiles         patch-install-dirs.diff \
                    macports-smoke-test.patch

depends_build-append \
                    path:bin/pkg-config:pkgconfig \
                    port:spirv-headers \
                    port:vulkan-headers

depends_lib-append  port:glslang \
                    port:lz4 \
                    port:spirv-tools

compiler.cxx_standard 2020

cmake.build_type    Release

configure.args-append \
                    -DCMAKE_INSTALL_INCLUDEDIR=include/${name} \
                    -DSLANG_VERSION_NUMERIC=${version} \
                    -DSLANG_VERSION_FULL=v${version} \
                    -DSLANG_ENABLE_AFTERMATH=OFF \
                    -DSLANG_ENABLE_CUDA=OFF \
                    -DSLANG_ENABLE_DXIL=OFF \
                    -DSLANG_ENABLE_EXAMPLES=OFF \
                    -DSLANG_ENABLE_GFX=OFF \
                    -DSLANG_ENABLE_OPTIX=OFF \
                    -DSLANG_ENABLE_RELEASE_DEBUG_INFO=OFF \
                    -DSLANG_ENABLE_REPLAYER=OFF \
                    -DSLANG_ENABLE_SLANG_PROXY=OFF \
                    -DSLANG_ENABLE_SLANG_RHI=OFF \
                    -DSLANG_ENABLE_SPLIT_DEBUG_INFO=OFF \
                    -DSLANG_ENABLE_TESTS=OFF \
                    -DSLANG_EXCLUDE_DAWN=ON \
                    -DSLANG_EXCLUDE_TINT=ON \
                    -DSLANG_INSTALL_USER_SKILLS=OFF \
                    -DSLANG_SLANG_LLVM_FLAVOR=DISABLE \
                    -DSLANG_USE_SYSTEM_GLSLANG=ON \
                    -DSLANG_USE_SYSTEM_LZ4=ON \
                    -DSLANG_USE_SYSTEM_SPIRV_HEADERS=ON \
                    -DSLANG_USE_SYSTEM_SPIRV_TOOLS=ON \
                    -DSLANG_USE_SYSTEM_VULKAN_HEADERS=ON

post-destroot {
    xinstall -d ${destroot}${prefix}/share/doc/${name}
    xinstall -m 0644 -W ${worksrcpath} LICENSE README.md ${destroot}${prefix}/share/doc/${name}
}

test.run            yes
test {
    set slangc ${cmake.build_dir}/Release/bin/slangc
    set smoke ${worksrcpath}/macports-smoke-test
    foreach {target out} {spirv hello.spv spirv-asm hello.spvasm glsl hello.glsl} {
        system -W ${smoke} "${slangc} hello.slang -target ${target} -profile glsl_450 -entry computeMain -o ${out}"
    }
    system -W ${smoke} "grep -q OpEntryPoint hello.spvasm && grep -q 'void main' hello.glsl"
}
