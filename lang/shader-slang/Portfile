categories          lang graphics
# Apache-2 WITH LLVM-exception; slang-crypto Unlicense; cmark BSD; miniz, unordered_dense MIT
license             Apache-2 public-domain BSD MIT
maintainers         {gmail.com:herby.gillot @herbygillot} openmaintainer

description         Slang shading language compiler
long_description    Slang is a shading language and compiler for building \
                    large, modular shader codebases. Its compiler, slangc, \
                    generates code for SPIR-V, GLSL, HLSL, Metal, WGSL, CUDA \
                    and C++ targets from a single Slang source.

homepage            https://shader-slang.com

worksrcdir          ${github.project}-${version}

