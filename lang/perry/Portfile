                    size    246497814

# Perry generates code through inkwell, which links LLVM 22 by way
# of llvm-sys 221.
set llvm_version    22
# llvm-sys links LLVM's system libraries into perry directly.
depends_lib-append  port:libffi \
                    port:libiconv \
                    port:libxml2 \
                    port:llvm-${llvm_version} \
                    port:zlib
build.env-append    LLVM_SYS_${llvm_version}1_PREFIX=${prefix}/libexec/llvm-${llvm_version}

# Since 0.5.1665 perry builds with a pinned nightly: perry-runtime uses
# unstable features, and .cargo/config.toml passes -Z use-sync-unwind and
# rebuilds std from source (build-std). RUSTC_BOOTSTRAP=1 unlocks these on
# MacPorts' stable rustc, as devel/bun does, and rust-src supplies the
# library sources. cargo.crates includes the crates std itself depends on
# (from rust-src's library/Cargo.lock), which build-std vendors offline.
depends_build-append \
                    port:rust-src
build.env-append    RUSTC_BOOTSTRAP=1

# libz-ng-sys builds zlib-ng with cmake. perry-runtime compiles an LLVM IR
# file (perry_trap.ll) with opaque pointers, which older Xcode clang (e.g.
# on macOS 12) rejects; use the clang matching the LLVM perry links.
depends_build-append \
                    port:cmake \
                    port:clang-${llvm_version}
build.env-append    PERRY_TRAP_CLANG=${prefix}/bin/clang-mp-${llvm_version}

# The runtime and stdlib archives perry links programs against come from
# their -static wrapper crates.
build.args-append   --package ${name} \
                    --package ${name}-runtime-static \
                    --package ${name}-stdlib-static

destroot {
    xinstall -m 0755 \
        ${worksrcpath}/target/[cargo.rust_platform]/release/${name} \
        ${destroot}${prefix}/bin/

    xinstall -m 0644 \
        ${worksrcpath}/target/[cargo.rust_platform]/release/lib${name}_runtime.a \
        ${worksrcpath}/target/[cargo.rust_platform]/release/lib${name}_stdlib.a \
        ${destroot}${prefix}/lib/
}

notes               "Perry invokes clang when compiling TypeScript. The \
                    Xcode command line tools provide /usr/bin/clang; to use \
                    a MacPorts LLVM toolchain instead, set PERRY_LLVM_CLANG \
                    to the desired clang executable."

github.livecheck.regex \
                    {([0-9.]+)}

