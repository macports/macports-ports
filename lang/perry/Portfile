description         Native TypeScript compiler written in Rust
long_description    Perry compiles TypeScript directly to native \
                    executables using SWC and LLVM, without requiring \
                    Node.js, Electron, or a browser engine at runtime.

checksums           ${distname}${extract.suffix} \
                    rmd160  d11d63ff15414c7e40158e08894c4b795253850e \
