# wasmer's arm64 unwinder needs __unw_add_find_dynamic_unwind_sections, new in macOS 14
if {${os.platform} eq "darwin" && ${os.major} < 23 && ${build_arch} eq "arm64"} {
    known_fail          yes
    pre-fetch {
        ui_error "${name} @${version} requires macOS 14 or later on Apple silicon."
        return -code error "incompatible macOS version"
    }
}

checksums           ${distname}${extract.suffix} \
                    rmd160  6a939b1f52ed3bb0c5aecb3651a61cf3fa7683b3 \
