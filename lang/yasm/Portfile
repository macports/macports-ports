PortSystem              1.0

name                    yasm
version                 1.3.0
revision                1

categories              lang
# bitvect is "triple-licensed" under Artistic 1.0, GPL 2.0, and LGPL 2.0.
# Everything else is licensed under BSD 2-clause or BSD 3-clause.
license                 {Artistic-1 GPL-2 LGPL-2} BSD
homepage                https://github.com/yasm/yasm
maintainers             {sethm.id.au:dev @McDaMastR} \
                        openmaintainer

description             A modular reimplementation of NASM
long_description        Yasm is a complete rewrite of the NASM assembler. \
                        Yasm currently supports the x86 and AMD64 instruction \
                        sets, accepts NASM and GAS assembler syntaxes, outputs \
                        binary, ELF32, ELF64, 32 and 64-bit Mach-O, RDOFF2, \
                        COFF, Win32, and Win64 object formats, and generates \
                        source debugging information in STABS, DWARF 2, and \
                        CodeView 8 formats.

depends_lib-append      port:gettext-runtime

master_sites            https://www.tortall.net/projects/yasm/releases

checksums               rmd160  9d9d40aa8cf5a20617564085f581b14ab1a553b4 \
                        sha256  3dce6601b495f5b3d45b59f7d2492a340ee7e84b5beca17e48f862502bd5603f \
                        size    1492156

configure.args-append   --enable-nls \
                        --enable-python \
                        --disable-python-bindings \
                        --disable-silent-rules

test.run                yes
test.target             check

livecheck.type          regex
livecheck.url           https://www.tortall.net/projects/yasm/releases
livecheck.regex         "${name}-(\[0-9]+(\\.\[0-9]+)*)\\.tar\\.gz"
