checksums           rmd160  6037c6326f751b9ebd86b0e1f0e4e857202f2005 \
                    sha256  6cbeb83294434e636a0c78760f1a6dfe3e50c1bab0cffa154603ce73e70508f1 \
                    size    821847

# vulkaninfo allocates the pLayeredApis array (VkPhysicalDeviceLayeredApiPropertiesKHR)
# and hands it to vkGetPhysicalDeviceProperties2 without initialising the sType of each
# element, so any run with VK_LAYER_KHRONOS_validation enabled reports, once per physical
# device:
#
#   pProperties->pNext<VkPhysicalDeviceLayeredApiPropertiesListKHR>.pLayeredApis[0].sType
#       must be VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_LAYERED_API_PROPERTIES_KHR
#
# i.e. VUID-VkPhysicalDeviceLayeredApiPropertiesKHR-sType-sType. The build compiles the
# checked-in vulkaninfo/generated/vulkaninfo.hpp: TOOLS_CODEGEN is off by default and its
# target is not part of the default build, so the patch belongs there. The generator that
# produces that file, scripts/generators/vulkaninfo_generator.py, has the same omission.
patchfiles-append   patch-vulkaninfo-layered-api-sType.diff

cmake.build_type    Release

set py_ver          3.14
set py_ver_nodot    [string map {. {}} ${py_ver}]
foreach stage {configure build destroot test} {
    ${stage}.env-append PATH=${frameworks_dir}/Python.framework/Versions/${py_ver}/bin:$env(PATH)
}
depends_build-append port:python${py_ver_nodot}

# TODO: cube, icd
configure.args-append \
                    -DBUILD_CUBE=OFF \
                    -DBUILD_ICD=OFF \
                    -DDTOOLS_VULKANINFO=ON \
                    -DDTOOLS_CODEGEN=ON \
                    -DVULKAN_LOADER_INSTALL_DIR=${prefix}
