# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem              1.0
PortGroup               github 1.0
PortGroup               legacysupport 1.1
PortGroup               meson 1.0

github.setup            artemsen swayimg 5.7 v
revision                0
categories              graphics wayland
license                 MIT
maintainers             {@barracuda156 macos-powerpc.org:barracuda} openmaintainer
description             Image viewer for Wayland
long_description        {*}${description}

checksums               rmd160  478f2b6e0c2bf84db4200c455c754f5fd5925c1e \
                        sha256  22e602cba022972ccc6e9701827135282679a5a8efc818132fdf56ce40a7d6fa \
                        size    1043452
github.tarball_from     archive

set py_ver              3.14
set py_ver_nodot        [string map {. {}} ${py_ver}]

# The build picks arbitrary giflib, but the code requires at least giflib5.
patchfiles-append       patch-meson-add-a-giflib-option-to-select-the-giflib.diff
# Fix colors on BE:
patchfiles-append       patch-Use-host-order-pixel-words-on-big-endian-machines.diff
# Fix for Apple:
patchfiles-append       patch-st_mtim.diff \
                        patch-ui-provide-a-pipe2-replacement-for-Darwin.diff
# Compile with either C++ ABI:
patchfiles-append       patch-imageformat.hpp.diff

configure.python        ${prefix}/bin/python${py_ver}

meson.native.binaries   python3=${configure.python}

depends_build-append    path:bin/pkg-config:pkgconfig \
                        port:python${py_ver_nodot} \
                        port:wayland-protocols

depends_lib-append      port:epoll-shim \
                        port:exiv2 \
                        path:lib/pkgconfig/fontconfig.pc:fontconfig \
                        path:lib/pkgconfig/freetype2.pc:freetype \
                        port:giflib6 \
                        port:libavif \
                        port:libheif \
                        path:include/turbojpeg.h:libjpeg-turbo \
                        port:libjxl \
                        port:libpixman \
                        port:libpng \
                        port:libraw \
                        port:libsixel \
                        port:libxkbcommon \
                        port:lua \
                        port:openexr \
                        port:openjpeg \
                        port:tiff \
                        port:wayland \
                        port:webp

depends_run-append      port:desktop-file-utils

platform darwin {
    depends_run-append  port:owl
}

# O_CLOEXEC, to_chars for libc++
legacysupport.newest_darwin_requires_legacy \
                        21
legacysupport.use_mp_libcxx yes
legacysupport.redirect_bins ${name}

compiler.cxx_standard   2020

configure.args-append   -Davif=enabled \
                        -Dcompositor=disabled \
                        -Ddesktop=true \
                        -Ddoc=false \
                        -Ddrm=disabled \
                        -Dexif=enabled \
                        -Dexr=enabled \
                        -Dgif=enabled \
                        -Dgiflib=${prefix}/libexec/giflib6 \
                        -Dheif=enabled \
                        -Djp2=enabled \
                        -Djpeg=enabled \
                        -Djxl=enabled \
                        -Dliblua=lua \
                        -Dpng=enabled \
                        -Draw=enabled \
                        -Dsixel=enabled \
                        -Dsvg=disabled \
                        -Dtests=disabled \
                        -Dtiff=enabled \
                        -Dwayland=enabled \
                        -Dwebp=enabled

variant rsvg description "Enable svg support via librsvg" {
    depends_lib-append  path:lib/pkgconfig/librsvg-2.0.pc:librsvg
    configure.args-replace \
                        -Dsvg=disabled -Dsvg=enabled
}

post-activate {
    system "${prefix}/bin/update-desktop-database ${prefix}/share/applications"
}
