Wait for uic before compiling both users of QuarterViewer.h. The dependency
on directui.cpp alone allows a parallel build to compile these files before
ui_QuarterViewer.h exists.

--- src/examples/Makefile.in.orig
+++ src/examples/Makefile.in
@@ -1140,3 +1140,5 @@
 directui.cpp: ui_QuarterViewer.h

+inheritui-inheritui.$(OBJEXT) inheritui-QuarterViewer.$(OBJEXT): ui_QuarterViewer.h
+
 ui_QuarterViewer.h: $(srcdir)/QuarterViewer.ui
