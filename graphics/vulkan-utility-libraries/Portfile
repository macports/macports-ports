PortSystem          1.0
PortGroup           github 1.0
PortGroup           cmake 1.1

github.setup        KhronosGroup Vulkan-Utility-Libraries 1.4.363.0 vulkan-sdk-
github.tarball_from archive
name                vulkan-utility-libraries
# 1: dropping 'noarch' below changes which binary archive can satisfy this port.
revision            1

categories          graphics
license             Apache-2
platforms           any
maintainers         {judaew @judaew} openmaintainer

description         Utility libraries for Vulkan developers
long_description    {*}${description}
homepage            https://vulkan.lunarg.com

checksums           rmd160  546acc189cef466e0298e0d27323780eacee0ed8 \
                    sha256  a5308b62e3bac84cf45c4d7dd5b830aabace4847fdb71f4fd7db3be034c2bebf \
                    size    1346915

# These are static archives of compiled objects, not headers. Tagged 'supported_archs
# noarch', the port was built once on an arm64 host and that archive was then served to
# x86_64 clients, where linking the validation layer fails with
#
#   ignoring file '.../libVulkanSafeStruct.a(...)': found architecture 'arm64',
#   required architecture 'x86_64'
#   Undefined symbols for architecture x86_64: vkuGetLayerSettingValue(...)
#
# Leaving supported_archs at its default makes the port build and cache per architecture.

cmake.build_type    Release

depends_build-append       port:vulkan-headers

set py_ver          3.14
set py_ver_nodot    [string map {. {}} ${py_ver}]
foreach stage {configure build destroot test} {
    ${stage}.env-append PATH=${frameworks_dir}/Python.framework/Versions/${py_ver}/bin:$env(PATH)
}
depends_build-append port:python${py_ver_nodot}
