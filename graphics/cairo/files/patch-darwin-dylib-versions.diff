#==================================================================================================
# Simple patch to tweak Cairo's dylib compatibility version. Upstream sets it to 1.0, which
# breaks backward ABI compatibility. We use the value from Cairo's old autotools build scripts,
# 11709.0.0.
#
# Author: Christopher Nielsen @ MacPorts
#==================================================================================================
--- meson.build.orig	2026-11-09 09:51:22.000000000 -0500
+++ meson.build	2026-11-09 09:50:45.000000000 -0500
@@ -35,10 +35,14 @@
   cairo_libversion = '@0@.@1@.@2@'.format(cairo_version_sonum, cairo_version, cairo_version_micro)
 endif
 
+# ABI compatibility version should be that used for 1.17.x
+cairo_version_compat = 11709
+cairo_dylib_ver_compat = '@0@.0.0'.format(cairo_version_compat)
+
 # Use a stable compatibility version for Darwin dylibs so cairo is suitable for distribution as a
 # system library.  The compatibility version is pinned at 1.0 while the current version tracks the
 # release, keeping clients from needing to relink on every release.
-cairo_darwin_versions = ['1.0', '@0@.@1@.@2@'.format(cairo_version_major, cairo_version_minor, cairo_version_micro)]
+cairo_darwin_versions = [cairo_dylib_ver_compat, '@0@.@1@.@2@'.format(cairo_version_major, cairo_version_minor, cairo_version_micro)]
 
 conf = configuration_data()
 
