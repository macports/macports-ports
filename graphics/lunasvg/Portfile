categories          graphics
license             MIT
maintainers         {@herbygillot gmail.com:herby.gillot} openmaintainer

description         SVG rendering and manipulation library in C++
long_description    LunaSVG is a lightweight, portable C++ library for rendering \
                    and manipulating Scalable Vector Graphics (SVG) documents.

checksums           rmd160  a6b1b986e59e5ff1237e5c583275593ec5476855 \
                    sha256  1abf1472ee6c4d19797916e8cc3c2e4b628e0d81178ffac60bdb0d457e32c690 \
                    size    294493

compiler.cxx_standard 2017

depends_lib-append   port:plutovg

configure.args-append \
                    -DBUILD_SHARED_LIBS=ON \
                    -DLUNASVG_BUILD_EXAMPLES=OFF \
                    -DUSE_SYSTEM_PLUTOVG=ON

# Use macports-libcxx on macOS <= 10.12
# svglayoutstate.cpp:28:18: error: 'value' is unavailable: introduced in macOS 10.13
legacysupport.use_mp_libcxx \
                    yes

post-destroot {
    set docdir ${destroot}${prefix}/share/doc/${name}
    xinstall -d ${docdir}
    xinstall -m 0644 -W ${worksrcpath} LICENSE README.md ${docdir}
}
