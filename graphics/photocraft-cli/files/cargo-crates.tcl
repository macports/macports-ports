proc photocraft::complete_crate_checksums {} {
    variable crate_checksums
    set complete_checksums [option checksums]
    foreach {crate_file crate_rmd160 crate_size} ${crate_checksums} {
        set checksum_index [lsearch -exact ${complete_checksums} ${crate_file}]
        if {${checksum_index} < 0} {
            return -code error "Missing Cargo checksum entry for ${crate_file}"
        }
        set complete_checksums [linsert ${complete_checksums} [expr {${checksum_index} + 1}] \
            rmd160 ${crate_rmd160} size ${crate_size}]
    }
    checksums {*}${complete_checksums}
}
port::register_callback photocraft::complete_crate_checksums
