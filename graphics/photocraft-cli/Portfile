PortSystem          1.0
PortGroup           github 1.0
PortGroup           cargo 1.0

name                photocraft-cli
github.setup        storytold photocraft 0.9.0 v
github.tarball_from archive
revision            0
categories          graphics
platforms           {darwin >= 20}
supported_archs     arm64 x86_64
installs_libs       no
license             {MIT Apache-2} OFL-1.1
maintainers         @wu21-web openmaintainer

description         Headless image editing and automation with PhotoCraft
long_description    PhotoCraft's command-line interface converts and inspects \
                    layered images, runs image-editing commands and batch \
                    actions, and provides an MCP server for automation. It \
                    supports PSD, PSB, the native .pcraft format, and flat image \
                    formats, including HEIC and HEIF decoding.

