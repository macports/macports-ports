post-patch {
    reinplace "s|git = \"https://github.com/storytold/craft-libs\", rev = \"${craft_print_rev}\"|path = \"${workpath}/craft-libs-${craft_print_rev}/crates/print\"|" \
        ${worksrcpath}/Cargo.toml
    reinplace "s|git = \"https://github.com/storytold/craft-libs\", rev = \"${craft_ui_rev}\"|path = \"${workpath}/craft-libs-${craft_ui_rev}/crates/ui\"|" \
        ${worksrcpath}/Cargo.toml
    reinplace "s|git = \"https://github.com/storytold/winprint.rs\", rev = \"${craft_gdi_rev}\"|path = \"${workpath}/winprint.rs-${craft_gdi_rev}/crates/gdi\"|" \
        ${workpath}/craft-libs-${craft_print_rev}/crates/print/Cargo.toml
    reinplace "s|git = \"https://github.com/storytold/winprint.rs\", rev = \"${winprint_rev}\"|path = \"${workpath}/winprint.rs-${winprint_rev}\"|" \
        ${workpath}/craft-libs-${craft_print_rev}/crates/print/Cargo.toml
}

cargo.offline_cmd   --offline

build.args-append   --package photocraft-cli \
                    --bin photocraft-cli \
                    --features heif

build.env-append    CRAFT_FONTS_DIR=

test.run            yes
test {
    set cli ${worksrcpath}/target/[cargo.rust_platform]/release/${name}
    system "[shellescape ${cli}] --version"
    system "[shellescape ${cli}] commands --json --filter blur"
}

destroot {
    xinstall -m 0755 \
        ${worksrcpath}/target/[cargo.rust_platform]/release/${name} \
        ${destroot}${prefix}/bin/

    set docdir ${destroot}${prefix}/share/doc/${name}
    xinstall -d ${docdir}
    xinstall -m 0644 ${worksrcpath}/LICENSE-MIT \
        ${worksrcpath}/LICENSE-APACHE \
        ${worksrcpath}/NOTICE \
        ${worksrcpath}/ATTRIBUTION.md \
        ${worksrcpath}/book/src/automation/cli.md \
        ${worksrcpath}/assets/fonts/OFL-Inter.txt \
        ${worksrcpath}/assets/fonts/OFL-JetBrainsMono.txt \
        ${worksrcpath}/assets/dict/LICENSE-SCOWL.txt \
        ${docdir}
}

source              ${filespath}/cargo-crates.tcl
