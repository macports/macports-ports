# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           cmake 1.1
PortGroup           boost 1.0
PortGroup           active_variants 1.1
PortGroup           python_variants 1.0

# Inkscape development branch (master, 1.5-dev), GTK 4 / gtkmm-4.0 front end.
# Built from the tip of the git master branch at build time. The version
# string below is cosmetic: bump it by hand when you want a new revision.
name                inkscape-devel
# Conflicts with the other Inkscape ports, whatever this port is named locally.
conflicts           inkscape
set my_name         inkscape

version             1.5.0-20261112
revision            0

categories          graphics gnome
license             GPL-3+
maintainers         nomaintainer
platforms           darwin

description         Inkscape vector graphics editor, git master (GTK 4)
long_description    Inkscape is a multi-platform, open-source vector graphics \
                    editor that uses SVG as its native file format. This port \
                    builds the git master branch (1.5-dev), which uses GTK 4 \
                    and gtkmm-4.0 instead of GTK 3.

homepage            https://inkscape.org/

# Plain git checkout of HEAD. git.branch is deliberately left empty: MacPorts
# then does a shallow clone of the remote's default branch tip instead of
# downloading the full ~1.5-2 GB history. (Set it to a commit hash to pin a
# revision, but that forces a full-history clone.)
fetch.type          git
git.url             https://gitlab.com/inkscape/inkscape.git

# MacPorts does not initialise submodules itself, and the build needs them
# (src/3rdparty/2geom, share/extensions, share/themes, ...). Try a shallow
# fetch first and fall back to a full one if the pinned commit is not
# reachable that way.
post-fetch {
    system -W ${worksrcpath} "git submodule update --init --recursive --depth 1 || git submodule update --init --recursive"
}

cmake.generator     Ninja

# ---------------------------------------------------------------------------
# Python
# '#!/usr/bin/env python' (and a bare 'python3') does not resolve to the
# MacPorts Python on macOS, so the interpreter is pinned explicitly, both
# for the extensions Inkscape launches at run time and for the helper
# scripts run by CMake at build time.
# ---------------------------------------------------------------------------
python.variants     314 315 315t
set python.bin      ${prefix}/bin/python${python.branch}

# These patterns come from the 1.3.2 port. The source layout of master may
# differ, so every edit is guarded; a pattern that no longer matches is
# silently a no-op (see the notes on how to check this).
post-patch {
    # Interpreter used to run extensions (.py scripts under share/extensions)
    set script_cpp ${worksrcpath}/src/extension/implementation/script.cpp
    if {[file exists ${script_cpp}]} {
        reinplace "s|\"python-interpreter\", *\{\"python3\"|\"python-interpreter\", \{\"python${python.branch}\"|g" \
            ${script_cpp}
    }
    # Python helpers invoked by CMake while building share/*
    foreach cml [glob -nocomplain ${worksrcpath}/share/*/CMakeLists.txt] {
        reinplace "s|COMMAND python3 |COMMAND ${python.bin} |g" ${cml}
    }
}

# ---------------------------------------------------------------------------
# Poppler
# Recent Poppler releases (26.x) no longer pull goo/gmem.h in indirectly, so
# gfree()/gmalloc() are undeclared in the PDF import code (pdf-input.cpp).
# They are thin wrappers around free()/malloc(), so call those directly.
# ---------------------------------------------------------------------------
post-patch {
    foreach f [concat [glob -nocomplain ${worksrcpath}/src/extension/internal/pdfinput/*.cpp] \
                      [glob -nocomplain ${worksrcpath}/src/extension/internal/pdfinput/*.h]] {
        reinplace "s|gfree(|free(|g" ${f}
        reinplace "s|gmalloc(|malloc(|g" ${f}
    }
}

# Steer any find_package(Python3) in the build to the same interpreter.
configure.args-append   -DPython3_EXECUTABLE=${python.bin}

# ---------------------------------------------------------------------------
# Compiler
# ---------------------------------------------------------------------------
# Inkscape master requires a C++20 compiler.
compiler.cxx_standard   2020
compiler.blacklist-append \
                    {clang < 1300}

# Need no-invalid-constexpr, due to lib2geom (now built from the in-tree
# submodule). Remove if/when fixed upstream.
if { [string match *clang* ${configure.compiler}] } {
    configure.cxxflags-append \
                    -Wno-invalid-constexpr \
                    -Wno-error=unknown-warning-option \
                    -Wno-unknown-warning-option
}

# this port only uses boost headers during build
# and does not link with any boost libraries
# no need to rebuild due to boost library ABI changes
boost.depends_type  build
boost.version       1.91

depends_build-append \
                    port:gettext \
                    port:gtest \
                    path:bin/pkg-config:pkgconfig

# gtkmm4 pulls in gtk4, glibmm, cairomm, pangomm, libsigc++-3.0 and graphene.
depends_lib-append \
                    port:boehmgc \
                    port:capypdf \
                    path:lib/pkgconfig/cairo.pc:cairo \
                    port:desktop-file-utils \
                    port:double-conversion \
                    port:fontconfig \
                    path:lib/pkgconfig/gdk-pixbuf-2.0.pc:gdk-pixbuf2 \
                    port:gettext-runtime \
                    path:lib/pkgconfig/glibmm-2.68.pc:glibmm \
                    port:gsl \
                    port:gtkmm4 \
                    port:gtksourceview5 \
                    path:lib/pkgconfig/harfbuzz.pc:harfbuzz \
                    port:ImageMagick \
                    port:lcms2 \
                    port:libcdr-0.1 \
                    port:libepoxy \
                    path:include/turbojpeg.h:libjpeg-turbo \
                    port:libpng \
                    port:libvisio-0.1 \
                    port:libwpg-0.3 \
                    port:libxml2 \
                    port:libxslt \
                    path:lib/pkgconfig/pango.pc:pango \
                    path:lib/pkgconfig/poppler.pc:poppler \
                    port:potrace \
                    port:zlib

depends_run-append \
                    port:adwaita-icon-theme \
                    port:hicolor-icon-theme \
                    port:py${python.variant}-cssselect \
                    port:py${python.variant}-lxml \
                    port:py${python.variant}-numpy \
                    port:py${python.variant}-scour

# Options carried over from the 1.3.2 port. Some may no longer exist in
# master; CMake only warns about unused -D variables.
configure.args-append \
                    -DBUILD_TESTING=OFF \
                    -DENABLE_LCMS=ON \
                    -DENABLE_POPPLER=ON \
                    -DENABLE_POPPLER_CAIRO=OFF \
                    -DWITH_ASAN=OFF \
                    -DWITH_DBUS=OFF \
                    -DWITH_GNU_READLINE=OFF \
                    -DWITH_GRAPHICS_MAGICK=OFF \
                    -DWITH_GSOURCEVIEW=ON \
                    -DWITH_IMAGE_MAGICK=ON \
                    -DWITH_INTERNAL_CAIRO=OFF \
                    -DWITH_INTERNAL_2GEOM=ON \
                    -DWITH_JEMALLOC=OFF \
                    -DWITH_LIBCDR=ON \
                    -DWITH_LIBVISIO=ON \
                    -DWITH_LIBWPG=ON \
                    -DWITH_MANPAGE_COMPRESSION=OFF \
                    -DWITH_NLS=ON \
                    -DWITH_OPENMP=OFF \
                    -DWITH_PROFILING=OFF \
                    -DWITH_X11=OFF

# The GTK 4 stack must match: quartz (native macOS) is the default, since
# gtkmm4 +x11 builds but is reported not to run (OpenGL issues).
variant quartz conflicts x11 description {Native macOS (quartz) GTK 4 stack} {
    require_active_variants gtk4 quartz
    require_active_variants gtkmm4 quartz
}
variant x11 conflicts quartz description {X11 GTK 4 stack} {
    require_active_variants gtk4 x11
    require_active_variants gtkmm4 x11
}
default_variants    +quartz

# Escape hatch if master does not yet build against your Poppler release:
# builds without PDF import (PDF export and everything else are unaffected).
variant no_pdfimport description {Build without PDF import (no Poppler dependency)} {
    configure.args-replace \
                    -DENABLE_POPPLER=ON \
                    -DENABLE_POPPLER=OFF
    depends_lib-delete \
                    path:lib/pkgconfig/poppler.pc:poppler
}

variant tests description {Enable tests} {
    configure.args-replace \
                    -DBUILD_TESTING=OFF \
                    -DBUILD_TESTING=ON

    test.run        yes
}

# CMake installs libinkscape_base into lib/inkscape, but the MacPorts cmake
# group gives it the install name ${prefix}/lib/libinkscape_base.*.dylib, so
# the executables look for it in ${prefix}/lib and fail to start (and
# rev-upgrade reports them as broken). Install it where it is linked.
# (The old 1.3.x port patched src/CMakeLists.txt for the same purpose; moving
# the files after destroot does not depend on the source layout.)
post-destroot {
    set libsub ${destroot}${prefix}/lib/inkscape
    foreach lib [glob -nocomplain ${libsub}/libinkscape_base*.dylib] {
        move ${lib} ${destroot}${prefix}/lib/
    }
    if {[file isdirectory ${libsub}] && [llength [glob -nocomplain ${libsub}/*]] == 0} {
        delete ${libsub}
    }
}

post-activate {
    catch {system "${prefix}/bin/gtk4-update-icon-cache -f -t ${prefix}/share/icons/hicolor"}
    catch {system "${prefix}/bin/update-desktop-database ${prefix}/share/applications"}
}

notes "
This is the Inkscape master branch (1.5-dev): expect crashes and regressions.\
\nIt conflicts with the inkscape and inkscape-devel (1.3.x, GTK 3) ports.
"

livecheck.type      none
