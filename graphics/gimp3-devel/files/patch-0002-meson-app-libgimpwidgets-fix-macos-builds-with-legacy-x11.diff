--- libgimpwidgets/gimppickbutton.c
+++ libgimpwidgets/gimppickbutton.c
@@ -20,6 +20,7 @@
 
 #include <gegl.h>
 #include <gtk/gtk.h>
+#include <gdk/gdk.h>
 #include <gdk/gdkkeysyms.h>
 
 #ifdef GDK_WINDOWING_X11
@@ -48,7 +49,9 @@
 #elif defined (GDK_WINDOWING_WIN32)
 #include "gimppickbutton-win32.h"
 #else
+#ifndef PLATFORM_OSX
 #include "gimppickbutton-kwin.h"
+#endif
 #include "gimppickbutton-xdg.h"
 #endif
 
@@ -191,8 +194,10 @@ gimp_pick_button_clicked (GtkButton *button)
 #endif
   if (_gimp_pick_button_xdg_available ())
     _gimp_pick_button_xdg_pick (GIMP_PICK_BUTTON (button));
+#ifndef PLATFORM_OSX
   else if (_gimp_pick_button_kwin_available ())
     _gimp_pick_button_kwin_pick (GIMP_PICK_BUTTON (button));
+#endif
   else
     _gimp_pick_button_default_pick (GIMP_PICK_BUTTON (button));
 #endif
--- libgimpwidgets/meson.build
+++ libgimpwidgets/meson.build
@@ -190,7 +190,10 @@ libgimpwidgets_introspectable = [
 
 if platform_osx
   libgimpwidgets_sources += [
+    #When GTK is compiled with Quartz support (default)
     'gimppickbutton-quartz.c',
+    #When GTK is compiled with legacy X11 support
+    'gimppickbutton-xdg.c',
   ]
 elif platform_windows
   libgimpwidgets_sources += [
--- meson.build
+++ meson.build
@@ -498,7 +498,7 @@ gmodule           = dependency('gmodule-no-export-2.0')
 gtk3_minver       = '3.24.0'
 gtk3              = dependency('gtk+-3.0',           version: '>='+gtk3_minver)
 gdk_specific_name = platform_osx ? 'gdk-quartz-3.0' : 'gdk-3.0'
-gdk_specific      = dependency(gdk_specific_name)
+gdk_specific      = dependency(gdk_specific_name, required: false)
 gtk_version_split = gtk3_minver.split('.')
 gtk_major = gtk_version_split[0].to_int()
 gtk_minor = gtk_version_split[1].to_int()
