+#ifdef GDK_WINDOWING_QUARTZ
   /* macOS does not restore the tool's cursor when the image window regains
      focus, leaving the canvas with the default arrow pointer (see: #7867). */
   if ((event->changed_mask     & GDK_WINDOW_STATE_FOCUSED) &&
@@ -913,7 +916,7 @@ gimp_image_window_window_state_event (GtkWidget           *widget,
   return FALSE;
 }
 
-#ifdef PLATFORM_OSX
+#ifdef GDK_WINDOWING_QUARTZ
 static gboolean
 gimp_image_window_restore_cursor (gpointer canvas)
 {
@@ -1302,7 +1305,7 @@ gimp_image_window_set_aux_info (GimpSessionManaged *session_managed,
 }
 
 
-#ifdef PLATFORM_OSX
+#ifdef GDK_WINDOWING_QUARTZ
 static gboolean
 gimp_image_window_focus_idle (gpointer data)
 {
@@ -1380,7 +1383,7 @@ gimp_image_window_new (Gimp              *gimp,
                                          NULL, NULL, GDK_HINT_USER_POS);
         }
 
-#ifdef PLATFORM_OSX
+#ifdef GDK_WINDOWING_QUARTZ
       g_idle_add_full (G_PRIORITY_DEFAULT_IDLE,
                        gimp_image_window_focus_idle,
                        g_object_ref (window), g_object_unref);
