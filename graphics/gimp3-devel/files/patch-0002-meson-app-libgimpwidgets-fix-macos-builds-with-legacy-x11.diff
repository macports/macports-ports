     return G_SOURCE_REMOVE;
 
-#if defined (G_OS_WIN32) || defined (PLATFORM_OSX)
+#if defined (G_OS_WIN32) || defined (GDK_WINDOWING_QUARTZ)
   /* set by gimp_dock_window_map() when the dock window is being re-mapped
