+#ifdef GDK_WINDOWING_QUARTZ
   ns_window = gdk_quartz_window_get_nswindow (gtk_widget_get_window (GTK_WIDGET (dock_window)));
   if (ns_window)
     {
@@ -1280,7 +1280,7 @@ gimp_dock_window_factory_display_changed (GimpContext *context,
