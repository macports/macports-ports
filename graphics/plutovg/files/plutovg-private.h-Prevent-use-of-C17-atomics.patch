From b56660e09e8d929d02ecd650b7180c621dd2883b Mon Sep 17 00:00:00 2001
From: commitmaniac <201806046+commitmaniac@users.noreply.github.com>
Date: Tue, 13 Oct 2026 22:34:00 -0400
Subject: [PATCH] plutovg-private.h: Prevent use of C17 atomics

Fix "error: address argument to atomic operation must be a pointer to
non-const _Atomic type ('const _Atomic(bool) *' invalid)"
---
 source/plutovg-private.h | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/source/plutovg-private.h b/source/plutovg-private.h
index 838cd43..cb2861d 100644
--- a/source/plutovg-private.h
+++ b/source/plutovg-private.h
@@ -14,7 +14,7 @@ typedef LONG plutovg_ref_count_t;
 #define plutovg_destroy_reference(ob) (ob && InterlockedDecrement(&(ob)->ref_count) == 0)
 #define plutovg_get_reference_count(ob) ((ob) ? InterlockedCompareExchange((LONG*)&(ob)->ref_count, 0, 0) : 0)

-#elif defined(__STDC_VERSION__) && __STDC_VERSION__ >= 201112L && !defined(__STDC_NO_ATOMICS__)
+#elif defined(__STDC_VERSION__) && __STDC_VERSION__ >= 201710L && !defined(__STDC_NO_ATOMICS__)

 #include <stdatomic.h>

--
2.56.0
