PortSystem          1.0

name                resvg
version             0.48.1
categories          graphics
platforms           darwin
license             Apache-2.0 MIT
maintainers         {yourname @yourgithub} openmaintainer
description         SVG rendering/simplification tools (resvg, usvg)
long_description    resvg is a small, fast SVG rendering library written in Rust. \
                     This port also builds usvg, its bundled SVG-normalization \
                     CLI, which converts text elements to path outlines among \
                     other simplifications (usvg input.svg output.svg).

homepage            https://github.com/linebender/resvg
master_sites        https://github.com/linebender/resvg/releases/download/v${version}/
distname            resvg-${version}
use_xz              yes

checksums           rmd160  6533c1a46d48ee2ef7e8933f49503845b7171793 \
                    sha256  13ed5a2bae7a01156288ecae5bf944cf7d1c572742c19fc68027947a4d87294c \
                    size    13023916

# Vendored source tarball: dependencies ship in ./vendor and ./.cargo/config
# already points cargo at them, so the build needs no network access.
depends_build-append \
                    port:cargo \
                    port:rust

use_configure       no

build.env-append    CARGO_HOME=${workpath}/.cargo_home

build.cmd           cargo
build.pre_args      build
build.args          --release --offline --frozen -p usvg -p resvg

destroot {
    xinstall -m 755 ${worksrcpath}/target/release/usvg  ${destroot}${prefix}/bin/usvg
    xinstall -m 755 ${worksrcpath}/target/release/resvg ${destroot}${prefix}/bin/resvg

    xinstall -d ${destroot}${prefix}/share/doc/${name}
    xinstall -m 644 ${worksrcpath}/README.md ${worksrcpath}/CHANGELOG.md \
        ${destroot}${prefix}/share/doc/${name}
}

livecheck.type      regex
livecheck.url       https://github.com/linebender/resvg/releases
livecheck.regex     {resvg-([0-9.]+)\.tar\.xz}
