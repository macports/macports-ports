Support exiv2 0.28, keeping 0.27 support.
https://github.com/butcherg/rawproc/issues/29
diff --git a/src/gimage.cpp b/src/gimage.cpp
--- a/src/gimage.cpp
+++ b/src/gimage.cpp
@@ -19,6 +19,14 @@
 #include "fileutil.h"
 #include "cJSON.h"
 #include "exiv2/exiv2.hpp"
+
+#if EXIV2_TEST_VERSION(0,28,0)
+typedef Exiv2::Error Exiv2Error;
+#define EXIV2_TOINT toInt64
+#else
+typedef Exiv2::AnyError Exiv2Error;
+#define EXIV2_TOINT toLong
+#endif
 #ifdef USE_LIBRTPROCESS
 #include <rtprocess/librtprocess.h>
 #endif
@@ -6849,14 +6857,18 @@ GIMAGE_ERROR gImage::insertMetadata(std::string filename, cmsHPROFILE profile, b
 		cmsUInt32Number iccprofilesize;
 		makeICCProfile(profile, iccprofile, iccprofilesize);
 		Exiv2::DataBuf iccprof((Exiv2::byte *) iccprofile, iccprofilesize);
+#if EXIV2_TEST_VERSION(0,28,0)
+		image->setIccProfile(std::move(iccprof));
+#else
 		image->setIccProfile(iccprof);
+#endif
 		delete [] iccprofile;
 	}
 	
 	try {
 		image->writeMetadata();
 	}
-	catch (Exiv2::AnyError& e) {
+	catch (Exiv2Error& e) {
 		return GIMAGE_EXIV2_METADATAWRITE_FAILED;
 	}
 
@@ -6895,7 +6907,7 @@ std::map<std::string,std::string> gImage::loadMetadata(const char * filename)
 					case Exiv2::signedLong:
 					case Exiv2::unsignedLongLong:
 					case Exiv2::signedLongLong:
-						imgdata[name] = tostr((unsigned short) exifData[*it].toLong());
+						imgdata[name] = tostr((unsigned short) exifData[*it].EXIV2_TOINT());
 						break;
 					case Exiv2::asciiString:
 					case Exiv2::date:
@@ -6907,7 +6919,7 @@ std::map<std::string,std::string> gImage::loadMetadata(const char * filename)
 			}
 		}
 	}
-	catch (Exiv2::AnyError& e) {
+	catch (Exiv2Error& e) {
 		imgdata["Error"] = "Metadata read failure.";
 		return imgdata;
 	}
@@ -6939,9 +6951,16 @@ GIMAGE_ERROR gImage::getMetadata(std::string filename)
 	 
 	char * prof;
 	if (image->iccProfileDefined()) {
+#if EXIV2_TEST_VERSION(0,28,0)
+		const Exiv2::DataBuf &icc = image->iccProfile();
+		prof = new char[icc.size()];
+		memcpy(prof, icc.c_data(), icc.size());
+		setProfile(prof, icc.size());
+#else
 		prof = new char[image->iccProfile()->size_]; 
 		memcpy(prof, image->iccProfile()->pData_, image->iccProfile()->size_);
 		setProfile(prof, image->iccProfile()->size_);
+#endif
 	}
 
 	return GIMAGE_OK;
