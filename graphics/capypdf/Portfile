PortSystem          1.0
PortGroup           github 1.0
PortGroup           meson 1.0

github.setup        jpakkane capypdf 0.22.0
github.tarball_from archive
revision            0

categories          graphics print
license             Apache-2
maintainers         nomaintainer
platforms           darwin

description         Low-level, fully colour-managed PDF generation library
long_description    CapyPDF is a low-level library for generating PDF files. It \
                    has no document model of its own and exposes PDF primitives \
                    directly, with a plain C API and a C++ wrapper header. It \
                    reads PNG, JPEG and TIFF images and uses LittleCMS 2 for \
                    colour management. Inkscape's development branch uses it \
                    for PDF output.

checksums           rmd160  2cd92e84dda946576c6595e541851bc8c445e747 \
                    sha256  3996f620b1117d243a146385d8262493701c5abe1e9ac4c564b810f5e5a79936 \
                    size    31083450

# The code uses C++23 (std::format, std::expected, std::byteswap), which on
# macOS needs a libc++ with floating-point to_chars: macOS 13.3 or later.
if {${os.platform} eq "darwin" && ${os.major} < 22} {
    known_fail      yes
    pre-fetch {
        ui_error "${name} requires macOS 13 or later (C++23 std::format)."
        return -code error "incompatible macOS version"
    }
}

# meson.build asks for cpp_std=c++23 (falling back to c++latest) and
# meson >= 1.10, so make sure a recent compiler is selected. Xcode 15's
# clang (clang-1500) is what upstream targets on macOS. GCC is excluded so
# the library and its users share libc++.
compiler.cxx_standard   2020
compiler.blacklist-append \
                    {clang < 1500} \
                    {macports-clang-[0-9]} \
                    {macports-clang-1[0-6]} \
                    *gcc*

depends_lib-append  port:freetype \
                    port:lcms2 \
                    port:libpng \
                    port:tiff \
                    port:zlib \
                    path:lib/pkgconfig/libjpeg.pc:libjpeg-turbo

# This port installs the library, the C header, the C++ wrapper header and the
# pkg-config file. The Python binding, tests and benchmark are not built:
# the binding would be installed into whichever Python meson itself runs
# under, and the tests need ~37 MB of extra data and several helper scripts.
post-patch {
    foreach sub {python benchmark test} {
        reinplace "s|subdir\[(\]'${sub}'\[)\]|message('${sub} skipped by the MacPorts port')|" \
            ${worksrcpath}/meson.build
    }
}

post-destroot {
    set docdir ${prefix}/share/doc/${name}
    xinstall -d ${destroot}${docdir}
    xinstall -m 0644 -W ${worksrcpath} COPYING readme.md ${destroot}${docdir}
}

# Upstream tags releases without a "v" prefix and publishes no GitHub releases.
livecheck.type      regex
livecheck.url       ${github.homepage}/tags
livecheck.regex     releases/tag/(\\d+\\.\\d+\\.\\d+)
