maintainers         {i0ntempest @i0ntempest} openmaintainer
# The SAM implementation requires Apache-2 even when other source uses MIT.
license             Apache-2 OFL-1.1 CC-BY-4 Permissive
platforms           {macosx >= 20}
supported_archs     arm64 x86_64
installs_libs       no

description         Photo library and RAW developer from the ArtCraft series
long_description    LightCraft is a native photo library and non-destructive RAW \
                    developer written in Rust, with catalog organization, color \
                    adjustments, masking and batch export. The desktop app and \
                    command-line interface share the same editing engine. The \
                    CLI also provides an MCP server.

# Keep the font input at the same commit as upstream's release workflow.
# See .github/workflows/release.yml
set craft_fonts_commit \
                    b076417b5880bd4154bd22f00695b1d28c6bea83
set craft_fonts_distfile \
                    craft-fonts-${craft_fonts_commit}.tar.gz
set craft_fonts_path ${workpath}/craft-fonts-${craft_fonts_commit}

master_sites-append \
                    https://github.com/storytold/craft-fonts/archive/${craft_fonts_commit}.tar.gz?dummy=:craft_fonts
distfiles-append    ${craft_fonts_distfile}:craft_fonts
extract.only        ${distname}${extract.suffix} ${craft_fonts_distfile}
extract.rename      no

checksums           ${distname}${extract.suffix} \
                    rmd160  8659bcba60562e35db710201f69a9c5ab184175c \
                    sha256  f2eb8faa052c7ec4c28b60607259cc97e6d88c98575a00f5daaa174daf96ccde \
                    size    18641093 \
                    ${craft_fonts_distfile} \
                    rmd160  089ad841de920f63740ab5818a3df6d780339063 \
                    sha256  35eadfeb7e4217a933f24b73a3d190b90fed81e6c933266f092c161746c0a9eb \
                    size    38822400

# Cargo.lock contains craft-ui and craft-docpath from Git; frozen mode cannot fetch them.
# Keep --locked below while allowing these pinned dependencies to be fetched.
cargo.offline_cmd

build.env-append    CRAFT_FONTS_DIR=${craft_fonts_path} \
                    CRAFT_FONTS_REQUIRED=1 \
                    LIGHTCRAFT_BUILD_DATE=[clock format [clock seconds] -format "%Y-%m-%d" -gmt 1]
build.args-append   --locked -p lightcraft -p lightcraft-cli --no-default-features
# Avoid retaining unused dylib dependencies.
rust.flags-append   -C link-arg=-Wl,-dead_strip_dylibs

pre-configure {
    set ::git_commit \
                    [exec curl -fsSL \
                        -H "Accept: application/vnd.github.sha" \
                        https://api.github.com/repos/${github.author}/${github.project}/commits/${github.tag_prefix}${version}]
    build.env-append \
                    LIGHTCRAFT_BUILD_SHA=${::git_commit}
}

# App defaults must be disabled above so -denoise removes the inference runtime.
# The GUI still enables SAM, while JXL and AVIF encoding are codec defaults.
variant denoise description {Enable AI denoise using separately installed models} {
    build.args-append --features denoise
}

variant rawnind requires denoise description {Offer downloading the RawNIND denoise model} {
    build.args-append --features rawnind-model
}

# HEIC support is pure Rust and needs no external libheif.
variant heic description {Enable HEIC and HEIF image decoding} {
    build.args-append --features heif
}

default_variants    +denoise +heic

# A bundle signed before muniversal merges its executables has an invalid
# signature. Build either native architecture until bundle merging is handled.
universal_variant   no

destroot {
    set target_dir ${worksrcpath}/target/[cargo.rust_platform]/release
    set app_dir ${destroot}${applications_dir}/LightCraft.app
    set resources_dir ${app_dir}/Contents/Resources
    set doc_dir ${destroot}${prefix}/share/doc/${name}
    xinstall -d ${app_dir}/Contents/MacOS ${resources_dir}/Licenses \
        ${destroot}${prefix}/bin ${doc_dir}

    # Follow packaging/macos/package.sh without creating release DMGs or ZIPs.
    xinstall -m 0755 ${target_dir}/lightcraft ${app_dir}/Contents/MacOS/LightCraft
    xinstall -m 0755 ${target_dir}/lightcraft-cli ${destroot}${prefix}/bin
    xinstall -m 0644 ${worksrcpath}/assets/app-icon/lightcraft.icns \
        ${resources_dir}/LightCraft.icns
    xinstall -m 0644 ${worksrcpath}/packaging/macos/Info.plist.in \
        ${app_dir}/Contents/Info.plist
    reinplace "s|@VERSION@|${version}|g; s|@SHORT_VERSION@|${version}|g; s|@BUILD_SHA@|${::git_commit}|g" \
        ${app_dir}/Contents/Info.plist
    system "/usr/libexec/PlistBuddy -c 'Set :LSMinimumSystemVersion ${macosx_deployment_target}' '${app_dir}/Contents/Info.plist'"
    set pkginfo [open ${app_dir}/Contents/PkgInfo w]
    puts -nonewline ${pkginfo} {APPL????}
    close ${pkginfo}

    ln -s ${applications_dir}/LightCraft.app/Contents/MacOS/LightCraft \
        ${destroot}${prefix}/bin/lightcraft

    xinstall -m 0644 -W ${worksrcpath} README.md LICENSE-MIT LICENSE-APACHE \
        NOTICE ${doc_dir}
    xinstall -m 0644 -W ${worksrcpath} LICENSE-MIT LICENSE-APACHE \
        NOTICE ${resources_dir}/Licenses
    foreach license_file [list ${worksrcpath}/assets/ATTRIBUTION.md \
                              ${worksrcpath}/docs/brand/LICENSE-brand.txt \
                              ${worksrcpath}/assets/fonts/OFL-Inter.txt] {
        xinstall -m 0644 ${license_file} ${resources_dir}/Licenses
        xinstall -m 0644 ${license_file} ${doc_dir}
    }
    xinstall -m 0644 ${worksrcpath}/assets/app-icon/LICENSE.txt \
        ${resources_dir}/Licenses/LICENSE-app-icon.txt
    xinstall -m 0644 ${worksrcpath}/assets/app-icon/LICENSE.txt \
        ${doc_dir}/LICENSE-app-icon.txt
    foreach license_file [glob ${craft_fonts_path}/fonts/*/OFL.txt] {
        set family [file tail [file dirname ${license_file}]]
        xinstall -m 0644 ${license_file} ${resources_dir}/Licenses/OFL-${family}.txt
        xinstall -m 0644 ${license_file} ${doc_dir}/OFL-${family}.txt
    }

    # Remove inherited Finder metadata before creating the final signatures.
    system "/usr/bin/xattr -cr '${app_dir}'"
    system "/usr/bin/xattr -c '${destroot}${prefix}/bin/lightcraft-cli'"
    system "/usr/bin/codesign --force --sign - --entitlements '${worksrcpath}/packaging/macos/entitlements.plist' '${app_dir}'"
    system "/usr/bin/codesign --force --sign - --entitlements '${worksrcpath}/packaging/macos/entitlements.plist' --identifier ai.storyteller.lightcraft-cli '${destroot}${prefix}/bin/lightcraft-cli'"
}

