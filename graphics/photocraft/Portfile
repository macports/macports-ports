PortSystem          1.0
PortGroup           cargo 1.0
PortGroup           github 1.0

github.setup        storytold photocraft 0.5.0 v
github.tarball_from archive
revision            0
categories          graphics aqua
maintainers         {i0ntempest @i0ntempest} openmaintainer
license             {MIT Apache-2} OFL-1.1 ISC CC-BY-3 Permissive
platforms           {macosx >= 20}
supported_archs     arm64 x86_64
installs_libs       no

description         Native image editor from the ArtCraft series
long_description    PhotoCraft is a native image editor written in Rust, with \
                    layers, masks, adjustment layers, type, vectors, brushes \
                    and PSD support. The desktop app and headless command-line \
                    interface share the same editing engine. The CLI supports \
                    conversion, batch processing and an MCP server.

# Keep the font input at the same commit as upstream's release workflow.
set craft_fonts_commit \
                    abb83316d96aa59c1cf64784289e378fe9fa5695
set craft_fonts_distfile \
                    craft-fonts-${craft_fonts_commit}.tar.gz
set craft_fonts_path ${workpath}/craft-fonts-${craft_fonts_commit}

master_sites-append \
                    https://github.com/storytold/craft-fonts/archive/${craft_fonts_commit}.tar.gz?dummy=:craft_fonts
distfiles-append    ${craft_fonts_distfile}:craft_fonts
extract.only        ${distname}${extract.suffix} ${craft_fonts_distfile}
extract.rename      no

checksums           ${distname}${extract.suffix} \
                    rmd160  6713d3a0ec6ab826843a3dda08fb519d5393e818 \
                    sha256  3fbd31c3370dbefb8d1dc70b52cb46965b8c7248de8acf279103898d99127b65 \
                    size    14351442 \
                    ${craft_fonts_distfile} \
                    rmd160  b0a9b8f1a594f5769da4ac90a9e90a52b2561e51 \
                    sha256  53e41ed01ee81a0ef664601a73fb87281f1fd748e724f560c8128d7d33eb3328 \
                    size    14570459

pre-configure {
    set ::git_commit  [exec curl -fsSL \
                        -H "Accept: application/vnd.github.sha" \
                        https://api.github.com/repos/${github.author}/${github.project}/commits/${github.tag_prefix}${version}]
    build.env-append \
                    PHOTOCRAFT_BUILD_SHA=${::git_commit}
}

build.args-append   -p photocraft -p photocraft-cli

# The PSD library must be selected to enable its standalone serde feature.
variant serde description {Enable serialization of PSD data structures} {
    build.args-append -p photocraft-psd --features serde
}

variant avif description {Enable AVIF image encoding} {
    build.args-append --features photocraft-codecs/avif
}

# HEIC support is pure Rust and needs no external libheif.
variant heic description {Enable HEIC and HEIF image decoding} {
    build.args-append --features heif
}

default_variants    +heic

build.env-append    CRAFT_FONTS_DIR=${craft_fonts_path} \
                    CRAFT_FONTS_REQUIRED=1 \
                    PHOTOCRAFT_BUILD_DATE=[clock format [clock seconds] -format "%Y-%m-%d" -gmt 1]

# The app targets Big Sur or newer, matching upstream's Metal requirements.
if {[vercmp ${macosx_deployment_target} < 11.0]} {
    macosx_deployment_target 11.0
}

# A bundle signed before muniversal merges its executables has an invalid
# signature. Build either native architecture until bundle merging is handled.
universal_variant   no

destroot {
    set target_dir ${worksrcpath}/target/[cargo.rust_platform]/release
    set app_dir ${destroot}${applications_dir}/PhotoCraft.app
    set resources_dir ${app_dir}/Contents/Resources
    set doc_dir ${destroot}${prefix}/share/doc/${name}
    xinstall -d ${app_dir}/Contents/MacOS ${resources_dir}/Licenses \
        ${destroot}${prefix}/bin ${doc_dir}

    # Follow packaging/macos/package.sh without creating release DMGs or ZIPs.
    xinstall -m 0755 ${target_dir}/photocraft ${app_dir}/Contents/MacOS/PhotoCraft
    xinstall -m 0755 ${target_dir}/photocraft-cli ${destroot}${prefix}/bin
    xinstall -m 0644 ${worksrcpath}/assets/app-icon/photocraft.icns \
        ${resources_dir}/PhotoCraft.icns
    xinstall -m 0644 ${worksrcpath}/packaging/macos/Info.plist.in \
        ${app_dir}/Contents/Info.plist
    reinplace "s|@VERSION@|${version}|g; s|@SHORT_VERSION@|${version}|g; s|@BUILD_SHA@|${::git_commit}|g" \
        ${app_dir}/Contents/Info.plist
    system "/usr/libexec/PlistBuddy -c 'Set :LSMinimumSystemVersion ${macosx_deployment_target}' '${app_dir}/Contents/Info.plist'"
    set pkginfo [open ${app_dir}/Contents/PkgInfo w]
    puts -nonewline ${pkginfo} {APPL????}
    close ${pkginfo}

    ln -s ${applications_dir}/PhotoCraft.app/Contents/MacOS/PhotoCraft \
        ${destroot}${prefix}/bin/photocraft

    xinstall -m 0644 -W ${worksrcpath} README.md LICENSE-MIT LICENSE-APACHE \
        NOTICE ATTRIBUTION.md ${doc_dir}
    xinstall -m 0644 -W ${worksrcpath} LICENSE-MIT LICENSE-APACHE \
        NOTICE ATTRIBUTION.md ${resources_dir}/Licenses
    xinstall -m 0644 ${worksrcpath}/docs/brand/LICENSE-brand.txt \
        ${resources_dir}/Licenses
    xinstall -m 0644 ${worksrcpath}/docs/brand/LICENSE-brand.txt ${doc_dir}
    foreach license_file [glob ${worksrcpath}/assets/fonts/OFL-*.txt \
                              ${worksrcpath}/assets/icons/LICENSE-*.txt \
                              ${worksrcpath}/assets/dict/LICENSE-*.txt] {
        xinstall -m 0644 ${license_file} ${resources_dir}/Licenses
        xinstall -m 0644 ${license_file} ${doc_dir}
    }
    foreach license_file [glob ${craft_fonts_path}/fonts/*/OFL.txt] {
        set family [file tail [file dirname ${license_file}]]
        xinstall -m 0644 ${license_file} ${resources_dir}/Licenses/OFL-${family}.txt
        xinstall -m 0644 ${license_file} ${doc_dir}/OFL-${family}.txt
    }

    system "/usr/bin/codesign --force --sign - '${app_dir}'"
    system "/usr/bin/codesign --force --sign - --identifier ai.storyteller.photocraft-cli '${destroot}${prefix}/bin/photocraft-cli'"
}

