post-destroot {
    set destdocdir  ${destroot}${prefix}/share/doc/VulkanMemoryAllocator

    xinstall -d ${destdocdir}
    xinstall -W ${worksrcpath} -m 644 \
        CHANGELOG.md \
        LICENSE.txt \
        README.md \
        ${destdocdir}
}

variant doc \
        description {Install HTML documentation} {
    depends_build-append    bin:doxygen:doxygen
    configure.args-append   -DVMA_BUILD_DOCUMENTATION=ON
}
