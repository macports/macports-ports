PortSystem          1.0
PortGroup           cargo 1.0

name                qrcode-barcode-scanner
version             0.11.0
revision            0
categories          graphics
installs_libs       no
license             AGPL-3+
maintainers         {qrcode-ai.com:contact @ThibautMelen} \
                    openmaintainer

description         offline QR code and barcode scanner for the command line
long_description    qrscan reads every QR code and barcode in an image file and \
                    prints a JSON report, offline. It reads QR Code, Micro QR, \
                    rMQR, Data Matrix, Aztec, PDF417, MaxiCode and the common \
                    linear barcodes, keeps the payload bytes and the position of \
                    each code, and scores QR scannability.

homepage            https://github.com/qrcode-ai-com/qrcode-barcode-scanner-rust
master_sites        https://github.com/qrcode-ai-com/qrcode-barcode-scanner-rust/releases/download/v${version}/
distname            qrcode-barcode-scanner-cli-${version}-source

# The port qrscan (redraiment/qrscan) also installs bin/qrscan.
conflicts           qrscan

checksums-append    ${distname}${extract.suffix} \
                    rmd160  67ec12678057ea58ef2e870d1f6477386c8c4c5e \
                    sha256  8e5e09f0ec8d93ae49ca35615c05bb1d326448b6de9757cef86ef48d7bf3a96d \
                    size    13179944

# The archive holds the whole workspace and its Cargo.lock; only the qrscan crate is built.
# Keep the workspace release profile (overflow checks in the rxing reader) and never set
# panic=abort: the engine catches reader panics.
build.args-append   -p qrcode-barcode-scanner-cli

set qrscan_bin      ${worksrcpath}/target/[cargo.rust_platform]/release/qrscan

test.run            yes
test {
    # The mixed fixture holds a QR code and a Code 128: every profile must read both.
    foreach profile {fast frame full} {
        set report [exec -ignorestderr ${qrscan_bin} --profile ${profile} --budget-ms 0 \
            ${worksrcpath}/fixtures/symbology/mixed-code128-qr.png]
        foreach payload {https://qrc-ai.com/76xMa STOCK-4827} {
            if {[string first "\"text\": \"${payload}\"" ${report}] < 0} {
                return -code error "qrscan --profile ${profile} did not read ${payload}"
            }
        }
    }
}

destroot {
    xinstall -m 0755 ${qrscan_bin} ${destroot}${prefix}/bin/
    xinstall -d ${destroot}${prefix}/share/doc/${name}
    xinstall -m 0644 -W ${worksrcpath} LICENSE LICENSING.md \
        crates/qrcode-ai-scanner/LICENSE-APACHE-2.0 \
        crates/qrcode-ai-scanner/THIRD-PARTY.md \
        ${destroot}${prefix}/share/doc/${name}
}

