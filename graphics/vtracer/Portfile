github.setup        visioncortex vtracer 0.6.4
github.tarball_from archive

revision            0
categories          graphics devel
license             {MIT Apache-2}
maintainers         {@yourgithub} openmaintainer

description         Raster to vector graphics converter
long_description    VTracer converts raster images (JPG, PNG, BMP) into \
                     SVG vector graphics, with support for both black & \
                     white line art and full-color photographs, as an \
                     alternative to potrace with broader input format \
                     support and native color tracing.

homepage            https://github.com/visioncortex/vtracer

checksums           vtracer-0.6.4.tar.gz \
                    rmd160  d04821c53deb255e62c9d934b1739fc4361c8540 \
                    sha256  a4b554afe0384ddbdb5f96dde2d2e6f412493ae990acc32e0d71c4f8b63d8ba4 \
                    size    30968130

depends_build-append \
                    port:cargo

# Upstream doesn't commit a Cargo.lock (a bare `cargo build --frozen`
# refuses to generate one, since that would require network access).
# We ship a real one -- generated by checking out the exact 0.6.4 tag
# and running `cargo generate-lockfile` against live crates.io -- as
# files/Cargo.lock, and drop it into the workspace root before build.
post-extract {
    file copy -force ${filespath}/Cargo.lock ${worksrcpath}/Cargo.lock
}

# The upstream repo does NOT commit a Cargo.lock (it's a workspace with
# cmdapp + webapp members). This list was generated by cloning the exact
# 0.6.4 tag and running `cargo generate-lockfile` against live crates.io,
# then extracting every [[package]] checksum from the resulting lock.
# It is a superset (includes webapp/wasm-only deps like wasm-bindgen)
# since the workspace resolves one shared lock -- harmless, cargo only
# actually compiles what cmdapp's dependency graph reaches.
#
# Re-generate on any version bump: checkout the new tag, run
# `cargo generate-lockfile`, re-extract [[package]] entries.
