# Build the CLI binary specifically (cmdapp/Cargo.toml has name = "vtracer").
# build.dir is the generic PortSystem option (not cargo-specific) that
# controls where the build.cmd is invoked from.
build.dir           ${worksrcpath}/cmdapp

destroot {
    xinstall -m 0755 \
        ${worksrcpath}/target/[cargo.rust_platform]/release/vtracer \
        ${destroot}${prefix}/bin/
}
