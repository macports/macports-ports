# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           github 1.0
PortGroup           cmake 1.1

github.setup        coin3d coin 4.0.10 v
name                Coin
license             BSD
description         cross platform C++ OpenGL scene graph library
long_description    Coin is a high-level 3D graphics library with a   \
                    C++ Application Programming Interface. Coin uses scene-graph data \
                    structures to render real-time graphics suitable for mostly all   \
                    kinds of scientific and engineering visualization applications.

conflicts           Coin-framework
categories          graphics devel
platforms           darwin
maintainers         nomaintainer

homepage            https://github.com/coin3d/coin

# Upstream publishes a purpose-built source tarball as a release asset; the
# autogenerated GitHub archive is not equivalent.
github.tarball_from releases
distname            ${github.project}-${version}-src
worksrcdir          ${github.project}

checksums           rmd160  1197ed42f84d1abb024eac964e8ad23e6ae2514e \
                    sha256  13fe68831292e7e725e7db1c6909d2b4fe5802080474c229fcac14ddf6445188 \
                    size    11855404

patchfiles          patch-coin-config.diff \
                    patch-simage.diff

compiler.cxx_standard 2011

depends_lib-append  port:simage \
                    port:fontconfig \
                    port:freetype \
                    port:expat \
                    port:zlib \
                    port:bzip2

# Coin defaults to dlopen()ing these at runtime rather than linking them. Link
# them properly instead: the libraries are hard dependencies of this port and
# are guaranteed present, and linking keeps them visible to otool and so to
# rev-upgrade.
configure.args-append \
                    -DCOIN_BUILD_TESTS=OFF \
                    -DCOIN_BUILD_DOCUMENTATION=OFF \
                    -DCOIN_BUILD_EXAMPLES=OFF \
                    -DUSE_EXTERNAL_EXPAT=ON \
                    -DFONTCONFIG_RUNTIME_LINKING=OFF \
                    -DFREETYPE_RUNTIME_LINKING=OFF \
                    -DLIBBZIP2_RUNTIME_LINKING=OFF \
                    -DSIMAGE_RUNTIME_LINKING=OFF \
                    -DZLIB_RUNTIME_LINKING=OFF \
                    -DCOIN_BUILD_MAC_FRAMEWORK=OFF

# OpenAL is resolved against the (deprecated) system framework, so it stays
# runtime-linked rather than becoming a port dependency.

# MacPorts sets CMAKE_FIND_FRAMEWORK=LAST, so FindOpenGL picks up a plain
# libGL.dylib from an installed mesa in preference to the system framework.
# Coin then links a second GL implementation and its CGL check fails, and any
# process that also holds the framework - Qt6 and opencascade both link it -
# crashes in cc_glglue_instance the first time Coin paints. Pin OpenGL to the
# framework the way FindOpenGL resolves it when mesa is absent.
pre-configure {
    set gl_framework ${configure.sdkroot}/System/Library/Frameworks/OpenGL.framework
    configure.args-append \
                    -DOPENGL_INCLUDE_DIR=${gl_framework} \
                    -DOPENGL_GLU_INCLUDE_DIR=${gl_framework} \
                    -DOPENGL_gl_LIBRARY=${gl_framework} \
                    -DOPENGL_glu_LIBRARY=${gl_framework}
}

if {${name} eq ${subport}} {
    variant manpages description {Include API documentation in manpages.} {
        depends_build-append    path:bin/doxygen:doxygen
        configure.args-replace  -DCOIN_BUILD_DOCUMENTATION=OFF \
                                -DCOIN_BUILD_DOCUMENTATION=ON
        configure.args-append   -DCOIN_BUILD_DOCUMENTATION_MAN=ON
    }
}

variant test description {Build and run the unit test suite} {
    configure.args-replace  -DCOIN_BUILD_TESTS=OFF -DCOIN_BUILD_TESTS=ON
    test.run                yes
}

subport Coin-framework {
    conflicts               Coin

    configure.args-replace  -DCOIN_BUILD_MAC_FRAMEWORK=OFF \
                            -DCOIN_BUILD_MAC_FRAMEWORK=ON
    cmake.install_prefix    ${frameworks_dir}
    configure.args-append   -DCMAKE_INSTALL_BINDIR=${prefix}/bin \
                            -DCMAKE_INSTALL_DATAROOTDIR=${prefix}/share
}
