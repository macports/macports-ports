Find simage 1.x, which ships headers and a library but no CMake package.
With SIMAGE_RUNTIME_LINKING=OFF, the optional config lookup otherwise
silently disables image loading despite the installed simage dependency.
Require the library and headers when using this fallback.

--- CMakeLists.txt.orig
+++ CMakeLists.txt
@@ -474,11 +474,18 @@
 endif()

 if(NOT SIMAGE_RUNTIME_LINKING)
-  find_package(simage)
-  if(simage_FOUND)
-    set(HAVE_LIBSIMAGE 1)
-    list(APPEND COIN_TARGET_LINK_LIBRARIES simage::simage)
-  endif()
+  find_package(simage QUIET)
+  if(NOT TARGET simage::simage)
+    # simage 1.x has no CMake package config.
+    find_path(SIMAGE_INCLUDE_DIR simage.h REQUIRED)
+    find_library(SIMAGE_LIBRARY NAMES simage REQUIRED)
+    add_library(simage::simage UNKNOWN IMPORTED)
+    set_target_properties(simage::simage PROPERTIES
+      IMPORTED_LOCATION "${SIMAGE_LIBRARY}"
+      INTERFACE_INCLUDE_DIRECTORIES "${SIMAGE_INCLUDE_DIR}")
+  endif()
+  set(HAVE_LIBSIMAGE 1)
+  list(APPEND COIN_TARGET_LINK_LIBRARIES simage::simage)
 endif()

 message(STATUS "${COIN_TARGET_INCLUDE_DIRECTORIES}")
