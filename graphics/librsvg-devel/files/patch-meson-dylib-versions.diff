#==================================================================================================
# Patch to properly set dylib versions for ABI compatibility
#
# TODO: We'll likely need to improve this a bit before submitting to upstream
#
# Author: Christopher Nielsen @ MacPorts
#==================================================================================================
--- meson.build.orig	2026-11-17 11:48:40.474978051 -0500
+++ meson.build	2026-11-17 11:47:53.296044649 -0500
@@ -11,6 +11,11 @@
 librsvg_api_major = api_split[0]
 librsvg_api_minor = api_split[1]
 
+# dylib versioning
+librsvg_darwin_version_compat = '53.0.0'
+librsvg_darwin_version_current = '53.0.0'
+librsvg_darwin_versions = [librsvg_darwin_version_compat, librsvg_darwin_version_current]
+
 librsvg_pc = 'librsvg-@0@'.format(librsvg_api_version)
 
 host_system = host_machine.system()
--- rsvg/meson.build.orig	2026-11-17 11:38:59.695750789 -0500
+++ rsvg/meson.build	2026-11-17 11:48:09.958499890 -0500
@@ -242,6 +242,7 @@
     override_options: default_overrides,
     vs_module_defs: librsvg_def,
     install: true,
+    darwin_versions: librsvg_darwin_versions,
     version: meson.project_version() # it's not exact as m4
   )
   if get_option('default_library') == 'shared'
