PortSystem          1.0
PortGroup           github 1.0

github.setup        Orc discount 3.0.2.0 v
github.tarball_from archive
revision            0
categories          textproc
maintainers         {landonf @landonf} openmaintainer
description         C implementation of the Markdown markup language
long_description    {*}${description}.
homepage            https://www.pell.portland.or.us/~orc/Code/discount/

checksums           rmd160  a576400c4cf95e1211d1332e599bbe4bcdb21bae \
                    sha256  99f6db36d3fff6c99acd21d4c6096176d4ac8785eab319d0faf77ad995b8b7c5 \
                    size    144283

license             BSD

configure.cmd       ./configure.sh
configure.args-append \
                    --shared --pkg-config

use_parallel_build  no

post-build {
    system -W ${worksrcpath} "install_name_tool -id ${prefix}/lib/libmarkdown.dylib libmarkdown.dylib"
    system -W ${worksrcpath} "install_name_tool -change libmarkdown.dylib ${prefix}/lib/libmarkdown.dylib markdown"
}

post-destroot {
    file rename ${destroot}${prefix}/bin/markdown \
                ${destroot}${prefix}/bin/${name}-markdown
}
