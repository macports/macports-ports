PortSystem          1.0
PortGroup           golang 1.0

go.setup            github.com/umputun/revdiff 1.13.0 v
revision            0
categories          textproc
maintainers         {@sikmir disroot.org:sikmir} openmaintainer
license             MIT

description         TUI for reviewing diffs, files, and documents with inline annotations
long_description    {*}${description}
homepage            https://revdiff.com/

build.cmd           make
build.pre_args-append \
                    REV=v${version} \
                    TAG=v${version}
build.args          build

checksums           rmd160  24a9c4919076a1418c51f1caff87e616fbf9d17c \
                    sha256  6ae1c6f11baefc110d14ffaed1120c26c82e27a00acf2703aeb4917d999b7a7a \
                    size    9083818

destroot {
    xinstall -m 0755 ${worksrcpath}/.bin/revdiff ${destroot}${prefix}/bin/revdiff

    set src_completion_dir ${worksrcpath}/completions

    set bash_completion_dir ${destroot}${prefix}/etc/bash_completion.d
    xinstall -d ${bash_completion_dir}
    xinstall -m 644 ${src_completion_dir}/revdiff.bash ${bash_completion_dir}/revdiff

    set fish_completion_dir ${destroot}${prefix}/share/fish/vendor_completions.d
    xinstall -d ${fish_completion_dir}
    xinstall -m 644 ${src_completion_dir}/revdiff.fish ${fish_completion_dir}/

    set zsh_completion_dir ${destroot}${prefix}/share/zsh/site-functions
    xinstall -d ${zsh_completion_dir}
    xinstall -m 644 ${src_completion_dir}/revdiff.zsh ${zsh_completion_dir}/_revdiff
}
