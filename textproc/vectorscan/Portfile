# -*- coding: utf-8; mode: tcl; tab-width: 4; truncate-lines: t; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           cmake 1.1
PortGroup           github 1.0
PortGroup           boost 1.0
PortGroup           legacysupport 1.1

# strnlen
legacysupport.newest_darwin_requires_legacy 10

github.setup        VectorCamp vectorscan 5.4.13 vectorscan/
revision            1
categories          textproc
license             BSD
maintainers         nomaintainer
github.tarball_from archive
supported_archs     arm64 x86_64

description         A portable fork of the high-performance regular \
                    expression matching library.

long_description    {*}${description} It follows the regular \
                    expression syntax of the commonly-used libpcre \
                    library, but is a standalone library with its own \
                    C API.  Vectorscan uses hybrid automata techniques \
                    to allow simultaneous matching of large numbers \
                    (up to tens of thousands) of regular expressions \
                    and for the matching of regular expressions across \
                    streams of data.  Vectorscan is typically used in a \
                    DPI library stack.

homepage            https://www.vectorcamp.gr/project/vectorscan/

checksums           rmd160  88356057a6929e15d160f6a32f83711890b8ad9b \
                    sha256  11bfcd2dde32d8a08d1a2eebb09294b12a3fa2be140078f8091b751fa1fabd89 \
                    size    20870326

conflicts           hyperscan

# Use ${python.default_version}
# name consistency with ${prefix}/var/macports/sources/rsync.macports.org/macports/release/tarballs/ports/_resources/port1.0/group/python-1.0.tcl
set python_default_version 314
set python_version  ${python_default_version}
set python_branch   [string index ${python_version} 0].[string range ${python_version} 1 end]

depends_build-append \
                    port:doxygen \
                    port:pkgconfig \
                    port:python${python_version} \
                    port:py${python_version}-breathe \
                    port:py${python_version}-sphinx \
                    port:ragel

depends_lib-append  port:pcre \
                    port:simde \
                    port:sqlite3

boost.version       1.91

compiler.cxx_standard   2023

# The flag `-DCMAKE_BUILD_TYPE=MacPorts` adds -Werror, which causes compile errors with -Wshadow
# Reference: https://github.com/intel/hyperscan/blob/master/CMakeLists.txt
cmake.build_type    Release

# upstream uses ccache, but: ccache: error: Operation not permitted
configure.ccache    yes
set ccache_dir      ${workpath}/.ccache
if {[option configure.ccache]} {
    pre-configure {
        xinstall -d ${ccache_dir} 
    }   
    configure.env-append    CCACHE_DIR=${ccache_dir} USE_CCACHE=ON
    build.env-append        CCACHE_DIR=${ccache_dir} USE_CCACHE=ON
    destroot.env-append     CCACHE_DIR=${ccache_dir} USE_CCACHE=ON
} else {
    configure.env-append    CCACHE_DISABLE=1 USE_CCACHE=OFF
    build.env-append        CCACHE_DISABLE=1 USE_CCACHE=OFF
    destroot.env-append     CCACHE_DISABLE=1 USE_CCACHE=OFF
}

switch ${build_arch} {
    arm64 {
        configure.args-append \
                    -DARCH_AARCH64=On
    }
    x86_64 {
        configure.args-append \
                    -DARCH_X86_64=On \
                    -DBUILD_AVX512=Off \
                    -DBUILD_AVX512VBMI=Off \
                    -DGNUCC_ARCH=haswell \
                    -DTUNE_FLAG=generic
    }
}

pre-configure {
    xinstall -d     ${workpath}/bin
    ln -s           ${prefix}/bin/sphinx-build-${python_branch} \
                    ${workpath}/bin/sphinx-build
}

configure.args-append \
                    -DBUILD_BENCHMARKS=Off \
                    -DBUILD_SHARED_LIBS=On \
                    -DBUILD_STATIC_LIBS=Off \
                    -DCMAKE_PROGRAM_PATH=${workpath}/bin \
                    -DFAT_RUNTIME=Off
