                    size    81933

# The CLI is an independent crate under cli/ rather than a workspace member:
# the repository root is the boon library, and cli/ depends on it by path.
build.dir           ${worksrcpath}/cli

destroot {
    xinstall -m 0755 \
        ${build.dir}/target/[cargo.rust_platform]/release/${name} \
        ${destroot}${prefix}/bin/

    set docdir ${destroot}${prefix}/share/doc/${name}
    xinstall -d ${docdir}
    xinstall -m 0644 -W ${worksrcpath} LICENSE-MIT LICENSE-APACHE README.md ${docdir}
}
