description         Command-line JSON Schema validator

long_description    {*}${description}. ${name} validates JSON and YAML \
                    documents against a JSON Schema, supporting drafts 4, 6, \
                    7, 2019-09 and 2020-12, with optional format and content \
                    assertions and several output formats.

categories          textproc
installs_libs       no
license             {MIT Apache-2}
maintainers         @jrjsmrtn openmaintainer

checksums           ${distname}${extract.suffix} \
                    rmd160  b686fca33ef6aa2f37c29563afe92456bfd7980e \
