# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           app 1.0
PortGroup           qt5 1.0
PortGroup           meson 1.0

name                recoll
version             1.44.2
revision            0

categories          textproc
license             GPL-2+
maintainers         {dockes.org:jf @medoc92} openmaintainer

description         Desktop full text search
long_description    Recoll is a desktop search tool based on Xapian

homepage            https://www.lesbonscomptes.com/recoll/
master_sites        ${homepage}

checksums           rmd160  7cc687b6917c94dd49b61f24f175678855fc4f7a \
                    sha256  1fb8762b6816dac1a17fe7ff5669cd49cad0aedf62284a93e58ff3e7123c7b13 \
                    size    3391166

# disable unexpected download of subprojects
meson.wrap_mode     nodownload

set py_ver          3.14
set py_ver_nodot    [string map {. {}} ${py_ver}]

patchfiles-append   patch-python-meson.build.diff \
                    patch-IOKit-meson.build.diff \
                    patch-rclgrep_meson.build.diff

post-patch {
    reinplace "s|@@PYTHON_BIN@@|${prefix}/bin/python${py_ver}|g" \
        ${worksrcpath}/meson.build

    reinplace "s|@@PYTHON_BRANCH@@|${py_ver}|g" \
        ${worksrcpath}/meson.build
}

qt5.depends_component qtwebkit qttools

depends_lib-append  port:aspell \
                    port:jsoncpp \
                    port:libiconv \
                    port:libmagic \
                    port:libxml2 \
                    port:libxslt \
                    port:python${py_ver_nodot} \
                    port:xapian-core \
                    port:zlib

depends_run-append  port:antiword \
                    port:py${py_ver_nodot}-lxml \
                    path:lib/pkgconfig/poppler.pc:poppler \
                    port:unrtf \
                    port:unzip

compiler.cxx_standard 2017

configure.args-append \
                    -Dpython-module=false \
                    -Dpython-aspell=false \
                    -Dpython-chm=false \
                    -Dsystemd=false \
                    -Drecollq=true \
                    -Drclgrep=true \
                    -Dx11mon=false \
                    -Dinotify=false

build.env-append    QMAKE=${prefix}/libexec/qt5/bin/qmake


pre-destroot {
    xinstall -m 0755 ${workpath}/build/qtgui/recoll.app/Contents/MacOS/recoll ${destroot}${prefix}/bin/${name}
}

post-destroot {
    system "install_name_tool -change @rpath/librecoll.39.dylib ${prefix}/lib/librecoll.39.dylib ${destroot}${prefix}/bin/${name}"
}

livecheck.url       ${homepage}/pages/download.html
