# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           cargo 1.0
PortGroup           github 1.0

github.setup        campkitchenus-maker rust-campchecklist 1.1.0 v
github.tarball_from releases
name                campchecklist
distname            campchecklist-${version}
revision            0

categories          textproc
license             MIT
maintainers         {@campkitchenus-maker} openmaintainer

description         Plain-text packing checklists for camping trips
long_description    campchecklist reads and edits plain-text packing lists \
                    made of '# Section' headings and '- \[ \]' / '- \[x\]' \
                    items. It shows packing progress per section, lists \
                    what is left, toggles or resets items in place, and \
                    prints a car-camping kitchen starter list.

homepage            https://campkitchen.us/pages/campchecklist

checksums           rmd160  7684d3766e299070aee1f9d8688df0e60e58d295 \
                    sha256  62ab56a8a2eb12b3449ffa77ff2c854e2f486cde87bba131bd5e845ed2bead2c \
                    size    7816

destroot {
    xinstall -m 0755 ${worksrcpath}/target/[cargo.rust_platform]/release/${name} \
        ${destroot}${prefix}/bin/
    xinstall -d ${destroot}${prefix}/share/doc/${name}
    xinstall -m 0644 -W ${worksrcpath} README.md CHANGELOG.md LICENSE \
        car-camping-kitchen.camp ${destroot}${prefix}/share/doc/${name}
}

test.run            yes
test.cmd            ${cargo.bin} test
test.target
test.pre_args       --release ${cargo.offline_cmd}
test.args           --target [cargo.rust_platform]
