# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           github 1.0
PortGroup           java 1.0

name                saxon
github.setup        Saxonica Saxon-HE 13.0 SaxonHE
livecheck.version   [string map {. -} ${version}]
git.branch          [join ${github.tag_prefix}]${livecheck.version}[join ${github.tag_suffix}]

categories          textproc java
license             MPL-2
maintainers         nomaintainer
platforms           any
supported_archs     noarch

description         saxon home edition - collection of tools to process XML documents
long_description    Saxon-HE provides implementations of XSLT 3.0, XQuery 3.1, \
                    XPath 3.1, and XSD 1.1 with a minimum level of conformance \
                    to the W3C recommendations.

homepage            https://www.saxonica.com
distname            [string totitle ${name}]HE${livecheck.version}J

checksums           rmd160  cc6b572befad2efa13b18f556b6ed9742c62e4b4 \
                    sha256  4a08ac02d8ea26b769bf14274bef27b3c8bbf2557b20b7e4258d172e99638163 \
                    size    8112309

java.version        17+
java.fallback       openjdk21

extract.mkdir       yes
use_zip             yes

use_configure       no

build               {}

destroot {
    set destdocdir  ${destroot}${prefix}/share/doc/${name}
    set destjavadir ${destroot}${prefix}/share/java

    xinstall -d ${destjavadir}
    xinstall -m 644 \
        ${worksrcpath}/${name}-he-${version}.jar \
        ${destjavadir}/${name}-he.jar
    xinstall -m 644 \
        ${worksrcpath}/${name}-he-xqj-${version}.jar \
        ${destjavadir}/${name}-he-xqj.jar

    # Install full documentation when published upstream
    xinstall -d ${destdocdir}
    xinstall -m 644 \
        ${worksrcpath}/notices/LICENSE.txt \
        ${destdocdir}
}
