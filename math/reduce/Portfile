PortSystem              1.0

name                    reduce
version                 20260307
revision                0
set version_dashes      [regsub {^(\d{4})(\d{2})(\d{2})$} ${version} {\1-\2-\3}]
set snapshot_dir        2026-03-08
categories              math lang
license                 BSD
universal_possible      false
use_bzip2               yes
maintainers             {gmail.com:mark.brethen @mbrethen} openmaintainer
description             REDUCE Computer Algebra System
long_description \
    REDUCE is an interactive system for general algebraic computations of \
    interest to mathematicians, scientists and engineers.
homepage                https://reduce-algebra.sourceforge.io/
master_sites            sourceforge:project/reduce-algebra/snapshot_${snapshot_dir}/macintosh
distname                Reduce-source_${version_dashes}
default_variants        +csl
universal_variant       no
notes                   "Default variant only install csl lisp.\
                        If both csl and psl are desired use\
                        +both_csl_psl variant.\
                        reduce documentation is in\
                        ${prefix}/share/doc/$name.\
                        Emacs reduce-mode lisp files are in\
                        ${prefix}/share/doc/$name/emacs.\
                        When invoking redcsl start the X11\
                        server first. This is not necessary\
                        when running reduce.app."

pre-fetch {
    if {${build_arch} eq "arm64" && ![variant_isset csl]} {
        ui_error {psl is not yet supported on arm64}
        return -code error 
    }
}

# the archive extracts directly to the worksrcpath instead of
# creating a top level directory
set worksrcdir      {.}

checksums               sha256  88e2f039821d45555f60fb75b1d61de81661a0f7386792a1b6288b84ed2007c4 \
                        rmd160  dac48eb58e95cc726f6e8777d58dd8feade89fb8 \
                        size    147103665

compiler.cxx_standard 2011

depends_build-append    port:gnuplot \
                        port:gmake \
                        port:automake \
                        port:autoconf \
                        port:libtool \
                        port:brotli \
                        port:freetype \
                        port:xorg-xorgproto \
                        port:xorg-libX11 \
                        port:xorg-libXcursor \
                        port:xorg-libXext \
                        port:Xft2 \
                        port:xorg-libXrandr \
                        port:xrender

depends_lib-append      \
                        port:libffi \
                        port:brotli

# does not build w/o these
configure.env-append    enable_universal=no
configure.ldflags-append -lbrotlicommon -lbrotlidec -lhvf

use_parallel_build      no
patchfiles-append       patch-packages-plot-gnuintfc.red.diff

# eliminated moving doc files to libexec/reduce, moved them to 
# ${prefix/share/doc/reduce.
variant csl conflicts psl both_csl_psl description {Uses CSL (Codemist Standard Lisp) and builds gui.} {
    configure.args-append   --with-csl
    destroot {
        set builddir [exec ${worksrcpath}/scripts/findhost.sh [exec ${worksrcpath}/config.guess]]
        set cslbuilddir ${worksrcpath}/cslbuild/${builddir}
        set bindir      ${destroot}${prefix}/bin
        set appsdir     ${destroot}${applications_dir}/${name}
        xinstall -d \
            ${destroot}${prefix}/share/doc/${name} \
            ${appsdir}
        copy {*}[glob ${worksrcpath}/doc/*] ${destroot}${prefix}/share/doc/${name}
        copy ${worksrcpath}/generic/emacs ${destroot}${prefix}/share/doc/${name}

        copy ${cslbuilddir}/csl/reduce.app ${appsdir}
        xinstall ${worksrcpath}/macbuild/runcsl.sh ${appsdir}/redcsl
        xinstall ${cslbuilddir}/redfront/rfcsl ${appsdir}
        ln -s ${applications_dir}/${name}/redcsl ${bindir}/redcsl
        ln -s ${applications_dir}/${name}/rfcsl ${bindir}/rfcsl
    }
}

# per the developers psl is not yet supported for arm64. 
variant psl conflicts csl both_csl_psl description {Uses PSL (Portable Standard Lisp). It does not include a gui.} {
    # not sure if this is the right approach, either throw an error
    # early or let the build fail w/o clear reason why it failed
    configure.args-delete   --with-csl
    configure.args-append   --with-psl
    destroot {
        set builddir [exec ${worksrcpath}/scripts/findhost.sh [exec ${worksrcpath}/config.guess]]
        set pslbuilddir ${worksrcpath}/pslbuild/${builddir}
        set cslbuilddir ${worksrcpath}/cslbuild/${builddir}
        set libexecdir  ${destroot}${prefix}/libexec/${name}
        set bindir      ${destroot}${prefix}/bin
        set appsdir     ${destroot}${applications_dir}/${name}
        xinstall -d \
            ${libexecdir} \
            ${libexecdir}/psl \
            ${libexecdir}/psl/psl \
            ${libexecdir}/psl/red \
            ${appsdir}

        copy ${worksrcpath}/macbuild/README.for.distribution ${libexecdir}/README
        copy {*}[glob ${pslbuilddir}/psl/*] ${libexecdir}/psl/psl
        copy {*}[glob ${pslbuilddir}/red/*] ${libexecdir}/psl/red
        xinstall -m a+rx ${worksrcpath}/macbuild/runpsl.sh ${libexecdir}/psl/redpsl
        xinstall -m a+rx ${cslbuilddir}/redfront/rfpsl ${libexecdir}/psl

        copy {*}[glob ${worksrcpath}/doc/*] ${destroot}${prefix}/share/doc/${name}
        copy ${worksrcpath}/generic/emacs ${destroot}${prefix}/share/doc/${name}

        ln -s ${prefix}/libexec/${name}/psl/redpsl ${bindir}/redpsl
        ln -s ${prefix}/libexec/${name}/psl/rfpsl ${bindir}/rfpsl
    }
}

variant both_csl_psl conflicts csl psl description {Install both CSL and PSL versions of Reduce.} {
    # not sure if this is the right approach, either throw an error
    # early or let the build fail w/o clear reason why it failed
    configure.args-delete   --with-csl
    configure.args-append   --with-both
    destroot {
        set builddir [exec ${worksrcpath}/scripts/findhost.sh [exec ${worksrcpath}/config.guess]]
        set pslbuilddir ${worksrcpath}/pslbuild/${builddir}
        set cslbuilddir ${worksrcpath}/cslbuild/${builddir}
        set libexecdir  ${destroot}${prefix}/libexec/${name}
        set bindir      ${destroot}${prefix}/bin
        set appsdir     ${destroot}${applications_dir}/${name}
    
        xinstall -d \
            ${libexecdir} \
            ${libexecdir}/psl \
            ${libexecdir}/psl/psl \
            ${libexecdir}/psl/red \
            ${appsdir}
    
        copy ${worksrcpath}/macbuild/README.for.distribution ${libexecdir}/README
        copy ${cslbuilddir}/csl/reduce.app ${appsdir}
        xinstall -m a+rx ${worksrcpath}/macbuild/runcsl.sh ${appsdir}/redcsl
        xinstall -m a+rx ${cslbuilddir}/redfront/rfcsl ${appsdir}
        
        copy {*}[glob ${pslbuilddir}/psl/*] ${libexecdir}/psl/psl
        copy {*}[glob ${pslbuilddir}/red/*] ${libexecdir}/psl/red
        xinstall -m a+rx ${worksrcpath}/macbuild/runpsl.sh ${libexecdir}/psl/redpsl
        xinstall -m a+rx ${pslbuilddir}/redfront/rfpsl ${libexecdir}/psl
    
        copy {*}[glob ${worksrcpath}/doc/*] ${destroot}${prefix}/share/doc/${name}
        copy ${worksrcpath}/generic/emacs ${destroot}${prefix}/share/doc/${name}
    
        # link scripts to ${prefix}/bin
        ln -s ${applications_dir}/${name}/redcsl ${bindir}/redcsl
        ln -s ${prefix}/libexec/${name}/psl/redpsl ${bindir}/redpsl
        ln -s ${applications_dir}/${name}/rfcsl ${bindir}/rfcsl
        ln -s ${prefix}/libexec/${name}/psl/rfpsl ${bindir}/rfpsl
    }
}

post-patch {
    reinplace -W ${worksrcpath} "s|@PREFIX@|${prefix}|g" \
        packages/plot/gnuintfc.red
}

livecheck.version   ${version_dashes}
livecheck.url       https://sourceforge.net/projects/reduce-algebra/files/
livecheck.regex     {snapshot_(\d{4}-\d{2}-\d{2})}
