# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           github 1.0

github.setup        NFFT nfft 3.6.0
github.tarball_from releases
revision            0

name                nfft-3
distname            nfft-${version}
categories          math
license             GPL-2+
maintainers         {nfft.org:jens @jenskeiner} openmaintainer
homepage            https://nfft.org/

description         Fast C routines to compute the Non-equispaced Discrete Fourier Transform
long_description    NFFT3 is a C library for computing nonequispaced fast Fourier \
                    transforms (NFFT) and generalisations: to arbitrary knots in time \
                    and frequency (NNFFT), to the sphere S^2 (NFSFT), to the hyperbolic \
                    cross (NSFFT), to real-valued data (NFCT, NFST) and to the rotation \
                    group (NFSOFT), together with iterative inverse solvers.

checksums           rmd160  13efbe3e9a3013db218eeef58aa09dff3a74c170 \
                    sha256  9a023a997e8513c83112df7bbb30d1d3983b796e8dbca9777db7d8ca186c00e0 \
                    size    6928580

depends_lib         port:fftw-3
depends_test        port:cunit

configure.args      --enable-shared \
                    --enable-static \
                    --enable-all \
                    --enable-portable-binary

test.run            yes
test.target         check

variant openmp description {Build the OpenMP-parallel libnfft3_omp} {
    compiler.openmp_version 2.5
    configure.args-append   --enable-openmp
}

variant gaussian description {Use the Gaussian window instead of Kaiser-Bessel} conflicts bspline sinc {
    configure.args-append   --with-window=gaussian
}

variant bspline description {Use the B-spline window instead of Kaiser-Bessel} conflicts gaussian sinc {
    configure.args-append   --with-window=bspline
}

variant sinc description {Use the sinc power window instead of Kaiser-Bessel} conflicts gaussian bspline {
    configure.args-append   --with-window=sinc
}

# Ignore release candidates such as 3.6.0-rc1.
github.livecheck.regex {([0-9.]+)}
