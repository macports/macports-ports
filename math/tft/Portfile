PortSystem          1.0
PortGroup           github 1.0
PortGroup           cmake 1.1

github.setup        kgramhans tft 0.6 v
revision            0
categories          math devel
license             GPL-3
maintainers         {makr @mohd-akram} openmaintainer

description         time/frequency transform library

long_description    tft is a library for performing transformation of signals \
                    (1D) into the time/frequency domain (2D). Also, backward \
                    transform from time/frequency domain to pure time domain \
                    is offered - allowing for masking out parts of the signal \
                    in the time/frequency domain.

github.tarball_from archive

checksums           rmd160  23f8ee57705b05f379b6252c46ac80bfd05caf52 \
                    sha256  a22e6500413b05b6c35b1df93577c2026675bfcf68438b09a80009fa75bbaf1e \
                    size    60276

post-patch {
    reinplace "s|add_subdirectory(gtest)||" ${worksrcpath}/CMakeLists.txt
}

configure.args      -DBUILD_SHARED_LIBS=ON \
                    -DCMAKE_BUILD_WITH_INSTALL_NAME_DIR=ON

destroot {
    copy ${worksrcpath}/include/tft ${destroot}${prefix}/include
    copy ${build.dir}/src/libtft.dylib ${destroot}${prefix}/lib
}
