# upstream builds with `cmake -S src` and require C17 and C++17.
cmake.source_dir    ${worksrcpath}/src
compiler.c_standard 2017
compiler.cxx_standard 2017

# the built-in manual needs SQLite driver.
qt6.depends_run-append sqlite-plugin

qt6.depends_lib-append qttools

destroot {
    xinstall -d ${destroot}${applications_dir}
    copy ${build.dir}/SpeedCrunch.app ${destroot}${applications_dir}
}
