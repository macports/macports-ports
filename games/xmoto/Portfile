# build-fix resolves compile errors by modifying the source code
patchfiles      build-fix.diff

if {${os.platform} eq "darwin"} {
  cmake.install_prefix \
                  ${destdir}${applications_dir}

  configure.args-append \
                  -DBUILD_MACOS_BUNDLE=ON

  patchfiles-append \
                  no-sign-and-fixup_bundle.diff \
                  opengl-link-system-framework.diff
}

