destroot {
    xinstall -m 0755 ${worksrcpath}/target/[cargo.rust_platform]/release/pumpkin \
        ${destroot}${prefix}/bin/
    xinstall -d ${destroot}${prefix}/share/doc/${name}
    xinstall -m 0644 -W ${worksrcpath} README.md LICENSE \
        assets/NOTICE.md assets/bedrock/LICENSE-GEYSER \
        ${destroot}${prefix}/share/doc/${name}/
}

