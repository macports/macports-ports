From 98b9581e63692e7e739d21e9d032f1840b04ac6e Mon Sep 17 00:00:00 2001
From: "Juergen E. Fischer" <jef@norbit.de>
Date: Mon, 10 Aug 2026 21:52:39 +0200
Subject: [PATCH 1/2] fix build with SIP 6.11 (debian unstable; fixes #66993;
 cherry-picked from c7621db47a)

---
 python/CMakeLists.txt       |  8 ++++++++
 python/core/conversions.sip | 40 ++++++++++++++++++++++++++++++++++++-
 python/core/core.sip.in     |  1 +
 3 files changed, 48 insertions(+), 1 deletion(-)

diff --git a/python/CMakeLists.txt b/python/CMakeLists.txt
index bb15706392e0..f7fb44921175 100644
--- python/CMakeLists.txt
+++ python/CMakeLists.txt
@@ -127,6 +127,14 @@ if(NOT WITH_QTWEBENGINE)
   set(SIP_DISABLE_FEATURES ${SIP_DISABLE_FEATURES} HAVE_WEBENGINE_SIP)
 endif()
 
+# sip 6.11 has support for the Movable Mapped Type Annotation
+# Including the annotation with older sip versions will throw a parser error,
+# so we need to generate a file without it for older versions
+if(${SIP_VERSION_STR} VERSION_LESS 6.11.0)
+  set(SIP_DISABLE_FEATURES ${SIP_DISABLE_FEATURES} MOVABLE_MAPPED_TYPE)
+else()
+  set(SIP_MOVABLE_STR "Movable,")
+endif()
 # Deprecated annotation supports message only since version 6.9.0 with abi-version 12.16 / 13.9 and above
 if(${SIP_VERSION_STR} VERSION_LESS 6.9.0)
   set(sipabi "")
diff --git a/python/core/conversions.sip b/python/core/conversions.sip
index 81872ec53a23..a8a655a7e6b4 100644
--- python/core/conversions.sip
+++ python/core/conversions.sip
@@ -1241,6 +1241,44 @@ which are not wrapped by PyQt:
     %End
 };
 
+%If (MOVABLE_MAPPED_TYPE)
+template <TYPE>
+%MappedType std::unique_ptr<TYPE> /@SIP_MOVABLE_STR@NoRelease,AllowNone,TypeHint="Optional[TYPE]",TypeHintValue="TYPE"/
+{
+%TypeHeaderCode
+#include <memory>
+#include <utility>      // For std::move().
+%End
+
+%ConvertFromTypeCode
+  const sipTypeDef *sip_type = sipFindType("TYPE*");
+  return sipConvertFromNewType(sipCpp->release(), sip_type, NULL);
+%End
+
+%ConvertToTypeCode
+  const sipTypeDef *sip_type = sipFindType("TYPE");
+
+  if (sipIsErr == NULL)
+    return sipCanConvertToType(sipPy, sip_type, 0);
+
+  if (sipPy == Py_None)
+    return 1;
+
+  int state;
+  TYPE *type_ = reinterpret_cast<TYPE *>(sipConvertToType(sipPy, sip_type, sipTransferObj, 0, &state, sipIsErr));
+
+  sipReleaseType(type_, sip_type, state);
+
+  if (*sipIsErr)
+    return 0;
+
+  *sipCppPtr = new std::unique_ptr<TYPE>(type_);
+  return sipGetState(sipTransferObj);
+%End
+};
+%End
+
+%If (!MOVABLE_MAPPED_TYPE)
 template <TYPE>
 %MappedType std::unique_ptr< TYPE > /NoRelease,AllowNone,TypeHint="Optional[TYPE]",TypeHintValue="TYPE"/
 {
@@ -1258,7 +1296,7 @@ template <TYPE>
   return 0;
 %End
 };
-
+%End
 
 template <TYPE>
 %MappedType QVector< QVector<TYPE> >
diff --git a/python/core/core.sip.in b/python/core/core.sip.in
index 8378dd455203..6603f49dd37d 100644
--- python/core/core.sip.in
+++ python/core/core.sip.in
@@ -97,6 +97,7 @@ done:
 %Feature ANDROID
 %Feature VECTOR_MAPPED_TYPE
 %Feature HAVE_WEBENGINE_SIP
+%Feature MOVABLE_MAPPED_TYPE
 
 %Import QtXml/QtXmlmod.sip
 %Import QtNetwork/QtNetworkmod.sip

