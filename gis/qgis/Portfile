# Use MacPorts libraries and Python instead of the self-contained SDK layout.
patchfiles-append   patch-macports-bundle.diff \
                    patch-Info.plist.in.diff \
                    patch-python-home.diff

post-patch {
    reinplace "s|@PREFIX@|${prefix}|g" ${worksrcpath}/platform/macos/Info.plist.in
}

# QGIS 4 installs the Contents tree directly below CMAKE_INSTALL_PREFIX.
cmake.install_prefix \
                    ${applications_dir}/${app_name}.app
cmake.install_rpath ${cmake.install_prefix}/Contents/Frameworks \
                    ${qt6.dir}/lib \
                    ${prefix}/lib

# Let QGIS use @rpath IDs instead of the PortGroup's default app/lib directory.
configure.pre_args-delete \
                    -DCMAKE_INSTALL_NAME_DIR=\"${cmake.install_prefix}/lib\"

pre-configure {
    # Figure out HDF5's mpi include directory
    set mpl_include_dir ""
    if {![catch {set result [active_variants hdf5 openmpi]}]} {
        if {$result} {
            set mpl_include_dir "-I${prefix}/include/openmpi-mp"
        }
    }
    if {![catch {set result [active_variants hdf5 mpich]}]} {
        if {$result} {
            set mpl_include_dir "-I${prefix}/include/mpich-mp"
        }
    }
    if {$mpl_include_dir ne ""} {
        configure.cxxflags-append ${mpl_include_dir}
    }
}

configure.args-append \
                    -DENABLE_TESTS=OFF \
                    -DEXPAT_INCLUDE_DIR=${prefix}/include \
                    -DEXPAT_LIBRARY=${prefix}/lib/libexpat.dylib \
                    -DGDAL_CONFIG=${prefix}/bin/gdal-config \
                    -DGEOS_CONFIG=${prefix}/bin/geos-config \
                    -DLIBZIP_CONF_INCLUDE_DIR=${prefix}/lib/pkgconfig \
