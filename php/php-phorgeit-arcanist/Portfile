# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:filetype=tcl:et:sw=4:ts=4:sts=4

PortSystem                  1.0
PortGroup                   github 1.0
PortGroup                   php 1.1

name                        php-phorgeit-arcanist
categories-append           devel
maintainers                 {ngie-eign @ngie-eign} openmaintainer
license                     Apache-2

description                 "Phorge.it Arcanist libraries"
long_description            Arcanist is the command-line tool for Phorge.  It \
                            allows you to interact with Phorge installs to \
                            send code for review, download patches, transfer \
                            files, view status, make API calls, and various \
                            other things.
homepage                    https://we.phorge.it/book/arcanist/

php.branches                8.3 8.4 8.5 8.6

version                     2026.27
github.setup                phorgeit arcanist 63de5a2953b79dbe6aac4ed92bdb64b45cad53d6
github.tarball_from         archive

if {[vercmp ${php.branch} >= 8.3]} {
    revision                0
    checksums               rmd160  e4f0943f2e21b7adaff7d8adce0349c0b7b81cde \
                            sha256  9211ead91f5968018f6f51ca782419518a7da1fec451882745c7780ac7c4ad41 \
                            size    2483182
}

if {${name} ne ${subport}} {
    # These variables make it easier to code-share with FreeBSD's port
    # (`devel/phorgeit-arcanist-lib`).
    set PHP_DESTDIR         lib/php/arcanist
    set PKGNAMEPREFIX       "${php}-"
    set PKGNAMESUFFIX       ""
    set PKGORIGIN           php/php-phorgeit-arcanist
    set PKGVERSION          ${version}
    set PORTNAME            forgeit-arcanist
    set PREFIX              ${prefix}

    patchfiles              patch-src_error_PhutilErrorHandler.php \
                            patch-src_future_http_HTTPSFuture.php \
                            patch-src_lint_linter_ArcanistPhpLinter.php \
                            patch-src_moduleutils_PhutilLibraryMapBuilder.php \
                            patch-src_phage_bootloader_PhagePHPAgentBootloader.php \
                            patch-src_runtime_ArcanistRuntime.php \
                            patch-src_toolset_workflow_ArcanistVersionWorkflow.php \
                            patch-src_utils_PhutilExecutionEnvironment.php \
                            patch-src_workflow_ArcanistAnoidWorkflow.php \
                            patch-src_workflow_ArcanistLiberateWorkflow.php \
                            patch-support_shell_hooks_bash-completion.sh

    # The package doesn't provide a configure script.
    set php.build_dirs {}
    use_configure no

    post-patch {
        foreach subdir {bin src} {
            foreach script [glob ${worksrcpath}/${subdir}/*] {
                reinplace "s|^#!.*php|#!${prefix}/bin/${php}|" $script
            }
        }

        set file "src/toolset/workflow/ArcanistVersionWorkflow.php"
        reinplace -W ${worksrcpath} "s|%%PKGNAME%%|${PKGNAMEPREFIX}${PORTNAME}${PKGNAMESUFFIX}|g" ${file}
        reinplace -W ${worksrcpath} "s|%%PKGVERSION%%|${PKGVERSION}|g" ${file}
        reinplace -W ${worksrcpath} "s|%%PKGORIGIN%%|${PKGORIGIN}|g" ${file}

        set files [list]
        lappend files src/lint/linter/ArcanistPhpLinter.php
        lappend files src/moduleutils/PhutilLibraryMapBuilder.php
        lappend files src/phage/bootloader/PhagePHPAgentBootloader.php
        lappend files src/runtime/ArcanistRuntime.php
        lappend files src/utils/PhutilExecutionEnvironment.php
        lappend files src/workflow/ArcanistLiberateWorkflow.php

        foreach file $files {
            reinplace -W ${worksrcpath} "s|%%PHP_CMD%%|${PREFIX}/bin/${php}|g" ${file}
        }

        #reinplace -W ${worksrcpath} "s|%%PYTHON_CMD%%|${prefix}/bin/python${python.version}|g" ${file}

        set file "support/shell/hooks/bash-completion.sh"
        reinplace -W ${worksrcpath} "s|%%PREFIX%%|${PREFIX}|g" ${file}
        reinplace -W ${worksrcpath} "s|%%PHP_DESTDIR%%|${PHP_DESTDIR}|g" ${file}
    }

    post-destroot {
        xinstall -d ${destroot}${prefix}/bin

        xinstall -d ${destroot}${prefix}/${PHP_DESTDIR}
        xinstall -d ${destroot}${prefix}/share/bash-completion/completions/

        set dirs [list bin externals resources scripts src support]
        foreach dir $dirs {
            copy ${worksrcpath}/$dir ${destroot}${prefix}/${PHP_DESTDIR}/$dir
        }

        file link -symbolic ${destroot}${prefix}/bin/arc ../${PHP_DESTDIR}/bin/arc
        file link -symbolic ${destroot}${prefix}/share/bash-completion/completions/arc ${destroot}${prefix}/${PHP_DESTDIR}/support/shell/hooks/bash-completion.sh

        system -W ${destroot} "find . -print0 | xargs -0 chown root:wheel"
        system -W ${destroot} "find . -type d -print0 | xargs -0 chmod 0555"
        system -W ${destroot} "find . ! -type d -print0 | xargs -0 chmod 0444"
        system -W ${destroot}${prefix}/bin "find . -type f -print0 | xargs -0 chmod 0555"
        # For whatever reason the package puts the underlying binary here.
        system -W ${destroot}${prefix}/${PHP_DESTDIR} "chmod +x bin/arc"

        file delete ${destroot}${prefix}/${PHP_DESTDIR}/resources/ssl/default.pem
        system -W ${destroot}${prefix}/${PHP_DESTDIR} "./bin/arc shell-complete --generate"
    }

    depends_lib         port:${php}-curl
}
