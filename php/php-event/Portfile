# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem              1.0
PortGroup               php 1.1

name                    php-event
categories-append       devel
maintainers             {ryandesign @ryandesign} {mathiesen.info:macintosh @BjarneDMat} openmaintainer
license                 PHP-3.01

php.branches            5.4 5.5 5.6 7.0 7.1 7.2 7.3 7.4 8.0 8.1 8.2 8.3 8.4 8.5 8.6
php.pecl                yes

# This extension must load after the sockets extension.
php.extension_ini       ~${php.extension_ini}

if {[vercmp ${php.branch} >= 5.4]} {
    version             3.1.6
    revision            0
    checksums           rmd160  4566c1682e6ea4a94e4961f88467d84ba3cac468 \
                        sha256  5b74554c6370aae8c284c8110fe27e071d3f663953c3eb762ffc429b0a3c83a2 \
                        size    205292
}

description             efficiently schedule I/O, time and signal based events

long_description        PECL extension to ${description} using libevent.

if {${name} ne ${subport}} {
    depends_lib-append  port:libevent \
                        path:lib/libssl.dylib:openssl \
                        port:${php}-sockets

    configure.args-append \
                        --with-event-libevent-dir=${prefix}

    if {[vercmp ${php.branch} < 7.4]} {
        configure.args-append \
                        --with-openssl-dir=${prefix}
    } else {
        depends_build-append    path:bin/pkg-config:pkgconfig
    }
}
