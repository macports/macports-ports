    #                    size    26577174
    #depends_run         port:audacity
    #use_configure       no
    #build               {}
    #installs_libs       no
    #supported_archs     noarch
    #platforms           {darwin any}
    #worksrcdir          help

    #set data_dir        ${prefix}/share/audacity
    #platform darwin {
    #    set data_dir    ${audacity_dir}
    #}

    #destroot {
    #    xinstall -d ${destroot}${data_dir}
    #    copy ${worksrcpath} ${destroot}${data_dir}
    #}
}
