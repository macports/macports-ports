From fe37c951b08d33adf6f6d58ac682df8fb80df350 Mon Sep 17 00:00:00 2001
From: Dmitry Makarenko <kryksyh@gmail.com>
Date: Wed, 4 Nov 2026 19:48:27 +0300
Subject: [PATCH] Fix id3tag target name

---
 recipes/libid3tag/meta.cmake | 2 +-
 recipes/libid3tag/spec.cmake | 6 +++---
 2 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/recipes/libid3tag/meta.cmake b/recipes/libid3tag/meta.cmake
index ce37a42..1797a1b 100644
--- muse_deps/recipes/libid3tag/meta.cmake
+++ muse_deps/recipes/libid3tag/meta.cmake
@@ -1,6 +1,6 @@
 # Audacity's fork only builds static on Windows; keep it static everywhere
 set(DEP_TARGET libid3tag::libid3tag)
-set(DEP_LIBS libid3tag)
+set(DEP_LIBS id3tag)
 set(DEP_STATIC ON)
 set(DEP_LINK_DEPS zlib::zlib)
 set(DEP_SYSTEM_HEADER id3tag.h)
diff --git a/recipes/libid3tag/spec.cmake b/recipes/libid3tag/spec.cmake
index 121c6c3..d1c3cd7 100644
--- muse_deps/recipes/libid3tag/spec.cmake
+++ muse_deps/recipes/libid3tag/spec.cmake
@@ -1,8 +1,8 @@
-set(DEP_VERSION 0.15.2b)
+set(DEP_VERSION 0.15.2c)
 
 # Audacity's fork: adds a CMake build and ID3v2.3 rendering (ID3_TAG_OPTION_ID3V2_3)
-set(DEP_SOURCE_URL    "https://github.com/audacity/libid3tag/archive/refs/tags/0.15.2b.tar.gz")
-set(DEP_SOURCE_SHA256 "1db8b1627b664e32094621efc1431a3471d760cc88800021e347302398ef5c6c")
+set(DEP_SOURCE_URL    "https://github.com/audacity/libid3tag/archive/refs/tags/0.15.2c.tar.gz")
+set(DEP_SOURCE_SHA256 "bef04cb487b7bdd69ee854f445ff994c197a6f7aeb5579258079bafe7d71b7df")
 
 set(DEP_DEPENDS zlib)
 
