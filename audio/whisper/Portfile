# Mirror a ggml variant here when it adds a backend to GGML_AVAILABLE_BACKENDS
# in ${prefix}/lib/cmake/ggml/ggml-config.cmake. Each of those builds a
# libggml-*.dylib that whisper's binaries link directly, so a ggml rebuilt
# without one leaves whisper failing at load time. ggml's other variants only
# retune code inside libggml and leave whisper's link line unchanged.
variant blas description {Use ggml with BLAS support} {
    require_active_variants ggml blas
}

variant opencl description {Use ggml with OpenCL support} {
    require_active_variants ggml opencl
}

variant metal conflicts vulkan description {Use ggml with Metal support} {
    require_active_variants ggml metal
}

variant vulkan conflicts metal description {Use ggml with Vulkan support} {
    require_active_variants ggml vulkan
}

default_variants    +blas

# Keep this in step with ggml's own +metal default: ggml builds the backend and
# carries the reason for the threshold.
if {${os.platform} eq "darwin" && ${os.major} >= 20 && \
    ${configure.sdk_version} >= 11} {
    default_variants    +metal
}
