+# Do not prepend -l to full paths returned by find_library(), or embed SDK paths.
+set(PC_COMMON_LINK_LIBRARIES)
+foreach(LIB IN LISTS COMMON_LINK_LIBRARIES)
+    get_filename_component(LIB_NAME "${LIB}" NAME_WE)
+    string(REGEX REPLACE "^lib" "" LIB_NAME "${LIB_NAME}")
+    list(APPEND PC_COMMON_LINK_LIBRARIES "-l${LIB_NAME}")
+endforeach()
+string(JOIN " " MINIAUDIO_PC_LIBS_PRIVATE ${PC_COMMON_LINK_LIBRARIES})
