# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           perl5 1.0

name                yfklog
version             0.7.0
revision            0
categories          science
license             GPL-2
maintainers         nomaintainer
platforms           {darwin any}
supported_archs     noarch

description         Text-mode ham radio logbook written in Perl
long_description    YFKlog is a general purpose, console-based ham radio \
                    logbook with SQLite or MySQL backend, ADIF import/export, \
                    LaTeX QSL label printing, award tracking, LoTW integration, \
                    Hamlib rig control and a DX cluster bandmap.

homepage            https://fkurz.net/ham/yfklog.html
master_sites        https://fkurz.net/ham/yfklog

checksums           rmd160  b42ae5150f80a375aedfee1e11eb65d819a58010 \
                    sha256  3f5f08abb6cf802ff39dd3e3c80b0f4348cee88d07d818bd32db51bd840d1668 \
                    size    525078
perl5.branches      5.34

depends_lib-append  port:perl${perl5.major} \
                    port:p${perl5.major}-curses \
                    port:p${perl5.major}-dbi \
                    port:p${perl5.major}-dbd-sqlite \
                    port:p${perl5.major}-libwww-perl \
                    port:p${perl5.major}-net-telnet \
                    port:p${perl5.major}-io-socket-timeout

post-patch {
    reinplace "s|^#!.*perl.*|#!${perl5.bin}|" ${worksrcpath}/yfk
}

use_configure       no
build               {}

destroot.destdir    DESTDIR=${destroot}${prefix}
post-destroot {
    if {![catch {exec grep -rlF ${destroot} ${destroot}${prefix}} files]} {
        foreach f [split $files "\n"] {
            reinplace "s|${destroot}||g" $f
        }
    }
}
