PortSystem              1.0
PortGroup               github 1.0
PortGroup               java 1.0

github.setup            logisim-evolution logisim-evolution 5.0.0 v
github.tarball_from     archive
revision                0

categories              cad education java
license                 GPL-3
maintainers             {@harens harens} \
                        openmaintainer

description             Digital logic designer and simulator
long_description        Logisim is an educational tool for designing and \
                        simulating digital logic circuits.

depends_build-append    bin:gradle:gradle
depends_lib-append      port:commons-cli \
                        port:commons-lang3 \
                        port:commons-text \
                        port:hamcrest \
                        port:slf4j

java.version            21+

set gradle_home         ${workpath}/.home/.gradle

checksums               rmd160  8d118223fb885cc720168e1dc6fd957343a5e145 \
                        sha256  f988340da25e65ae3e8e8b29e6b16b4014661ed730a8952fc5c618337828f9ca \
                        size    47777810

patchfiles              use-installed-jars.diff

post-patch {
    reinplace "s|@@PREFIX@@|${prefix}|g" ${worksrcpath}/build.gradle.kts
}

use_configure           no

build.cmd               gradle
build.target            createApp
build.args              --no-daemon \
                        --gradle-user-home="${gradle_home}" \
                        --max-workers=${build.jobs} \
                        --parallel

test.run                yes
test.target             check
test.args               --no-daemon \
                        --gradle-user-home="${gradle_home}" \
                        --max-workers=${build.jobs} \
                        --parallel

destroot {
    set destappdir  ${destroot}${applications_dir}
    set destdocdir  ${destroot}${prefix}/share/doc/${name}
    set destjavadir ${destroot}${prefix}/share/java

    xinstall -d ${destappdir}
    copy \
        [glob -directory ${worksrcpath}/build/ macOS-*]/Logisim-evolution.app \
        ${destappdir}

    xinstall -d ${destjavadir}
    ln -s \
        ${applications_dir}/Logisim-evolution.app/Contents/app/${name}-${version}-all.jar \
        ${destjavadir}/${name}-all.jar

    xinstall -d ${destdocdir}
    xinstall -m 644 \
        ${worksrcpath}/CHANGES.md \
        ${worksrcpath}/CITATION.cff \
        ${worksrcpath}/LICENSE.md \
        ${worksrcpath}/README.md \
        ${destdocdir}
}
