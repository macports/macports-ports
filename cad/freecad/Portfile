PortSystem              1.0
PortGroup               cmake 1.1
PortGroup               github 1.0
PortGroup               qt6 1.0
PortGroup               boost 1.0

github.setup            FreeCAD FreeCAD 26.3rc2
name                    freecad
categories              cad
maintainers             {gmail.com:mark.brethen @mbrethen} openmaintainer
license                 LGPL-2.1+

description \
    FreeCAD is a general purpose feature-based, parametric 3D modeler.

long_description \
    FreeCAD is a general purpose feature-based, parametric 3D modeler for \
    CAD, MCAD, CAx, CAE and PLM, aimed directly at mechanical engineering \
    and product design but also fits a wider range of uses in engineering, \
    such as architecture or other engineering specialties. It is 100% Open \
    Source (LGPL2+ license) and extremely modular, allowing for very \
    advanced extension and customization.

homepage                https://www.freecad.org

# Use upstream's purpose-built source tarball rather than the autogenerated
# GitHub archive: only the former carries the populated
# src/3rdParty/OndselSolver submodule that the Assembly workbench needs. It
# unpacks flat, with no top-level directory, hence extract.mkdir.
master_sites            https://github.com/FreeCAD/FreeCAD/releases/download/${version}/
distname                freecad_source_${version}
extract.mkdir           yes

checksums               rmd160  b60cfa38263cca3e95ff038657c5d52d5e8e2ddc \
                        sha256  250ffabd322a1f952918fb6590540c3683a7c11b353287c812acc6d3c2c6fe5e \
                        size    98187608

set python_branch       3.13
set python_version      [string map {. ""} ${python_branch}]
set python_prefix       ${frameworks_dir}/Python.framework/Versions/${python_branch}
set python_pkgd         ${python_prefix}/lib/python${python_branch}/site-packages

# The boost PortGroup defaults to 1.76, which is too old: App/Transactions.cpp
# calls contains() on a boost::multi_index hashed_index (added in 1.78).
# Use the tested 1.81 port; FreeCAD's own BOOST_MIN_VERSION of 1.74 is stale.
boost.version           1.81

# qttools provides Qt6UiTools, which FreeCADGui links against, as well as
# lrelease/lupdate and the uic/rcc tools FreeCAD's FindPySide6Tools.cmake
# uses to generate the PySide resource modules.
qt6.depends_lib         qtbase qtsvg qttools

# pybind11 is header-only: MeshPart's flatmesh and the CAM module need its
# CMake config at configure time and nothing at run time.
depends_build-append    port:pybind11 \
                        port:swig \
                        port:swig-python

# libmed and hdf5 are pulled in by the bundled Salome SMESH, which FEM and
# MeshPart both require.
depends_lib-append      port:python${python_version} \
                        port:opencascade \
                        port:Coin \
                        port:py${python_version}-pivy \
                        port:py${python_version}-pyside6 \
                        port:py${python_version}-lark \
                        port:xercesc3 \
                        port:icu \
                        port:freetype \
                        port:yaml-cpp \
                        port:libmed \
                        port:hdf5 \
                        port:vtk \
                        port:zlib \
                        path:share/pkgconfig/eigen3.pc:eigen3

depends_run-append      port:py${python_version}-defusedxml \
                        port:py${python_version}-matplotlib

compiler.cxx_standard   2023
# FreeCAD 26.3 requires Clang 18 or newer; the C++ standard alone does not
# exclude older compilers in MacPorts base. Use MacPorts Clang when needed.
compiler.blacklist-append *gcc* {clang < 1800} {macports-clang-1[0-7]}

cmake.install_prefix    ${prefix}/libexec/${name}
cmake.install_rpath     ${cmake.install_prefix}/lib

# PySide6Tools needs no _DIR: py-pyside6 ships no CMake config for it, and
# FreeCAD's own FindPySide6Tools.cmake resolves the uic/rcc executables from
# the Qt6::uic and Qt6::rcc targets instead.
configure.args-append   -DBUILD_GUI=ON \
                        -DFREECAD_USE_EXTERNAL_COIN_PIVY=ON \
                        -DENABLE_DEVELOPER_TESTS=OFF \
                        -DBUILD_FEM_NETGEN=OFF \
                        -DFREECAD_USE_PCL=OFF \
                        -DPython3_EXECUTABLE=${python_prefix}/bin/python${python_branch} \
                        -DPython3_ROOT_DIR=${python_prefix} \
                        -DPython_EXECUTABLE=${python_prefix}/bin/python${python_branch} \
                        -DPython_ROOT_DIR=${python_prefix} \
                        -DShiboken6_DIR=${python_pkgd}/shiboken6/lib/cmake/Shiboken6 \
                        -DPySide6_DIR=${python_pkgd}/PySide6/lib/cmake/PySide6

# hdf5 2.1.1_1's CMake config cannot find libaec in its private prefix and
# repeats the install prefix in its imported-target paths. Use FindHDF5's
# header/library discovery for both FreeCAD and VTK instead.
configure.args-append   -DHDF5_NO_FIND_PACKAGE_CONFIG_FILE=ON

# ccache is auto-detected before project() and silently changes the compiler
# launcher; MacPorts manages that itself.
configure.args-append   -DFREECAD_USE_CCACHE=OFF

# These are looked up opportunistically: libspnav and cpptrace would be linked
# if installed, and Doxygen only adds a documentation target.
# Disable them so the result does not depend on unrelated installed ports.
configure.args-append   -DCMAKE_DISABLE_FIND_PACKAGE_Spnav=ON \
                        -DCMAKE_DISABLE_FIND_PACKAGE_cpptrace=ON \
                        -DCMAKE_DISABLE_FIND_PACKAGE_Doxygen=ON

# CMake's FindOpenGL on macOS looks for a library named GL before it tries the
# framework, and with CMAKE_FIND_FRAMEWORK=LAST that picks up mesa's X11 libGL
# whenever mesa happens to be installed. Coin, opencascade and Qt all link
# Apple's OpenGL.framework, so FreeCAD has to match or two GL implementations
# end up in one process. Pin the framework, and mask the GL/gl.h probe so
# Quarter does not include mesa's header alongside the framework's.
pre-configure {
    set gl_framework ${configure.sdkroot}/System/Library/Frameworks/OpenGL.framework
    configure.args-append \
                        -DOPENGL_INCLUDE_DIR=${gl_framework} \
                        -DOPENGL_GLU_INCLUDE_DIR=${gl_framework} \
                        -DOPENGL_gl_LIBRARY=${gl_framework} \
                        -DOPENGL_glu_LIBRARY=${gl_framework} \
                        -DHAVE_GL_GL_H=0
}

post-destroot {
    # FreeCAD adds Ext/ to sys.path, but its non-Conda macOS install puts the
    # PySide compatibility package in MacOS/. Workbenches import PySide at
    # startup, so install the package on the application-local search path.
    move ${destroot}${cmake.install_prefix}/MacOS/PySide \
        ${destroot}${cmake.install_prefix}/Ext/PySide

    # On macOS FreeCAD installs its executables under MacOS/, not bin/.
    # FreeCAD resolves symlinks with realpath() before deriving its home
    # directory, so plain symlinks are enough here.
    ln -s ${cmake.install_prefix}/MacOS/FreeCAD \
        ${destroot}${prefix}/bin/FreeCAD

    ln -s ${cmake.install_prefix}/MacOS/FreeCADCmd \
        ${destroot}${prefix}/bin/FreeCADCmd

    # Stub app bundle whose executable is a launcher script. Info.plist and
    # the icons come from upstream's own bundle template, which carries the
    # placeholders FreeCAD's CMake substitutes when it builds a bundle itself.
    set appdir ${destroot}${applications_dir}/FreeCAD.app
    set template ${worksrcpath}/src/MacAppBundle/FreeCAD.app/Contents
    xinstall -d ${appdir}/Contents/MacOS
    xinstall -d ${appdir}/Contents/Resources

    xinstall -m 644 ${template}/Info.plist ${appdir}/Contents/
    xinstall -m 644 {*}[glob ${template}/Resources/*.icns] \
        ${appdir}/Contents/Resources/
    xinstall -m 755 ${filespath}/FreeCAD ${appdir}/Contents/MacOS

    reinplace -W ${appdir}/Contents "s,NAME_STRING_FROM_CMAKE,FreeCAD,g" Info.plist
    reinplace -W ${appdir}/Contents "s,VERSION_STRING_FROM_CMAKE,${version},g" Info.plist
    # Upstream leaves CFBundleIdentifier empty; fill the <string> on the line
    # that follows the key, in the org.freecad namespace upstream uses.
    reinplace -W ${appdir}/Contents \
        "/CFBundleIdentifier/{n;s,<string></string>,<string>org.freecad.FreeCAD</string>,;}" \
        Info.plist
    reinplace -W ${appdir}/Contents/MacOS "s,@@PREFIX@@,${prefix},g" FreeCAD
}

variant netgen description {Build the FEM module with the NETGEN mesher} {
    depends_lib-append      port:netgen
    configure.args-replace  -DBUILD_FEM_NETGEN=OFF -DBUILD_FEM_NETGEN=ON
}

github.livecheck.regex  {(\d+\.\d+(\.\d+)?)}
