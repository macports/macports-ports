PortGroup           meson 1.0
PortGroup           yelp 1.0

name                gedit
version             50.0
revision            0

gitlab.instance     https://gitlab.gnome.org
gitlab.setup        World/gedit ${name} ${version}

categories          gnome editors
license             GPL-2+
maintainers         {devans @dbevans} {mascguy @mascguy} openmaintainer
description         GNOME editor.
long_description    {*}${description}

# Disable unexpected download of subprojects
meson.wrap_mode     nodownload

# Needed for project submodule 'libgd'
fetch.type          git

# redefinition of typedef error
compiler.c_standard 2011

checksums           rmd160  cbb6f530ee8b86ccea0800a805dfad9fd1f09ab4 \
                    sha256  c2d064001b95196f046a6f9705245e3a02dc427265f4e24af9bd2d5f3cb619ee \
                    size    3411352

depends_build-append \
                    port:appstream-glib \
                    port:gettext \
                    bin:git:git \
                    port:gtk-doc \
                    port:itstool \
                    path:bin/pkg-config:pkgconfig \
                    path:bin/vala:vala

depends_lib-append \
                    port:desktop-file-utils \
                    port:gettext-runtime \
                    path:lib/pkgconfig/glib-2.0.pc:glib2 \
                    path:lib/pkgconfig/gobject-introspection-1.0.pc:gobject-introspection \
                    port:gsettings-desktop-schemas \
                    port:gspell \
