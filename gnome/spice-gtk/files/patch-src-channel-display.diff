From 02377912fe173e4af7714aef036d0555ee7531bc Mon Sep 17 00:00:00 2001
From: Mohamed Akram <mohd.akram@outlook.com>
Date: Wed, 7 Oct 2026 19:25:10 +0400
Subject: [PATCH] channel-display: fix build on macOS

Fixes: https://gitlab.freedesktop.org/spice/spice-gtk/-/work_items/200
Signed-off-by: Mohamed Akram <mohd.akram@outlook.com>
---
 src/channel-display.c | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/src/channel-display.c b/src/channel-display.c
index ae0a459a..22c87561 100644
--- src/channel-display.c
+++ src/channel-display.c
@@ -21,7 +21,7 @@
 #endif
 #include <glib/gi18n-lib.h>
 
-#ifdef G_OS_UNIX
+#if defined(G_OS_UNIX) && !__APPLE__
 #include <drm/drm_fourcc.h>
 #endif
 
@@ -2109,7 +2109,7 @@ static void display_handle_monitors_config(SpiceChannel *channel, SpiceMsgIn *in
 }
 
 
-#ifdef G_OS_UNIX
+#if defined(G_OS_UNIX) && !__APPLE__
 /* coroutine context */
 static void display_handle_gl_scanout_unix(SpiceChannel *channel, SpiceMsgIn *in)
 {
@@ -2275,7 +2275,7 @@ static void channel_set_handlers(SpiceChannelClass *klass)
         [ SPICE_MSG_DISPLAY_SURFACE_DESTROY ]    = display_handle_surface_destroy,
 
         [ SPICE_MSG_DISPLAY_MONITORS_CONFIG ]    = display_handle_monitors_config,
-#ifdef G_OS_UNIX
+#if defined(G_OS_UNIX) && !__APPLE__
         [ SPICE_MSG_DISPLAY_GL_SCANOUT_UNIX ]    = display_handle_gl_scanout_unix,
         [ SPICE_MSG_DISPLAY_GL_SCANOUT2_UNIX ]   = display_handle_gl_scanout2_unix,
 #endif
