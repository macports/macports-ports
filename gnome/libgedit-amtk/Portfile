# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:filetype=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           gitlab 1.0
PortGroup           meson 1.0

name                libgedit-amtk
version             5.11.0
revision            0

gitlab.instance     https://gitlab.gnome.org
gitlab.setup        World/gedit ${name} ${version}

categories          gnome
license             LGPL-3+
maintainers         {mascguy @mascguy} openmaintainer
description         GNOME text editor support
long_description    ${description}

checksums           rmd160  8d9872e85a49f2d9de0c1d171672392fa5308117 \
                    sha256  eda52600fc2e8b49f98fe974397a75e0286d744e09446b13e631202e99ca536e \
                    size    65365

# Disable unexpected download of subprojects
meson.wrap_mode     nodownload

depends_build-append \
                    port:gettext \
                    port:gtk-doc \
                    path:bin/pkg-config:pkgconfig

depends_lib-append \
                    port:gettext-runtime \
                    path:lib/pkgconfig/glib-2.0.pc:glib2 \
                    path:lib/pkgconfig/gobject-introspection-1.0.pc:gobject-introspection \
                    port:gsettings-desktop-schemas \
                    path:lib/pkgconfig/gtk+-3.0.pc:gtk3 \
                    path:lib/pkgconfig/icu-uc.pc:icu

platform darwin {
    # build requires a newer version of ar/ranlib than available on 10.6 and earlier
    if {${os.major} < 11} {
        depends_build-append port:cctools
    }
}

# ld: unknown option: -export-symbols
compiler.blacklist-append \
                    *gcc-4.0 *gcc-4.2

configure.args-append \
                    -Dgtk_doc=true

# gobject-introspection uses g-ir-scanner, which uses $CC from env
if {${universal_possible} && [variant_isset universal]} {
    foreach arch ${configure.universal_archs} {
        lappend merger_build_env(${arch})     "CC=${configure.cc} -arch ${arch}"
        lappend merger_destroot_env(${arch})  "CC=${configure.cc} -arch ${arch}"
    }
} else {
    build.env-append       "CC=${configure.cc} ${configure.cc_archflags}"
    destroot.env-append    "CC=${configure.cc} ${configure.cc_archflags}"
}
