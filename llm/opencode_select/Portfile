PortSystem              1.0
PortGroup               stub 1.0
PortGroup               select 1.0

name                    opencode_select
version                 1.0
revision                0
categories              llm
maintainers             {breun @breun} openmaintainer
supported_archs         noarch
platforms               any
description             Common files for selecting default OpenCode version
long_description        This port installs files that allow 'port select' to \
                        be used to create links to the preferred default \
                        version of OpenCode \
                        \(sudo port select --set opencode opencode1|opencode2\).

post-destroot {
    select::install opencode ${filespath}/base
    select::install opencode ${filespath}/none
}

livecheck.type          none

# Documentation for opencode ports:
#   PortGroup               select 1.0
#   depends_run-append      port:opencode_select
#   select.group            opencode
#   select.file             ${filespath}/${name}
