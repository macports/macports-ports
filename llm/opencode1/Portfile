# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           npm 1.0
PortGroup           select 1.0

name                opencode1
version             1.18.31
revision            0

categories          llm
platforms           {darwin any >= 19}
maintainers         {breun @breun} openmaintainer
license             MIT
supported_archs     x86_64 arm64

description         OpenCode 1, an open source agent that helps you write code
long_description    OpenCode is an open source agent that helps you write code.\
                    \n\
                    \nThis port tracks the OpenCode 1.x line and installs the \
                    opencode1 binary. Use 'port select' to choose which major \
                    version provides the unversioned opencode command.\
                    \n\
                    \n- LSP Enabled: Automatically loads the right LSPs for the LLM\
                    \n- Multi-session: Start multiple agents in parallel on the same project\
                    \n- Share links: Share a link to any session for reference or to debug\
                    \n- Claude Pro: Log in with Anthropic to use your Claude Pro or Max account\
                    \n- ChatGPT Plus/Pro: Log in with OpenAI to use your ChatGPT Plus or Pro account\
                    \n- Any model: 75+ LLM providers through Models.dev, including local models\
                    \n- Any editor: Available as a terminal interface, desktop app, and IDE extension

homepage            https://opencode.ai

npm.rootname        opencode-ai

checksums           rmd160  159cd2659ecdf15b710721a1a28e73eb9ade5569 \
                    sha256  b6baa53003cd2e096981474ba9461a33aba2e6948b2b4b08c4aa1a88e6dc1b59 \
                    size    3051

depends_run-append  port:opencode_select

select.group        opencode
select.file         ${filespath}/${name}

# npm package ships bin/opencode; install as the versioned opencode1 name.
post-destroot {
    move ${destroot}${prefix}/bin/opencode ${destroot}${prefix}/bin/${name}
}

notes \
"To make this the default OpenCode (i.e., the version run by the \
'opencode' command), run:\
\n\
\n    sudo port select --set ${select.group} ${name}\
\n\
\nOpenCode 2.x is also available. To install and select it instead:\
\n\
\n    sudo port install opencode2\
\n    sudo port select --set ${select.group} opencode2\
\n\
\nMigration guide: https://opencode.ai/v2/docs/migrate-v1/"
