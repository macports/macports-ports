# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           github 1.0
PortGroup           metal 1.0

# This pre-configure block needs to run before those defined in the cmake-1.1
# PortGroup, or that will have passed an argument based on a wrong value of
# macosx_sdk_version.
pre-configure {
    # The CMakeLists.txt will use `xcrun --show-sdk-version` to determine what
    # to enable, if we set a different sysroot, the build may fail because of
    # missing headers.
    set macosx_sdk_version [exec xcrun --show-sdk-version]
}

PortGroup           cmake 1.1

# Check if mlx-c and ollama is compatible before updating
github.setup        ml-explore mlx 0.32.4 v
github.tarball_from archive
revision            1

# Additional dependencies that would otherwise be downloaded at runtime by CMake
set gguf_tools_commit \
                    8fa6eb65236618e28fd7710a0fba565f7faa1848
master_sites-append https://github.com/antirez/gguf-tools/archive/${gguf_tools_commit}:gguf
distfiles-append    gguf-tools-${gguf_tools_commit}.tar.gz:gguf

master_sites-append https://developer.apple.com/metal/cpp/files:metal
distfiles-append    metal-cpp_26.zip:metal

checksums           ${name}-${version}.tar.gz \
                    rmd160  a5b1775bd5166738d8618169aa9e080dd7914f4b \
                    sha256  0276db8d7bf1af8db6d4ae25c7c550abea4d5b3b6a16207610a5d4a0c19fe1a0 \
                    size    4535793 \
                    gguf-tools-${gguf_tools_commit}.tar.gz \
                    rmd160  065bc0c2ae0c4e5baa01f39a8d15ec68c748474f \
                    sha256  9e30bc1eb82cc2231150d39ce37dcdd6f844d6994fba18da83fc537a487ba86f \
                    size    34394 \
                    metal-cpp_26.zip \
                    rmd160  0034942bd6ea351e599727f53e36af24990c1f57 \
                    sha256  4df3c078b9aadcb516212e9cb03004cbc5ce9a3e9c068fa3144d021db585a3a4 \
                    size    260405

categories          llm devel
maintainers         {@neverpanic cal} openmaintainer
supported_archs     arm64

platforms           {darwin >= 23}

license             MIT
description         \
    MLX is an array framework for machine learning on Apple silicon, brought to \
    you by Apple machine learning research.
long_description    ${description}

use_xcode           yes

extract.only        ${name}-${version}.tar.gz \
                    gguf-tools-${gguf_tools_commit}.tar.gz

patchfiles          diff-CMakeLists.txt-use-system-nlohmann_json.patch \
                    diff-mlx-CMakeLists.txt-prefer-local-includes.patch

set port_libfmt     libfmt12
cmake.prefix_path-append \
                    ${prefix}/lib/${port_libfmt}/cmake

depends_extract-append \
                    bin:unzip:unzip

depends_lib-append  port:nlohmann-json \
                    port:${port_libfmt}

# upstream uses ccache, but: ccache: error: Operation not permitted
configure.ccache    yes
set ccache_dir      ${workpath}/.ccache
if {[option configure.ccache]} {
    pre-configure {
        xinstall -d ${ccache_dir} 
    }   
    configure.env-append    CCACHE_DIR=${ccache_dir} USE_CCACHE=ON
    build.env-append        CCACHE_DIR=${ccache_dir} USE_CCACHE=ON
    destroot.env-append     CCACHE_DIR=${ccache_dir} USE_CCACHE=ON
} else {
    configure.env-append    CCACHE_DISABLE=1 USE_CCACHE=OFF
    build.env-append        CCACHE_DISABLE=1 USE_CCACHE=OFF
    destroot.env-append     CCACHE_DISABLE=1 USE_CCACHE=OFF
}

configure.args-append   \
                    -DMLX_BUILD_TESTS=Off \
                    -DMLX_BUILD_EXAMPLES=Off \
                    -DBUILD_SHARED_LIBS=On \
                    -DUSE_SYSTEM_FMT=On \
                    -DFETCHCONTENT_FULLY_DISCONNECTED=On \
                    -DFETCHCONTENT_SOURCE_DIR_GGUFLIB=${workpath}/gguf-tools-${gguf_tools_commit} \
                    -DFETCHCONTENT_SOURCE_DIR_METAL_CPP=${workpath}/metal-cpp
# This breaks linking the tests
configure.pre_args-delete \
                    -DCMAKE_BUILD_WITH_INSTALL_RPATH:BOOL=ON

post-extract {
    # This is a bit of a hack to extract the metal-cpp_26.zip file, because it
    # would be ignored by the normal extract step.
    use_zip         yes
    extract.only    metal-cpp_26.zip
    portextract::extract_main
}


set pyversions {310 311 312 313 314}

foreach v ${pyversions} {
    subport py${v}-${name} {
        PortGroup           python 1.0

        # The python PortGroup disables configure and overrides
        # build.cmd; undo both so cmake drives the build.
        python.pep517       no
        use_configure       yes
        build.cmd           make
        build.post_args     VERBOSE=ON

        python.version      ${v}

        categories-prepend  llm devel
        description         Python ${python.branch} bindings for the MLX array framework
        long_description    Python ${python.branch} bindings for ${name}, \
                            an array framework for machine learning on Apple \
                            silicon, brought to you by Apple machine learning \
                            research.

        depends_lib-append  port:${name} \
                            port:py${python.version}-nanobind \
                            port:robin-map

        compiler.cxx_standard   2020

        configure.args-append -DMLX_BUILD_PYTHON_BINDINGS=ON \
                              -DMLX_BUILD_PYTHON_STUBS=OFF \
                              -DPython_EXECUTABLE=${python.bin} \
                              -DFETCHCONTENT_FULLY_DISCONNECTED=ON \
                              -DFETCHCONTENT_TRY_FIND_PACKAGE_MODE=ALWAYS \
                              -Dnanobind_DIR=${python.pkgd}/nanobind/cmake

        build.target        core

        destroot {
            # Install the core extension module
            set mlx_pkgd ${destroot}${python.pkgd}/mlx
            xinstall -d ${mlx_pkgd}

            # Copy the Python package files
            copy {*}[glob ${worksrcpath}/python/mlx/*] ${mlx_pkgd}/

            # Find and install the built core extension module
            foreach f [glob ${cmake.build_dir}/core.*] {
                xinstall -m 0755 ${f} ${mlx_pkgd}/
            }

            # Create lib/ directory and symlink libmlx.dylib so the
            # extension module can find it via @loader_path/lib RPATH
            xinstall -d ${mlx_pkgd}/lib
            ln -sf ${prefix}/lib/libmlx.dylib ${mlx_pkgd}/lib/libmlx.dylib
        }
    }
}

variant tests description "Build with tests" {
    master_sites-append     https://github.com/onqtam/doctest/archive/v2.4.12:doctest
    distfiles-append        doctest-2.4.12.tar.gz:doctest
    checksums-append        doctest-2.4.12.tar.gz \
                            rmd160  abde774b8c61a7e928a116de60f84562d5d671b4 \
                            sha256  73381c7aa4dee704bd935609668cf41880ea7f19fa0504a200e13b74999c2d70 \
                            size    2188849
    extract.only-append     doctest-2.4.12.tar.gz
    configure.args-replace \
        -DMLX_BUILD_TESTS=Off \
        -DMLX_BUILD_TESTS=On
    configure.args-append \
        -DFETCHCONTENT_SOURCE_DIR_DOCTEST=${workpath}/doctest-2.4.12
    test.run                yes

    post-destroot {
        file delete -force \
            ${destroot}${prefix}/include/doctest \
            ${destroot}${prefix}/lib/cmake/doctest
    }
}
