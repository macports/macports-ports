    ln -s ../libexec/${name}/bin/${name} ${destroot}${prefix}/bin/${name}

    copy ${worksrcpath}/skills ${worksrcpath}/skill-data ${destroot}${pkgroot}/

    xinstall -d ${destroot}${prefix}/share/doc/${name}
