# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           npm 1.0
PortGroup           select 1.0

name                opencode2
version             2.0.8
revision            0

categories          llm
platforms           {darwin any >= 19}
maintainers         {oakimov @oakimov} {breun @breun} openmaintainer
license             MIT
supported_archs     x86_64 arm64

description         OpenCode 2, an open source AI coding agent
long_description    OpenCode is an open source AI coding agent. This port \
                    installs the OpenCode 2.x terminal UI (CLI) as the \
                    opencode2 binary. Use 'port select' to choose which major \
                    version provides the unversioned opencode command.\
                    \n\
                    \n- Terminal-based interface for AI-assisted coding\
                    \n- Built-in support for many LLM providers via /connect\
                    \n- Configurable agents, models, skills, tools, and themes\
                    \n- Extensible with plugins, MCP servers, and custom commands\
                    \n\
                    \nMigration from 1.x: https://opencode.ai/v2/docs/migrate-v1/

homepage            https://opencode.ai/v2/docs

npm.rootname        @opencode/cli
distname            cli-${version}

checksums           rmd160  22fb25b87548530201b58f15b4a4d62a07267e31 \
                    sha256  c49d596aaf9274c2ac12178c074540a2605b84adde5dc45619ecbb52919a6bc4 \
                    size    2418

depends_run-append  port:opencode_select

select.group        opencode
select.file         ${filespath}/${name}

# @opencode/cli ships both opencode and opencode2; keep only the versioned
# binary so opencode_select can manage the unversioned opencode name.
post-destroot {
    delete ${destroot}${prefix}/bin/opencode
}

notes \
"To make this the default OpenCode (i.e., the version run by the \
'opencode' command), run:\
\n\
\n    sudo port select --set ${select.group} ${name}\
\n\
\nOpenCode 1.x remains available as opencode1:\
\n\
\n    sudo port install opencode1\
\n    sudo port select --set ${select.group} opencode1\
\n\
\nMigration guide: https://opencode.ai/v2/docs/migrate-v1/"
