# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           github 1.0

github.setup        anonnerdfrenzy survival-llm 0.3.4 v
github.tarball_from archive
revision            0

categories          llm
supported_archs     noarch
platforms           {darwin any}
maintainers         {gmail.com:herby.gillot @herbygillot} \
                    openmaintainer
license             MIT

description         offline AI assistant and survival library that cites its sources

long_description    Survival LLM is a local AI assistant that answers questions \
                    about first aid, emergencies and practical skills from an \
                    offline library of medical, government, how-to and \
                    encyclopedia articles, and shows the passage each answer \
                    came from. Models run through Ollama. The library (1.3 or \
                    8.8 GB) and a model are downloaded on first run.

homepage            https://brangus.io/survival-llm

checksums           rmd160  0392ab85d463f942860c3a1bc9196dbeeba4f427 \
                    sha256  05fc0a862c7e590d12a009995ae5e09bff1720142cc6e8bdefc9f8415d996c2b \
                    size    1228090

set python_branch   3.14
set python_ver      [string map {. {}} ${python_branch}]
set python_bin      ${prefix}/bin/python${python_branch}

depends_build       port:python${python_ver}

depends_run         port:ollama \
                    port:python${python_ver} \
                    port:py${python_ver}-pypdf \
                    port:py${python_ver}-pywebview \
                    port:py${python_ver}-truststore

post-patch {
    reinplace {s|"/opt/homebrew/bin/ollama", |"@PREFIX@/bin/ollama", &|} \
        ${worksrcpath}/app/server.py
    reinplace "s|@PREFIX@|${prefix}|" ${worksrcpath}/app/server.py
    reinplace "s|Update it with git pull\\.|Update it with MacPorts.|" \
        ${worksrcpath}/app/server.py
}

use_configure       no

build {}

destroot {
    set appdir ${destroot}${prefix}/share/${name}
    xinstall -d ${appdir}/app ${appdir}/library
    xinstall -m 0644 -W ${worksrcpath} chat.py core.py memory.py ${appdir}
    xinstall -m 0644 -W ${worksrcpath}/library myfiles.py passages.py search.py \
        ${appdir}/library
    xinstall -m 0644 ${worksrcpath}/app/server.py ${appdir}/app
    copy ${worksrcpath}/app/static ${appdir}/app
    set fp [open ${appdir}/version.txt w]
    puts $fp ${version}
    close $fp

    system "${python_bin} -m compileall -q -d ${prefix}/share/${name} ${appdir}"

    foreach {cmd script} {survival-llm app/server.py survival-llm-chat chat.py} {
        set fp [open ${destroot}${prefix}/bin/${cmd} w]
        puts $fp "#!/bin/sh"
        puts $fp "exec ${python_bin} ${prefix}/share/${name}/${script} \"\$@\""
        close $fp
        file attributes ${destroot}${prefix}/bin/${cmd} -permissions 0755
    }

    set docdir ${destroot}${prefix}/share/doc/${name}
    xinstall -d ${docdir}
    xinstall -m 0644 -W ${worksrcpath} LICENSE README.md SOURCES.md ${docdir}
}

notes "
Run `survival-llm` to open the app in its own window, or `survival-llm-chat\
 QUESTION` in a terminal. The first run downloads a model and the library;\
 the library goes to ~/Survival LLM Library, models to ~/.ollama/models.
"
