post-patch {
    set tauriconf tauri.conf.json
    system -W ${worksrcpath}/src-tauri \
        "${prefix}/bin/jq -r '.bundle.targets = \"app\" | \
            .bundle.createUpdaterArtifacts = false | \
            .bundle.macOS.signingIdentity = \"-\" | \
            .bundle.macOS.minimumSystemVersion = \"${macosx_deployment_target}\"' \
            ${tauriconf} | ${prefix}/bin/sponge ${tauriconf}"
}

configure.cmd           ${prefix}/bin/pnpm install
configure.pre_args
configure.args-append   --frozen-lockfile \
                        --reporter append-only

# Tauri bundles every binary target from this Cargo package, but its nested
# Cargo invocation does not reliably leave both executables in target/release
# when run through MacPorts. Generate the frontend first because
# generate_context!() requires frontendDist to exist, then build both binaries
# explicitly for the bundler.
pre-build {
    system -W ${worksrcpath} \
        "${prefix}/bin/pnpm run build"
    system -W ${worksrcpath}/src-tauri \
        "${cargo.bin} build --release ${cargo.offline_cmd} --verbose \
            -j${build.jobs} --bins --features tauri/custom-protocol"
}

build.dir               ${worksrcpath}
build.cmd               ${prefix}/bin/pnpm
build.pre_args
build.args              exec tauri build \
                        --bundles app \
                        --verbose

destroot {
    set app_name "Codex Switcher"
    set app_path "${worksrcpath}/src-tauri/target/release/bundle/macos/${app_name}.app"
    copy ${app_path} ${destroot}${applications_dir}

    set dest_app "${destroot}${applications_dir}/${app_name}.app"
    copy ${worksrcpath}/dist ${dest_app}/Contents/Resources/
    set web_launcher ${destroot}${prefix}/bin/codex-switcher-web
    set launcher_fd [open ${web_launcher} w]
    puts ${launcher_fd} "#!/bin/sh"
    puts ${launcher_fd} "exec \"${applications_dir}/${app_name}.app/Contents/MacOS/codex-web\" \"\$@\""
    close ${launcher_fd}
    file attributes ${web_launcher} -permissions 0755
    system "/usr/bin/codesign --force --deep --sign - [shellescape ${dest_app}]"
}

