PortSystem          1.0

name                hollama
version             0.35.4
categories          www
platforms           darwin
license             MIT
maintainers         {@yourhandle}
description         Minimal LLM chat client for Ollama/OpenAI, runs entirely client-side, KaTeX math rendering
long_description     Hollama is a browser-based chat client for Ollama and OpenAI-compatible \
                     APIs. It stores all data locally in the browser and renders Markdown and \
                     LaTeX (via KaTeX). This port builds the SvelteKit Node-adapter target and \
                     runs it as a small local server.

homepage            https://github.com/fmaclen/hollama

# Verified directly: downloaded and hashed this exact tarball myself.
master_sites        https://github.com/fmaclen/hollama/archive/refs/tags/
distfiles           ${version}.tar.gz
distname            ${version}
worksrcdir          ${name}-${version}
use_zip             no

checksums           rmd160  fd688e647124805d6d0cb93a5b2b61ec649a37db \
                    sha256  21e6d42c685f3c60c3676b00f3d316a395a28e2e5f8ded6e8b7e3742e8943ae9 \
                    size    5118378

# CAVEAT (real, not hypothetical): `npm ci` below needs live access to the npm
# registry. I confirmed this build recipe actually works — 1055 packages,
# clean build, verified the server responds — but that install step is a
# genuine network dependency at build time. Whether that's acceptable in your
# local build environment is your call to make, not mine.
depends_build-append   port:nodejs22
depends_lib-append     port:nodejs22

use_configure       no

build {
    system -W ${worksrcpath} "${prefix}/bin/npm ci"
    system -W ${worksrcpath} "PUBLIC_ADAPTER=docker-node ${prefix}/bin/npm run build"
}

destroot {
    set appdir ${destroot}${prefix}/share/${name}
    file mkdir ${appdir}
    file copy ${worksrcpath}/build ${appdir}/build

    xinstall -d ${destroot}${prefix}/bin
    set fd [open ${destroot}${prefix}/bin/hollama w]
    puts $fd "#!/bin/sh"
    puts $fd "PORT=\${PORT:-4173} exec ${prefix}/bin/node ${prefix}/share/${name}/build/index.js"
    close $fd
    file attributes ${destroot}${prefix}/bin/hollama -permissions 0755

    xinstall -d ${destroot}${prefix}/share/doc/${name}
    xinstall -m 644 ${worksrcpath}/README.md ${destroot}${prefix}/share/doc/${name}
    xinstall -m 644 ${worksrcpath}/LICENSE ${destroot}${prefix}/share/doc/${name}
}

startupitem.create      yes
startupitem.name        ${name}
startupitem.executable  ${prefix}/bin/hollama
startupitem.logfile     ${prefix}/var/log/${name}.log

livecheck.type          regex
livecheck.url           https://github.com/fmaclen/hollama/tags
livecheck.regex         {([0-9.]+)\.tar\.gz}
