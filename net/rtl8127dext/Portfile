PortSystem          1.0
PortGroup           github 1.0
PortGroup           xcode 1.0

github.setup        stefb69 RTL812xLucy 1.1.2-rtl8127.beta4 v
github.tarball_from archive
name                rtl8127dext
version             0.2.30
revision            0
categories          net aqua
# The embedded extension targets DriverKit 24.0 (macOS 15).
platforms           {macosx >= 24}
supported_archs     arm64 x86_64
maintainers         {i0ntempest @i0ntempest} openmaintainer
license             GPL-2
installs_libs       no

description         Realtek RTL812x Ethernet DriverKit extension
long_description    Realtek RTL812x family ethernet DriverKit driver for supported Realtek\
                    PCIe and Thunderbolt Ethernet adapters, inlcuding RTL8125, RTL8126, RTL8127,\
                    and RTL8162 series.

checksums           rmd160  f584682db41d11baf3375abbc81df48b30825b91 \
                    sha256  1f72bc8a85211da8aedb9d9fa2733343b239970eaedbdf04ebf3e8f433a1cde9 \
                    size    4774387

# Fix TSO with mismatched MTUs and backport the RTL8162 PCI match.
# https://github.com/stefb69/RTL812xLucy/pull/18
patchfiles          patch-pr-18.diff
patch.pre_args      -p1

xcode.project       RTL8127Dext/RTL8127Dext.xcodeproj
xcode.target        RTL8127App
xcode.configuration Release
xcode.use_project_sdk \
                    yes
xcode.build.settings-append \
                    OTHER_SWIFT_FLAGS=-disable-sandbox \
                    CODE_SIGN_IDENTITY=- \
                    AD_HOC_CODE_SIGNING_ALLOWED=YES

destroot {
    xinstall -d ${destroot}${applications_dir}
    copy [xcode::get_project_path]/build/${xcode.configuration}/RTL8127App.app ${destroot}${applications_dir}
}

notes "
    This build is ad hoc signed and works only with SIP disabled and system extension developer mode enabled.
"
