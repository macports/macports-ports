Backport PCI ID 10ec:8162 from Mieze/RTL812xLucy 48551c7. The dext already has chip detection for this ID, and the host app can now display the device.
---
 RTL8127Dext/RTL8127App/RTL8127App.swift | 1 +
 RTL8127Dext/RTL8127Dext/Info.plist      | 2 +-
 2 files changed, 2 insertions(+), 1 deletion(-)

diff --git a/RTL8127Dext/RTL8127App/RTL8127App.swift b/RTL8127Dext/RTL8127App/RTL8127App.swift
index 54a6a96..c818db7 100644
--- a/RTL8127Dext/RTL8127App/RTL8127App.swift
+++ b/RTL8127Dext/RTL8127App/RTL8127App.swift
@@ -89,6 +89,7 @@ enum Hardware {
         0x8126: "RTL8126 (5GbE)",
         0x5000: "RTL8126 (5GbE)",
         0x8125: "RTL8125 (2.5GbE)",
+        0x8162: "RTL8162 (2.5GbE)",
         0x3000: "RTL8125 (2.5GbE)",
     ]
 
diff --git a/RTL8127Dext/RTL8127Dext/Info.plist b/RTL8127Dext/RTL8127Dext/Info.plist
index b07d384..e2d4972 100644
--- a/RTL8127Dext/RTL8127Dext/Info.plist
+++ b/RTL8127Dext/RTL8127Dext/Info.plist
@@ -46,7 +46,7 @@
 			<key>IOUserServerName</key>
 			<string>net.wizzz.RTL8127Dext</string>
 			<key>IOPCIPrimaryMatch</key>
-			<string>0x812510ec 0x81251186 0x300010ec 0x812610ec 0x500010ec 0x812710ec 0x0e1010ec</string>
+			<string>0x812510ec 0x81251186 0x300010ec 0x812610ec 0x500010ec 0x812710ec 0x0e1010ec 0x816210ec</string>
 			<key>IOPCITunnelCompatible</key>
 			<true/>
 			<key>IOProbeScore</key>

