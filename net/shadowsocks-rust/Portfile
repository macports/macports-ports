github.setup        shadowsocks shadowsocks-rust 1.25.0 v
github.tarball_from archive

revision            0
categories          net
license             MIT
maintainers         @zonyitoo \
                    openmaintainer

description         Lightweight secured SOCKS5 proxy

long_description \
    shadowsocks is a fast tunnel proxy that helps you bypass firewalls. \
    shadowsocks-rust is a Rust implementation of shadowsocks protocol.

variant local description {Build local client service binary (sslocal)} {
    build.args-append   {--features "local"}
}

variant server description {Build server service binary (ssserver)} {
    build.args-append   {--features "server"}
}

variant service description {Build service binary (ssservice)} {
    build.args-append   {--features "service"}
}

variant manager description {Build manager binary (ssmanager)} {
    build.args-append   {--features "manager"}
}

variant basic conflicts full description {Build only basic features} {
    build.args-append   {--no-default-features --features "basic"}
}

variant full conflicts basic description {Build with features "full"} {
    build.args-append   {--features "full"}
}

default_variants +local +server

checksums           ${distfiles} \
                    rmd160  08f084d8f735b7900f1c7d4d35dd82c11a0f38ce \
                    sha256  477a525e9b11d4c90ded6629552548d00a32675ec6f6f18ee45c98447e54b5f3 \
                    size    547519 \

destroot {
    if {[variant_isset local]} {
        xinstall -m 0755 ${worksrcpath}/target/[cargo.rust_platform]/release/sslocal \
            ${destroot}${prefix}/bin/
    }
    if {[variant_isset server]} {
        xinstall -m 0755 ${worksrcpath}/target/[cargo.rust_platform]/release/ssserver \
            ${destroot}${prefix}/bin/
    }
    if {[variant_isset manager]} {
        xinstall -m 0755 ${worksrcpath}/target/[cargo.rust_platform]/release/ssmanager \
            ${destroot}${prefix}/bin/
    }
    if {[variant_isset service]} {
        xinstall -m 0755 ${worksrcpath}/target/[cargo.rust_platform]/release/ssservice \
            ${destroot}${prefix}/bin/
    }
}

