PortSystem          1.0

name                ap-utils
version             1.4.1
revision            0
categories          net
maintainers         nomaintainer
license             GPL-2

description         Utilities for ATMEL, NWN, ME102 wireless access points
long_description    {*}${description}

homepage            https://ap-utils.sourceforge.net/
master_sites        sourceforge:project/${name}/${name}/${version}
use_bzip2           yes

checksums           rmd160  d531288fd06216f136e6827c118765732b0952ec \
                    sha256  2fc07e0603d745f169b686ddb5101b31942dc6aa0a2f994f2685e5e249ef0f26 \
                    size    348746

# Allocate ITEM pointers, not structs, which modern ncurses makes opaque.
patchfiles          patch-menu-item-sizeof.diff

depends_lib         port:libiconv \
                    port:ncurses

configure.args      --mandir=${prefix}/share/man \
                    --with-libiconv-prefix=${prefix}

test.run            yes
test {
    set out [exec ${worksrcpath}/src/ap-mrtg -h]
    if {![string match "*MRTG parsable format*" ${out}]} {
        return -code error "unexpected ap-mrtg output: ${out}"
    }
}

livecheck.type      regex
livecheck.url       https://sourceforge.net/projects/${name}/rss?path=/${name}
livecheck.regex     /${name}-(\[0-9.\]+)${extract.suffix}
