# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           gitlab 1.0
PortGroup           cmake 1.1
PortGroup           qt6 1.0

gitlab.setup        openconnect openconnect-gui 1.6.2 v
revision            0
categories          net aqua
maintainers         {i0ntempest @i0ntempest} openmaintainer
license             GPL-2+

description         GUI client for openconnect VPN
long_description    ${description}

checksums           rmd160  18b679ff2db47b10b16971a6c7aab45f797487be \
                    sha256  91b1e3bec158dade963301310f52a910dbe21422415145ee69acb9e00c663539 \
                    size 1179198

set libfmt_ver      12

depends_build-append \
                    port:pkgconfig
depends_lib-append  path:lib/pkgconfig/gnutls.pc:gnutls \
                    port:spdlog \
                    port:libfmt${libfmt_ver} \
                    port:openconnect
depends_run         port:vpnc-scripts

qt6.depends_lib     qtscxml

use_parallel_build  no

cmake.install_prefix \
                    ${applications_dir}
cmake.build_type    Release
cmake.prefix_path-append \
                    ${prefix}/lib/libfmt${libfmt_ver}/cmake

post-patch {
    reinplace "s|\${output}/../etc/vpnc/vpnc-script|${prefix}/etc/vpnc-scripts/vpnc-script|g" CMake/Modules/FindOpenConnect.cmake
    reinplace "s|^\[\[:space:\]\]*fixup_bundle(.*||" ${worksrcpath}/src/CMakeLists.txt
}

post-destroot {
    file rename \
        ${destroot}${applications_dir}/LICENSE.txt \
        ${destroot}${applications_dir}/OpenConnect-GUI.app/Contents/Resources
    system -W ${destroot}${applications_dir} "/usr/bin/codesign --sign - OpenConnect-GUI.app"
}
