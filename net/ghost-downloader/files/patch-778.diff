diff --git a/tests/test_clipboard_listener.py b/tests/test_clipboard_listener.py
new file mode 100644
index 00000000..461eedbe
--- /dev/null
+++ b/tests/test_clipboard_listener.py
@@ -0,0 +1,54 @@
+from PySide6.QtCore import QMimeData
+
+import app.services.clipboard_listener as clipboardListenerModule
+from app.services.clipboard_listener import ClipboardListener, GHOST_URLS_MIME, setClipboardUrls
+
+
+class StubClipboard:
+    def __init__(self, text: str, mimeType: str = ""):
+        self._mimeData = QMimeData()
+        self._mimeData.setText(text)
+        if mimeType:
+            self._mimeData.setData(mimeType, b"1")
+
+    def ownsClipboard(self) -> bool:
+        return False
+
+    def mimeData(self) -> QMimeData:
+        return self._mimeData
+
+    def text(self) -> str:
+        return self._mimeData.text()
+
+
+def test_set_clipboard_urls_marks_ghost_urls(monkeypatch):
+    clipboard = StubClipboard("")
+    clipboard.setMimeData = lambda mimeData: setattr(clipboard, "_mimeData", mimeData)
+    monkeypatch.setattr(
+        clipboardListenerModule.QApplication,
+        "clipboard",
+        lambda: clipboard,
+    )
+
+    setClipboardUrls(["https://example.com/one", "https://example.com/two"])
+
+    assert clipboard.text() == "https://example.com/one\nhttps://example.com/two"
+    assert clipboard.mimeData().hasFormat(GHOST_URLS_MIME)
+
+
+def test_ignores_ghost_urls(qapp, qtbot):
+    listener = ClipboardListener(lambda url: True)
+    listener._clipboard = StubClipboard("https://example.com/file", GHOST_URLS_MIME)
+
+    with qtbot.assertNotEmitted(listener.urlsDetected):
+        listener._onDataChanged()
+
+
+def test_detects_external_urls(qapp, qtbot):
+    listener = ClipboardListener(lambda url: True)
+    listener._clipboard = StubClipboard("https://example.com/file")
+
+    with qtbot.waitSignal(listener.urlsDetected, timeout=1000) as signal:
+        listener._onDataChanged()
+
+    assert signal.args == [["https://example.com/file"]]
