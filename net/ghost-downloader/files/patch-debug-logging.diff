Create the per-user log directory before redirecting stderr. Nuitka's
--force-stderr-spec opens its file before Python startup, when the directory
might not exist. Applied only by the debug variant.

--- a/Ghost-Downloader-3.py
+++ b/Ghost-Downloader-3.py
@@ -3,7 +3,21 @@
-import os
-import sys
-import traceback
-from dataclasses import replace
-from typing import TYPE_CHECKING
-
-from app.config.paths import APP_DATA_DIR
+import os
+import sys
+import time
+import traceback
+from dataclasses import replace
+from typing import TYPE_CHECKING
+
+
+def openDebugLog() -> None:
+    folder = os.path.expanduser("~/Library/Logs/GhostDownloader/Debug")
+    os.makedirs(folder, mode=0o700, exist_ok=True)
+    path = os.path.join(folder, f"ghost-downloader-{time.time_ns()}-{os.getpid()}.stderr.log")
+    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
+    # Capture native assertion failures as well as Python stderr.
+    os.dup2(fd, 2)
+    os.close(fd)
+
+
+openDebugLog()
+
+from app.config.paths import APP_DATA_DIR
