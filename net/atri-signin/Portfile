PortSystem          1.0
PortGroup           golang 1.0

go.setup            github.com/wu21-web/atri-signin 0.4.1 v
go.offline_build    no
go.toolchain_min    1.27
revision            0

categories          net
license             MIT
maintainers         {andyllk @wu21-web}

description         Sign in and claim rewards on Atrishop automatically
long_description    A one-shot Go CLI that logs into each account listed in a CSV and claims the daily check-in on Atri Shop.

checksums           rmd160  4de2c65820d59ae20192e99068ea4477288bef20 \
                    sha256  10068209c3da68304a696c8a5959c13fd339ad5d4a860aeb79b4f17dc3c2d16f \
                    size    34612

build.args-append   -trimpath \
                    -ldflags \"-X github.com/wu21-web/atri-signin/internal/version.Version=${git.branch}\" \
                    -o ${name} \
                    ./cmd/${name}

destroot {
    xinstall -m 0755 ${worksrcpath}/${name} ${destroot}${prefix}/bin/
}

post-destroot {
    set docdir ${destroot}${prefix}/share/doc/${name}
    xinstall -d ${docdir}
    xinstall -m 0644 ${worksrcpath}/README.md ${docdir}
    xinstall -m 0644 ${worksrcpath}/LICENSE ${docdir}
}
