# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0

name                libudns
version             0.7

categories          net
license             LGPL-2.1+
maintainers         nomaintainer

description         DNS resolver library
long_description    UDNS is a stub DNS resolver library with ability to \
                    perform both syncronous and asyncronous DNS queries.

homepage            https://www.corpit.ru/mjt/udns.html
master_sites        https://www.corpit.ru/mjt/udns/
distname            udns-${version}

checksums           rmd160  49f248b04ca54514d36179ec55fdfa9eb8a7ccef \
                    sha256  69df35dc42b6d11710ce1abdf4a0e1613feba8fca009f9c9a93d1716926ccac3 \
                    size    86471

patchfiles          patch-Makefile.in.diff

configure.pre_args
configure.universal_args-delete --disable-dependency-tracking

destroot {
    set destbindir  ${destroot}${prefix}/bin
    set destdocdir  ${destroot}${prefix}/share/doc/${name}
    set destincdir  ${destroot}${prefix}/include
    set destlibdir  ${destroot}${prefix}/lib
    set destmandir  ${destroot}${prefix}/share/man

    xinstall -d ${destbindir}
    xinstall -W ${worksrcpath} \
        dnsget \
        ex-rdns \
        rblcheck \
        ${destbindir}

    xinstall -d ${destincdir}
    xinstall -W ${worksrcpath} -m 644 \
        udns.h \
        ${destincdir}

    xinstall -d ${destlibdir}
    xinstall -W ${worksrcpath} -m 644 \
        libudns.a \
        ${destlibdir}

    xinstall -d ${destdocdir}
    xinstall -W ${worksrcpath} -m 644 \
        COPYING.LGPL \
        NEWS \
        NOTES \
        ${destdocdir}

    xinstall -d ${destmandir}/man1
    xinstall -W ${worksrcpath} \
        dnsget.1 \
        rblcheck.1 \
        ${destmandir}/man1

    xinstall -d ${destmandir}/man3
    xinstall -W ${worksrcpath} \
        udns.3 \
        ${destmandir}/man3
}

livecheck.type      regex
livecheck.url       https://www.corpit.ru/mjt/udns/
livecheck.regex     "udns-(\[0-9]+(\\.\[0-9]+)*)\\.tar\\.gz"
