From 5dbdacaa04c0d09077829dd252c5ee79b6185ff6 Mon Sep 17 00:00:00 2001
From: Un1q32 <joey.t.reinhart@gmail.com>
Date: Wed, 2 Sep 2026 02:49:25 -0400
Subject: [PATCH] vquic: fix preprocessor check for old Darwin versions

Closes #22797
---
 lib/vquic/vquic.c | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/lib/vquic/vquic.c b/lib/vquic/vquic.c
index bbc5777eac88..44103d3d6641 100644
--- a/deps/src/curl/lib/vquic/vquic.c
+++ b/deps/src/curl/lib/vquic/vquic.c
@@ -564,9 +564,12 @@ static size_t vquic_msghdr_get_udp_gro(struct msghdr *msg)
 }
 #endif /* (HAVE_SENDMMSG || HAVE_SENDMSG) && !HAVE_APPLE_MSG_X */
 
+/* IP_RECVTOS was added in the macOS 10.13 SDK */
 #if (defined(HAVE_SENDMMSG) || defined(HAVE_SENDMSG) || \
   defined(HAVE_APPLE_MSG_X)) && \
-  (defined(IP_RECVTOS) || defined(IP_TOS)) && defined(IPTOS_ECN_MASK)
+  ((defined(__APPLE__) && defined(IP_RECVTOS)) || \
+   (!defined(__APPLE__) && defined(IP_TOS))) && \
+  defined(IPTOS_ECN_MASK)
 static uint8_t vquic_msghdr_get_ecn(struct msghdr *msg, int family)
 {
   struct cmsghdr *cmsg;
