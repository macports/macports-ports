checksums           rmd160  cef5f950fc5daefdfe1bcf9d10fb30a539cfcf17 \
                    sha256  079f3b5932bb468ab677b3d390dd1d0961b789019842b2dc13f8c2e41239c713 \
                    size    4820101

worksrcdir          ${name}

depends_build-append \
                    port:pkgconfig \
                    port:zip
depends_lib-append  port:the_Foundation \
                    port:fribidi \
                    path:lib/pkgconfig/harfbuzz.pc:harfbuzz \
                    port:libjxl \
                    port:SDL3 \
                    port:mpg123 \
                    port:opusfile  \
                    port:webp

destroot {
    copy ${build.dir}/app/Lagrange.app ${destroot}${applications_dir}
}

variant tui description {Build the TUI interface} {
    configure.args-append \
                    -DENABLE_TUI=YES

    depends_lib-append \
                    port:ncurses \
                    port:sealcurses

    post-destroot {
        copy ${build.dir}/app/clagrange ${destroot}${prefix}/bin
        file mkdir ${destroot}${prefix}/share/lagrange
        copy ${build.dir}/app/Lagrange.app/Contents/Resources/resources.lgr ${destroot}${prefix}/share/lagrange
    }
}

