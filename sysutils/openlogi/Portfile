# Make xtask honor the Rust PortGroup's CARGO_BUILD_TARGET when locating bundle artifacts.
patchfiles-append       patch-xtask-cargo-build-target.diff
# https://github.com/AprilNEA/OpenLogi/pull/1228 - various fixes
patchfiles-append       patch-1228.diff
patch.args              -p1

post-patch {
    reinplace "s|13\\.0|${macosx_deployment_target}|g" \
        ${worksrcpath}/xtask/src/icon/macos.rs \
        ${worksrcpath}/crates/openlogi-desktop/Cargo.toml \
        ${worksrcpath}/crates/openlogi-desktop/bundle/agent-release/Info.plist \
        ${worksrcpath}/crates/openlogi-desktop/bundle/overlay-release/Info.plist
}

pre-fetch {
    if {${xcodeversion} eq "none" || [vercmp ${xcodeversion} 26.0] < 0} {
        ui_error "${name} requires Xcode 26.0 or later to compile its Icon Composer assets."
        return -code error "incompatible Xcode version"
    }
}

# Allow Cargo to fetch locked Git workspace dependencies that cannot use directory source replacement.
cargo.offline_cmd

build.env-append        OPENLOGI_DEVELOPER_DIR=${developer_dir}
build.cmd               ${cargo.bin} run
build.pre_args          --release --locked
build.args              -p xtask -- \
                        macos bundle --channel production

destroot {
    set app_name ${github.project}
    set source_app ${worksrcpath}/target/release/bundle/osx/${app_name}.app
    set dest_app ${destroot}${applications_dir}/${app_name}.app
    copy ${source_app} ${destroot}${applications_dir}

    # Preserve the independently identifiable login-item helpers by signing
    # from the inside out, as OpenLogi's release bundler does.
    set agent ${dest_app}/Contents/Library/LoginItems/OpenLogi\ Agent.app
    set overlay ${dest_app}/Contents/Library/LoginItems/OpenLogi\ Overlay.app
    set cli ${dest_app}/Contents/MacOS/openlogi
    set entitlements ${worksrcpath}/crates/openlogi-desktop/bundle/OpenLogi.entitlements
    foreach nested [list ${agent} ${overlay}] {
        system "/usr/bin/codesign --force --options runtime --timestamp=none \
            --sign - [shellescape ${nested}]"
    }
    system "/usr/bin/codesign --force --options runtime --timestamp=none \
        --entitlements [shellescape ${entitlements}] --sign - [shellescape ${cli}]"
    system "/usr/bin/codesign --force --options runtime --timestamp=none \
        --entitlements [shellescape ${entitlements}] --sign - [shellescape ${dest_app}]"

    xinstall -d ${destroot}${prefix}/bin
    ln -s ${applications_dir}/${app_name}.app/Contents/MacOS/openlogi \
        ${destroot}${prefix}/bin/${name}
}

