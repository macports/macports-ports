# Use MacPorts signing and tool paths without disabling XPC peer verification.
--- a/macUSB/Shared/Services/Helper/HelperConnectionSecurityPolicy.swift
+++ b/macUSB/Shared/Services/Helper/HelperConnectionSecurityPolicy.swift
@@ -1,8 +1,8 @@
 import Foundation
+import Security
 
 enum HelperConnectionSecurityPolicy {
     static let trustVerificationFailureMarker = "macusb_helper_trust_verification_failed"
-    private static let teamIdentifier = "27NC66L8P2"
 
     #if DEBUG
     static let expectedHelperBundleIdentifier = "com.kruszoneq.macusb.helper.debug"
@@ -10,8 +10,25 @@
     static let expectedHelperBundleIdentifier = "com.kruszoneq.macusb.helper"
     #endif
 
-    static let trustedHelperRequirement =
-        "anchor apple generic and certificate leaf[subject.OU] = \"\(teamIdentifier)\" and identifier \"\(expectedHelperBundleIdentifier)\""
+    // MacPorts signs locally. Pin XPC peers to the designated requirement
+    // of the installed binary (a cdhash for ad-hoc signatures).
+    static var trustedHelperRequirement: String {
+        let peerURL = Bundle.main.bundleURL.appendingPathComponent("Contents/Library/Helpers/macUSBHelper")
+        var code: SecStaticCode?
+        var requirement: SecRequirement?
+        var requirementText: CFString?
+        guard SecStaticCodeCreateWithPath(peerURL as CFURL, [], &code) == errSecSuccess,
+              let code,
+              SecStaticCodeCheckValidity(code, [], nil) == errSecSuccess,
+              SecCodeCopyDesignatedRequirement(code, [], &requirement) == errSecSuccess,
+              let requirement,
+              SecRequirementCopyString(requirement, [], &requirementText) == errSecSuccess,
+              let requirementText else {
+            // Fail closed if the installed peer cannot be authenticated.
+            return "never"
+        }
+        return requirementText as String
+    }
 
     static var localizedFailureTitle: String {
         String(localized: "Nie można zweryfikować helpera macUSB")
