PortSystem          1.0
PortGroup           golang 1.0

go.setup            github.com/synfinatic/aws-sso-cli 2.3.2 v
go.toolchain_min    1.26.4
go.offline_build    no
github.tarball_from archive
revision            0

homepage            https://synfinatic.github.io/aws-sso-cli/

# Building on macOS with cgo enables the native Keychain backend.
build.env-append    CGO_ENABLED=1
build.args-append   -trimpath \
                    -ldflags \"-X main.Version=${version} -X main.Tag=v${version} -X main.Buildinfos=MacPorts\" \
                    -o ${worksrcpath}/aws-sso \
                    ./cmd/aws-sso

description         AWS IAM Identity Center CLI
long_description    \
    {*}${description}. A secure command-line tool for discovering AWS IAM Identity Center \
    accounts and roles, retrieving temporary credentials, and opening AWS web console \
    sessions.

categories          sysutils
installs_libs       no
license             GPL-3+
maintainers         nomaintainer

checksums           rmd160  fd8485aa12fc6971bfd07bcd7577565f3c2b5fa9 \
                    sha256  3847945ad19bf9dddaea3a095095fb6e6425d95f8f1ca30d0a5a1f569aeaeaa3 \
                    size    431574

destroot {
    xinstall -m 0755 ${worksrcpath}/aws-sso ${destroot}${prefix}/bin/aws-sso
