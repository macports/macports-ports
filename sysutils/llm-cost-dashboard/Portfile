github.setup        Mattbusel llm-cost-dashboard 1.4.0 v
github.tarball_from archive
name                llm-cost-dashboard
revision            0
categories          sysutils devel
installs_libs       no
license             MIT
maintainers         {tensorust.com:mattbusel @Mattbusel} \
                    openmaintainer

description         Price LLM API calls from logs and watch spend in a terminal dashboard

long_description    {*}${description}. llm-dash reads JSONL request logs, \
                    Claude Code transcripts and OpenAI usage exports, prices \
                    each call (prompt caching and Batch API rates included) \
                    and shows spend, budgets and forecasts in a terminal UI, \
                    over HTTP or as Prometheus metrics.

checksums           ${distname}${extract.suffix} \
                    rmd160  a2345a495d5f5a3ca722a5422fa57bdf4d406fa7 \
                    sha256  9b3c096c5f0037617db98a993587b44c191ae99c4b19b41708bce8d5d76f560f \
                    size    2170070

set exec_name       llm-dash

destroot {
    set bin ${worksrcpath}/target/[cargo.rust_platform]/release/${exec_name}
    xinstall -m 0755 ${bin} ${destroot}${prefix}/bin/

    xinstall -d ${destroot}${prefix}/share/bash-completion/completions
    xinstall -d ${destroot}${prefix}/share/zsh/site-functions
    xinstall -d ${destroot}${prefix}/share/fish/vendor_completions.d
    system "${bin} --completions bash > ${destroot}${prefix}/share/bash-completion/completions/${exec_name}"
    system "${bin} --completions zsh > ${destroot}${prefix}/share/zsh/site-functions/_${exec_name}"
    system "${bin} --completions fish > ${destroot}${prefix}/share/fish/vendor_completions.d/${exec_name}.fish"

    xinstall -d ${destroot}${prefix}/share/doc/${name}
    xinstall -m 0644 -W ${worksrcpath} README.md CHANGELOG.md LICENSE \
        ${destroot}${prefix}/share/doc/${name}
}

test.run            yes
test.cmd            ${worksrcpath}/target/[cargo.rust_platform]/release/${exec_name}
test.target         --version

