if {$build_arch eq "arm64"} {
    distfiles       runx-0.9.1-aarch64-apple-darwin.tar.gz
    checksums       sha256 7106c89fa6f1808b5d48134de94a93fe64e7f3ccb47e603f1305a9ad12f0aec5
    worksrcdir      runx-0.9.1-aarch64-apple-darwin
} elseif {$build_arch eq "x86_64"} {
    distfiles       runx-0.9.1-x86_64-apple-darwin.tar.gz
    checksums       sha256 0976abcdde6932af9c8c6cd548c7e92763abae12378956de9b8c161b903c564c
    worksrcdir      runx-0.9.1-x86_64-apple-darwin
} else {
    known_fail      yes
}

use_configure       no
build               {}

destroot {
    xinstall -m 755 -d $destroot$prefix/bin
    xinstall -m 755 $worksrcpath/runx $destroot$prefix/bin/runx
    xinstall -m 755 $worksrcpath/runx-js-worker $destroot$prefix/bin/runx-js-worker
}
