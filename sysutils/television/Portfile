PortSystem          1.0
PortGroup           cargo 1.0
PortGroup           github 1.0

github.setup        alexpasmantier television 0.15.9
github.tarball_from archive
revision            0

categories          sysutils
license             MIT
maintainers         @nino-mau openmaintainer
installs_libs       no

description         A very fast, portable and hackable fuzzy finder.
long_description    Television is a fast, portable fuzzy finder for the terminal. \
                    It lets you search in real-time through any kind of data source \
                    such as files, text, git repositories, environment variables, docker containers, and more.

checksums           ${distname}${extract.suffix} \
                    rmd160  6bccaebf88d4851a9840a0d2e96d353a3ef29b07 \
                    sha256  5f46cbe7b14e1d6e3958f436b1d6ed8af86e9914d7d2aee5a9379e8e1772072d \
                    size    25491411

# Required by the default files channel.
depends_run-append  port:bat \
                    port:fd

set tv_bin          ${worksrcpath}/target/[cargo.rust_platform]/release/tv

post-build {
    foreach _shell {bash fish zsh} {
        system -W ${worksrcpath} \
            "${tv_bin} completions ${_shell} > tv.${_shell}"
    }
}

destroot {
    xinstall -m 0755 ${tv_bin} ${destroot}${prefix}/bin/
    xinstall -m 0644 ${worksrcpath}/man/tv.1 \
        ${destroot}${prefix}/share/man/man1/

    # Install shell completions.
    xinstall -d ${destroot}${prefix}/share/bash-completion/completions
    xinstall -m 0644 ${worksrcpath}/tv.bash \
        ${destroot}${prefix}/share/bash-completion/completions/tv

    xinstall -d ${destroot}${prefix}/share/fish/vendor_completions.d
    xinstall -m 0644 ${worksrcpath}/tv.fish \
        ${destroot}${prefix}/share/fish/vendor_completions.d/

    xinstall -d ${destroot}${prefix}/share/zsh/site-functions
    xinstall -m 0644 ${worksrcpath}/tv.zsh \
        ${destroot}${prefix}/share/zsh/site-functions/_tv

    set docdir ${destroot}${prefix}/share/doc/${name}
    xinstall -d ${docdir}
    xinstall -m 0644 ${worksrcpath}/LICENSE ${docdir}
}

