set _bin_name       tldr

notes "tealdeer is installed as ${_bin_name}"

destroot {
    xinstall -m 0755 \
        {*}[glob ${worksrcpath}/target/*/release/${_bin_name}] \
        ${destroot}${prefix}/bin/

    # Shell completions
    xinstall -d ${destroot}${prefix}/share/bash-completion/completions
    xinstall ${worksrcpath}/completion/bash_${name} \
        ${destroot}${prefix}/share/bash-completion/completions/${name}

    xinstall -d ${destroot}${prefix}/share/fish/vendor_completions.d
    xinstall ${worksrcpath}/completion/fish_${name} \
        ${destroot}${prefix}/share/fish/vendor_completions.d/${name}.fish

    xinstall -d ${destroot}${prefix}/share/zsh/site-functions
    xinstall ${worksrcpath}/completion/zsh_${name} \
        ${destroot}${prefix}/share/zsh/site-functions/_${name}
}


