# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           github 1.0

# Repackages upstream's signed and notarized release instead of building
# from source: a source build goes through xcodebuild (see
# https://trac.macports.org/ticket/68731), fetches Swift packages at build
# time, and the extension's app-group entitlements need upstream's signing
# identity.

github.setup        sbarex QLMarkdown 1.5.7
github.tarball_from releases
revision            0

categories          sysutils textproc
license             GPL-3
maintainers         nomaintainer
platforms           {darwin >= 21}
# Upstream ships a universal binary.
supported_archs     x86_64 arm64
installs_libs       no

description         Quick Look extension for Markdown files
long_description    QLMarkdown previews Markdown files in Quick Look, with \
                    GitHub Flavored Markdown, syntax highlighting of code \
                    blocks, math, emoji and more. It also ships a command \
                    line renderer, qlmarkdown_cli.

# The release asset is not versioned (QLMarkdown.zip): keep each version's
# distfile in its own directory so a version bump never reuses a stale one.
distname            QLMarkdown
dist_subdir         ${name}/${version}
use_zip             yes
extract.mkdir       yes

checksums           rmd160  dfa412d2726e937713cd410c3a23b65404837534 \
                    sha256  96cc95553ee63557f7ec58f41a568ff1fe5bca95b6bcd3883709fa8337c685d4 \
                    size    26322745

use_configure       no
build {}

# The prebuilt bundle is universal whatever the configured arch; thinning it
# would break its code signature.
test.ignore_archs   yes

destroot {
    xinstall -d ${destroot}${applications_dir} ${destroot}${prefix}/bin
    # Copy the notarized bundle untouched (symlinks included), so its
    # signature stays valid.
    copy ${worksrcpath}/QLMarkdown.app ${destroot}${applications_dir}

    # Upstream says the CLI must stay inside the bundle: link to it.
    ln -s ${applications_dir}/QLMarkdown.app/Contents/Resources/qlmarkdown_cli \
        ${destroot}${prefix}/bin/qlmarkdown_cli
}

notes "
To activate the Quick Look extension:
  1. Launch ${applications_dir}/QLMarkdown.app once, so macOS discovers the extension.
  2. Enable it in System Settings > General > Login Items & Extensions > Quick Look.

QLMarkdown updates itself with Sparkle. Turn off its automatic update checks\
 and update through MacPorts instead, so the installed files stay in sync with\
 the MacPorts registry.

Per-user support files live in ~/Library/Group Containers/group.org.sbarex.qlmarkdown\
 and are not removed when the port is uninstalled.
"
