# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           cargo   1.0
PortGroup           github  1.0

github.setup        NVIDIA OpenShell 0.1.6 v
github.tarball_from archive
name                openshell
revision            0

homepage            https://docs.nvidia.com/openshell/latest/

description         Safe, private runtime for autonomous AI agents

long_description    \
    OpenShell runs autonomous AI agents in sandboxes governed by declarative \
    policies covering filesystem, network, process and inference access. \
    This port provides the openshell CLI, the openshell-gateway control \
    plane and the openshell-prover policy verifier.

categories          sysutils security
installs_libs       no
license             Apache-2
platforms           {darwin >= 16}
maintainers         {gmail.com:herby.gillot @herbygillot} \
                    openmaintainer

checksums           ${distname}${extract.suffix} \
                    rmd160  445027ba4dae8e4dc4addf0bda8a240587bd8fab \
                    sha256  e7bce772f5837a4ffc29fb51a49381eec3d4771a9f015c75b06d4f66deb109d2 \
                    size    8480348

depends_build-append \
                    path:bin/pkg-config:pkgconfig \
                    path:bin/protoc:protobuf3-cpp

depends_lib-append  port:libiconv \
                    port:z3

# Upstream stamps the workspace version at release time; Cargo.lock lists it too
post-patch {
    reinplace "s|^version = \"0.0.0\"\$|version = \"${version}\"|" \
        ${worksrcpath}/Cargo.toml ${worksrcpath}/Cargo.lock
}

# libz3 has an @rpath install name
rust.flags-append   -C link-arg=-Wl,-rpath,${prefix}/lib

build.env-append    GIT_DIR=/nonexistent \
                    PROTOC=${prefix}/bin/protoc

build.args          -p openshell-cli \
                    -p openshell-gateway \
                    -p openshell-prover-cli

set openshell_bins  {openshell openshell-gateway openshell-prover}

destroot {
    foreach bin ${openshell_bins} {
        xinstall -m 0755 \
            ${worksrcpath}/target/[cargo.rust_platform]/release/${bin} \
            ${destroot}${prefix}/bin/
    }

    set openshell ${destroot}${prefix}/bin/openshell
    foreach {shell dest} {
        bash    share/bash-completion/completions/openshell
        fish    share/fish/vendor_completions.d/openshell.fish
        zsh     share/zsh/site-functions/_openshell
    } {
        xinstall -d [file dirname ${destroot}${prefix}/${dest}]
        system "${openshell} completions ${shell} > ${destroot}${prefix}/${dest}"
    }

    set docdir ${destroot}${prefix}/share/doc/${name}
    xinstall -d ${docdir}
    xinstall -m 0644 -W ${worksrcpath} \
        LICENSE README.md THIRD-PARTY-NOTICES ${docdir}
}

notes "
${name} does not include openshell-driver-vm, so openshell-gateway runs\
sandboxes with Docker or Podman. The gateway sends anonymous usage telemetry\
unless OPENSHELL_TELEMETRY_ENABLED=false is set in its environment.
"

test.run            yes
test {
    foreach bin ${openshell_bins} {
        set out [exec ${worksrcpath}/target/[cargo.rust_platform]/release/${bin} --version]
        if {${out} ne "${bin} ${version}"} {
            return -code error "unexpected ${bin} --version output: ${out}"
        }
    }

    set fixtures ${worksrcpath}/crates/openshell-prover-cli/tests/fixtures
    set out [exec ${worksrcpath}/target/[cargo.rust_platform]/release/openshell-prover \
        check --boundary ${fixtures}/boundary.yaml ${fixtures}/candidate-contained.yaml]
    if {![string match "result: within_boundary*" ${out}]} {
        return -code error "unexpected openshell-prover check output: ${out}"
    }
}

