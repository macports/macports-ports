PortSystem          1.0
PortGroup           github 1.0

github.setup        bats-core bats-assert 2.2.4 v
github.tarball_from archive
revision            0

categories          sysutils devel
platforms           any
supported_archs     noarch
# CC0 1.0, a public-domain dedication; MacPorts has no CC0 license name.
license             public-domain
maintainers         {@jrjsmrtn gmail.com:jrjsmrtn} openmaintainer

description         Common assertions for Bats
long_description    bats-assert is a helper library providing common assertions for \
                    Bats, such as assert_output and assert_line.

checksums           rmd160  6df13d5d280006838ba16feed87dde0e270a183d \
                    sha256  e305df20c4c36cba4570e10f1cd824efb1ae71d88b5ef474550781ebee04192f \
                    size    24904

depends_run         port:bats-support

use_configure       no
build               {}

# Where bats-core's bats_load_library looks: bats_load_library bats-assert.
destroot {
    set dir ${destroot}${prefix}/lib/bats/${name}
    xinstall -d ${dir} ${destroot}${prefix}/share/doc/${name}
    xinstall -m 0644 ${worksrcpath}/load.bash ${dir}
    copy ${worksrcpath}/src ${dir}
    xinstall -m 0644 ${worksrcpath}/README.md ${worksrcpath}/LICENSE \
        ${destroot}${prefix}/share/doc/${name}
}

depends_test        port:bats-core \
                    port:bats-support
test.run            yes
test.cmd            ${prefix}/bin/bats
test.target         test
