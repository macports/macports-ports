# The upstream binary is installed as-shipped, so its compiled-in defaults
# still point at /var/osquery and /var/log/osquery. Every path osquery writes
# to or reads from has to be redirected into the MacPorts prefix here.
--config_path=@CONFPATH@/osquery.conf
--database_path=@DATAPATH@/osquery.db
--logger_path=@LOGPATH@
--pidfile=@RUNPATH@/osquery.pidfile
--extensions_socket=@RUNPATH@/osquery.em
--extensions_autoload=@CONFPATH@/extensions.load
--augeas_lenses=@SHAREPATH@/lenses
