# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           github 1.0

github.setup        dedalozzo chaperone 1.0.1 v
github.tarball_from archive
revision            0

categories          sysutils devel
license             MIT
maintainers         {@dedalozzo} openmaintainer
platforms           {darwin >= 22}
installs_libs       no

description         Run a script as the responsible process of a background app

long_description    Chaperone is a tiny background-only macOS app that runs \
                    one script as its responsible process. Listed under \
                    System Settings > Privacy & Security > Developer Tools, \
                    it exempts the programs the script builds and starts \
                    from the XProtect first-launch scan. It runs only scripts \
                    under prefixes you allowlist in ~/.config/chaperone/allow.

checksums           rmd160  b6d294e5978b992a66d5bf69715cc929bb2b13e7 \
                    sha256  9a44f47b5d4d42ee98486df827e987f351195374a1f9036c3913c72b67258d68 \
                    size    5324700

use_configure       no

# The Makefile calls swiftc and codesign itself, for the architecture in
# ARCH, and installs with `make install DESTDIR=...`. APP_PATH is written
# into the installed shim.
build.args          ARCH=${configure.build_arch}

destroot.args       ARCH=${configure.build_arch} \
                    PREFIX_APP=${applications_dir} \
                    PREFIX_BIN=${prefix}/bin \
                    APP_PATH=${applications_dir}/Chaperone.app

# `make test` runs test/run.sh against a separate test build of the app; it
# never reads the user's allowlist.
test.run            yes
test.target         test
test.args           ARCH=${configure.build_arch}

notes "
Add ${applications_dir}/Chaperone.app in System Settings > Privacy &\
 Security > Developer Tools (press Shift-Cmd-G in the picker and type the\
 path), and make sure its switch is on. Remove it and add it again after\
 every upgrade: the app is signed ad hoc, so its identity changes with each\
 new version.

Chaperone refuses every script until you list the allowed prefixes, one\
 per line, in ~/.config/chaperone/allow. See\
 https://github.com/dedalozzo/chaperone#the-allowlist
"
