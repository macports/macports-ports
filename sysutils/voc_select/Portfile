PortSystem          1.0
PortGroup           stub 1.0
PortGroup           select 1.0

name                voc_select
version             1.0
revision            0
categories          sysutils lang
maintainers         {freebsd.am:antranigv @antranigv} openmaintainer
supported_archs     noarch
platforms           any
description         Common files for selecting default Vishap Oberon Compiler
long_description    This port installs files that allow 'port select' to create \
                    links to the preferred default version of voc (Vishap Oberon). \
                    Install voc2 (and later a select-aware voc) then run \
                    e.g. 'sudo port select --set voc voc2'.

# Documentation for voc ports that participate in this group:
#   PortGroup           select 1.0
#   depends_run-append  port:voc_select
#   select.group        voc
#   select.file         ${filespath}/${name}

post-destroot {
    select::install voc ${filespath}/base
    select::install voc ${filespath}/none
}

livecheck.type      none
