PortSystem          1.0
PortGroup           golang 1.0

go.setup            github.com/containers/buildah 1.45.2 v
go.package          go.podman.io/buildah
go.toolchain_min    1.26
revision            0

homepage            https://buildah.io

description         Tool that facilitates building OCI images

long_description    {*}${description}. It can be used to build images \
                    in the OCI or traditional Docker image format, and \
                    to work with container images and container storage.

categories          sysutils
installs_libs       no
license             Apache-2
maintainers         {jesuschapman.me:developer @JesusChapman} openmaintainer

checksums           ${distname}${extract.suffix} \
                    rmd160  a46d1bb04c3a90dc2ce6b00c6c416d4ccdde89de \
                    sha256  bcf85e76b9d1ce18a20efb32d330a624e7ee6fd368ae1da4ef0b17b0738615c9 \
                    size    11453807

depends_build-append \
                    port:go-md2man

depends_lib-append  port:gpgme \
                    port:gnupg2 \
                    port:libassuan \
                    port:sqlite3 \
                    path:bin/pkg-config:pkgconfig

build.cmd           make
build.target        bin/buildah

post-build {
    system -W ${worksrcpath}/docs "make GOMD2MAN=${prefix}/bin/go-md2man"
}

destroot {
    xinstall -m 755 ${worksrcpath}/bin/buildah ${destroot}${prefix}/bin/

    xinstall -d -m 755 ${destroot}${prefix}/etc/containers
    xinstall -m 644 ${worksrcpath}/tests/policy.json \
        ${destroot}${prefix}/etc/containers/
    xinstall -m 644 ${worksrcpath}/tests/registries.conf \
        ${destroot}${prefix}/etc/containers/

    xinstall -d -m 755 ${destroot}${prefix}/share/man/man1
    xinstall -m 644 {*}[glob ${worksrcpath}/docs/buildah*.1] \
        ${destroot}${prefix}/share/man/man1/
    xinstall -m 644 {*}[glob ${worksrcpath}/docs/links/buildah*.1] \
        ${destroot}${prefix}/share/man/man1/

    xinstall -d -m 755 ${destroot}${prefix}/share/bash-completion/completions
    xinstall -m 644 ${worksrcpath}/contrib/completions/bash/buildah \
        ${destroot}${prefix}/share/bash-completion/completions/
}
