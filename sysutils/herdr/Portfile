description         Terminal workspace manager for AI coding agents

long_description    Herdr is a terminal workspace manager built for AI coding \
                    agents. It keeps agent sessions running in the background, \
                    restores them after disconnects, reports which agents are \
                    working or blocked, and exposes the same controls through \
                    its CLI and socket API.

checksums           ${distname}${extract.suffix} \
                    rmd160  fcdcf7b918f7c7035dc372fc8664bbb8dc1ff0f5 \
                    sha256  60453051025ee44ebf055d26cdaf665a0accd99a992cddd22c166a26c49cd161 \
                    size    10800785

# The Zig series libghostty-vt builds its own sources with. An exact pin, not a
# floor: Zig breaks the language and standard library at every minor release.
set zig_series      0.15

patchfiles          patch-macports-update.diff
patch.args          -p1

# Inherited from the Zig toolchain, which is the only thing here that will not
# build further back.
platforms           "darwin >= [zig_toolchain.min_darwin ${zig_series}]"

depends_build-append \
                    port:zig-${zig_series}

# herdr vendors libghostty-vt and builds it with Zig during the cargo build.
# That Zig build pulls its own dependencies -- 22 packages, most of them
# Ghostty's GUI assets that the VT library never uses -- and they are left to
# Zig to fetch rather than declared as distfiles here.
#
# Setting LIBGHOSTTY_VT_ZIG_SYSTEM_DIR is what would make vendor/libghostty-vt
# pass `zig build --system`, which disables fetching and then requires every
# one of those packages to be laid out by hand. It is deliberately not set.
#
# The cache variables keep everything Zig fetches inside the work directory.
build.env-append    HERDR_MACPORTS_BUILD=1 \
                    ZIG=[zig_toolchain.bin ${zig_series}] \
                    ZIG_GLOBAL_CACHE_DIR=${workpath}/zig-global-cache \
                    ZIG_LOCAL_CACHE_DIR=${workpath}/zig-local-cache

post-build {
    set release_dir ${worksrcpath}/target/[cargo.rust_platform]/release
    set herdr       ${release_dir}/${name}

    set bash_completions_dir ${release_dir}/share/bash-completion/completions
    set fish_completions_dir ${release_dir}/share/fish/vendor_completions.d
    set zsh_completions_dir  ${release_dir}/share/zsh/site-functions

    xinstall -d ${bash_completions_dir} \
        ${fish_completions_dir} \
        ${zsh_completions_dir}

    system "${herdr} completion bash > ${bash_completions_dir}/${name}"
    system "${herdr} completion fish > ${fish_completions_dir}/${name}.fish"
    system "${herdr} completion zsh > ${zsh_completions_dir}/_${name}"
}

destroot {
    set release_dir ${worksrcpath}/target/[cargo.rust_platform]/release

    xinstall -m 0755 ${release_dir}/${name} \
        ${destroot}${prefix}/bin/

    foreach completions_dir {
        share/bash-completion/completions 
        share/fish/vendor_completions.d 
        share/zsh/site-functions
    } {
        xinstall -d ${destroot}${prefix}/${completions_dir}
        copy {*}[glob ${release_dir}/${completions_dir}/*] \
            ${destroot}${prefix}/${completions_dir}/
    }

    set docdir ${prefix}/share/doc/${name}
    xinstall -d ${destroot}${docdir}
    xinstall -m 0644 ${worksrcpath}/LICENSE ${worksrcpath}/README.md \
        ${destroot}${docdir}/
}

test.run            yes
test.dir            ${worksrcpath}/target/[cargo.rust_platform]/release
test.cmd            ./${name}
test.target         --version

