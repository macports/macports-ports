# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem              1.0
PortGroup               github 1.0

github.setup            godspeedhq vigil 0.6.5 v
github.tarball_from     releases
revision                0
distname                vigil-${github.version}

categories              sysutils
platforms               any
supported_archs         noarch
license                 Apache-2
maintainers             @bjo004 openmaintainer

description             Job scheduler, supervisor and metrics forwarder in each OS's own shells
long_description        Vigil runs scheduled jobs, supervises them and forwards their \
                        metrics and logs to Datadog, OpenTelemetry, Splunk or a file. \
                        It is written in the shells that ship with each OS (bash on \
                        Linux and macOS, PowerShell on Windows), so it needs nothing \
                        else installed.
homepage                https://github.com/godspeedhq/vigil

checksums               rmd160  bdcb5318e036a7205f6d474ea33c078d89a49c28 \
                        sha256  b10aacd6e870979d6e3ec28957c6b4bc997551649163f5bbc5b33741409e4c39 \
                        size    590230

use_configure           no

# The supervisor runs as root from the LaunchDaemon below, as the install
# script's system service does; its root is ${prefix}/var/vigil.
set vigil_root          ${prefix}/var/vigil
set vigil_label         org.macports.vigil

startupitem.type        launchd
startupitem.location    LaunchDaemons
startupitem.install     yes
startupitem.custom_file ${worksrcpath}/${vigil_label}.plist

# Vigil's own LaunchDaemon (SPECIFICATION.md 18): restarted on failure but
# not after a clean stop, and only the supervisor is stopped, so running jobs
# finish. Disabled until port load, as MacPorts' own startup items are.
build {
    set plist [open ${worksrcpath}/${vigil_label}.plist w]
    puts ${plist} "<?xml version=\"1.0\" encoding=\"UTF-8\"?>
<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">
<plist version=\"1.0\">
<dict>
  <key>Label</key><string>${vigil_label}</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>${prefix}/libexec/vigil/app/vigil</string>
    <string>--root</string>
    <string>${vigil_root}</string>
    <string>supervise</string>
  </array>
  <key>WorkingDirectory</key><string>${vigil_root}</string>
  <key>Disabled</key><true/>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>AbandonProcessGroup</key><true/>
  <key>StandardOutPath</key><string>${vigil_root}/logs/supervisor/service.log</string>
  <key>StandardErrorPath</key><string>${vigil_root}/logs/supervisor/service.log</string>
</dict>
</plist>"
    close ${plist}
}

# The program, read-only and MacPorts': self update leaves it to port, and
# service install to port load (18.6).
destroot {
    xinstall -d ${destroot}${prefix}/libexec/vigil
    copy ${worksrcpath}/app ${worksrcpath}/packs ${destroot}${prefix}/libexec/vigil/
    set f [open ${destroot}${prefix}/libexec/vigil/app/PACKAGED w]
    puts ${f} "manager = MacPorts
upgrade = sudo port selfupdate && sudo port upgrade vigil
root    = ${vigil_root}
service = sudo port load vigil"
    close ${f}
    xinstall -d ${destroot}${prefix}/bin
    set f [open ${destroot}${prefix}/bin/vigil w]
    puts ${f} "#!/bin/bash
exec /bin/bash \"${prefix}/libexec/vigil/app/vigil\" \"\$@\""
    close ${f}
    file attributes ${destroot}${prefix}/bin/vigil -permissions 0755
    xinstall -d ${destroot}${prefix}/share/doc/vigil
    xinstall -m 0644 -W ${worksrcpath} LICENSE ${destroot}${prefix}/share/doc/vigil
}

# The root is Vigil's data, not MacPorts' files: made on activation, kept
# when the port is deactivated or uninstalled. A starting configuration only
# when there is none: the defaults vigil init takes on Enter (the host name,
# metrics to a file, the base pack).
post-activate {
    xinstall -d ${vigil_root}/logs/supervisor
    if {![file exists ${vigil_root}/config/vigil.config]} {
        system "/bin/bash ${prefix}/libexec/vigil/app/vigil init --backend file < /dev/null"
    }
}

notes "
Vigil's configuration, scripts, state and logs are in ${vigil_root}:
  sudo vigil config        edits the configuration
  sudo port load vigil     runs it now and at every boot
Uninstalling the port keeps ${vigil_root}.
"

github.livecheck.regex  {([0-9.]+)}
