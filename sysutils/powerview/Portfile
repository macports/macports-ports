PortSystem          1.0
PortGroup           github 1.0

github.setup        NatePick PowerView 0.3.3 v
github.tarball_from archive

checksums           rmd160  def651838c419bedf30b619538d50a077d013d0a \
                    sha256  b7566c9f0cf734be1284d2f2554b2f003ed0de632ae77e486c23a303daee8a3a \
                    size    11417

name                powerview
revision            0

categories          sysutils
supported_archs     noarch

license             MIT
maintainers         nomaintainer

description         An nvtop-style terminal GPU monitor for macOS

long_description    PowerView is a customizable terminal GPU monitoring \
                    utility for macOS powered by Apple's powermetrics.

homepage            https://github.com/NatePick/PowerView

depends_run         port:python313

use_configure       no

build {}

destroot {
        xinstall -d ${destroot}${prefix}/libexec/powerview
    
        xinstall -m 755 \
            ${worksrcpath}/powerview.py \
            ${destroot}${prefix}/libexec/powerview/powerview.py
    
        xinstall -m 755 \
            ${worksrcpath}/powerview-helper \
            ${destroot}${prefix}/libexec/powerview/powerview-helper
    
        file attributes \
            ${destroot}${prefix}/libexec/powerview/powerview-helper \
            -owner root \
            -group wheel \
            -permissions 0755
    
        xinstall -d ${destroot}${prefix}/bin

    set launcher ${destroot}${prefix}/bin/powerview
    set fp [open ${launcher} w]

    puts ${fp} "#!/bin/sh"
    puts ${fp} "exec ${prefix}/bin/python3.13 ${prefix}/libexec/powerview/powerview.py \"\$@\""

    close ${fp}

    file attributes ${launcher} -permissions 0755
}
