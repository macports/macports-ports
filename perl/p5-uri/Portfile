PortSystem          1.0
PortGroup           perl5 1.0

perl5.branches      5.28 5.30 5.32 5.34
perl5.setup         URI 5.36 ../../authors/id/O/OA/OALDERS
license             {Artistic-1 GPL}
maintainers         nomaintainer
description         URI - Uniform Resource Identifiers (absolute and relative)
long_description    {*}${description}

platforms           {darwin any}
supported_archs     noarch

checksums           rmd160  1885ba1624750e690c7644a5705b791f78392578 \
                    sha256  32719e57413db6e18492e104707b95c2210df637614c512e7368c9ec3c2f783b \
                    size    137403

if {${perl5.major} != ""} {
    depends_build-append \
                    port:p${perl5.major}-test-fatal \
                    port:p${perl5.major}-test-needs \
                    port:p${perl5.major}-test-warnings

    depends_lib-append \
                    port:p${perl5.major}-mime-base32 \
                    port:p${perl5.major}-mime-base64 \
                    port:p${perl5.major}-regexp-ipv6

    # As of URI 5.34, the fuctionality of separate module URI::ws
    # has been added to URI proper.  Deactivate port p${perl5.major}-uri-ws
    # if active to avoid activation conflicts.
    pre-activate {
        set pname p${perl5.major}-uri-ws
        if {![catch {set installed [lindex [registry_active $pname] 0]}]} {
            registry_deactivate_composite $pname "" [list ports_nodepcheck 1]
        }
    }
}

livecheck.type      regex
livecheck.url       https://cpan.metacpan.org/authors/id/O/OA/OALDERS
livecheck.regex     "${perl5.module}-(\\d+(?:\\.\\d+)*)"
