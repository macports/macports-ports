PortSystem          1.0
PortGroup           perl5 1.0

perl5.branches      5.28 5.30 5.32 5.34
perl5.setup         DBD-Pg 3.21.2 ../../authors/id/T/TU/TURNSTEP
revision            0
license             {Artistic-1 GPL}
categories-append   databases
maintainers         nomaintainer
description         DBD::Pg - PostgreSQL database driver for the DBI module
long_description    {*}${description}

checksums           rmd160  2c3ffdce0e61023faf656c55076ac5c3f4590668 \
                    sha256  d79179255ccb0c87b029db2eecaea56828e581255c48445d5fc0e79fa4e9245b \
                    size    318356

if {${perl5.major} ne ""} {
    depends_build-append \
                    port:p${perl5.major}-app-info \
                    port:p${perl5.major}-extutils-makemaker \
                    port:p${perl5.major}-test-simple \
                    port:p${perl5.major}-time-hires

    depends_lib-append \
                    port:p${perl5.major}-dbi \
                    port:p${perl5.major}-version


    variant postgresql10 requires postgresql14 description "Legacy compatibility variant" {}
    variant postgresql11 requires postgresql14 description "Legacy compatibility variant" {}
    variant postgresql12 requires postgresql14 description "Legacy compatibility variant" {}
    variant postgresql13 requires postgresql14 description "Legacy compatibility variant" {}

    set pg_vers {14 15 16 17 18}
    set pg_names [lmap v $pg_vers {string cat postgresql ${v}}]
    foreach v ${pg_vers} pg_name ${pg_names} {
        variant ${pg_name} \
                conflicts {*}[ldelete ${pg_names} ${pg_name}] \
                description "Build with PostgreSQL ${v} Port" "
            depends_lib-append      port:${pg_name}
            configure.env           PATH=${prefix}/lib/postgresql${v}/bin:$env(PATH) \
                                    POSTGRES_INCLUDE=${prefix}/include/postgresql${v} \
                                    \"POSTGRES_LIB=${prefix}/lib/postgresql${v} -lssl\"
        "
    }

    set none_selected 1
    foreach pg_ver ${pg_names} {
        if {[variant_isset ${pg_ver}]} {
            set none_selected 0
            break
        }
    }

    if {${none_selected}} {
        default_variants +[lindex ${pg_names} end]
    }

}
