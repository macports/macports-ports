By default, the build system will download an appropriate JDK to build
the project.  Alter the build system to instead search for an installed
JDK.

--- pom.xml.orig	2026-11-03 03:36:08
+++ pom.xml	2026-11-03 10:35:16
@@ -392,17 +392,10 @@
           <executions>
             <execution>
               <goals>
-                <goal>toolchain</goal>
+                <goal>select-jdk-toolchain</goal>
               </goals>
             </execution>
           </executions>
-          <configuration>
-            <toolchains>
-              <jdk>
-                <version>27</version>
-              </jdk>
-            </toolchains>
-          </configuration>
         </plugin>
         <plugin>
           <groupId>org.codehaus.mojo</groupId>
