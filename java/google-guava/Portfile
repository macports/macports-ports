# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem              1.0
PortGroup               github 1.0
PortGroup               maven 1.0

name                    google-guava
github.setup            google guava 33.7.2 v
github.tarball_from     archive

categories              java
license                 Apache-2
platforms               any
supported_archs         noarch
homepage                https://guava.dev
maintainers             {sethm.id.au:dev @McDaMastR} \
                        openmaintainer

description             Google's core libraries for Java
long_description        Google Guava replaces and includes Google Collections \
                        plus many other important core libraries.  It is a \
                        strict, backward-compatible superset of the Google \
                        Collections Library.  It also includes six months \
                        worth of bug fixes, documetnation fixes, and \
                        performance fixes, so it is strongly encouraged to \
                        instead of Google Collections.

depends_run-append      port:failureaccess

# Building requires Java >= 22-24
# Running requires Java >= 8
# <https://github.com/google/guava/issues/8650>
if {[variant_isset gwt]} {
    java.version        24+
} else {
    java.version        22+
}

checksums               rmd160  4e48528290af6de8ca0df489f5f09df237c39f5a \
                        sha256  d268bdf736d6d45ef381ce05c5715824324877e5f0bf56d9f4e34700ac978d04 \
                        size    5954566

patchfiles              use-installed-jdk.diff

build.args-append       --define=maven.javadoc.skip \
                        --define=maven.source.skip \
                        --define=toolchain.jdk.version="\[[java::selected_version],)" \
                        --define=toolchain.skip \
                        --projects=guava \
                        --projects=guava-testlib

destroot {
    set destdocdir  ${destroot}${prefix}/share/doc/${name}
    set destjavadir ${destroot}${prefix}/share/java

    set modules {
        guava
        guava-testlib
    }

    xinstall -d ${destjavadir}
    foreach module ${modules} {
        xinstall -W ${worksrcpath} -m 644 \
            ${module}/target/${module}-${version}-jre.jar \
            ${destjavadir}/${module}-jre.jar
    }

    if {[variant_isset gwt]} {
        xinstall -W ${worksrcpath} -m 644 \
            guava-gwt/target/guava-gwt-${version}-jre.jar \
            ${destjavadir}/guava-gwt-jre.jar
    }

    xinstall -d ${destdocdir}
    xinstall -W ${worksrcpath} -m 644 \
        CONTRIBUTING.md \
        CONTRIBUTORS \
        LICENSE \
        README.md \
        ${destdocdir}

    if {[variant_isset doc]} {
        xinstall -d ${destdocdir}/javadoc
        foreach module ${modules} {
            copy \
                ${worksrcpath}/${module}/target/reports/apidocs \
                ${destdocdir}/javadoc/${module}
        }
    }
}

variant doc \
        description {Install javadoc} {
    build.args-delete   --define=maven.javadoc.skip
}

variant gwt \
        description {Add GWT support} {
    # Bypass build system bug w/ package goal
    build.target        install
    build.args-append   --projects=guava-gwt \
                        --projects=guava-tests
    build.args-delete   --define=maven.source.skip
}
