# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           github 1.0
PortGroup           maven 1.0

name                itext
github.setup        itext itext-java 9.7.1
github.tarball_from archive

# Prevent *-android tags from counting as new versions
github.livecheck.regex \
                    {([0-9.]+)}

categories          java print
license             {AGPL-3+ Commercial}
platforms           any
supported_archs     noarch
maintainers         nomaintainer

description         Java library that allows you to generate PDF files \
                    on the fly.

long_description    iText Core/Community for Java is a library with a \
                    suite of tools for creating, manipulating, and \
                    maintaining PDF documents.

homepage            https://itextpdf.com/products/itext-core
checksums           rmd160  684cf2506cbaaf70c85e8485e98c8677edf194c0 \
                    sha256  7d9cc4d94d06cfc5c94a191fc179d1e1cf8553473b70c4070a539be16f5c10f9 \
                    size    871632963

java.version        1.8+
java.fallback       openjdk11

destroot {
    set destjavadir ${destroot}${prefix}/share/java/itextpdf
    set modules {
        barcodes
        bouncy-castle-adapter
        bouncy-castle-connector
        bouncy-castle-fips-adapter
        brotli-compressor
        commons
        font-asian
        forms
        hyph
        io
        kernel
        layout
        pdfa
        pdftest
        pdfua
        sign
        styled-xml-parser
        svg
        webp-image-support
    }

    xinstall -d -m 755 ${destjavadir}

    foreach module ${modules} {
        xinstall -m 644 \
            ${worksrcpath}/${module}/target/itext-${module}-${version}.jar \
            ${destjavadir}/${module}.jar
    }
}
