# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem              1.0
PortGroup               maven 1.0

name                    commons-logging
version                 1.4.0
revision                1

categories              java
license                 Apache-2
platforms               any
supported_archs         noarch
homepage                https://commons.apache.org/proper/commons-logging
maintainers             nomaintainer

description             Apache Commons-Logging
long_description        Commons-Logging is a wrapper around a variety of \
                        logging API implementations.

if {[variant_isset doc]} {
    java.version        11+
} else {
    java.version        1.8+
}

master_sites            apache:commons/logging/source/
distname                ${name}-${version}-src
dist_subdir             ${name}/${version}_1

checksums               rmd160  d759eee8dac33a8ccd90f99b03c8d7106f196e1e \
                        sha256  3596de02a6b4d4f11b4353f4db7964cb248fdc18252a4636eb1496149a5fcd9e \
                        size    259506

build.args-append       --define=maven.source.skip

destroot {
    set destdocdir  ${destroot}${prefix}/share/doc/${name}
    set destjavadir ${destroot}${prefix}/share/java

    xinstall -d ${destjavadir}
    xinstall -m 644 \
        ${worksrcpath}/target/${name}-${version}.jar \
        ${destjavadir}/${name}.jar
    xinstall -m 644 \
        ${worksrcpath}/target/${name}-${version}-api.jar \
        ${destjavadir}/${name}-api.jar
    xinstall -m 644 \
        ${worksrcpath}/target/${name}-${version}-adapters.jar \
        ${destjavadir}/${name}-adapters.jar

    xinstall -d ${destdocdir}
    xinstall -m 644 \
        ${worksrcpath}/LICENSE.txt \
        ${worksrcpath}/NOTICE.txt \
        ${worksrcpath}/RELEASE-NOTES.txt \
        ${destdocdir}

    if {[variant_isset doc]} {
        copy ${worksrcpath}/target/reports/apidocs ${destdocdir}/javadoc
    }
}

variant doc \
        description {Install javadoc} {
    build.target-append javadoc:javadoc
}

livecheck.type          regex
livecheck.url           ${homepage}/download_logging.cgi
livecheck.regex         "${name}-(\[0-9]+(\\.\[0-9]+)*)-src\\.tar\\.gz"
