# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           github 1.0
PortGroup           java 1.0

github.setup        elharo xom 1.4.6 v
github.tarball_from archive

categories          java devel textproc
platforms           any
maintainers         nomaintainer
supported_archs     noarch
license             LGPL-2.1

description         A tree-based API for XML processing

long_description    XOM is a new XML object model. It is an open source (LGPL), \
                    tree-based API for processing XML with Java that strives for \
                    correctness, simplicity, and performance, in that order.
homepage            https://xom.nu

checksums           rmd160  146e2a83a67a4d1a3b2bdfe5e06e33863c844b54 \
                    sha256  5b7b22613f73b728bcd2e7a78c48d426d94cbfd40d094f1bca434a857fd9c86e \
                    size    4637408

depends_build       bin:ant:apache-ant \
                    port:apache-ivy \
                    port:junit

depends_lib         port:jaxen \
                    port:xercesj

java.version        1.8+

patchfiles          bump-jdk-version.diff \
                    remove-ivy-download.diff \
                    remove-jaxen-compilation.diff

use_configure       no

build.cmd           ant
build.target        jar
build.args          -Divy.default.ivy.user.dir=${worksrcpath}/.ivy2 \
                    -Divy.jar.file=${prefix}/share/java/ivy.jar \
                    -Djaxen.dir=${prefix}/share/java/jaxen.jar \
                    -Djunit.jar=${prefix}/share/java/junit.jar \
                    -Dparser.jar=${prefix}/share/java/xercesj/xercesImpl.jar \
                    -Dxmlapis.jar=${prefix}/share/java/xercesj/xml-apis.jar

destroot {
    set destdocdir  ${destroot}${prefix}/share/doc/${name}
    set destjavadir ${destroot}${prefix}/share/java

    xinstall -d ${destjavadir}
    xinstall -m 644 \
        ${worksrcpath}/build/${name}-${version}.jar \
        ${destjavadir}/${name}.jar

    xinstall -d ${destdocdir}
    xinstall -m 644 \
        ${worksrcpath}/CONTRIBUTING.md \
        ${worksrcpath}/LICENSE.txt \
        ${worksrcpath}/README.md \
        ${worksrcpath}/README.txt \
        ${worksrcpath}/RELEASING.md \
        ${worksrcpath}/SECURITY.md \
        ${worksrcpath}/Todo.txt \
        ${worksrcpath}/lgpl.txt \
        ${worksrcpath}/overview.html \
        ${destdocdir}

    if {[variant_isset doc]} {
        copy ${worksrcpath}/build/apidocs ${destdocdir}
    }
}

variant doc \
        description {Install javadoc} {
    build.target-append     javadoc
}
