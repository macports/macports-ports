# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           github 1.0
PortGroup           java 1.0

name                postgresql-jdbc
github.setup        pgjdbc pgjdbc 42.7.14 REL
github.tarball_from archive
github.livecheck.regex \
                    {([0-9.]+)}

categories          java databases
license             BSD
maintainers         nomaintainer
description         PostgreSQL JDBC driver
long_description    \
    Pure Java JDBC driver for connecting to PostgreSQL databases.
homepage            https://jdbc.postgresql.org

platforms           any
supported_archs     noarch

checksums           rmd160  592ac503cc9dc9dc34b19eade872d13f8198c1bc \
                    sha256  ffcb07c7f25c5f4d67c904e434767b75e0d7c5cb11646bf5e565ce6dfbe17284 \
                    size    2506215

# Building requires Java >= 17
# Running requires Java >= 8
java.version        17+
depends_build       port:gradle

set gradle_home     ${workpath}/.home/.gradle

use_configure       no

build.cmd           ${prefix}/bin/gradle
build.target        assemble
build.args          --no-daemon \
                    --exclude-task=javadocJar \
                    --exclude-task=sourcesJar \
                    --gradle-user-home=${gradle_home} \
                    --max-workers=${build.jobs}

destroot {
    set destdocdir  ${destroot}${prefix}/share/doc/${name}
    set destjavadir ${destroot}${prefix}/share/java

    xinstall -d ${destjavadir}
    xinstall -W ${worksrcpath} -m 644 \
        pgjdbc/build/libs/postgresql-${version}-SNAPSHOT.jar \
        ${destjavadir}/postgresql.jar

    xinstall -d ${destdocdir}
    xinstall -W ${worksrcpath} -m 644 \
        ADOPTERS.md \
        CHANGELOG.md \
        CONTRIBUTING.md \
        LICENSE \
        README.md \
        SECURITY.md \
        TESTING.md \
        ${destdocdir}
}
