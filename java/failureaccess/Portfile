# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem              1.0
PortGroup               github 1.0
PortGroup               maven 1.0

name                    failureaccess
github.setup            google guava 1.0.3 ${name}-v
github.tarball_from     archive

categories              java
license                 Apache-2
platforms               any
supported_archs         noarch
homepage                https://guava.dev
maintainers             {sethm.id.au:dev @McDaMastR} \
                        openmaintainer

description             Guava InternalFutureFailureAccess and InternalFutures
long_description        Contains the InternalFutureFailureAccess and \
                        InternalFutures classes as split off from the core \
                        Guava library.

# Building requires Java >= 9
# Running requires Java >= 8
java.version            9+

checksums               rmd160  b17fd613593c9debe6b2779412cbfadf6d72ac5b \
                        sha256  af9149700931ecc9d845b048c0cfddfde349b213b04d80531c2561f2a85a1b9e \
                        size    5868274

build.dir               ${worksrcpath}/futures/failureaccess
build.args-append       --define=maven.javadoc.skip \
                        --define=maven.source.skip

destroot {
    set destdocdir  ${destroot}${prefix}/share/doc/${name}
    set destjavadir ${destroot}${prefix}/share/java

    xinstall -d ${destjavadir}
    xinstall -m 644 \
        ${worksrcpath}/futures/${name}/target/${name}-${version}.jar \
        ${destjavadir}/${name}.jar

    xinstall -d ${destdocdir}
    xinstall -m 644 \
        ${worksrcpath}/LICENSE \
        ${destdocdir}

    if {[variant_isset doc]} {
        copy \
            ${worksrcpath}/futures/${name}/target/reports/apidocs \
            ${destdocdir}/javadoc
    }
}

variant doc \
        description {Install javadoc} {
    build.args-delete   --define=maven.javadoc.skip
}
