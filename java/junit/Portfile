# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:filetype=tcl:et:sw=4:ts=4:sts=4

PortSystem              1.0
PortGroup               github 1.0
PortGroup               maven 1.0

name                    junit
github.setup            junit-team junit4 4.13.2 r
github.tarball_from     archive
revision                1

categories              java devel
license                 EPL-1
platforms               any
supported_archs         noarch
homepage                https://junit.org/junit4
maintainers             {sethm.id.au:dev @McDaMastR} \
                        openmaintainer

description             Java framework for repeatable tests
long_description        JUnit 4 is a simple framework to write repeatable \
                        tests.  It is an instance of the xUnit architecture \
                        for unit testing frameworks.

java.version            1.8-17

dist_subdir             ${name}/${version}_1

checksums               rmd160  173a920ef0c583fde66ca7ca004adce14ae803e6 \
                        sha256  1b6d700fc374c82951d247f6d80238951d87c61661ceb151f9fbf40f65413561 \
                        size    1077147

build.args              --define=jdkVersion=1.8

destroot {
    set destdocdir  ${destroot}${prefix}/share/doc/${name}
    set destjavadir ${destroot}${prefix}/share/java

    xinstall -d ${destjavadir}
    xinstall -m 644 \
        ${worksrcpath}/target/${name}-${version}.jar \
        ${destjavadir}/${name}.jar

    xinstall -d ${destdocdir}
    xinstall -m 644 \
        ${worksrcpath}/BUILDING \
        ${worksrcpath}/CODING_STYLE.txt \
        ${worksrcpath}/CONTRIBUTING.md \
        ${worksrcpath}/LEGACY_CODING_STYLE.txt \
        ${worksrcpath}/LICENSE-junit.txt \
        ${worksrcpath}/NOTICE.txt \
        ${worksrcpath}/README.md \
        {*}[glob -directory ${worksrcpath}/doc ReleaseNotes*.md] \
        ${destdocdir}

    if {[variant_isset doc]} {
        copy ${worksrcpath}/target/apidocs ${destdocdir}/javadoc
    }
}

variant doc \
        description {Install javadoc} {
    build.args-append   --activate-profiles=generate-docs
}
