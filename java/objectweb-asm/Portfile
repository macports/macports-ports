# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem              1.0
PortGroup               gitlab 1.0
PortGroup               java 1.0

name                    objectweb-asm
gitlab.instance         https://gitlab.ow2.org
gitlab.setup            asm asm 9_11_1 ASM_
version                 [string map {_ .} ${version}]

categories              java devel
license                 BSD
platforms               any
supported_archs         noarch
homepage                https://asm.ow2.io
maintainers             nomaintainer

description             Java bytecode manipulation framework.
long_description        ASM is a Java bytecode manipulation framework. It \
                        offers similar functionalities as BCEL or SERP, but \
                        is much smaller and faster than these tools.

checksums               rmd160  cc55b621ac1152f0cde1404d3bff81d4724c7db6 \
                        sha256  9a40a550aa1287f793a3f1a18f4174928136f409ed28241ab1e3e75dbc104c9c \
                        size    1425164

depends_build-append    bin:gradle:gradle

# Building requires Java >= 17
# Running requires Java >= 5
java.version            17+

set gradle_home         ${workpath}/.home/.gradle

use_configure           no

build.cmd               gradle
build.target            assemble
build.args              --no-daemon \
                        --gradle-user-home=${gradle_home} \
                        --max-workers=${build.jobs}

test.run                yes
test.args               --no-daemon \
                        --gradle-user-home=${gradle_home} \
                        --max-workers=${build.jobs}

destroot {
    set destdocdir  ${destroot}${prefix}/share/doc/${name}
    set destjavadir ${destroot}${prefix}/share/java/${name}

    set modules {
        asm
        asm-analysis
        asm-commons
        asm-test
        asm-tree
        asm-util
        tools
    }

    xinstall -d ${destjavadir}
    foreach module ${modules} {
        xinstall -W ${worksrcpath} -m 644 \
            ${module}/build/libs/${module}-${version}-SNAPSHOT.jar \
            ${destjavadir}/${module}.jar
    }

    xinstall -d ${destdocdir}
    xinstall -W ${worksrcpath} -m 644 \
        LICENSE.txt \
        README.md \
        ${destdocdir}
}
