set dep_jars {}
foreach {group artifact dep_version dep_rmd160 dep_sha256 dep_size} ${sdk_deps} {
    set tag [string map {. _ - _} ${artifact}]
    set jar ${artifact}-${dep_version}.jar
    master_sites-append https://repo1.maven.org/maven2/[string map {. /} ${group}]/${artifact}/${dep_version}/:${tag}
    distfiles-append    ${jar}:${tag}
    checksums-append    ${jar} rmd160 ${dep_rmd160} sha256 ${dep_sha256} size ${dep_size}
    lappend dep_jars    ${jar}
}

# extract.suffix names the distfile type: base master (since 14fdd90f9)
# drops a custom extract.cmd for distfiles whose type differs from it.
extract.suffix      .jar
extract.cmd         unzip
extract.pre_args    -q
extract.post_args   -d ${workpath}/api
extract.only        ${sdk_name}-${version}-javadoc.jar

use_configure       no

build {}

# The test compiles and runs files/SdkSmokeTest.java against the SDK and the
# bundled jars: offline, it builds a WorkspaceClient and round-trips an SDK
# model through Jackson, so a missing or mismatched dependency fails it.
test.run            yes
test {
    set cp [list ${distpath}/${sdk_name}-${version}.jar]
    foreach jar ${dep_jars} {
        lappend cp ${distpath}/${jar}
    }
    set cp [join ${cp} :]
    xinstall -m 0644 ${filespath}/SdkSmokeTest.java ${workpath}
    system -W ${workpath} "${java.home}/bin/javac -cp ${cp} SdkSmokeTest.java"
    system -W ${workpath} "${java.home}/bin/java -cp ${cp}:${workpath} SdkSmokeTest"
}

destroot {
    set javadir ${destroot}${prefix}/share/java
    set libdir  ${sdk_share}/lib
    set docdir  ${destroot}${prefix}/share/doc/${name}

    xinstall -d ${javadir} ${destroot}${libdir} ${docdir}

    xinstall -m 0644 ${distpath}/${sdk_name}-${version}.jar \
        ${javadir}/${sdk_name}.jar
    xinstall -m 0644 ${distpath}/${sdk_name}-${version}-sources.jar \
        ${javadir}/${sdk_name}-sources.jar

    # The classpath file lists the SDK jar and every bundled dependency.
    set cp [list ${prefix}/share/java/${sdk_name}.jar]
    foreach jar ${dep_jars} {
        xinstall -m 0644 ${distpath}/${jar} ${destroot}${libdir}
        lappend cp ${libdir}/${jar}
    }
    set fp [open ${destroot}${sdk_share}/classpath w]
    puts ${fp} [join ${cp} :]
    close ${fp}

    file copy ${workpath}/api ${docdir}
}

notes "
The Databricks SDK for Java is installed with its runtime dependencies, pinned\
 to the versions this SDK release requires:

    ${prefix}/share/java/${sdk_name}.jar           the SDK
    ${sdk_share}/lib/      its dependencies
    ${sdk_share}/classpath  all of them, as a classpath

Use the classpath file to compile and run code against the SDK:

    javac -cp \"\$(cat ${sdk_share}/classpath)\" MyApp.java
    java -cp \"\$(cat ${sdk_share}/classpath):.\" MyApp
    jshell --class-path \"\$(cat ${sdk_share}/classpath)\"

API documentation: ${prefix}/share/doc/${name}/api/
"
