# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem              1.0
PortGroup               maven 1.0

name                    commons-codec
version                 1.23.0

categories              java
license                 Apache-2
platforms               any
supported_archs         noarch
homepage                https://commons.apache.org/proper/commons-codec
maintainers             nomaintainer

description             Jakarta Commons-Codec
long_description        Commons Codec provides implementations of common \
                        encoders and decoders such as Base64, Hex, various \
                        phonetic encodings, and URLs.

master_sites            apache:commons/codec/source/
distname                ${name}-${version}-src

checksums               rmd160  38a71c4d2f37708da9b16ffb396778adeef4818d \
                        sha256  24283dd892485465d6988a2e8ff5d6ea36ea8d35bff4afa07dfef20b8557939c \
                        size    642974

java.version            1.8+

destroot {
    set destdocdir  ${destroot}${prefix}/share/doc/${name}
    set destjavadir ${destroot}${prefix}/share/java

    xinstall -d ${destjavadir}
    xinstall -W ${worksrcpath} -m 644 \
        target/${name}-${version}.jar \
        ${destjavadir}/${name}.jar

    xinstall -d ${destdocdir}
    xinstall -W ${worksrcpath} -m 644 \
        CODE_OF_CONDUCT.md \
        CONTRIBUTING.md \
        LICENSE.txt \
        NOTICE.txt \
        README.md \
        RELEASE-NOTES.txt \
        SECURITY.md \
        ${destdocdir}

    if {[variant_isset doc]} {
        copy ${worksrcpath}/target/reports/apidocs ${destdocdir}/javadoc
    }
}

variant doc \
        description {Install javadoc} {
    build.target-append javadoc:javadoc
}

livecheck.type          regex
livecheck.url           ${homepage}/download_codec.cgi
livecheck.regex         "${name}-(\[0-9]+(\\.\[0-9]+)*)-src\\.tar\\.gz"
