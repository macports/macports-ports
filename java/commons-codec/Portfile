distname            ${name}-${version}-src
master_sites        apache:commons/codec/source/

checksums           rmd160  90a50538336fd1c2e1919e487814b3a48b74f32c \
                    sha256  eb16c29286ee8dde0f77777404b6e3c485af1c6212f4f472792c64ffbe00ad81 \
