# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem      1.0
PortGroup       github 1.0
PortGroup       maven 1.0

name            msv
github.setup    xmlark ${name} 2022.7 ${name}-
github.tarball_from archive
revision        0
epoch           1

categories      java textproc
maintainers     nomaintainer
platforms       any
supported_archs noarch
license         BSD

description     Sun Multi-Schema XML Validator (MSV) validates XML files
long_description    The Sun Multi-Schema XML Validator (MSV) is a Java \
                technology tool to validate XML documents against \
                several kinds of XML schemata.  It supports RELAX NG, \
                RELAX Namespace, RELAX Core, TREX, XML DTDs and a \
                subset of XML Schema Part 1.
homepage        https://xmlark.github.io/msv/

checksums       rmd160  d0ba31e52f050cae4ef4a0e9372144a93f65df66 \
                sha256  8b1279458c32580f17116bcd0af87ec583279bfa00276248f180118cdc823e3e \
                size    2594951

java.version    1.8+
java.fallback   openjdk11

destroot {
    set destbindir  ${destroot}${prefix}/bin
    set destdocdir  ${destroot}${prefix}/share/doc/${name}
    set destjavadir ${destroot}${prefix}/share/java/${name}
    set modules {
        core
        generator
        relames
        rngconverter
        schmit
        tahiti
        trexconverter
        xsdlib
    }

    xinstall -d ${destjavadir}
    xinstall -m 644 \
        ${worksrcpath}/${name}/target/${name}-core-${version}-jar-with-dependencies.jar \
        ${destjavadir}/${name}.jar
    xinstall -m 644 \
        ${worksrcpath}/generator/target/${name}-generator-${version}-jar-with-dependencies.jar \
        ${destjavadir}/xmlgen.jar
    xinstall -m 644 \
        ${worksrcpath}/relames/target/${name}-relames-${version}-jar-with-dependencies.jar \
        ${destjavadir}/relames.jar
    xinstall -m 644 \
        ${worksrcpath}/rngconverter/target/${name}-rngconverter-${version}-jar-with-dependencies.jar \
        ${destjavadir}/rngconv.jar
    xinstall -m 644 \
        ${worksrcpath}/schmit/target/${name}-schmit-${version}-jar-with-dependencies.jar \
        ${destjavadir}/schmit.jar
    xinstall -m 644 \
        ${worksrcpath}/tahiti/target/${name}-tahiti-${version}-jar-with-dependencies.jar \
        ${destjavadir}/tahiti.jar
    xinstall -m 644 \
        ${worksrcpath}/trexconverter/target/${name}-trexconverter-${version}-jar-with-dependencies.jar \
        ${destjavadir}/trexconv.jar
    xinstall -m 644 \
        ${worksrcpath}/xsdlib/target/xsdlib-${version}-jar-with-dependencies.jar \
        ${destjavadir}/xsdlib.jar

    xinstall -d ${destbindir}
    xinstall ${filespath}/relames ${destbindir}
    reinplace \
        "s|@@RELAMES@@|${prefix}/share/java/${name}/relames.jar|g" \
        ${destbindir}/relames

    xinstall -d ${destdocdir}
    xinstall -m 644 \
        ${worksrcpath}/README.md \
        ${worksrcpath}/docs/index.md \
        ${destdocdir}

    foreach module ${modules} {
        xinstall -d ${destdocdir}/${module}
        xinstall -m 644 \
            {*}[glob -directory ${worksrcpath}/docs/${module} *.{html,md,txt}] \
            ${destdocdir}/${module}
    }
}
