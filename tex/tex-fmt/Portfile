github.setup        WGUNDERWOOD tex-fmt 0.5.7 v
github.tarball_from archive
revision            0

homepage            https://wgunderwood.github.io/tex-fmt/

categories          tex textproc
license             MIT
maintainers         {@mbbatukan} openmaintainer

description         Extremely fast LaTeX formatter written in Rust.
long_description    ${name} is an extremely fast LaTeX formatter written \
                    in Rust. Indentation, line wrapping and other formatting \
                    for LaTeX source code.

checksums           ${distname}${extract.suffix} \
                    rmd160  55503ac60c5df3bc2dd3035852c1cea005c93b45 \
                    sha256  fee9ccd8f13be00cf437ce73928892eb0b55349bd4c81e226bc3fd3cb9de644c \
                    size    920864

destroot {
    set bin_path ${worksrcpath}/target/[cargo.rust_platform]/release/${name}

    xinstall -m 0755 ${bin_path} ${destroot}${prefix}/bin/
    xinstall -m 0644 ${worksrcpath}/man/${name}.1 \
        ${destroot}${prefix}/share/man/man1/

    set comp_path(bash) ${destroot}${prefix}/share/bash-completion/completions/${name}
    set comp_path(fish) ${destroot}${prefix}/share/fish/completions/${name}.fish
    set comp_path(zsh)  ${destroot}${prefix}/share/zsh/site-functions/_${name}

    foreach shell {bash fish zsh} {
        xinstall -d [file dirname $comp_path(${shell})]
        system -W ${destroot}${prefix}/bin "./${name} --completion ${shell} > $comp_path(${shell})"
    }
}

test.run            yes
test.cmd            ${cargo.bin} test --release --offline
test.target

