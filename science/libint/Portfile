license             GPL-2

description         Evaluate the integrals in modern atomic and molecular theory

long_description    A library of C/C++ functions for efficient evaluation of several kinds of \
                    two-body molecular integrals over Gaussian functions.

checksums           rmd160  759ec92e5984370f19eca4561e5128dc29b3ae54 \
                    sha256  9651705c79f77418ef0230aafc0cf1b71b17c1c89e413ee0e5ee7818650ce978 \
                    size    21778422

boost.version       1.91
depends_lib-append      port:gmp \
                        port:mpfr \
                        port:eigen3-5

cmake.out_of_source yes
cmake.build_type    release
configure.cxxflags-delete "-Os"
configure.cxxflags-append "-O2 -std=c++14"

configure.args-append   -DLIBINT2_BUILD_SHARED_AND_STATIC_LIBS=ON \
                        -DCMAKE_INSTALL_PREFIX=${destroot}${prefix} \
                        -DLIBINT2_CARTGAUSS_ORDERING=standard \
                        -DLIBINT2_SHGAUSS_ORDERING=gaussian \
                        -DLIBINT2_SHELL_SET=standard \
                        -DLIBINT2_ENABLE_ONEBODY=2 \
                        -DLIBINT2_ENABLE_ERI=2 \
                        -DLIBINT2_ENABLE_ERI2=2 \
                        -DLIBINT2_ENABLE_ERI3=2 \
                        -DLIBINT2_ERI2_PURE_SH=OFF \
                        -DLIBINT2_ERI3_PURE_SH=OFF \
                        -DLIBINT2_CONTRACTED_INTS=ON \
                        -DLIBINT2_GENERATE_FMA=ON \
                        -DLIBINT2_ENABLE_UNROLLING=300  \
                        -DLIBINT2_MAX_AM=3
                        

