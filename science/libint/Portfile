# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           github          1.0

github.setup        evaleev libint 2.12.0 v
github.tarball_from archive
categories          science
maintainers         mcmaster.ca:yangx59
license             GPL-2

description         Evaluate the integrals in modern atomic and molecular theory

long_description    A library of C/C++ functions for efficient evaluation of several kinds of \
                    two-body molecular integrals over Gaussian functions.

checksums           rmd160  8c492eb59d88071e808e6c39e761a439c06c8fb4 \
                    sha256  732988a1ea95eb4eae91bcb2b2a718d95dc5caca41533746fc4111532d55ae74 \
                    size    21962025

depends_build-append   port:autoconf \
                        port:automake \
                        port:libtool

depends_lib-append      port:boost191 \
                        port:gmp

# 2.12.0 predates the CMake build; this is the autotools path, like FreeBSD's port.
use_autoreconf      no
configure.cxxflags-append "-std=c++14"

configure.args      --enable-shared \
                    --with-cartgauss-ordering=standard \
                    --with-shgauss-ordering=gaussian \
                    --with-shell-set=standard \
                    --enable-1body=1 \
                    --with-max-am=3,3 \
                    --enable-eri=1 \
                    --enable-eri2=1 \
                    --enable-eri3=1 \
                    --with-eri-max-am=3,3 \
                    --with-eri2-max-am=3,3 \
                    --with-eri3-max-am=3,3 \
                    --disable-eri2-pure-sh \
                    --disable-eri3-pure-sh \
                    --enable-contracted-ints \
                    --enable-fma \
                    --enable-unrolling \
                    --with-boost=${prefix}/libexec/boost/1.91 \
                    --with-cc-optflags="${configure.cflags}" \
                    --with-cxx-optflags="-O1"

build.target        default

variant static description {Build static libraries as well} {
    configure.args-append  --enable-static
}

post-patch {
    # Same fix as FreeBSD: make sure LDFLAGS actually reach the -rpath line
    reinplace "s| -rpath|${configure.ldflags} -rpath|g" ${worksrcpath}/src/lib/MakeVars.in
}

pre-configure {
    # Upstream's autoheader step doesn't work cleanly here, so regenerate
    # the configure script manually instead of using a full autoreconf,
    # exactly as FreeBSD's port does.
    system "cd ${worksrcpath} && ${prefix}/bin/glibtoolize -c -f && ${prefix}/bin/aclocal && ${prefix}/bin/autoconf"
}

post-destroot {
    system "${prefix}/bin/strip -x  ${destroot}${prefix}/lib/*.dylib"
}
