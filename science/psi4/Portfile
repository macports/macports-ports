PortSystem          1.0
PortGroup           github          1.0
PortGroup           cmake           1.1
PortGroup           python_variants 1.0

github.setup        psi4 psi4 1.10.1 v
github.tarball_from archive
categories          science
maintainers         nomantainer
license             LGPL-3

description         Open-Source Quantum Chemistry

long_description    Psi4 is a suite of ab initio quantum chemistry programs for \
                    high-accuracy simulations of molecular properties.

checksums           rmd160  3c49a02b1a21bd8640ae502207903600d86e1aab \
                    sha256  9931c9189473cf32764b481964195b492ba488efa680f5e549ecb957a1d5bc54 \
                    size    51081993

python.variants     314 315:python315-devel 315t:python315-freethreading-devel

depends_lib-append  port:libint \
                    port:boost191 \
                    port:eigen3-5 \
                    port:gmp \
                    port:libxc7 \
                    port:py${python.variant}-numpy \
                    port:py${python.variant}-networkx \
                    port:py${python.variant}-pip \
                    port:py${python.variant}-pydantic_settings \
                    port:py${python.variant}-qcmanybody

post-patch {
    # Line 109 in psi4 1.10.1's libmints/CMakeLists.txt: mints links Libint2::cxx
    # but #includes gau2grid/gau2grid.h without linking gau2grid::gg — upstream bug.
    reinplace "109s|Libint2::cxx|Libint2::cxx gau2grid::gg|" \
        ${worksrcpath}/psi4/src/psi4/libmints/CMakeLists.txt
}

# Not yet confirmed present in the MacPorts tree as of this writing —
# check before relying on them; psi4 may need these installed via pip
# into the same python312 environment if no port exists:
#   py312-pydantic, py312-pint, py312-msgpack, py312-psutil,
#   py312-py-cpuinfo, py312-deepdiff, qcelemental, qcengine, qcmanybody
# QCElemental/QCEngine/QCManybody in particular are psi4-ecosystem
# packages unlikely to be MacPorts-packaged; pip install into
# ${prefix}/bin/python3.12 is the realistic path for those.

configure.compiler  macports-clang-23
configure.args      -DCMAKE_INSTALL_PREFIX=${prefix} \
                    -DPython_EXECUTABLE=${prefix}/bin/python${python.branch} \
                    -DBLAS_TYPE=SYSTEM_NATIVE \
                    -DLAPACK_TYPE=SYSTEM_NATIVE \
                    -DCMAKE_INSIST_FIND_PACKAGE_Libint2=ON \
                    -DCMAKE_PREFIX_PATH=${prefix} \
                    -DCMAKE_BUILD_TYPE=Release \
                    -DOpenMP_omp_LIBRARY=/Volumes/Development/optlocal/lib/libomp/libomp.dylib \
                    -DOpenMP_C_LIB_NAMES=omp \
                    -DOpenMP_CXX_LIB_NAMES=omp \
                    -DOpenMP_C_FLAGS="-fopenmp=libomp -I/Volumes/Development/optlocal/include/libomp" \
                    -DOpenMP_CXX_FLAGS="-fopenmp=libomp -I/Volumes/Development/optlocal/include/libomp" 
use_parallel_build  yes
build.jobs          4
