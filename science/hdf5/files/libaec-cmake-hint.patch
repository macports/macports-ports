--- config/install/hdf5-config.cmake.in.orig	2026-11-19 13:39:41
+++ config/install/hdf5-config.cmake.in	2026-11-19 13:40:37
@@ -140,7 +140,12 @@
 # If szip/libaec support was enabled and libaec was found on the system at build
 # time, locate libaec to propagate the dependency
 if (${HDF5_PACKAGE_NAME}_PROVIDES_SZIP_SUPPORT AND NOT @SZIP_USE_EXTERNAL@)
-  find_dependency (@LIBAEC_PACKAGE_NAME@ OPTIONAL_COMPONENTS @LIBAEC_SEARCH_TYPE@)
+  if ("@LIBAEC_PACKAGE_NAME@" STREQUAL "libaec" AND IS_DIRECTORY "@libaec_DIR@")
+    # Reuse the package location found when HDF5 was configured.
+    find_dependency (libaec CONFIG HINTS "@libaec_DIR@" OPTIONAL_COMPONENTS @LIBAEC_SEARCH_TYPE@)
+  else ()
+    find_dependency (@LIBAEC_PACKAGE_NAME@ OPTIONAL_COMPONENTS @LIBAEC_SEARCH_TYPE@)
+  endif ()
 endif ()
 
