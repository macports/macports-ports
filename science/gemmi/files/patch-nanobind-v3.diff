+      message(FATAL_ERROR "nanobind version must be >= 2.4.0 and < 4.0.0 (found ${nanobind_VERSION})")
+    endif()
     message(STATUS "Found nanobind ${nanobind_VERSION}: ${NB_DIR}")
   endif()
-  nanobind_add_module(gemmi_py NOMINSIZE
