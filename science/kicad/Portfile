# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           cmake 1.1
PortGroup           gitlab 1.0
PortGroup           python_variants 1.0
PortGroup           active_variants 1.1

name                kicad
version             10.0.7
description         KiCad is an electronic design automation software suite
long_description    KiCad is an EDA software suite for the creation of professional schematics \
                    and printed circuit boards up to 32 copper layers with additional technical layers.
categories          science
license             GPL-3+
maintainers         {ra1nb0w @ra1nb0w} openmaintainer
homepage            https://www.kicad.org/

python.variants     314 315 315t
set python_framework_dir ${frameworks_dir}/Python.framework/Versions/${python.branch}
set python.bin      ${prefix}/bin/python${python.branch}

if {${name} eq ${subport}} {
    PortGroup           boost 1.0
    PortGroup           conflicts_build 1.0
    PortGroup           legacysupport 1.1

    gitlab.setup        kicad/code kicad ${version}
    checksums           rmd160  eac475fc97b350a015a9ed40981a639fc32175a9 \
                        sha256  2fd6e4a0f6212fe0d26582be01e85c4d6fd59ce664018c0ffb94b2f1b074be51 \
                        size    234602726



    patchfiles-append \
        macports_prefix.patch \
        0001-cmake-adding-KICAD_MACOSX_APP_BUNDLE-option.patch \
        0002-disable-codesigning.patch \
        bitmaps_png_CMakeList.txt.patch \
        kicad_project_tree_cpp.patch
#        opencascade-7.8.patch 

    post-patch {
        reinplace -W ${worksrcpath} "s|@PREFIX@|${prefix}|g" \
            common/gestfich.cpp \
            eeschema/sim/ngspice.cpp
    }

    boost.version       1.91
    conflicts_build     boost

    compiler.cxx_standard 2017

    # It requires c++17 <filesystem> and abs
    legacysupport.newest_darwin_requires_legacy 19
    legacysupport.use_mp_libcxx yes

    # KICAD_IPC_API is mandatory since 10.0.7
    require_active_variants nng dylib 

    depends_build-append \
        path:bin/doxygen:doxygen \
        path:bin/pkg-config:pkgconfig \
        port:swig \
        port:swig-python \
        port:protobuf3-cpp

    depends_lib-append \
        port:glew \
        port:glm \
        port:curl \
        port:opencascade \
        port:py${python.variant}-wxpython-4.0 \
        port:zlib \
        path:lib/pkgconfig/cairo.pc:cairo \
        port:py${python.variant}-pybind11 \
        path:lib/pkgconfig/pixman-1.pc:libpixman \
        port:unixODBC \
        path:lib/pkgconfig/harfbuzz.pc:harfbuzz \
        port:kicad-symbols \
        port:kicad-footprints \
        port:kicad-packages3D \
        port:kicad-templates \
        port:ngspice-lib 
#        port:kicad-docs \

    cmake.build_type Release

    configure.args-append \
        -DKICAD_MACOSX_APP_BUNDLE=OFF \
        -DSKIP_DOC_UPDATE=ON \
        -DKICAD_IPC_API=YES \
        -DRELEASE_NAME=9.0.7 \
        -DwxWidgets_CONFIG_EXECUTABLE=${python_framework_dir}/bin/wx-config \
        -DKICAD_BUILD_QA_TESTS=OFF \
        -DKICAD_SCRIPTING_WXPYTHON=ON \
        -DPYTHON_SITE_PACKAGE_PATH=${python_framework_dir}/lib/python${python.branch}/site-packages \
        -DPYTHON_EXECUTABLE=${python_framework_dir}/bin/python${python.branch} \
        -DPYTHON_INCLUDE_DIR=${python_framework_dir}/Headers \
        -DPYTHON_LIBRARY=${python_framework_dir}/Python \
        -DDOXYGEN_DOT_EXECUTABLE=${prefix}/bin/dot \
        -DDOXYGEN_EXECUTABLE=${prefix}/bin/doxygen \
        -DNGSPICE_LIB_NAME=libngspice.dylib \
        -DOCC_INCLUDE_DIR=${prefix}/include/opencascade \
        -DOCC_LIBRARY_DIR=${prefix}/lib \
        -Wno-dev

    post-destroot {
        foreach app_name {bitmap2component eeschema gerbview kicad pcb_calculator pcbnew} {
            set app_dir ${destroot}${applications_dir}/KiCad/${app_name}.app/Contents
            xinstall -d ${app_dir}/MacOS \
                ${app_dir}/Resources
            xinstall -m 0644 ${worksrcpath}/${app_name}/${app_name}.icns \
                ${app_dir}/Resources/${app_name}.icns
            if {[file exists ${worksrcpath}/${app_name}/${app_name}_doc.icns]} {
                xinstall -m 0644 ${worksrcpath}/${app_name}/${app_name}_doc.icns \
                    ${app_dir}/Resources/${app_name}_doc.icns
            }
            xinstall -m 0644 ${build.dir}/${app_name}/Info.plist \
                ${app_dir}/Info.plist

            ln -s ${prefix}/bin/${app_name} ${app_dir}/MacOS/${app_name}

            foreach kiface [glob ${destroot}${prefix}/bin/*.kiface] {
                set filename  [file tail $kiface]
                ln -s ${prefix}/bin/$filename ${app_dir}/MacOS/${filename}
            }
        }

        #libki libraries are not properly referenced. Correct this
        foreach prog [glob ${destroot}${prefix}/bin/*] {
            exec install_name_tool -change libkicommon.${version}.dylib \
                                      ${prefix}/lib/libkicommon.${version}.dylib \
                                      ${prog}

            exec install_name_tool -change libkiapi.${version}.dylib \
                                      ${prefix}/lib/libkiapi.${version}.dylib \
                                      ${prog}

            exec install_name_tool -change libkigal.${version}.dylib \
                                      ${prefix}/lib/libkigal.${version}.dylib \
                                      ${prog}
        }

        foreach lib [glob ${destroot}${prefix}/lib/kicad/plugins/*/*.so] {
            exec install_name_tool -change libkicommon.${version}.dylib \
                                      ${prefix}/lib/libkicommon.${version}.dylib \
                                      ${lib}

            exec install_name_tool -change libkiapi.${version}.dylib \
                                      ${prefix}/lib/libkiapi.${version}.dylib \
                                      ${lib}

            exec install_name_tool -change libkigal.${version}.dylib \
                                      ${prefix}/lib/libkigal.${version}.dylib \
                                      ${lib}
        }

        foreach lib [glob ${destroot}${prefix}/lib/*.${version}.dylib] {
            exec install_name_tool -change libkicommon.${version}.dylib \
                                      ${prefix}/lib/libkicommon.${version}.dylib \
                                      ${lib}

            exec install_name_tool -change libkiapi.${version}.dylib \
                                      ${prefix}/lib/libkiapi.${version}.dylib \
                                      ${lib}

            exec install_name_tool -change libkigal.${version}.dylib \
                                      ${prefix}/lib/libkigal.${version}.dylib \
                                      ${lib}
        }

    }

    # Exclude x.99.y development versions
    gitlab.livecheck.regex {([0-9]+\.([1-8]?[0-9]|9[0-8])\.[0-9]+)}
} else {
    supported_archs     noarch
    platforms           any

    if {${subport} ne "kicad-docs"} {
        patchfiles-append ${subport}.patch
    }

    livecheck.type      none
}

subport kicad-docs {
    checksums           rmd160  9b5c9570129336d2cf603e91cbcc29f7668da69c \
                        sha256  0ecf3c1b748a1a2d07cc3f8e74e3ffcca948ee997b1eed2ef371ae4d7992ab9a \
                        size    602194906

    description         KiCad documentation
    long_description    {*}${description}

    # we use a pre-compiled binary since it takes a very long time to compile
    # and requires many big dependencies
    master_sites        https://kicad-downloads.s3.cern.ch/docs
    distname            ${name}-doc-${version}

    use_configure       no

    build {}

    destroot {
        xinstall -d ${destroot}${prefix}/share/doc
        file copy ${worksrcpath}/share/doc/kicad ${destroot}${prefix}/share/doc
    }
}

subport kicad-symbols {
    gitlab.setup        kicad/libraries kicad-symbols ${version}
    checksums           rmd160  8eb06cf091ffbfa14d8ed1aa0a5ccecfebe8aa72 \
                        sha256  34a27dadbbc6cf74f7b795198273a77a409db8dd5afd865b06bff05237a1be83 \
                        size    4380863


    configure.args-append \
                        -DPython3_EXECUTABLE= ${python_framework_dir}/bin/python${python.branch}\
                        -DPython3_ROOT_DIR=${python_framework_dir} \
                        -DPython3_FIND_STRATEGY=LOCATION

    description         Kicad symbols
    long_description    {*}${description}

    post-configure {
        reinplace "s|^#!.*python3.*|#!${python.bin}|" [exec find ${worksrcpath} -type f -name "*.py"]
    }
}

