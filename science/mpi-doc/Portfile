destroot {
    delete ${destroot}${prefix}/share/man/man1
    delete ${destroot}${prefix}/share/man/man3
    move ${worksrcpath}/man/man1 ${destroot}${prefix}/share/man/
    move ${worksrcpath}/man/man3 ${destroot}${prefix}/share/man/
}

