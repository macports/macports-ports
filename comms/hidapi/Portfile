# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem              1.0
PortGroup               cmake 1.1
PortGroup               github 1.0
PortGroup               legacysupport 1.1

# wcsdup
legacysupport.newest_darwin_requires_legacy 10

github.setup            libusb hidapi 0.16.0 hidapi-
github.tarball_from     archive
revision                0

categories              comms
license                 {BSD GPL-3 Permissive}
platforms               darwin freebsd netbsd openbsd linux
maintainers             {sethm.id.au:dev @McDaMastR} \
                        openmaintainer

description             A simple library for communicating with HID devices
long_description        HIDAPI is a multi-platform library which allows an \
                        application to interface with USB and Bluetooth \
                        HID-Class devices.

checksums               rmd160  82b311db067518ec75ac2c7457aa102b7a96cf89 \
                        sha256  bc599d295792fe515778f19ce86a49760b0ea5fc114e5258245d470609632bbf \
                        size    453539

compiler.c_standard     2011

configure.args-append   -DBUILD_SHARED_LIBS=ON \
                        -DCMAKE_BUILD_WITH_INSTALL_RPATH=OFF \
                        -DHIDAPI_INSTALL_TARGETS=ON \
                        -DHIDAPI_WITH_TESTS=ON

test.run                yes

post-destroot {
    set destdocdir  ${destroot}${prefix}/share/doc/${name}

    xinstall -d ${destdocdir}
    xinstall -W ${cmake.source_dir} -m 644 \
        AUTHORS.txt \
        LICENSE.txt \
        README.md \
        ${destdocdir}
}

platform darwin {
    if {${os.major} < 14} {
        patchfiles-append   add-missing-iokit-symbols.diff
    }

    # <https://github.com/libusb/hidapi/issues/492>
    configure.args-append   -DCMAKE_FRAMEWORK=OFF
    # <https://github.com/libusb/hidapi/issues/622>
    configure.args-append   -DHIDAPI_USE_LEGACY_COMPATIBILITY_VERSION=ON
}

platform freebsd {
    depends_build-append    path:bin/pkg-config:pkgconfig
    depends_lib-append      path:lib/pkgconfig/libusb-1.0.pc:libusb
    configure.args-append   -DHIDAPI_WITH_HIDRAW=ON \
                            -DHIDAPI_WITH_LIBUSB=OFF \
                            -DHIDAPI_WITH_NETBSD=OFF
}

platform netbsd {
    depends_build-append    path:bin/pkg-config:pkgconfig
    depends_lib-append      port:libiconv \
                            path:lib/pkgconfig/libusb-1.0.pc:libusb
    configure.args-append   -DHIDAPI_WITH_HIDRAW=OFF \
                            -DHIDAPI_WITH_LIBUSB=ON \
                            -DHIDAPI_WITH_NETBSD=ON
}

platform openbsd {
    depends_build-append    path:bin/pkg-config:pkgconfig
    depends_lib-append      port:libiconv \
                            path:lib/pkgconfig/libusb-1.0.pc:libusb
    configure.args-append   -DHIDAPI_WITH_HIDRAW=OFF \
                            -DHIDAPI_WITH_LIBUSB=ON \
                            -DHIDAPI_WITH_NETBSD=OFF
}

platform linux {
    depends_build-append    path:bin/pkg-config:pkgconfig
    configure.args-append   -DHIDAPI_WITH_HIDRAW=ON \
                            -DHIDAPI_WITH_LIBUSB=OFF \
                            -DHIDAPI_WITH_NETBSD=OFF
}
