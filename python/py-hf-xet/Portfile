python.versions     310 311 312 313 314 315 315t
python.pep517_backend maturin
# Upstream Cargo.toml pins pyo3 0.26 with plain "abi3-py37", which pyo3 itself
# refuses to build against Python 3.15 at all (max supported version 3.14) --
# and unlike the GIL-enabled build, this check cannot be worked around with
# PYO3_USE_ABI3_FORWARD_COMPATIBILITY for a free-threaded interpreter. Bump
# pyo3 to a version with native 3.15t support and switch to the abi3t feature
# for the py315t subport only; this crate isn't vendored (no cargo.crates),
# so cargo just re-resolves and fetches the newer pyo3 itself during build.
if {${subport} eq "py315t-hf-xet"} {
    post-patch {
        reinplace {s|"0.26"|"0.29"|} ${worksrcpath}/hf_xet/Cargo.toml
        reinplace {s|"abi3-py37",|"abi3t", "abi3t-py315",|} ${worksrcpath}/hf_xet/Cargo.toml
    }
}
