    if {${python.version} >= 314} {
        depends_lib-delete  port:py${python.suffix}-pydantic
        depends_lib-append  port:py${python.suffix}-pydantic
        # pyproject.toml requires pydantic>=2.12 for python>=3.14,
        # >=2.11 otherwise — MacPorts' py-pydantic port version, not this
        # conditional, is what actually determines which you get; check
        # it satisfies the right floor for whichever python.version this
        # subport targets.
    }

    livecheck.type      none
