# The core "safetensors" Rust crate is a path dependency
# (bindings/python/Cargo.toml: path = "../../safetensors"), and the sdist
# above already bundles that sibling directory -- verified directly by
# unpacking it. No separate GitHub-tag fetch is needed for it at all.

if {${subport} eq "py315t-safetensors"} {
    # Shipped Cargo.toml hardcodes pyo3's plain "abi3"/"abi3-py310"
    # features, which CPython's free-threaded build cannot load at all
    # (a separate, incompatible stable-ABI track, not a superset/subset
    # of plain abi3). Verified against pyo3 0.29.2's actual feature list:
    # abi3t's floor is 3.15, so abi3t-py315 is the only version-specific
    # abi3t feature that exists.
    post-patch {
        reinplace {s|features = \["abi3", "abi3-py310"\]|features = ["abi3t", "abi3t-py315"]|} \
            ${worksrcpath}/bindings/python/Cargo.toml
    }
}

