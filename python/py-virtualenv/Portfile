# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           python 1.1
PortGroup           select 1.0

name                py-virtualenv
version             21.15.6
revision            0

categories-append   devel
platforms           {darwin any}
supported_archs     noarch
license             MIT
maintainers         {reneeotten @reneeotten} {larryv @larryv} openmaintainer

description         Virtual Python Environment builder
long_description    virtualenv is a tool to create isolated Python \
                    environments.

homepage            https://virtualenv.pypa.io

checksums           rmd160  aa0ea16983e8ee441fd905aaf777d6785f2ed450 \
                    sha256  c8b65c7d206ca6ef18de9352c160b3f04f66fff9f6b0ec8fd31f14688eba52c4 \
                    size    5641659

# keep Python version 2.7 here, other EOL Python versions can be removed
# See <https://trac.macports.org/wiki/Python#VersionPolicy>
python.versions     27 310 311 312 313 314 315 315t

if {${name} ne ${subport}} {
    depends_lib     port:py${python.suffix}-distlib \
                    port:py${python.suffix}-filelock \
                    port:py${python.suffix}-platformdirs \
                    port:py${python.suffix}-python-discovery

    if {${python.version} < 311} {
        depends_lib-append \
                    port:py${python.suffix}-typing_extensions
    }

    if {${python.version} == 27} {
        PortGroup   deprecated 1.0
        deprecated.eol_version  yes

        depends_build-append \
                        port:py${python.suffix}-setuptools_scm

        depends_lib-delete \
                    port:py${python.suffix}-typing_extensions \
                    port:py${python.suffix}-python-discovery

        depends_lib-append \
                        port:py${python.suffix}-importlib-resources \
                        port:py${python.suffix}-importlib-metadata \
                        port:py${python.suffix}-contextlib2 \
                        port:py${python.suffix}-pathlib2 \
                        port:py${python.suffix}-six

        version     20.15.1
        revision    0
        checksums   rmd160  22ae6412f07079cc66ab083e63b234da203e99da \
                    sha256  288171134a2ff3bfb1a2f54f119e77cd1b81c29fc1265a2356f3e8d14c7d58c4 \
                    size    13523736

        post-destroot {
            set docdir ${prefix}/share/doc/${subport}
            xinstall -d ${destroot}${docdir}/docs/changelog
            xinstall -m 0644 -W ${worksrcpath} README.md LICENSE \
                ${destroot}${docdir}
            xinstall -m 0644 {*}[glob -directory ${worksrcpath}/docs *.rst] \
                    ${destroot}${docdir}/docs
            xinstall -m 0644 {*}[glob -directory ${worksrcpath}/docs/changelog *] \
                    ${destroot}${docdir}/docs/changelog
        }

    } else {
        # latest upstream version
        python.pep517       yes
        python.pep517_backend   hatch

        depends_build-append \
                        port:py${python.suffix}-hatch-fancy-pypi-readme \
                        port:py${python.suffix}-hatch-vcs
    }

    depends_run-append  port:virtualenv_select

    select.group        virtualenv
    select.file         virtualenv${python.suffix}

    notes-append "
    The executable is installed as\
    '${prefix}/bin/virtualenv-${python.branch}'. To symlink it to\
    '${prefix}/bin/virtualenv', run:

        sudo port select --set ${select.group} ${select.file}
    "

    livecheck.type  none
}
