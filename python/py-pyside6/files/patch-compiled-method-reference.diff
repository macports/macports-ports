Retain the compiled method's function until MethodDynamicSlot is destroyed.
PyObject_GetAttr returns the owned reference consumed by MethodDynamicSlot;
dropping it here causes an extra decrement when the connection is removed.

--- sources/pyside6/libpyside/dynamicslot.cpp.orig
+++ sources/pyside6/libpyside/dynamicslot.cpp
@@ -194,7 +194,7 @@
     case SlotType::CompiledMethod: {
         // PYSIDE-1523: PyMethod_Check is not accepting compiled form, we just go by attributes.
         PyObject *function = PyObject_GetAttr(callback, PySide::PySideName::im_func());
-        Py_DECREF(function);
+        // Transfer the function reference to MethodDynamicSlot, as for ordinary methods.
         PyObject *pythonSelf = PyObject_GetAttr(callback, PySide::PySideName::im_self());
         Py_DECREF(pythonSelf);
         return new PysideReceiverMethodSlot(function, pythonSelf);
