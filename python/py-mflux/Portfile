# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           python 1.0

name                py-mflux
version             0.19.2
revision            0
categories-append   science graphics
license             MIT
maintainers         nomaintainer
supported_archs     any

description         MLX-native implementations of state-of-the-art generative \
                    image models (FLUX, Z-Image, Qwen Image, and more)

long_description    MFLUX is a line-by-line MLX port of several state-of-the-art \
                    generative image models from the Hugging Face Diffusers and \
                    Transformers libraries, allowing local text-to-image \
                    generation on Apple Silicon Macs using Apple's MLX framework. \
                     Requires an Apple Silicon Mac (M1 or later)\; does not run on \
                    Intel Macs.

homepage            https://github.com/filipstrand/mflux

checksums           rmd160  aaf14c76ec92bd406650dbea30d28c4335cf54ab \
                    sha256  94876782ad97c271c518c65ad2303e4f360b952fc3977287b195a838950a3245 \
                    size    976736

python.versions     312 313 314

if {${name} ne ${subport}} {
    # mflux requires Apple Silicon (MLX has no meaningful CPU-only fallback path
    # for these model sizes); fail cleanly on Intel rather than building a
    # non-functional port.
    pre-fetch {
        if {${configure.build_arch} ne "arm64" && [lindex [split [exec arch] " "] 0] ne "arm64"} {
            ui_error "${name} requires an Apple Silicon Mac (MLX has no usable CPU fallback for these model sizes)."
            return -code error "unsupported architecture"
        }
    }

    python.pep517_backend \
                    uv

    depends_lib-append \
                    port:py${python.version}-filelock \
                    port:py${python.version}-fonttools \
                    port:py${python.version}-huggingface_hub \
                    port:py${python.version}-mlx \
                    port:py${python.version}-numpy \
                    port:py${python.version}-piexif \
                    port:py${python.version}-pillow \
                    port:py${python.version}-platformdirs \
                    port:py${python.version}-protobuf3 \
                    port:py${python.version}-opencv4 \
                    port:py${python.version}-pytorch \
                    port:py${python.version}-yaml \
                    port:py${python.version}-requests \
                    port:py${python.version}-safetensors \
                    port:py${python.version}-sentencepiece \
                    port:py${python.version}-tokenizers \
                    port:py${python.version}-toml \
                    port:py${python.version}-tqdm \
                    port:py${python.version}-transformers
}
