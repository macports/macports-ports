    # when MacPorts' rust PortGroup also configures the linker. Without this,
    # linking fails with a wall of undefined _Py* symbols, because those symbols
    # are meant to resolve at runtime against the host CPython, not at link time.
    build.env-append \
            "RUSTFLAGS=-C link-arg=-undefined -C link-arg=dynamic_lookup"

