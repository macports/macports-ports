python.pep517_backend \
                    hatch

if {${name} ne ${subport}} {
    depends_build-append  \
                    port:py${python.version}-hatch-fancy-pypi-readme \
                    port:py${python.version}-uv-dynamic-versioning

    depends_lib-append  \
                    port:py${python.version}-h11 \
                    port:py${python.version}-h2 \
                    port:py${python.version}-trio \
                    port:py${python.version}-truststore

    if {${python.version} eq 310} {
        version     2.14.0
        revision    0

        checksums   rmd160  5fecaad0dc47ccb74d45cc4a1b6e75d31b420fa8 \
                    sha256  72ce9847270cf6324f2c8c2385ca1481d243159d37fc7a8ebc8441a81fe67b5e \
                    size    2133484
    }

    configure.dir   ${worksrcpath}/src/httpcore2
    build.dir       ${configure.dir}

    # METADATA doesn't get the correct version number
    post-destroot {
        move ${destroot}/${python.prefix}/lib/python${python.branch}/site-packages/httpcore2-0.0.0.dist-info \
            ${destroot}/${python.prefix}/lib/python${python.branch}/site-packages/httpcore2-${version}.dist-info
        reinplace "s|0\.0\.0|${version}|g" \
            ${destroot}/${python.prefix}/lib/python${python.branch}/site-packages/httpcore2-${version}.dist-info/METADATA
    }
}
