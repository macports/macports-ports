#==================================================================================================
# Patch to remove block for setuptools 84.2.0/84.2.1, as it's only needed on Windows.
#==================================================================================================
--- pyproject.toml.orig	2026-11-24 17:27:29.980594196 -0500
+++ pyproject.toml	2026-11-24 17:27:54.846900779 -0500
@@ -2,7 +2,7 @@
 # setuptools 84.2.0 and 84.2.1 misname the cffi extension as a bare .pyd on
 # PyPy/Windows, which PyPy cannot import (see pypa/setuptools#5351). Drop these
 # exclusions once the fix is released.
-requires = ["setuptools!=84.2.0,!=84.2.1", "cffi>=2.0"]
+requires = ["setuptools", "cffi>=2.0"]
 build-backend = "setuptools.build_meta"
 
 [tool.cibuildwheel]
