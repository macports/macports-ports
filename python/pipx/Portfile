PortSystem          1.0
PortGroup           python 1.0
PortGroup           github 1.0

github.setup        pypa pipx 1.17.14
revision            0
checksums           rmd160  07e69c4c342de6fedebede03b26031be8e63b0c2 \
                    sha256  35ebc854609aa8b0d6aac777093a88213b6bc6d844e48d0132d477abbe74eaa0 \
                    size    665186

categories          python sysutils
license             MIT
maintainers         {@mndavidoff alluvialsw.com:md14-macports} openmaintainer
supported_archs     noarch
platforms           {darwin any}

description         Execute binaries from Python packages in isolated environments
long_description    ${description}

github.tarball_from archive
github.livecheck.regex  {([\d.]+)}

if {
    ![variant_isset python311] &&
    ![variant_isset python312] &&
    ![variant_isset python313] &&
    ![variant_isset python314]
} {
    default_variants +python314
}

variant python311 conflicts python312 python313 python314 description {Use Python 3.11} {}
variant python312 conflicts python311 python313 python314 description {Use Python 3.12} {}
variant python313 conflicts python311 python312 python314 description {Use Python 3.13} {}
variant python314 conflicts python311 python312 python313 description {Use Python 3.14} {}

if {[variant_isset python314]} {
    python.default_version 314
} elseif {[variant_isset python313]} {
    python.default_version 313
} elseif {[variant_isset python312]} {
    python.default_version 312
} elseif {[variant_isset python311]} {
    python.default_version 311
}

python.pep517       yes
python.pep517_backend hatch

build.env-append    SETUPTOOLS_SCM_PRETEND_VERSION=${version}

depends_build-append \
                    port:py${python.version}-docutils \
                    port:py${python.version}-hatch-vcs

depends_lib-append  port:py${python.version}-argcomplete \
                    port:py${python.version}-filelock \
                    port:py${python.version}-packaging \
                    port:py${python.version}-platformdirs \
                    port:py${python.version}-userpath
