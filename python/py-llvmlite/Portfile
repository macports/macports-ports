    set llvmver         22

    build.env-append    LLVM_DIR=${prefix}/libexec/llvm-${llvmver}/lib/cmake/
    depends_build-append \
                        path:bin/cmake:cmake

    depends_lib-append  port:llvm-${llvmver} \
                        port:zstd \
                        port:zlib
