--- CMakeLists.txt.orig	2022-11-09 06:37:21
+++ CMakeLists.txt	2026-11-18 18:56:41
@@ -36,9 +36,14 @@
 # that lived in setup.py. CMake's FindOpenMP handles all of that, including
 # the macOS conda/homebrew toolchain quirks.
 # ---------------------------------------------------------------------------
-find_package(OpenMP QUIET)
+find_package(OpenMP COMPONENTS CXX)
 if(OpenMP_CXX_FOUND)
-    message(STATUS "OpenMP found — enabling multi-threaded preprocessing")
+    set (OpenMP_CXX_FLAGS " -Xpreprocessor -fopenmp -I@PREFIX@/include/libomp -L@PREFIX@/lib/libomp -lomp")
