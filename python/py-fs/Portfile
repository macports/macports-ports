python.versions     310 311 312 313 314 315

if {${name} ne ${subport}} {
    # Upstream hasn’t landed anything substantive since 2022, but these pull
    # requests pending against the upstream keep the module alive and current.
    patchfiles-append   patch-pr_586.diff \
                        patch-pr_588.diff \
                        patch-pr_589.diff \
                        patch-pr_590.diff \
                        patch-pr_605.diff \
                        patch-pr_606.diff

    depends_lib-append \
                        port:py${python.version}-appdirs \
                        port:py${python.version}-six \
                        port:py${python.version}-tz

    post-destroot {
        set docdir ${prefix}/share/doc/${subport}
        xinstall -d ${destroot}${docdir}
        xinstall -m 0644 -W ${worksrcpath} README.md LICENSE \
            ${destroot}${docdir}
    }

    depends_test-append port:py${python.version}-parameterized
    test.run            yes
    test.args-append    --ignore=tests/test_ftpfs.py

    if {${python.version} >= 315} {
        # https://github.com/python/cpython/pull/134890 broke this test in
        # Python 3.15.
        test.args-append \
                        --ignore=tests/test_doctest.py
    }
}
