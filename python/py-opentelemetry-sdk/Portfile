long_description    {*}${description}

homepage            https://github.com/open-telemetry/opentelemetry-python/tree/main/opentelemetry-sdk

distname            opentelemetry_sdk-${version}

checksums           rmd160  d70a640b757cb6eb713ca06c68009f28e8a163c8 \
                    sha256  7eec4de13dd21ff3a1670dcb0e02079e692736f94d733dfdce5af461d884248d \
