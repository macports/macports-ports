python.versions     313 314 315
python.pep517_backend hatch

if {${name} ne ${subport}} {
    depends_lib-append \
                    port:py${python.version}-opentelemetry-api \
                    port:py${python.version}-opentelemetry-semantic-conventions \
                    port:py${python.version}-typing_extensions

    test.run        yes
    depends_test-append \
                    port:py${python.version}-flaky \
                    port:py${python.version}-opentelemetry-test-utils \
                    port:py${python.version}-psutil

    # tests/trace/test_trace.py::TestTracer::test_shutdown runs the
    # 'python' found on PATH; make that this subport's Python, not whatever
    # 'port select python' points at.
    pre-test {
        xinstall -d ${workpath}/test-bin
        ln -sf ${python.bin} ${workpath}/test-bin/python
    }
    test.env-append PATH=${workpath}/test-bin:$env(PATH)
}
