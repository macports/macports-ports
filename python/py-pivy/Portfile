# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           github 1.0
PortGroup           python 1.0

set real_name       pivy
github.setup        FreeCAD ${real_name} 0.6.10
github.tarball_from archive
name                py-${real_name}
license             Permissive
maintainers         nomaintainer
description         Pivy is a Coin binding for Python.
long_description    {*}${description}

# 0.6.2 built via setup.py, which imports distutils -- removed from the stdlib
# in Python 3.12. 0.6.10 ships a CMakeLists.txt, which is what upstream itself
# builds with, so use that and drop the setup.py patches along with it.
python.versions     310 311 312 313

checksums           rmd160  bd0777bb414e899fba29f062187382dc4665791a \
                    sha256  7b409816c9fad84cf94f93659281f9dd2501d285eb2fc609e9401a3d004ce723 \
                    size    6678472

if {${name} ne ${subport}} {
    PortGroup       cmake 1.1

    depends_lib-append \
                    port:python${python.version} \
                    port:Coin
    depends_build-append \
                    port:swig \
                    port:swig-python

    use_configure   yes

    # cmake drives the build, so the PEP517 toolchain is not needed.
    python.pep517   no

    # The python PortGroup aims build.cmd and destroot.cmd at setup.py. Point
    # them back at the generated makefiles. build.cmd in particular must be
    # reset before configure.args is touched, or the cmake PortGroup picks up
    # "python3.x setup.py --no-user-cfg" as -DCMAKE_MAKE_PROGRAM and configure
    # dies on "Unknown argument --no-user-cfg". See
    # https://github.com/macports/macports-ports/commit/63c9c8e6e312c8e36603cb118d94f995aa8a6e67
    build.cmd       make
    build.target    all
    destroot.cmd    make
    destroot.target install
    destroot.destdir \
                    DESTDIR=${destroot}

    # pivy runs SWIG with -includeall, so every #include in Coin's headers has
    # to resolve. fake_headers/ holds zero-byte stubs standing in for the
    # standard headers SWIG must not actually parse, but it predates Coin
    # 4.0.10's SbByteBuffer.h picking up <memory>, so SWIG stops with
    #   Inventor/SbByteBuffer.h:21: Error: Unable to find 'memory'
    # Add the missing stub, empty like every other one.
    post-extract {
        touch ${worksrcpath}/fake_headers/memory
    }

    # FreeCAD refuses to configure unless the Coin that pivy was built against
    # matches the installed Coin exactly, down to the micro version:
    #   "Coin3D version X mismatches Pivy Coin3D Y."
    # Revbump this port whenever the Coin port changes version.
    #
    # SoQt is looked up opportunistically by pivy's CMakeLists and takes a hard
    # Qt dependency when present, which would make the build depend on what
    # else happens to be installed. FreeCAD uses its own bundled Quarter viewer
    # and needs only pivy's coin module, so that lookup is disabled.
    configure.args-append \
                    -DPIVY_Python_SITEARCH=${python.pkgd} \
                    -DPython_EXECUTABLE=${python.bin} \
                    -DPython_ROOT_DIR=${python.prefix} \
                    -DCMAKE_DISABLE_FIND_PACKAGE_SoQt=ON
}
