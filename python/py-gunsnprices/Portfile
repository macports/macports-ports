PortSystem          1.0
PortGroup           python 1.0

name                py-gunsnprices
version             0.1.2
revision            0

categories-append   textproc
license             MIT CC-BY-4
maintainers         {@gunsnprices-admin} openmaintainer
supported_archs     noarch
platforms           {darwin any}

description         parse firearm and ammunition product titles
long_description    gunsnprices parses firearm and ammunition product \
                    titles into structured data: brand and model (for \
                    example Glock 19 Gen 5 MOS), caliber, magazine \
                    capacity, barrel length, rounds per box and cost per \
                    round. It uses the model dictionaries and caliber \
                    list behind the GunsNPrices price comparison site and \
                    includes a command-line tool that prints JSON, \
                    installed as gunsnprices-X.Y for Python X.Y.

homepage            https://gunsnprices.com

checksums           rmd160  9778ad940dfdfc99dea348c330da55fe7977ec99 \
                    sha256  595d6017c3dd2b9fbf7fdb04b595f9b7cea28142a8eea08649a95e85f18634f4 \
                    size    133962

