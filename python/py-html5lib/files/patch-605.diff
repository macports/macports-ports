From ebf52a8491b5ab101166556834c7c9f153cf7fd8 Mon Sep 17 00:00:00 2001
From: xingyaner <longfor2025@gmail.com>
Date: Sat, 19 Sep 2026 22:27:15 +0800
Subject: [PATCH] setup: make pkg_resources optional

Signed-off-by: xingyaner <longfor2025@gmail.com>
---
 setup.py | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git setup.py setup.py
index 30ee0575..6dda2861 100644
--- setup.py
+++ setup.py
@@ -6,9 +6,10 @@
 
 from os.path import join, dirname
 from setuptools import setup, find_packages, __version__ as setuptools_version
-from pkg_resources import parse_version
-
-import pkg_resources
+try:
+    import pkg_resources
+except ImportError:
+    pkg_resources = None
 
 try:
     import _markerlib.markers
@@ -50,7 +51,7 @@ def default_environment():
 # recognise the markers needed by this setup.py
 # Change this to setuptools 20.10.0 to support all markers.
 if pkg_resources:
-    if parse_version(setuptools_version) < parse_version('18.5'):
+    if (pkg_resources.parse_version(setuptools_version) < pkg_resources.parse_version('18.5')):
         MarkerEvaluation = pkg_resources.MarkerEvaluation
 
         del pkg_resources.parser
