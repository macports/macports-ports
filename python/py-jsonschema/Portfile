# py-jsonschema-format-nongpl metaport (jsonschema[format-nongpl])
foreach python_version ${python.versions} {
    subport py${python_version}-jsonschema-format-nongpl {
        revision            1
        supported_archs     noarch
        distfiles
        build {}
        destroot {
            xinstall -d -m 0755 ${destroot}${prefix}/share/doc/${subport}
            system "echo ${subport} > ${destroot}${prefix}/share/doc/${subport}/stub"
        }
        depends_lib-append  port:py${python.suffix}-jsonschema \
                            port:py${python.suffix}-fqdn \
                            port:py${python.suffix}-idna \
                            port:py${python.suffix}-isoduration \
                            port:py${python.suffix}-jsonpointer \
                            port:py${python.suffix}-rfc3339-validator \
                            port:py${python.suffix}-rfc3986-validator \
                            port:py${python.suffix}-rfc3987-syntax \
                            port:py${python.suffix}-uri-template \
                            port:py${python.suffix}-webcolors
        livecheck.type      none
    }
}

