+def _table_style(name):
+    """The prettytable style called name. prettytable >= 3.12 has the styles
+    in the TableStyle enum (its deprecated module constants reach the module
+    __dict__ only once accessed); older versions have only the constants.
+    Either way an unknown name raises KeyError, as before."""
+    name = name.upper()
+    if hasattr(prettytable, "TableStyle"):
+        return prettytable.TableStyle[name]
+    return prettytable.__dict__[name]
+
