python.versions     310 311 312

if {${name} ne ${subport}} {
    # ipython-sql looks styles up in prettytable's module __dict__, but
    # prettytable >= 3.12 has them in the TableStyle enum and keeps the old
    # names only as deprecated attributes, which a __dict__ lookup misses
    # until they are first read, so queries raise KeyError. Use TableStyle
    # when it exists, else the module constant. Upstream's GitHub README
    # (newer than the 0.5.0 release) says future work goes into JupySQL.
    patchfiles              patch-prettytable-tablestyle.diff

    depends_lib-append      port:py${python.version}-ipython \
                            port:py${python.version}-ipython_genutils \
                            port:py${python.version}-prettytable \
                            port:py${python.version}-sqlalchemy \
                            port:py${python.version}-sqlparse \
                            port:py${python.version}-six
}
