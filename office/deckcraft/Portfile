platforms           {macosx >= 20}
supported_archs     arm64 x86_64
installs_libs       no

description         Presentation editor from the ArtCraft series
long_description    DeckCraft is a native presentation editor written in Rust, \
                    with slide masters, themes, shapes, charts, animations, \
                    transitions and media playback. The desktop app and command-line \
                    interface share the same engine. The CLI supports rendering, \
                    conversion, command scripting and an MCP server.

# Keep the font input at the same commit as upstream's release workflow.
set craft_fonts_commit \
                    37827adc41fd165f9a9234ac40f94dbad353aa69
set craft_fonts_distfile \
                    craft-fonts-${craft_fonts_commit}.tar.gz
set craft_fonts_path ${workpath}/craft-fonts-${craft_fonts_commit}

master_sites-append \
                    https://github.com/storytold/craft-fonts/archive/${craft_fonts_commit}.tar.gz?dummy=:craft_fonts
distfiles-append    ${craft_fonts_distfile}:craft_fonts
extract.only        ${distname}${extract.suffix} ${craft_fonts_distfile}
extract.rename      no

checksums           ${distname}${extract.suffix} \
                    rmd160  a0dde8ae74092c4bce590c67a53195f091873afe \
                    sha256  a370bb3069168c42b3b62007ef2de1973be4b814c7022e333804e7d1b6b165ae \
                    size    4313809 \
                    ${craft_fonts_distfile} \
                    rmd160  955bc3f273896a21b52186f1b59929ee629c2b46 \
                    sha256  64c213260ee643c99edb1300ff047a2a00b270d7efef4aa943fec78641fdfef0 \
                    size    48970374

# Cargo.lock contains Git dependencies; frozen mode cannot fetch them.
# Keep --locked below while allowing these pinned dependencies to be fetched.
cargo.offline_cmd

build.env-append    CRAFT_FONTS_DIR=${craft_fonts_path} \
                    CRAFT_FONTS_REQUIRED=1 \
                    DECKCRAFT_BUILD_DATE=[clock format [clock seconds] -format "%Y-%m-%d" -gmt 1]
build.args-append   --locked -p deckcraft -p deckcraft-cli
# Avoid retaining unused dylib dependencies.
rust.flags-append   -C link-arg=-Wl,-dead_strip_dylibs

pre-configure {
    set ::git_commit \
                    [exec curl -fsSL \
                        -H "Accept: application/vnd.github.sha" \
                        https://api.github.com/repos/${github.author}/${github.project}/commits/${github.tag_prefix}${version}]
    build.env-append \
                    DECKCRAFT_BUILD_SHA=${::git_commit}
}

# A bundle signed before muniversal merges its executables has an invalid
# signature. Build either native architecture until bundle merging is handled.
universal_variant   no

destroot {
    set target_dir ${worksrcpath}/target/[cargo.rust_platform]/release
    set app_dir ${destroot}${applications_dir}/DeckCraft.app
    set resources_dir ${app_dir}/Contents/Resources
    set doc_dir ${destroot}${prefix}/share/doc/${name}
    xinstall -d ${app_dir}/Contents/MacOS ${resources_dir}/Licenses \
        ${destroot}${prefix}/bin ${doc_dir}

    # Follow packaging/macos/package.sh without creating release DMGs or ZIPs.
    xinstall -m 0755 ${target_dir}/deckcraft ${app_dir}/Contents/MacOS/DeckCraft
    xinstall -m 0755 ${target_dir}/deckcraft-cli ${destroot}${prefix}/bin
    xinstall -m 0644 ${worksrcpath}/assets/app-icon/deckcraft.icns \
        ${resources_dir}/DeckCraft.icns
    xinstall -m 0644 ${worksrcpath}/packaging/macos/Info.plist.in \
        ${app_dir}/Contents/Info.plist
    reinplace "s|@VERSION@|${version}|g; s|@SHORT_VERSION@|${version}|g; s|@BUILD_SHA@|${::git_commit}|g" \
        ${app_dir}/Contents/Info.plist
    system "/usr/libexec/PlistBuddy -c 'Set :LSMinimumSystemVersion ${macosx_deployment_target}' '${app_dir}/Contents/Info.plist'"
    set pkginfo [open ${app_dir}/Contents/PkgInfo w]
    puts -nonewline ${pkginfo} {APPL????}
    close ${pkginfo}

    ln -s ${applications_dir}/DeckCraft.app/Contents/MacOS/DeckCraft \
        ${destroot}${prefix}/bin/deckcraft

    xinstall -m 0644 -W ${worksrcpath} README.md LICENSE-MIT LICENSE-APACHE \
        NOTICE ATTRIBUTION.md ${doc_dir}
    xinstall -m 0644 -W ${worksrcpath} LICENSE-MIT LICENSE-APACHE \
        NOTICE ${resources_dir}/Licenses
    xinstall -m 0644 ${worksrcpath}/ATTRIBUTION.md ${resources_dir}/Licenses
    xinstall -m 0644 ${worksrcpath}/docs/brand/LICENSE-brand.txt \
        ${resources_dir}/Licenses
    xinstall -m 0644 ${worksrcpath}/docs/brand/LICENSE-brand.txt ${doc_dir}
    xinstall -m 0644 ${worksrcpath}/licenses/pdf-writer/LICENSE-ICC.txt \
        ${resources_dir}/Licenses
    xinstall -m 0644 ${worksrcpath}/licenses/pdf-writer/LICENSE-ICC.txt ${doc_dir}
    # These fonts are embedded by egui, not fetched from craft-fonts.
    foreach license_file [glob ${cargo.home}/git/checkouts/egui-*/*/crates/epaint_default_fonts/fonts/*.txt] {
        xinstall -m 0644 ${license_file} ${resources_dir}/Licenses
        xinstall -m 0644 ${license_file} ${doc_dir}
    }

    foreach license_file [glob ${craft_fonts_path}/fonts/*/OFL.txt] {
        set family [file tail [file dirname ${license_file}]]
        xinstall -m 0644 ${license_file} ${resources_dir}/Licenses/OFL-${family}.txt
        xinstall -m 0644 ${license_file} ${doc_dir}/OFL-${family}.txt
    }

    # Remove inherited Finder metadata before creating the final signatures.
    system "/usr/bin/xattr -cr '${app_dir}'"
    system "/usr/bin/xattr -c '${destroot}${prefix}/bin/deckcraft-cli'"
    system "/usr/bin/codesign --force --sign - --entitlements '${worksrcpath}/packaging/macos/entitlements.plist' '${app_dir}'"
    system "/usr/bin/codesign --force --sign - --entitlements '${worksrcpath}/packaging/macos/entitlements.plist' --identifier ai.storyteller.deckcraft-cli '${destroot}${prefix}/bin/deckcraft-cli'"
}

