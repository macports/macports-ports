# Only the HandBrake source tarball is extracted by MacPorts; the contrib
# tarballs are unpacked by HandBrake's own build system.
extract.only        ${distname}${extract.suffix}

post-extract {
    # Make the pre-fetched contrib distfiles available to the build.
    ln -sfh ${distpath} ${worksrcpath}/download
}

# libdovi is built from its vendored-crates tarball so that cargo never
# accesses the network; the Sparkle framework is removed because MacPorts
# must not use the in-application updater and xcodebuild would otherwise
# fetch it through Swift Package Manager; ffmpeg's X11 support is disabled
# so an installed X server cannot change what gets linked; the Xcode build
# keeps its DerivedData inside the work directory and turns off user script
# sandboxing, because the MacPorts build sandbox allows neither writes to
# $HOME nor nested sandboxes.
patch.pre_args-replace  -p0 -p1
patchfiles          0001-libdovi-Use-vendored-crates.patch \
                    0002-MacGui-Disable-Sparkle.patch \
                    0003-ffmpeg-Disable-X11.patch \
                    0004-macosx-Build-inside-the-MacPorts-sandbox.patch

post-patch {
    # The Sparkle package reference is gone; do not let Xcode resolve it.
    delete "${worksrcpath}/macosx/HandBrake.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved"
}

configure.cmd       ${prefix}/bin/python3.14
configure.pre_args  ${worksrcpath}/make/configure.py
configure.args      --build=build \
                    --force \
                    --prefix=${prefix} \
                    --disable-gtk \
                    --disable-df-fetch \
                    --enable-libdovi \
                    --enable-x265 \
                    --cc=${configure.cc} \
                    --python=${prefix}/bin/python3.14 \
                    --arch=${configure.build_arch} \
                    --minver=${macosx_deployment_target} \
                    --verbose

# HandBrakeCLI does not build the Xcode project, but it still needs Xcode's
# Metal toolchain for the VideoToolbox shaders.
if {${subport} eq "HandBrakeCLI"} {
    configure.args-append  --disable-xcode
}

build.dir           ${worksrcpath}/build
build.target        build

build.env-append    CARGO_HOME=${worksrcpath}/.cargo-home \
                    CARGO_NET_OFFLINE=true \
                    MACOSX_DEPLOYMENT_TARGET=${macosx_deployment_target}

destroot {
    if {${subport} eq "HandBrakeCLI"} {
        xinstall -d ${destroot}${prefix}/bin
        xinstall -m 0755 ${worksrcpath}/build/HandBrakeCLI \
            ${destroot}${prefix}/bin

        set docDir ${destroot}${prefix}/share/doc/${subport}
        xinstall -d ${docDir}
        xinstall -m 0644 -W ${worksrcpath} \
            AUTHORS.markdown COPYING LICENSE NEWS.markdown README.markdown \
            THANKS.markdown TRANSLATION.markdown ${docDir}
    } else {
        xinstall -d ${destroot}${applications_dir}
        copy ${worksrcpath}/build/xroot/HandBrake.app \
            ${destroot}${applications_dir}
    }
}

# fdk-aac is not GPL-compatible, so binaries built with this variant are
# not redistributable and are excluded from MacPorts binary archives.
variant fdk_aac description {Enable AAC encoding via Fraunhofer FDK AAC (nonfree)} {
    license             Restrictive
    configure.args-append  --enable-fdk-aac

    distfiles-append    fdk-aac-2.0.3.tar.gz:hbcontribs
    checksums-append    fdk-aac-2.0.3.tar.gz \
                            rmd160  dbf93965d6dc92b36d739e081252c91c444ee183 \
                            sha256  e25671cd96b10bad896aa42ab91a695a9e573395262baed4e4a2ff178d6a3a78 \
                            size    2518649
}

if {[variant_isset fdk_aac]} {
    notes-append "This build includes fdk-aac, which is not compatible with \
the GPL.  The resulting binaries are not redistributable."
}

livecheck.type      regex
livecheck.url       https://handbrake.fr/downloads.php
livecheck.regex     {Current Version: (\d(?:\.\d+)+)}

subport HandBrakeCLI {
    livecheck.type  none
}
