# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           xcodeversion 1.0

# HandBrake needs the full Xcode installation (for the Metal toolchain),
# not just the Command Line Tools, so point DEVELOPER_DIR at Xcode.
use_xcode           yes

name                HandBrake
version             1.11.2
categories          multimedia aqua
platforms           macosx
license             GPL-2
maintainers         {larryv @larryv}

description         The open source video transcoder
long_description    HandBrake is a tool for converting video from \
                    nearly any format to a selection of modern, \
                    widely supported codecs.
homepage            https://handbrake.fr

livecheck.type      regex
livecheck.url       https://handbrake.fr/downloads.php
livecheck.regex     {Current Version: (\d(?:\.\d+)+)}

subport HandBrakeCLI {
    categories-delete   aqua
    description-append  (CLI)
    long_description-append {*}{(This port provides the command-line
                                interface only; install the `HandBrake`
                                port for the graphical user interface.)}
    livecheck.type      none
}

# Upstream requires macOS 13.5 to build HandBrake 1.11.x.
if {${os.platform} eq "darwin" && [vercmp ${os.version} 13.5] < 0} {
    pre-fetch {
        ui_error "Building ${subport} ${version} requires macOS 13.5 or later."
        return -code error "unsupported platform"
    }
}

# Upstream requires Xcode 15.2.  HandBrake also compiles Metal shaders for
# its VideoToolbox filters, so a full Xcode installation is needed for both
# the GUI and the command-line build; the command line tools are not enough.
minimum_xcodeversions {22 15.2} {23 15.2} {24 15.2} \
                      {25 15.2} {26 15.2}

if {${subport} eq "HandBrake"} {
    depends_run         port:HandBrakeCLI
}

# Upstream builds 64-bit only, and its build system has no universal build.
supported_archs     x86_64 arm64
universal_variant   no

# The bundled contrib libraries are built exactly as upstream does, so the
# resulting binary is self-contained and matches upstream's feature set.
# Pre-fetch all of them so the build never accesses the network.
depends_build       port:autoconf \
                    port:automake \
                    port:cargo \
                    port:cargo-c \
                    port:cmake \
                    port:libtool \
                    port:m4 \
                    port:meson \
                    port:nasm \
                    port:ninja \
                    port:pkgconfig \
                    port:python314

# The bundled contrib libraries are static, but HandBrake links these
# three from the MacPorts prefix.  Declaring them keeps the result
# independent of what happens to be installed on the build machine.
depends_lib         port:bzip2 \
                    port:libiconv \
                    port:zlib

# Use Apple's clang, as upstream does.  This also avoids a dependency on
# MacPorts' libc++ runtime in the final binary.
compiler.blacklist-append  macports-clang-* gcc-*

use_bzip2           yes

distname            HandBrake-${version}-source
worksrcdir          HandBrake-${version}

master_sites        https://github.com/HandBrake/HandBrake/releases/download/${version}:src \
                    https://github.com/HandBrake/HandBrake-contribs/releases/download/contribs2:hbcontribs2 \
                    https://github.com/HandBrake/HandBrake-contribs/releases/download/contribs:hbcontribs

dist_subdir         HandBrake

