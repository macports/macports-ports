The MacPorts build sandbox does not allow the default DerivedData location
under $HOME and refuses nested sandboxing, which xcodebuild uses for its
script phases.  Keep the CoreFoundation home inside the build tree and turn
off user script sandboxing so both work inside the MacPorts sandbox.

--- a/macosx/module.defs
+++ b/macosx/module.defs
@@ -65,7 +65,14 @@
 ## $(2) = list of goals to shunt through xcodebuild->make
 ##
 
+## xcodebuild writes its DerivedData to $HOME/Library/Developer/Xcode, which
+## is outside the MacPorts build sandbox; give it a CoreFoundation home
+## inside the build tree instead.
+MACOSX.cf_home = $(abspath $(BUILD))/xcode-home
+$(shell $(MKDIR.exe) -p '$(MACOSX.cf_home)')
+
 MACOSX.XCODE = $(strip \
+    env CFFIXED_USER_HOME='$(MACOSX.cf_home)' \
     $(XCODEBUILD.exe) \
         $(MACOSX.project) \
         $(foreach t,$(1),-target $t) \
@@ -75,6 +82,7 @@
         SYMROOT='$(XCODE.symroot)' \
         CONFIGURATION_BUILD_DIR='$(XCODE.symroot)' \
         CONFIGURATION_TEMP_DIR='$(XCODE.symroot)' \
+        ENABLE_USER_SCRIPT_SANDBOXING='NO' \
         \
         EXTERNAL_BUILD='$(abspath $(BUILD))' \
         EXTERNAL_CONF_ARGS='$(CONF.args)' \
