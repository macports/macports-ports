# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           github 1.0

github.setup        markksantos caption-checker 1.1.0 v
github.tarball_from archive
revision            0

categories          multimedia textproc
platforms           any
supported_archs     noarch
license             MIT
maintainers         {markksantos.com:hello @markksantos} openmaintainer

description         check SRT and WebVTT captions against Netflix, BBC and DCMP limits

long_description    ${name} checks SRT and WebVTT caption files against \
                    Netflix English, the BBC subtitle guidelines or the \
                    DCMP Captioning Key and flags captions that read too \
                    fast, lines that are too long, too many lines, \
                    captions on screen too briefly or too long, short \
                    gaps, overlaps and unreadable timestamps. It exits \
                    with 1 when a caption breaks a limit, so it works as \
                    a CI check, has --json output, and can run as an MCP \
                    server for AI assistants. It needs nothing besides \
                    Node.js.

homepage            https://www.markstudios.com/tools/caption-checker

checksums           rmd160  fd58f3c4b2c4a598d7ea8f1a0dbe311a67f005d7 \
                    sha256  1a7d6f352d5e5e32937b12f2e889309f9c30e4a0bec79f70e7e37bd2130f817f \
                    size    303771

depends_run         path:bin/node:nodejs22

use_configure       no

post-patch {
    reinplace "s|^#!/usr/bin/env node|#!${prefix}/bin/node|" ${worksrcpath}/bin/caption-check.js
}

build {}

destroot {
    set libdir ${destroot}${prefix}/libexec/${name}
    xinstall -d ${libdir}/bin ${libdir}/examples
    xinstall -m 0644 -W ${worksrcpath} index.js mcp.js package.json ${libdir}
    xinstall -m 0755 ${worksrcpath}/bin/caption-check.js ${libdir}/bin
    xinstall -m 0644 ${worksrcpath}/examples/travel-vlog.srt ${libdir}/examples
    ln -s ${prefix}/libexec/${name}/bin/caption-check.js ${destroot}${prefix}/bin/caption-check

    set docdir ${destroot}${prefix}/share/doc/${name}
    xinstall -d ${docdir}
    xinstall -m 0644 -W ${worksrcpath} CHANGELOG.md LICENSE README.md ${docdir}
}

# The tests read the bundled example file and need no network.
test.run            yes
test {
    system -W ${worksrcpath} "${prefix}/bin/node --test test/check.test.js test/mcp.test.js"
}
