# openssl_adblock2privoxy.cnf -- the PRIVOXY Root CA (self-signed; its own
# trust anchor) and the adblock2privoxy-nginx server certificate it issues.
#
# Used by the adblock2privoxy port's PKI commands:
#   openssl req -config openssl_adblock2privoxy.cnf -new -x509 ... -extensions privoxy_ca
#   openssl ca  -config openssl_adblock2privoxy.cnf ... -extensions adblock2privoxy
# CA settings match openssl_privoxy.cnf of the privoxy port: pathlen:0 and
# extendedKeyUsage serverAuth restrict the CA to TLS server certificates.

[ca]
default_ca        = CA_default

[ CA_default ]
# Directory and file locations.
dir               = .
certs             = $dir
crl_dir           = $dir
new_certs_dir     = $dir
database          = $dir/index.txt
serial            = $dir/serial
RANDFILE          = $dir/.rand
rand_serial       = yes

# The root key and root certificate.
private_key       = $dir/privoxy.key.pem
certificate       = $dir/privoxy.cert.pem

# For certificate revocation lists.
crlnumber         = $dir/crlnumber
crl               = $dir/privoxy.crl.pem
crl_extensions    = crl_ext
default_crl_days  = 30

# SHA-1 is deprecated, so use SHA-2 instead.
default_md        = sha256

name_opt          = ca_default
cert_opt          = ca_default
preserve          = no
policy            = policy_strict

# allow issuing multiple certificates with the same CN
unique_subject    = no

[ policy_strict ]
# See the POLICY FORMAT section of `man ca`.
countryName             = optional
stateOrProvinceName     = optional
organizationName        = optional
organizationalUnitName  = optional
commonName              = supplied
emailAddress            = optional

[req]
# Options for the `req` tool (`man req`).
distinguished_name  = req_distinguished_name
string_mask         = utf8only

[req_distinguished_name]
countryName                     = US
countryName_default             = US
countryName_min                 = 2
countryName_max                 = 2
stateOrProvinceName             = Massachusetts
stateOrProvinceName_default     = Massachusetts
localityName                    = Boston
localityName_default            = Boston
organizationName                = MacPorts Privoxy
organizationName_default        = MacPorts Privoxy
organizationalUnitName          = MacPorts Privoxy
organizationalUnitName_default  = MacPorts Privoxy
commonName                      = MacPorts Privoxy Root CA
commonName_default              = MacPorts Privoxy Root CA
commonName_max                  = 64
# email deprecated, but private intercepting proxy has no AIA
emailAddress                    = macports-users@lists.macports.org
emailAddress_default            = macports-users@lists.macports.org
emailAddress_max                = 254

[ privoxy_ca ]
# The self-signed privoxy CA certificate (`man x509v3_config`).
subjectKeyIdentifier            = hash
authorityKeyIdentifier          = keyid:always
basicConstraints                = critical, CA:true, pathlen:0
keyUsage                        = critical, cRLSign, keyCertSign
# TLS server certificates only: a chain through this CA is not valid for
# S/MIME or code signing.
extendedKeyUsage                = serverAuth

[ adblock2privoxy ]
# Extensions for the server certificate (`man x509v3_config`).
basicConstraints                = critical, CA:FALSE
subjectKeyIdentifier            = hash
authorityKeyIdentifier          = keyid:always
keyUsage                        = critical, digitalSignature
extendedKeyUsage                = serverAuth
subjectAltName                  = DNS:localhost, IP:127.0.0.1

[ crl_ext ]
# Extension for CRLs (`man x509v3_config`).
authorityKeyIdentifier=keyid:always
