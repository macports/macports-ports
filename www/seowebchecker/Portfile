                    size    234820

depends_run         port:nodejs20

use_configure       no

build {
    # No compilation required (interpreted Node.js CLI)
}

destroot {
    set app_dir ${destroot}${prefix}/lib/node_modules/seowebchecker
    xinstall -d ${app_dir}
    file copy {*}[glob ${worksrcpath}/npm/*] ${app_dir}/

    xinstall -d ${destroot}${prefix}/bin
    ln -s ${prefix}/lib/node_modules/seowebchecker/bin/cli.js ${destroot}${prefix}/bin/seowebchecker
    ln -s ${prefix}/lib/node_modules/seowebchecker/bin/cli.js ${destroot}${prefix}/bin/seowebchecker-audit
}
