# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           github 1.0
PortGroup           openssl 1.0

# Upstream's last two tagged releases (v2_0_2, v2_0_3) both fail to build on
# any current autoconf/automake/gtk3 toolchain: configure.ac calls the long
# removed AM_PATH_GTK_3_0 macro. That's fixed on master as of this commit,
# which also carries unrelated macOS build fixes not in any tagged release
# yet. Pinning to this commit (rather than a tag) until a new release is
# cut; see https://github.com/juddmon/jpilot/pull/80
github.setup        juddmon jpilot c25715c26710708ebfcb01e7b75c709fd6cdb17d
revision            0
categories          palm
license             GPL-2
maintainers         @HodsonTech openmaintainer

description         A Palm Pilot desktop for Unix
long_description    J-Pilot is a desktop organizer application for the palm pilot and other\
    Palm OS devices.  It is similar in functionality to the one that\
    3Com/Palm distributed.

checksums           rmd160  623916f451a7b96c9b1c7bf2cc917a5859103409 \
                    sha256  04d54580882a04ed4fc95913b09739608712dcce5561d411facdd9425e72ae07 \
                    size    1578803

# Fixes the AM_PATH_GTK_3_0 build failure described above, and the KeyRing
# plugin's build against OpenSSL 3 (HEADER_NEW_DES_H no longer defined).
# Drop each once a release tag containing that fix is available and the
# port is bumped to it; see
# https://github.com/juddmon/jpilot/pull/80 and
# https://github.com/juddmon/jpilot/pull/81
patchfiles          patch-configure.ac-pkgconfig-gtk3.diff \
                    patch-KeyRing-keyring.c-openssl3.diff

depends_build       port:autoconf \
                    port:automake \
                    port:libtool \
                    port:gettext \
                    port:intltool \
                    port:pkgconfig

depends_lib         path:lib/pkgconfig/gtk+-3.0.pc:gtk3 \
                    port:libiconv \
                    port:pilot-link \
                    path:lib/pkgconfig/sqlite3.pc:sqlite3

use_configure       yes

# Upstream ships no generated configure script; autogen.sh reproduces the
# usual autoreconf-style bootstrap (autopoint/intltoolize/libtoolize/
# aclocal/autoheader/automake/autoconf) and by default also runs the
# resulting ./configure itself -- NOCONFIGURE=1 skips just that last step,
# since MacPorts' own configure phase already does it.
pre-configure {
    system -W ${worksrcpath} "NOCONFIGURE=1 ./autogen.sh"
}

configure.args      --with-libiconv-prefix=${prefix} \
                    --with-pilot-prefix=${prefix}
