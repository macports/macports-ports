# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           github 1.0
PortGroup           openssl 1.0

# Upstream's last two tagged releases (v2_0_2, v2_0_3) both fail to build on
# any current autoconf/automake/gtk3 toolchain: configure.ac calls the long
# removed AM_PATH_GTK_3_0 macro. That's fixed on master as of this commit
# (both juddmon/jpilot#80 and #81 are merged here, so no patches are needed
# any more -- see the previous revision of this Portfile if a diff is
# wanted). Pinned just before upstream's later pilot-link >=0.15.0 bump,
# which MacPorts' pilot-link doesn't yet satisfy (0.12.5); re-pin further
# once that's available, or once a new release tag covers all of this.
github.setup        juddmon jpilot 38d3f8dd422a9fb69caced4e48b842a022feb343
revision            0
categories          palm
license             GPL-2
maintainers         @HodsonTech openmaintainer

description         A Palm Pilot desktop for Unix
long_description    J-Pilot is a desktop organizer application for the palm pilot and other\
    Palm OS devices.  It is similar in functionality to the one that\
    3Com/Palm distributed.

checksums           rmd160  48fbbbdeeca1eec4ff8c71b39022ee11da6024d4 \
                    sha256  18e0e654cc51391f7cb3783de23c6f59db490030e1a0edf7af4cd1d2d057e13f \
                    size    1581710

depends_build       port:autoconf \
                    port:automake \
                    port:libtool \
                    port:gettext \
                    port:intltool \
                    port:pkgconfig

depends_lib         path:lib/pkgconfig/gtk+-3.0.pc:gtk3 \
                    port:libiconv \
                    port:pilot-link \
                    path:lib/pkgconfig/sqlite3.pc:sqlite3

use_configure       yes

# Upstream ships no generated configure script; autogen.sh reproduces the
# usual autoreconf-style bootstrap (autopoint/intltoolize/libtoolize/
# aclocal/autoheader/automake/autoconf) and by default also runs the
# resulting ./configure itself -- NOCONFIGURE=1 skips just that last step,
# since MacPorts' own configure phase already does it.
pre-configure {
    system -W ${worksrcpath} "NOCONFIGURE=1 ./autogen.sh"
}

configure.args      --with-libiconv-prefix=${prefix} \
                    --with-pilot-prefix=${prefix}
