# Upstream commit/PR for this fix: https://github.com/juddmon/jpilot/pull/81
--- KeyRing/keyring.c.orig
+++ KeyRing/keyring.c
@@ -41,6 +41,15 @@
 #  include <openssl/md5.h>
 #  include <openssl/des.h>

+/* HEADER_NEW_DES_H used to be defined by OpenSSL's des.h itself to flag
+ * the pointer-based DES_set_key()/DES_ecb3_encrypt() API. OpenSSL dropped
+ * the macro once that became the only API, long before OpenSSL 3, so
+ * without this compat define every "#ifdef HEADER_NEW_DES_H" below falls
+ * back to lowercase des_*() calls that no longer exist. */
+#  ifndef HEADER_NEW_DES_H
+#    define HEADER_NEW_DES_H
+#  endif
+
 #endif

 /* Pilot-link header files */
