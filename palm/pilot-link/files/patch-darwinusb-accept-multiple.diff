From 05ebea4d9eaa2171381dd8f1f49d722af6d499ba Mon Sep 17 00:00:00 2001
From: HodsonTech <jeff@hodsontech.com>
Date: Thu, 15 Oct 2026 00:17:29 -0500
Subject: [PATCH] darwinusb: accept a new handheld while an old connection
 record exists

The default was chosen by '#if HAVE_PTHREAD', but this file never includes
config.h, so the macro was always undefined and the option was always 0. A
connection left in the list after a HotSync then made every later pi_accept()
in the same process ignore the handheld ('new device plugged but we already
have a running connection') until the program was restarted. This file uses
pthreads unconditionally, so default the option to 1.
---
 libpisock/darwinusb.c | 15 +++++++++------
 1 file changed, 9 insertions(+), 6 deletions(-)

diff --git a/libpisock/darwinusb.c b/libpisock/darwinusb.c
index d6c89a0f..ea40ea6a 100644
--- a/libpisock/darwinusb.c
+++ b/libpisock/darwinusb.c
@@ -112,12 +112,15 @@
 #define MAX_AUTO_READ_SIZE	4096
 #define AUTO_READ_SIZE		64
 
-/* Options */
-#if HAVE_PTHREAD
-static int accept_multiple_simultaneous_connections = 1;	/* enabled by default when compiling with --enable-threads */
-#else
-static int accept_multiple_simultaneous_connections = 0;	/* disabled by default, set to 1 to enable */
-#endif
+/* Options.
+ * This file always uses pthreads, so accept a newly plugged-in handheld even if an
+ * earlier connection is still in the list. With the old default of 0, a connection
+ * left over from a finished HotSync made every later pi_accept() in the same process
+ * fail until the program was restarted. (The old "#if HAVE_PTHREAD" test could never
+ * be true here: config.h is not included in this file, so the macro was always
+ * undefined.)
+ */
+static int accept_multiple_simultaneous_connections = 1;
 
 /* IOKit interface */
 static IONotificationPortRef usb_notify_port;
