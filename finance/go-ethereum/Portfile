# The commit the release tag points at, and its date, as build/ci.go stamps them.
set geth_commit     1df30b18d9ed35ee9d28ffd4648442c2204554ad
set geth_date       20261023

# The binaries upstream ships in its geth-alltools archive.
set geth_tools      {abigen evm geth rlpdump}

build.args-append   -trimpath \
                    -tags urfave_cli_no_docs,ckzg \
                    -ldflags \"--buildid=none -s \
                        -X github.com/ethereum/go-ethereum/internal/version.gitCommit=${geth_commit} \
                        -X github.com/ethereum/go-ethereum/internal/version.gitDate=${geth_date}\" \
                    -o ${worksrcpath}/build/bin/ \
                    {*}[lmap tool ${geth_tools} {string cat ./cmd/${tool}}]

destroot {
    foreach tool ${geth_tools} {
        xinstall -m 0755 ${worksrcpath}/build/bin/${tool} ${destroot}${prefix}/bin/
    }
}

